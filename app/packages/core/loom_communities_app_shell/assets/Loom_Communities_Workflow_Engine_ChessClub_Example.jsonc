{
  "specVersion": 4,
  "packageId": "init_chess_club_1",
  "communityId": "community_chess_club",
  "communityHandle": "chess-club",
  "displayName": "Chess Club",
  "extensionId": "ext_chess_club",
  "branding": {
    "accentColor": "#6B4F2A"
  },
  "seedDataFiles": [],
  "idempotencyKey": "chess-club-spec-v4-tab-audience-checksum-2026-08-28",
  "experience": {
    "displayName": "Chess Club",
    "tagline": "Ladder matches, club nights, pairings, standings, and rules for local chess players.",
    "accentColor": "#6B4F2A",
    "theme": {
      "accent": "#6B4F2A",
      "tabThemes": {
        "calendar": {
          "accent": "#365B3A"
        },
        "admin": {
          "accent": "#4A3B63"
        }
      }
    },
    "creatableAction": {
      "multiActionStyle": "speedDial",
      "presentationStyle": "popup"
    },
    "roles": [
      {
        "roleId": "chess-organizer",
        "label": "Organizer",
        "roleLabel": "Organizer",
        "description": "Schedules club activity, manages pairings, publishes rankings, and maintains rules."
      },
      {
        "roleId": "chess-member",
        "label": "Player",
        "roleLabel": "Member",
        "description": "Schedules and plays matches, reports results, joins club nights, and participates in discussions."
      },
      {
        "roleId": "chess-owner",
        "label": "Owner",
        "roleLabel": "Owner",
        "description": "Sets up the community and owns its data-export responsibilities; admission authority remains in App Access and is not modeled as a workflow."
      }
    ],
    "workflowDefinitions": {
      "chess-match-meetup": {
        "initialState": "proposed",
        "states": {
          "proposed": {
            "label": "Match proposed",
            "tone": "info",
            "editableFields": [
              "matchTitle",
              "proposerName",
              "opponentName",
              "opponentFanId",
              "eventDate",
              "eventTime",
              "expiresAt",
              "location",
              "boardLabel",
              "roundLabel"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-member"
              ]
            }
          },
          "accepted": {
            "label": "Match accepted",
            "tone": "positive"
          },
          "declined": {
            "label": "Match declined",
            "tone": "negative"
          },
          "rescheduled": {
            "label": "New time proposed",
            "tone": "warning",
            "editableFields": [
              "eventDate",
              "eventTime",
              "expiresAt",
              "location",
              "boardLabel"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-member"
              ]
            }
          },
          "completed": {
            "label": "Match completed",
            "tone": "positive",
            "isTerminal": true
          },
          "cancelled": {
            "label": "Meetup cancelled",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "accept-match",
            "label": "Accept match",
            "icon": "event_available",
            "tone": "primary",
            "from": [
              "proposed",
              "rescheduled"
            ],
            "to": "accepted",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorEqualsField": {
                "key": "opponentFanId"
              },
              "formula": "isBefore(now(), expiresAt)",
              "locationOverlap": {
                "locationField": "location",
                "dateField": "eventDate",
                "timeField": "eventTime",
                "durationMinutes": 90
              }
            },
            "effects": [
              {
                "op": "append",
                "key": "matchHistory",
                "value": {
                  "action": "accepted",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "decline-match",
            "label": "Decline match",
            "icon": "event_busy",
            "tone": "secondary",
            "from": [
              "proposed",
              "rescheduled"
            ],
            "to": "declined",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorEqualsField": {
                "key": "opponentFanId"
              }
            },
            "effects": [
              {
                "op": "append",
                "key": "matchHistory",
                "value": {
                  "action": "declined",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "suggest-new-time",
            "label": "Suggest new time",
            "icon": "update",
            "tone": "secondary",
            "from": [
              "proposed",
              "accepted",
              "declined"
            ],
            "to": "rescheduled",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "formula": "$actor == proposedByFanId || $actor == opponentFanId"
            },
            "inputs": {
              "eventDate": {
                "type": "text",
                "required": true
              },
              "eventTime": {
                "type": "text",
                "required": true
              },
              "expiresAt": {
                "type": "text",
                "required": true
              },
              "location": {
                "type": "text",
                "required": true
              },
              "boardLabel": {
                "type": "text",
                "required": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "eventDate",
                "value": "{input.eventDate}"
              },
              {
                "op": "set",
                "key": "eventTime",
                "value": "{input.eventTime}"
              },
              {
                "op": "set",
                "key": "expiresAt",
                "value": "{input.expiresAt}"
              },
              {
                "op": "set",
                "key": "location",
                "value": "{input.location}"
              },
              {
                "op": "set",
                "key": "boardLabel",
                "value": "{input.boardLabel}"
              },
              {
                "op": "append",
                "key": "matchHistory",
                "value": {
                  "action": "new-time-proposed",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "add-reminder",
            "label": "Add reminder",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": [
              "accepted"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "formula": "$actor == proposedByFanId || $actor == opponentFanId",
              "instanceDataEquals": {
                "key": "reminderState",
                "value": "not-added"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "reminderState",
                "value": "added"
              },
              {
                "op": "set",
                "key": "reminderEnabled",
                "value": true
              },
              {
                "op": "append",
                "key": "matchHistory",
                "value": {
                  "action": "reminder-added",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "record-result",
            "label": "Record result",
            "icon": "emoji_events",
            "tone": "primary",
            "from": [
              "accepted"
            ],
            "to": "completed",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "formula": "$actor == proposedByFanId || $actor == opponentFanId"
            },
            "effects": [
              {
                "op": "append",
                "key": "matchHistory",
                "value": {
                  "action": "result-ready",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ],
            "linkedWorkflowId": "chess-match-result"
          },
          {
            "id": "cancel-meetup",
            "label": "Cancel meetup",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "proposed",
              "accepted",
              "declined",
              "rescheduled"
            ],
            "to": "cancelled",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorEqualsField": {
                "key": "proposedByFanId"
              }
            },
            "effects": [
              {
                "op": "append",
                "key": "matchHistory",
                "value": {
                  "action": "cancelled",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "reminder": {
          "anchorDateField": "eventDate",
          "anchorTimeField": "eventTime",
          "leadHours": 24,
          "enabledField": "reminderEnabled"
        },
        "renderBindings": [
          {
            "states": [
              "proposed",
              "accepted",
              "declined",
              "rescheduled"
            ],
            "audience": "any",
            "tabId": "matches",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Propose match",
                "byRoleIds": [
                  "chess-member"
                ],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "proposedByFanId": "$actor",
                  "proposedAt": "$timestamp",
                  "reminderState": "not-added",
                  "reminderEnabled": false,
                  "matchHistory": []
                }
              }
            ]
          },
          {
            "states": [
              "completed",
              "cancelled"
            ],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          },
          {
            "states": [
              "accepted",
              "completed"
            ],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "matchTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "proposerName": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "person_outline",
            "labelTemplate": "Proposed by {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "opponentName": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "sports_esports",
            "labelTemplate": "Opponent: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "opponentFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "formEntry"
          },
          "eventDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "calendar_today",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "eventTime": {
            "type": "time",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "expiresAt": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "timer_outlined",
            "labelTemplate": "Respond by {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "location": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "location_on_outlined",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "boardLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "grid_4x4",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "roundLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "format_list_numbered",
            "labelTemplate": "{value}",
            "displayContexts": [
              "detail"
            ]
          },
          "proposedByFanId": {
            "type": "fanId?",
            "writableBy": "platform"
          },
          "proposedAt": {
            "type": "date?",
            "writableBy": "platform",
            "sortable": true
          },
          "reminderState": {
            "type": "text",
            "writableBy": "platform",
            "displayIcon": "notifications_outlined",
            "labelTemplate": "Reminder: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "reminderEnabled": {
            "type": "bool",
            "writableBy": "platform"
          },
          "matchHistory": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "history",
            "labelTemplate": "{value.length} updates",
            "displayContexts": [
              "detail"
            ]
          }
        },
        "visibility": {
          "default": "membersOnly"
        }
      },
      "chess-match-result": {
        "initialState": "draft",
        "states": {
          "draft": {
            "label": "Draft result",
            "tone": "info",
            "editableFields": [
              "resultTitle",
              "playerOneName",
              "playerTwoName",
              "roundLabel",
              "score",
              "outcome",
              "participantFanIds"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-member"
              ]
            }
          },
          "submitted": {
            "label": "Result submitted",
            "tone": "info"
          },
          "correction-requested": {
            "label": "Correction requested",
            "tone": "warning",
            "editableFields": [
              "score",
              "outcome"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-member"
              ]
            }
          },
          "disputed": {
            "label": "Result disputed",
            "tone": "negative"
          },
          "final": {
            "label": "Saved result",
            "tone": "positive"
          },
          "undone": {
            "label": "Result undone",
            "tone": "warning"
          },
          "voided": {
            "label": "Result voided",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "submit-result",
            "label": "Submit score",
            "icon": "send",
            "tone": "primary",
            "from": [
              "draft"
            ],
            "to": "submitted",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "participantFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Result submitted"
              },
              {
                "op": "set",
                "key": "submittedAt",
                "value": "$timestamp"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "score-submitted",
                  "actorFanId": "$actor",
                  "at": "$timestamp",
                  "score": "{score}",
                  "outcome": "{outcome}"
                }
              }
            ]
          },
          {
            "id": "save-result",
            "label": "Save result",
            "icon": "save",
            "tone": "primary",
            "from": [
              "submitted"
            ],
            "to": "final",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "participantFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Result saved"
              },
              {
                "op": "set",
                "key": "savedAt",
                "value": "$timestamp"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "saved",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "request-correction",
            "label": "Edit score",
            "icon": "edit",
            "tone": "secondary",
            "from": [
              "submitted",
              "final"
            ],
            "to": "correction-requested",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "participantFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Correction requested"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "correction-requested",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "correct-result",
            "label": "Correct result",
            "icon": "published_with_changes",
            "tone": "primary",
            "from": [
              "correction-requested"
            ],
            "to": "submitted",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "participantFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Corrected result submitted"
              },
              {
                "op": "set",
                "key": "submittedAt",
                "value": "$timestamp"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "result-corrected",
                  "actorFanId": "$actor",
                  "at": "$timestamp",
                  "score": "{score}",
                  "outcome": "{outcome}"
                }
              }
            ]
          },
          {
            "id": "dispute-result",
            "label": "Dispute result",
            "icon": "report_problem",
            "tone": "destructive",
            "from": [
              "submitted",
              "correction-requested",
              "final"
            ],
            "to": "disputed",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "participantFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Result disputed"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "disputed",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "resolve-dispute",
            "label": "Resolve dispute",
            "icon": "gavel",
            "tone": "primary",
            "from": [
              "disputed"
            ],
            "to": "final",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer",
                "chess-member"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Result saved"
              },
              {
                "op": "set",
                "key": "savedAt",
                "value": "$timestamp"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "dispute-resolved",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "undo-result",
            "label": "Undo result",
            "icon": "undo",
            "tone": "destructive",
            "from": [
              "final"
            ],
            "to": "undone",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "participantFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Result undone"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "undone",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "reopen-result",
            "label": "Record again",
            "icon": "restart_alt",
            "tone": "secondary",
            "from": [
              "undone"
            ],
            "to": "draft",
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "participantFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Draft result"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "reopened",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "void-result",
            "label": "Void result",
            "icon": "block",
            "tone": "destructive",
            "from": [
              "draft",
              "submitted",
              "correction-requested",
              "disputed",
              "undone"
            ],
            "to": "voided",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Result voided"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "voided",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "record-standings-impact",
            "label": "Record standings impact",
            "icon": "leaderboard",
            "tone": "secondary",
            "from": [
              "final"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            },
            "inputs": {
              "rankingImpactNote": {
                "type": "text",
                "required": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "rankingImpactNote",
                "value": "{input.rankingImpactNote}"
              },
              {
                "op": "set",
                "key": "rankingImpactRecordedAt",
                "value": "$timestamp"
              },
              {
                "op": "append",
                "key": "resultHistory",
                "value": {
                  "action": "standings-impact-recorded",
                  "actorFanId": "$actor",
                  "at": "$timestamp",
                  "note": "{input.rankingImpactNote}"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": [
              "draft",
              "correction-requested"
            ],
            "audience": "any",
            "tabId": "matches",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Record match",
                "byRoleIds": [
                  "chess-member"
                ],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "statusMessage": "Draft result",
                  "participantFanIds": [
                    "$actor"
                  ],
                  "resultHistory": []
                }
              }
            ]
          },
          {
            "states": [
              "submitted",
              "disputed",
              "final",
              "undone"
            ],
            "audience": "any",
            "tabId": "matches",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "primary"
          },
          {
            "states": [
              "disputed"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": [
              "voided"
            ],
            "audience": "any",
            "tabId": "matches",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "resultTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "playerOneName": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "person_outline",
            "labelTemplate": "White: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "playerTwoName": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "person",
            "labelTemplate": "Black: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "roundLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "format_list_numbered",
            "labelTemplate": "{value}",
            "displayContexts": [
              "detail"
            ]
          },
          "score": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "scoreboard",
            "labelTemplate": "Score: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "outcome": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "emoji_events",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "participantFanIds": {
            "type": "fanId[]",
            "required": true,
            "writableBy": "formEntry"
          },
          "statusMessage": {
            "type": "text",
            "writableBy": "platform",
            "displayIcon": "info_outline",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "submittedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "send"
          },
          "savedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "save"
          },
          "rankingImpactNote": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "leaderboard",
            "labelTemplate": "{value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "rankingImpactRecordedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true
          },
          "resultHistory": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "history",
            "labelTemplate": "{value.length} result updates",
            "displayContexts": [
              "detail"
            ]
          }
        },
        "visibility": {
          "default": "membersOnly"
        }
      },
      "chess-club-night": {
        "initialState": "scheduled",
        "states": {
          "scheduled": {
            "label": "Club night scheduled",
            "tone": "info",
            "editableFields": [
              "eventTitle",
              "eventKind",
              "eventDate",
              "eventTime",
              "location",
              "pairingNote",
              "recipientFanId"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            }
          },
          "reminded": {
            "label": "Reminder sent",
            "tone": "positive"
          },
          "cancelled": {
            "label": "Club night cancelled",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "rsvp-club-night",
            "label": "RSVP",
            "icon": "event_available",
            "tone": "primary",
            "from": [
              "scheduled",
              "reminded"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "attendingFanIds",
                "present": false
              }
            },
            "effects": [
              {
                "op": "appendUnique",
                "key": "attendingFanIds",
                "value": "$actor"
              }
            ]
          },
          {
            "id": "withdraw-club-night-rsvp",
            "label": "Withdraw RSVP",
            "icon": "event_busy",
            "tone": "secondary",
            "from": [
              "scheduled",
              "reminded"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "attendingFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "removeValue",
                "key": "attendingFanIds",
                "value": "$actor"
              }
            ]
          },
          {
            "id": "add-event-reminder",
            "label": "Add reminder",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": [
              "scheduled",
              "reminded"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-member"
              ],
              "actorInList": {
                "key": "reminderFanIds",
                "present": false
              }
            },
            "effects": [
              {
                "op": "appendUnique",
                "key": "reminderFanIds",
                "value": "$actor"
              }
            ]
          },
          {
            "id": "send-reminder",
            "label": "Send reminder",
            "icon": "notifications",
            "tone": "primary",
            "from": [
              "scheduled"
            ],
            "to": "reminded",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "reminderStatus",
                "value": "sent"
              },
              {
                "op": "append",
                "key": "reminderHistory",
                "value": {
                  "action": "reminder-sent",
                  "recipientFanId": "{recipientFanId}",
                  "sentByFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "cancel-club-night",
            "label": "Cancel club night",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "scheduled",
              "reminded"
            ],
            "to": "cancelled",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "reminderStatus",
                "value": "cancelled"
              },
              {
                "op": "append",
                "key": "reminderHistory",
                "value": {
                  "action": "cancelled",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": [
              "scheduled",
              "reminded"
            ],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Schedule club night",
                "byRoleIds": [
                  "chess-organizer"
                ],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "reminderStatus": "scheduled",
                  "reminderHistory": [],
                  "attendingFanIds": [],
                  "reminderFanIds": []
                }
              }
            ]
          },
          {
            "states": [
              "cancelled"
            ],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          },
          {
            "states": [
              "scheduled",
              "reminded"
            ],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "eventTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "eventKind": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "category",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "eventDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "calendar_today",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "eventTime": {
            "type": "time",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "location": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "location_on_outlined",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "pairingNote": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "format_list_bulleted",
            "labelTemplate": "{value}",
            "displayContexts": [
              "detail"
            ]
          },
          "recipientFanId": {
            "type": "fanId?",
            "writableBy": "formEntry",
            "displayIcon": "person_outline",
            "labelTemplate": "Reminder recipient: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "reminderStatus": {
            "type": "text",
            "writableBy": "platform",
            "displayIcon": "notifications_outlined",
            "labelTemplate": "Reminder: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "reminderHistory": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "history",
            "labelTemplate": "{value.length} reminder updates",
            "displayContexts": [
              "detail"
            ]
          },
          "attendingFanIds": {
            "type": "fanId[]",
            "writableBy": "platform",
            "displayIcon": "groups_outlined",
            "labelTemplate": "Attending: {value.length}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "reminderFanIds": {
            "type": "fanId[]",
            "writableBy": "platform",
            "displayIcon": "alarm",
            "labelTemplate": "Reminders: {value.length}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          }
        },
        "visibility": {
          "default": "membersOnly"
        }
      },
      "chess-discussion-thread": {
        "initialState": "open",
        "states": {
          "open": {
            "label": "Open discussion",
            "tone": "positive",
            "editableFields": [
              "subject"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-organizer",
                "chess-member"
              ]
            }
          },
          "archived": {
            "label": "Archived",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "post-message",
            "label": "Reply",
            "icon": "send",
            "tone": "primary",
            "from": [
              "open"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-organizer",
                "chess-member"
              ]
            },
            "inputs": {
              "messageBody": {
                "type": "text",
                "required": true
              }
            },
            "effects": [
              {
                "op": "append",
                "key": "messages",
                "value": {
                  "senderFanId": "$actor",
                  "body": "{input.messageBody}",
                  "timestamp": "$timestamp"
                }
              },
              {
                "op": "append",
                "key": "threadHistory",
                "value": {
                  "action": "replied",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "mute-thread",
            "label": "Mute",
            "icon": "notifications_off",
            "tone": "secondary",
            "from": [
              "open"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-organizer",
                "chess-member"
              ]
            },
            "effects": [
              {
                "op": "append",
                "key": "threadHistory",
                "value": {
                  "action": "muted",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "archive-thread",
            "label": "Archive",
            "icon": "archive",
            "tone": "destructive",
            "from": [
              "open"
            ],
            "to": "archived",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            },
            "effects": [
              {
                "op": "append",
                "key": "threadHistory",
                "value": {
                  "action": "archived",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": [
              "open"
            ],
            "audience": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New thread",
                "byRoleIds": [
                  "chess-organizer",
                  "chess-member"
                ],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "messages": [],
                  "threadHistory": []
                }
              }
            ]
          },
          {
            "states": [
              "archived"
            ],
            "audience": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "subject": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "messages": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "forum",
            "labelTemplate": "{value.length} messages",
            "displayContexts": [
              "detail"
            ]
          },
          "threadHistory": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "history",
            "labelTemplate": "{value.length} thread updates",
            "displayContexts": [
              "detail"
            ]
          },
          "messageCount": {
            "type": "number",
            "formula": "size(messages)",
            "displayIcon": "chat_bubble_outline",
            "labelTemplate": "{value} messages",
            "displayContexts": [
              "tile",
              "detail"
            ]
          }
        },
        "visibility": {
          "default": "membersOnly"
        }
      },
      "chess-export-package": {
        "initialState": "ready",
        "states": {
          "ready": {
            "label": "Ready to export",
            "tone": "info",
            "editableFields": [
              "exportLabel",
              "exportScope"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-owner"
              ]
            }
          },
          "generated": {
            "label": "Export generated",
            "tone": "positive"
          },
          "rolled-back": {
            "label": "Export rolled back",
            "tone": "warning"
          },
          "cancelled": {
            "label": "Export cancelled",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "change-export-scope",
            "action": "configure_scope",
            "label": "Change scope",
            "icon": "tune",
            "tone": "secondary",
            "from": [
              "ready",
              "rolled-back"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-owner"
              ]
            },
            "inputs": {
              "exportScope": {
                "type": "list",
                "required": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "exportScope",
                "value": "{input.exportScope}"
              },
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Ready to generate"
              },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "action": "scope-changed",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "generate-export",
            "action": "run",
            "label": "Generate export",
            "icon": "archive",
            "tone": "primary",
            "from": [
              "ready"
            ],
            "to": "generated",
            "guard": {
              "allowedRoleIds": [
                "chess-owner"
              ],
              "formula": "size(exportScope) > 0"
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Export generated; integrity metadata is platform-managed"
              },
              {
                "op": "set",
                "key": "generatedAt",
                "value": "$timestamp"
              },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "action": "generated",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "download-export",
            "action": "download",
            "label": "Download export",
            "icon": "download",
            "tone": "secondary",
            "from": [
              "generated"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "chess-owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "downloadedAt",
                "value": "$timestamp"
              },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "action": "downloaded",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "rollback-export",
            "action": "rollback",
            "label": "Rollback",
            "icon": "restore",
            "tone": "destructive",
            "from": [
              "generated"
            ],
            "to": "rolled-back",
            "guard": {
              "allowedRoleIds": [
                "chess-owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Export rolled back"
              },
              {
                "op": "set",
                "key": "rolledBackAt",
                "value": "$timestamp"
              },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "action": "rolled-back",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "reopen-export",
            "action": "retry",
            "label": "Generate again",
            "icon": "restart_alt",
            "tone": "secondary",
            "from": [
              "rolled-back"
            ],
            "to": "ready",
            "guard": {
              "allowedRoleIds": [
                "chess-owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Ready to generate"
              },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "action": "reopened",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "cancel-export",
            "action": "cancel",
            "label": "Cancel export",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "ready",
              "rolled-back"
            ],
            "to": "cancelled",
            "guard": {
              "allowedRoleIds": [
                "chess-owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "statusMessage",
                "value": "Export cancelled"
              },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "action": "cancelled",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": [
              "ready",
              "generated",
              "rolled-back"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New export",
                "byRoleIds": [
                  "chess-owner"
                ],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "ownerFanId": "$actor",
                  "statusMessage": "Ready to generate",
                  "exportHistory": []
                }
              }
            ]
          },
          {
            "states": [
              "cancelled"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "summary"
          },
          {
            "states": [
              "generated",
              "rolled-back",
              "cancelled"
            ],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "exportLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "exportScope": {
            "type": "list",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "filter_list",
            "labelTemplate": "{value.length} data groups",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "ownerFanId": {
            "type": "fanId?",
            "writableBy": "platform"
          },
          "statusMessage": {
            "type": "text",
            "writableBy": "platform",
            "displayIcon": "info_outline",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          // Export bundle service writes the real SHA-256 checksum over the bytes it serves.
          "checksum": {
            "type": "text?",
            "writableBy": "platform",
            "displayIcon": "verified_user",
            "labelTemplate": "Checksum: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "generatedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "schedule",
            "hideWhenEmpty": true
          },
          "downloadedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "download_done",
            "hideWhenEmpty": true
          },
          "rolledBackAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "restore",
            "hideWhenEmpty": true
          },
          "exportHistory": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "history",
            "labelTemplate": "{value.length} export updates",
            "displayContexts": [
              "detail"
            ]
          }
        },
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "allowedRoleIds": [
              "chess-owner",
              "chess-member"
            ]
          }
        }
      },
      "chess-pairing-queue": {
        "initialState": "open",
        "states": {
          "open": {
            "label": "Pairing queue open",
            "tone": "positive",
            "editableFields": [
              "queueTitle",
              "queueOpenedAt",
              "waitingPlayerNames"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            }
          },
          "assigned": {
            "label": "Pairings in progress",
            "tone": "info",
            "editableFields": [
              "waitingPlayerNames"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            }
          },
          "closed": {
            "label": "Pairing queue closed",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "assign-pairing",
            "label": "Assign pairing",
            "icon": "compare_arrows",
            "tone": "primary",
            "from": [
              "open",
              "assigned"
            ],
            "to": "assigned",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ],
              "formula": "size(waitingPlayerNames) > 1"
            },
            "inputs": {
              "playerOne": {
                "type": "text",
                "required": true
              },
              "playerTwo": {
                "type": "text",
                "required": true
              },
              "boardLabel": {
                "type": "text",
                "required": true
              }
            },
            "effects": [
              {
                "op": "append",
                "key": "assignmentHistory",
                "value": {
                  "playerOne": "{input.playerOne}",
                  "playerTwo": "{input.playerTwo}",
                  "boardLabel": "{input.boardLabel}",
                  "assignedByFanId": "$actor",
                  "assignedAt": "$timestamp"
                }
              },
              {
                "op": "removeValue",
                "key": "waitingPlayerNames",
                "value": "{input.playerOne}"
              },
              {
                "op": "removeValue",
                "key": "waitingPlayerNames",
                "value": "{input.playerTwo}"
              }
            ]
          },
          {
            "id": "close-pairing-queue",
            "label": "Close queue",
            "icon": "lock",
            "tone": "destructive",
            "from": [
              "open",
              "assigned"
            ],
            "to": "closed",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            }
          }
        ],
        "renderBindings": [
          {
            "states": [
              "open",
              "assigned"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New pairing queue",
                "byRoleIds": [
                  "chess-organizer"
                ],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "assignmentHistory": []
                }
              }
            ]
          },
          {
            "states": [
              "closed"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "queueTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "queueOpenedAt": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "schedule",
            "labelTemplate": "Opened {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "waitingPlayerNames": {
            "type": "list",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "format_list_numbered",
            "labelTemplate": "Waiting in order: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "assignmentHistory": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "history",
            "labelTemplate": "{value.length} pairings assigned",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "queueLength": {
            "type": "number",
            "formula": "size(waitingPlayerNames)",
            "displayIcon": "groups_outlined",
            "labelTemplate": "Waiting: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          }
        },
        "visibility": {
          "default": "membersOnly"
        }
      },
      "chess-rankings-table": {
        "initialState": "draft",
        "states": {
          "draft": {
            "label": "Ranking update draft",
            "tone": "info",
            "editableFields": [
              "rank",
              "playerName",
              "score",
              "delta",
              "changeEvidence",
              "rankChangeConfirmed"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            }
          },
          "current": {
            "label": "Current ranking",
            "tone": "positive"
          },
          "retired": {
            "label": "Retired ranking row",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "publish-ranking",
            "label": "Publish rankings",
            "icon": "publish",
            "tone": "primary",
            "from": [
              "draft"
            ],
            "to": "current",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ],
              "formula": "rankChangeConfirmed == true"
            },
            "effects": [
              {
                "op": "set",
                "key": "lastUpdated",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "publishedByFanId",
                "value": "$actor"
              },
              {
                "op": "append",
                "key": "publicationHistory",
                "value": {
                  "action": "published",
                  "actorFanId": "$actor",
                  "at": "$timestamp",
                  "rank": "{rank}",
                  "score": "{score}",
                  "delta": "{delta}",
                  "evidence": "{changeEvidence}"
                }
              }
            ]
          },
          {
            "id": "revise-ranking",
            "label": "Revise ranking",
            "icon": "edit",
            "tone": "secondary",
            "from": [
              "current"
            ],
            "to": "draft",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "rankChangeConfirmed",
                "value": false
              }
            ]
          },
          {
            "id": "retire-ranking",
            "label": "Retire ranking row",
            "icon": "archive",
            "tone": "destructive",
            "from": [
              "draft",
              "current"
            ],
            "to": "retired",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            }
          }
        ],
        "renderBindings": [
          {
            "states": [
              "current"
            ],
            "audience": "any",
            "tabId": "rankings",
            "cardSurfaceFamily": "table",
            "bindingKind": "primary"
          },
          {
            "states": [
              "draft",
              "current"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New ranking row",
                "byRoleIds": [
                  "chess-organizer"
                ],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "rankChangeConfirmed": false,
                  "publicationHistory": []
                }
              }
            ]
          },
          {
            "states": [
              "retired"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "table",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "rank": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "format_list_numbered",
            "labelTemplate": "#{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "playerName": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "displayIcon": "person_outline",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "score": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "military_tech",
            "labelTemplate": "Rating: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "delta": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "trending_up",
            "labelTemplate": "Change: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "changeEvidence": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "fact_check",
            "labelTemplate": "{value}",
            "displayContexts": [
              "detail"
            ]
          },
          "rankChangeConfirmed": {
            "type": "bool",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "verified",
            "labelTemplate": "Change confirmed: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "lastUpdated": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "update",
            "labelTemplate": "Updated {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "publishedByFanId": {
            "type": "fanId?",
            "writableBy": "effect"
          },
          "publicationHistory": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "history",
            "labelTemplate": "{value.length} publications",
            "displayContexts": [
              "detail"
            ]
          }
        },
        "visibility": {
          "default": "public"
        }
      },
      "chess-rules-documents": {
