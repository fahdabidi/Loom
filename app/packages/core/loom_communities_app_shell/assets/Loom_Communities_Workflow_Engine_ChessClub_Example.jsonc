            "icon": "download",
            "tone": "primary",
            "from": [
              "available",
              "embedded-opened",
              "external-opened"
            ],
            "to": "downloaded",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer",
                "chess-member"
              ]
            },
            "effects": [
              {
                "op": "append",
                "key": "openHistory",
                "value": {
                  "action": "downloaded",
                  "actorFanId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "archive-document",
            "action": "archive",
            "label": "Archive document",
            "icon": "archive",
            "tone": "destructive",
            "from": [
              "available",
              "embedded-opened",
              "external-opened",
              "downloaded"
            ],
            "to": "archived",
            "guard": {
              "allowedRoleIds": [
                "chess-organizer"
              ]
            }
          }
        ],
        "renderBindings": [
          {
            "states": [
              "available",
              "embedded-opened",
              "external-opened",
              "downloaded"
            ],
            "audience": "any",
            "tabId": "documents",
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
