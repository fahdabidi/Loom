            }
          ]
        },
        {
          "id": "mark-payment-failed",
          "label": "Mark failed",
          "icon": "report",
          "tone": "secondary",
          "from": [
            "unpaid"
          ],
          "to": "failed",
          "guard": {
            "allowedPersonaIds": [
              "guardian"
            ]
          },
          "effects": [
            {
              "op": "set",
              "key": "paymentStatus",
              "value": "Failed"
            }
          ]
        },
        {
          "id": "retry-payment",
          "label": "Retry payment",
          "icon": "undo",
          "tone": "primary",
          "from": [
            "failed"
          ],
          "to": "paid",
          "guard": {
            "allowedPersonaIds": [
              "guardian"
            ]
          },
          "effects": [
            {
              "op": "set",
              "key": "paymentStatus",
              "value": "Paid after retry"
