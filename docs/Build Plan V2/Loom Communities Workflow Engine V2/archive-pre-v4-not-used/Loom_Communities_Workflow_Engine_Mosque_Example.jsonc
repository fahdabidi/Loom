      "renderBindings": [
        {
          "states": [
            "public",
            "anonymous",
            "restricted"
          ],
          "role": "any",
          "tabId": "giving",
          "cardSurfaceFamily": "singleItem",
          "bindingKind": "primary"
        }
      ],
      "instanceDataSchema": {
        "visibilityPreference": {
          "type": "text",
          "displayIcon": "privacy_tip",
          "labelTemplate": "{value}"
