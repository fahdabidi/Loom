        {
          "id": "close-care-request",
          "label": "Close care request",
          "icon": "check",
          "tone": "primary",
          "from": [
            "responded"
          ],
          "to": "resolved",
          "guard": {
            "allowedPersonaIds": [
              "mosque-admin"
            ]
          },
          "effects": [
            {
              "op": "set",
              "key": "careStatus",
              "value": "Resolved"
            }
          ]
