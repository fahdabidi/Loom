          ]
        },
        "submitted": {
          "label": "Submitted"
        },
        "assigned": {
          "label": "Assigned"
        },
        "responded": {
          "label": "Responded"
        },
        "resolved": {
          "label": "Resolved",
          "isTerminal": true
        }
      },
      "transitions": [
        {
          "id": "submit-care-request",
          "label": "Submit care request",
