          "type": "text",
          "displayIcon": "description",
          "labelTemplate": "{value}"
        },
        "assignedReviewerPersonaId": {
          "type": "text",
          "displayIcon": "person",
          "labelTemplate": "Assigned: {value}"
        },
        "privateDetails": {
          "type": "text",
          "displayIcon": "privacy_tip",
          "labelTemplate": "{value}"
        },
        "responseSummary": {
          "type": "text",
          "displayIcon": "reply",
          "labelTemplate": "{value}"
        },
        "careStatus": {
          "type": "text",
          "displayIcon": "check",
          "labelTemplate": "{value}"
        }
      }
    },
