        "receiptVisibility": {
          "type": "text",
          "displayIcon": "description",
          "labelTemplate": "{value}"
        },
        "fundContext": {
          "type": "text",
          "displayIcon": "flag",
          "labelTemplate": "{value}"
        }
      }
    },
    "mosque-care-request": {
      "initialState": "draft",
