{"is_error":false,"duration_api_ms":134841,"num_turns":9,"stop_reason":"end_turn","session_id":"063b8528-54e3-46d4-8b74-0e09c58706fb","total_cost_usd":0.445912,"usage":{"input_tokens":4,"cache_creation_input_tokens":18992,"cache_read_input_tokens":23886,"output_tokens":9668,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":18992,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":9144,"cache_read_input_tokens":16182,"cache_creation_input_tokens":10514,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10514},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":2229,"outputTokens":20,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.002329,"contextWindow":200000,"maxOutputTokens":32000,"canonicalModel":"claude-haiku-4-5","provider":"firstParty"},"claude-opus-5":{"inputTokens":4,"outputTokens":9668,"cacheReadInputTokens":23886,"cacheCreationInputTokens":18992,"webSearchRequests":0,"costUSD":0.44358299999999995,"contextWindow":1000000,"maxOutputTokens":64000,"canonicalModel":"claude-opus-5","provider":"firstParty"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subtype":"success","api_error_status":null,"result":"```json\n{\n  \"status\": \"fail\",\n  \"currentReviewRunId\": \"phaseA-authz-repro-hoa-1\",\n  \"freshReview\": true,\n  \"appCommitSha\": \"559f3a1b\",\n  \"reviewedScreenRowIds\": [\"hoa-entry-gate\", \"hoa-home-role-summary\", \"hoa-persona-picker-dialog\", \"hoa-sign-in-specific-person\"],\n  \"reviewedScreenshotHashes\": [\"c7075e99bfc00f2bad5d423ebd21ea758b23ca11544d8c1f58f99ec9b6089013\", \"49c30190047cc8ca9a5704b7fcfda9f52c2d271af4b24bbcc10ee777943fedf3\", \"9641121450ef3b2d57424be50a43e00488cdc43096b402e4be726719926dcc13\", \"6b8cb0131b1e3cbd242b7aa7718c876939168044a81fcfb0e9e859df8bdd593f\"],\n  \"reviewerType\": \"llm-vision-headless-cli\",\n  \"summary\": \"Identity legibility is genuinely solved across the signed-in surfaces: Home, the role picker, and the account list all render the actual display name \\\"Morgan\\\" (the latter two also render \\\"ID: board-member-20\\\"), so this flow does not have the 'role without a name' problem. The failures are elsewhere: the fresh entry gate renders an \\\"Existing Accounts\\\" heading over an empty gap with no empty-state copy, leaving loading-vs-empty ambiguous, and the role subtitle ships as a truncated fragment \\\"Board Member -\\\" with a dangling hyphen on both Home and the role picker. Home also shows two content cards whose only visible text is the literal token \\\"title\\\", and a \\\"2 roles\\\" pill whose tappability is not signalled. Three of four screens pass with minor issues; the entry gate fails on state legibility.\",\n  \"holisticQuestionAnswers\": [\n    {\n      \"questionId\": \"identity-legibility\",\n      \"question\": \"Across this flow, can the signed-in user always tell who they are (by name), not just which role they are using?\",\n      \"answer\": \"Yes, on every screen where an account exists. On Home (hoa-home-role-summary) the community card carries a bordered inset reading \\\"Signed in as Morgan\\\" above \\\"Board Member\\\", so name and acting role are shown together. In the role picker (hoa-persona-picker-dialog) identity is even stronger: a mint circular avatar with the letter \\\"M\\\", \\\"Signed in as Morgan\\\", and \\\"ID: board-member-20\\\" sit directly above the Board Member / Resident radio group. The account list (hoa-sign-in-specific-person) shows the same M avatar with \\\"Morgan\\\", \\\"ID: board-member-20\\\", and a checked \\\"Signed in\\\" chip. So there is no meaningful identity gap between screen 4 and screens 2-3 here -- screens 3 and 4 both expose name plus account ID, and screen 2 exposes name plus role but not the ID, which is acceptable for a home surface. The only screen without a name is the fresh entry gate, which is correct because no account exists yet. Points deducted only because Home stops at the name and never exposes the account ID, and because the role line under the name on both Home and the picker is the truncated fragment \\\"Board Member -\\\", which slightly muddies the 'what am I acting as' half of the question.\",\n      \"score\": 88,\n      \"blocksPass\": false,\n      \"visibleEvidence\": [\n        \"hoa-home-role-summary: bordered inset inside the teal community card reads \\\"Signed in as Morgan\\\" on the first line with \\\"Board Member\\\" bolded beneath it and a \\\"2 roles\\\" pill at the right.\",\n        \"hoa-persona-picker-dialog: mint circle containing \\\"M\\\", to its right \\\"Signed in as Morgan\\\" and grey secondary line \\\"ID: board-member-20\\\", placed above the selected Board Member radio.\",\n        \"hoa-sign-in-specific-person: row under group label \\\"Board Member (Board Member)\\\" shows avatar \\\"M\\\", name \\\"Morgan\\\", \\\"ID: board-member-20\\\", and a green check chip labelled \\\"Signed in\\\".\",\n        \"hoa-entry-gate: no name anywhere, only \\\"Welcome to Loom\\\" and \\\"Choose an account below or create a new one.\\\" -- correct for a pre-account state.\"\n      ],\n      \"affectedScreenRowIds\": [\"hoa-entry-gate\", \"hoa-home-role-summary\", \"hoa-persona-picker-dialog\", \"hoa-sign-in-specific-person\"]\n    }\n  ],\n  \"screenReviews\": [\n    {\n      \"screenRowId\": \"hoa-entry-gate\",\n      \"affectedScreenRowIds\": [\"hoa-entry-gate\"],\n      \"critique\": \"The header card (\\\"Welcome to Loom\\\" in dark green over \\\"Choose an account below or create a new one.\\\") and the bottom sticky bar (\\\"Choose an active account or create one to continue to AuthZ Repro HOA.\\\" plus a \\\"Check membership status\\\" outlined button) are clear and correctly community-scoped. The defect is the \\\"Existing Accounts\\\" section: the bold heading is followed by roughly 100px of blank white and then a hairline divider before \\\"Create New Account\\\". There is no \\\"No accounts yet\\\" line, no skeleton, and no spinner, so a user cannot tell whether the list is empty, still loading, or failed to load. The instruction \\\"Choose an account below\\\" actively contradicts the empty region, since there is nothing below to choose. The \\\"Check membership status\\\" button also gives no hint of what it will do or what state it would resolve.\",\n      \"verdict\": \"fail\",\n      \"severity\": \"major\",\n      \"targetProductionSurface\": \"The Existing Accounts section should render an explicit empty state (e.g. \\\"No accounts on this device yet -- create one below\\\") or a loading skeleton, and the header copy should not tell the user to choose an account when none exist.\",\n      \"visibleObservations\": [\n        \"Heading \\\"Existing Accounts\\\" with an empty gap beneath it and no list rows, no placeholder text, no spinner.\",\n        \"Header card: \\\"Welcome to Loom\\\" / \\\"Choose an account below or create a new one.\\\"\",\n        \"Create New Account form: empty \\\"Display name\\\" field, \\\"Persona type\\\" dropdown preset to \\\"Board Member\\\", filled dark-green \\\"Sign Up\\\" button.\",\n        \"Sticky bottom bar: \\\"Choose an active account or create one to continue to AuthZ Repro HOA.\\\" plus outlined \\\"Check membership status\\\" button with refresh icon.\"\n      ],\n      \"directQuestionAnswers\": [\n        {\n          \"question\": \"Is the current state (loading / empty / error / populated) unambiguous?\",\n          \"visibleEvidence\": \"\\\"Existing Accounts\\\" heading sits above pure white space terminated by a divider -- no row, no empty text, no spinner.\",\n          \"why\": \"An empty region is indistinguishable from an unresolved load, so the user cannot tell whether waiting would help.\"\n        },\n        {\n          \"question\": \"Is the copy accurate for the state actually shown?\",\n          \"visibleEvidence\": \"\\\"Choose an account below or create a new one.\\\" and \\\"Choose an active account or create one to continue to AuthZ Repro HOA.\\\"\",\n          \"why\": \"Both strings offer a choice that does not exist in this state; the community name is correct, but the primary instruction is wrong for a zero-account gate.\"\n        },\n        {\n          \"question\": \"Are the available actions clear?\",\n          \"visibleEvidence\": \"Outlined button \\\"Check membership status\\\" with no accompanying result or status text.\",\n          \"why\": \"Sign Up is unambiguous, but the membership-status action states neither the current membership state nor what checking will change.\"\n        }\n      ],\n      \"screenshotHash\": \"c7075e99bfc00f2bad5d423ebd21ea758b23ca11544d8c1f58f99ec9b6089013\"\n    },\n    {\n      \"screenRowId\": \"hoa-home-role-summary\",\n      \"affectedScreenRowIds\": [\"hoa-home-role-summary\", \"hoa-persona-picker-dialog\"],\n      \"critique\": \"Identity and context read well: the teal app bar shows \\\"AuthZ Repro HOA\\\" with bell / chat / people icons, and the community card repeats the name with the tagline \\\"Test-only community for live read-visibility verification.\\\" and an inset reading \\\"Signed in as Morgan\\\" / \\\"Board Member\\\" / \\\"2 roles\\\". Three problems are visible. First, the third line of that inset is the truncated fragment \\\"Board Member -\\\" -- a role label followed by a dangling hyphen and nothing after it, which reads as an unpopulated description field rather than product copy. Second, the two light cards below \\\"Home / Pinned and unassigned community surfaces.\\\" contain nothing but a tag chip whose label is the literal lowercase word \\\"title\\\", so the populated state is visually indistinguishable from broken data. Third, \\\"2 roles\\\" is styled as a flat pill with no chevron or button affordance, so it is unclear whether it is a static count or the entry point to role switching (which actually lives behind the people icon).\",\n      \"verdict\": \"pass\",\n      \"severity\": \"minor\",\n      \"targetProductionSurface\": \"A Home that names the signed-in person, states the acting role with a complete description, exposes role switching with an explicit affordance, and renders real card titles.\",\n      \"visibleObservations\": [\n        \"Teal app bar: back arrow, \\\"AuthZ Repro HOA\\\" wrapped to two lines, bell, chat bubble, and people icons.\",\n        \"Dark banner with megaphone icon: \\\"No sponsored message right now.\\\"\",\n        \"Community card inset: \\\"Signed in as Morgan\\\" / \\\"Board Member\\\" / \\\"Board Member -\\\" with a \\\"2 roles\\\" pill on the right.\",\n        \"Section card: house icon, \\\"Home\\\", \\\"Pinned and unassigned community surfaces.\\\"\",\n        \"Two near-white cards, each containing only a tag-icon chip labelled \\\"title\\\".\",\n        \"Bottom nav: filled \\\"Home\\\" pill (selected) and outlined \\\"Messages\\\" pill.\"\n      ],\n      \"directQuestionAnswers\": [\n        {\n          \"question\": \"Can the user tell who they are and what role they are acting as?\",\n          \"visibleEvidence\": \"\\\"Signed in as Morgan\\\" directly above bolded \\\"Board Member\\\" inside the community card inset.\",\n          \"why\": \"Both the account display name and the active role are on screen without opening any dialog; only the ID is absent, which is acceptable here.\"\n        },\n        {\n          \"question\": \"Is the populated state unambiguous?\",\n          \"visibleEvidence\": \"Two content cards whose only text is the chip label \\\"title\\\"; the sponsored slot explicitly says \\\"No sponsored message right now.\\\"\",\n          \"why\": \"The sponsored slot models empty state well, but the content cards give no way to tell a real item from a rendering failure.\"\n        },\n        {\n          \"question\": \"Are the available actions clear and is role switching discoverable?\",\n          \"visibleEvidence\": \"Flat \\\"2 roles\\\" pill with no chevron; role switching is actually behind the unlabelled people icon in the app bar.\",\n          \"why\": \"The count hints that more roles exist but does not indicate where to change them, so discovery depends on guessing the icon.\"\n        }\n      ],\n      \"screenshotHash\": \"49c30190047cc8ca9a5704b7fcfda9f52c2d271af4b24bbcc10ee777943fedf3\"\n    },\n    {\n      \"screenRowId\": \"hoa-persona-picker-dialog\",\n      \"affectedScreenRowIds\": [\"hoa-persona-picker-dialog\"],\n      \"critique\": \"This is the strongest screen of the four. The dialog titled \\\"Account role and permissions\\\" explains itself in real product voice -- \\\"Your memberships determine which community actions are available. Choose the role you want to use in this community.\\\" -- and the identity block (mint \\\"M\\\" avatar, \\\"Signed in as Morgan\\\", \\\"ID: board-member-20\\\") sits above the choices, so the user knows both who they are and what they are about to change. The selected \\\"Board Member\\\" radio is filled and tinted dark green while \\\"Resident\\\" is an unfilled outline, making current state unmistakable. Two flaws: each option's subtitle is a truncated fragment -- \\\"Board Member -\\\" and \\\"Resident -\\\", both ending in a bare hyphen where the permission description should be, which defeats the dialog's stated purpose of explaining what each role can do. Also, only \\\"Cancel\\\" is present; the dialog appears to apply selection immediately with no confirm action or explanatory note, so the consequence of tapping a radio is unstated.\",\n      \"verdict\": \"pass\",\n      \"severity\": \"minor\",\n      \"targetProductionSurface\": \"A role picker that names the account, shows each role with a real one-line permission summary, and makes clear whether selection applies immediately.\",\n      \"visibleObservations\": [\n        \"Title \\\"Account role and permissions\\\" over the body copy about memberships determining available actions.\",\n        \"Mint circular avatar \\\"M\\\", \\\"Signed in as Morgan\\\", grey line \\\"ID: board-member-20\\\".\",\n        \"Selected filled radio: \\\"Board Member\\\" in green with subtitle \\\"Board Member -\\\".\",\n        \"Unselected outline radio: \\\"Resident\\\" with subtitle \\\"Resident -\\\".\",\n        \"Divider, then \\\"Sign in as a specific person…\\\" with sub-line \\\"Use one of this community's individual accounts.\\\" and an enter-arrow icon.\",\n        \"Single green text action \\\"Cancel\\\" bottom-right; dimmed Home content visible behind the scrim.\"\n      ],\n      \"directQuestionAnswers\": [\n        {\n          \"question\": \"Can the user tell who they are, by name, on this screen?\",\n          \"visibleEvidence\": \"\\\"Signed in as Morgan\\\" with \\\"ID: board-member-20\\\" beneath it, next to an \\\"M\\\" avatar.\",\n          \"why\": \"Name plus account ID are both shown, so this screen exposes at least as much identity as the account list does.\"\n        },\n        {\n          \"question\": \"Does the copy describe actual data rather than placeholders?\",\n          \"visibleEvidence\": \"Role subtitles read \\\"Board Member -\\\" and \\\"Resident -\\\", each ending in a hyphen with nothing after it.\",\n          \"why\": \"The dialog promises to explain permissions but the per-role descriptions are empty, so the trailing hyphen exposes an unfilled template field.\"\n        },\n        {\n          \"question\": \"Are the available actions clear?\",\n          \"visibleEvidence\": \"Only \\\"Cancel\\\" is offered alongside the radios and \\\"Sign in as a specific person…\\\".\",\n          \"why\": \"The escape hatch and the drill-in are clear, but nothing states whether picking a radio commits immediately or requires a confirm.\"\n        }\n      ],\n      \"screenshotHash\": \"9641121450ef3b2d57424be50a43e00488cdc43096b402e4be726719926dcc13\"\n    },\n    {\n      \"screenRowId\": \"hoa-sign-in-specific-person\",\n      \"affectedScreenRowIds\": [\"hoa-sign-in-specific-person\", \"hoa-entry-gate\"],\n      \"critique\": \"Reached from the role picker, this screen correctly resolves the empty-list problem seen on the fresh gate: \\\"Existing Accounts\\\" now holds a real row -- mint \\\"M\\\" avatar, name \\\"Morgan\\\", \\\"ID: board-member-20\\\" (wrapped awkwardly as \\\"ID: board-\\\" / \\\"member-20\\\"), and a chip with a green filled check reading \\\"Signed in\\\", which unambiguously marks the active account. Problems: the group label above it reads \\\"Board Member (Board Member)\\\", duplicating the same string in and out of parentheses, which looks like a role-name/persona-type template collision rather than product copy. The screen also reuses the generic sign-in gate verbatim -- \\\"Welcome to Loom\\\" / \\\"Choose an account below or create a new one.\\\" -- with no title, back affordance, or breadcrumb tying it to \\\"Sign in as a specific person\\\" or to AuthZ Repro HOA, so after arriving from a modal the user has no visible route back and no confirmation of which community's accounts these are. The app bar region at the top renders blank white, reinforcing that impression. The \\\"Create New Account\\\" form defaults \\\"Persona type\\\" to \\\"Board Member\\\" with an empty \\\"Display name\\\", so tapping \\\"Sign Up\\\" without typing has an undefined outcome.\",\n      \"verdict\": \"pass\",\n      \"severity\": \"minor\",\n      \"targetProductionSurface\": \"A community-scoped account list with a title such as \\\"Sign in as a specific person -- AuthZ Repro HOA\\\", a back affordance, and de-duplicated role group headers.\",\n      \"visibleObservations\": [\n        \"Header card \\\"Welcome to Loom\\\" / \\\"Choose an account below or create a new one.\\\" identical to the entry gate.\",\n        \"Group label in green: \\\"Board Member (Board Member)\\\".\",\n        \"Account row: \\\"M\\\" avatar, \\\"Morgan\\\", \\\"ID: board-member-20\\\" wrapped across two lines, and a chip \\\"Signed in\\\" with a green filled checkmark.\",\n        \"\\\"Create New Account\\\" section: empty \\\"Display name\\\" field, \\\"Persona type\\\" = \\\"Board Member\\\", filled \\\"Sign Up\\\" button.\",\n        \"No app bar, no title, and no back arrow at the top of the screen -- the top region is blank white.\"\n      ],\n      \"directQuestionAnswers\": [\n        {\n          \"question\": \"Is the signed-in account identifiable and distinguishable from other accounts?\",\n          \"visibleEvidence\": \"Row reads \\\"Morgan\\\" / \\\"ID: board-member-20\\\" with a green-check \\\"Signed in\\\" chip on the right.\",\n          \"why\": \"Name, stable ID, and active-session marker are all present, so the active account is unmistakable.\"\n        },\n        {\n          \"question\": \"Does the displayed text read like real product copy?\",\n          \"visibleEvidence\": \"Group header \\\"Board Member (Board Member)\\\" repeats the identical string inside the parentheses.\",\n          \"why\": \"A role label and a persona-type label that happen to be equal are concatenated without de-duplication, which reads as a template artefact.\"\n        },\n        {\n          \"question\": \"Does the screen make its own context clear given it was reached from a modal?\",\n          \"visibleEvidence\": \"Top of screen is blank white with no title or back arrow; the only header is the generic \\\"Welcome to Loom\\\" card.\",\n          \"why\": \"Nothing on screen names \\\"Sign in as a specific person\\\" or AuthZ Repro HOA, so the user loses the thread of where they are and how to return.\"\n        }\n      ],\n      \"screenshotHash\": \"6b8cb0131b1e3cbd242b7aa7718c876939168044a81fcfb0e9e859df8bdd593f\"\n    }\n  ],\n  \"findings\": [\n    {\n      \"findingId\": \"empty-existing-accounts-no-state\",\n      \"title\": \"\\\"Existing Accounts\\\" renders a blank gap with no empty or loading state\",\n      \"description\": \"On the fresh entry gate the bold \\\"Existing Accounts\\\" heading is followed by empty white space and then a divider -- no rows, no \\\"none yet\\\" copy, no skeleton, no spinner. Loading, empty, and failed-to-load are indistinguishable. The surrounding copy makes it worse: the header card says \\\"Choose an account below or create a new one.\\\" and the sticky bar says \\\"Choose an active account or create one to continue to AuthZ Repro HOA.\\\", both directing the user to choose from a list that has nothing in it. The same layout with a populated row is visible on hoa-sign-in-specific-person, confirming the section is simply unrendered rather than intentionally hidden.\",\n      \"severity\": \"major\",\n      \"status\": \"open\",\n      \"resolved\": false,\n      \"affectedScreenRowIds\": [\"hoa-entry-gate\"],\n      \"requiredFix\": \"Render an explicit zero-state (e.g. \\\"No accounts on this device yet\\\") or a loading skeleton in the Existing Accounts section, and suppress or reword the \\\"choose an account below\\\" instruction when the list is empty.\"\n    },\n    {\n      \"findingId\": \"truncated-role-description-dangling-hyphen\",\n      \"title\": \"Role descriptions render as \\\"Board Member -\\\" / \\\"Resident -\\\" with a dangling hyphen\",\n      \"description\": \"Both the Home community card and the role-picker dialog show role subtitles that end in a bare hyphen with no text after it: \\\"Board Member -\\\" appears under the signed-in role on Home and under the selected radio in the dialog, and \\\"Resident -\\\" appears under the unselected radio. The dialog explicitly promises \\\"Your memberships determine which community actions are available\\\", but the per-role permission text that would deliver on that promise is missing, leaving a visibly unfilled \\\"<role> - <description>\\\" template.\",\n      \"severity\": \"major\",\n      \"status\": \"open\",\n      \"resolved\": false,\n      \"affectedScreenRowIds\": [\"hoa-home-role-summary\", \"hoa-persona-picker-dialog\"],\n      \"requiredFix\": \"Populate each role with a real one-line permission summary, and when no description exists, drop the separator entirely instead of emitting a trailing hyphen.\"\n    },\n    {\n      \"findingId\": \"duplicated-role-group-header\",\n      \"title\": \"Account group header reads \\\"Board Member (Board Member)\\\"\",\n      \"description\": \"On the account list, the green group label above Morgan's row reads \\\"Board Member (Board Member)\\\" -- the same string rendered twice, once bare and once parenthesised. This is a role-label / persona-type concatenation that was not de-duplicated when the two values are equal, and it reads as a template artefact rather than product copy.\",\n      \"severity\": \"minor\",\n      \"status\": \"open\",\n      \"resolved\": false,\n      \"affectedScreenRowIds\": [\"hoa-sign-in-specific-person\"],\n      \"requiredFix\": \"Suppress the parenthetical persona type when it is identical to the role label, so the header reads simply \\\"Board Member\\\".\"\n    },\n    {\n      \"findingId\": \"account-list-missing-context-header\",\n      \"title\": \"\\\"Sign in as a specific person\\\" list has no title, back affordance, or community scoping\",\n      \"description\": \"The account list reached from the role-picker dialog reuses the generic entry gate verbatim -- \\\"Welcome to Loom\\\" / \\\"Choose an account below or create a new one.\\\" -- with a blank white region where an app bar would be. Nothing on screen repeats the originating action name \\\"Sign in as a specific person…\\\", names AuthZ Repro HOA, or offers a visible way back, even though the dialog described these as \\\"one of this community's individual accounts\\\".\",\n      \"severity\": \"minor\",\n      \"status\": \"open\",\n      \"resolved\": false,\n      \"affectedScreenRowIds\": [\"hoa-sign-in-specific-person\"],\n      \"requiredFix\": \"Give the screen a titled app bar naming the action and the community, plus a back affordance returning to the role picker.\"\n    },\n    {\n      \"findingId\": \"roles-pill-affordance-unclear\",\n      \"title\": \"\\\"2 roles\\\" pill on Home gives no affordance for switching roles\",\n      \"description\": \"The Home community card shows a flat \\\"2 roles\\\" pill beside \\\"Board Member\\\" with no chevron, underline, or button styling. Role switching actually lives behind the unlabelled people icon in the teal app bar. A user who reads \\\"2 roles\\\" has no visible path to the second role, and no indication of whether the pill itself is tappable.\",\n      \"severity\": \"minor\",\n      \"status\": \"open\",\n      \"resolved\": false,\n      \"affectedScreenRowIds\": [\"hoa-home-role-summary\"],\n      \"requiredFix\": \"Make the roles pill an explicit control (chevron or \\\"Switch role\\\" label) that opens the Account role and permissions dialog, or label the app-bar people icon.\"\n    },\n    {\n      \"findingId\": \"home-cards-title-placeholder\",\n      \"title\": \"Home content cards display only the literal token \\\"title\\\"\",\n      \"description\": \"Below \\\"Home / Pinned and unassigned community surfaces.\\\" two light cards each contain a single tag chip whose label is the lowercase word \\\"title\\\" and no other content. This is placeholder domain data for a throwaway test community rather than an identity defect, but as rendered it makes a populated list indistinguishable from a rendering failure, since there is no fallback copy for an item with no usable title.\",\n      \"severity\": \"minor\",\n      \"status\": \"open\",\n      \"resolved\": false,\n      \"affectedScreenRowIds\": [\"hoa-home-role-summary\"],\n      \"requiredFix\": \"Render a real item title, and provide a visible fallback (e.g. \\\"Untitled surface\\\") plus supporting metadata so an item without a title cannot be mistaken for broken rendering.\"\n    },\n    {\n      \"findingId\": \"role-picker-no-confirm-semantics\",\n      \"title\": \"Role picker offers only \\\"Cancel\\\" with no stated commit behaviour\",\n      \"description\": \"The \\\"Account role and permissions\\\" dialog presents Board Member / Resident radios and a single green \\\"Cancel\\\" text action. There is no Confirm/Apply button and no line stating that selecting a radio switches the active role immediately, so the user cannot tell whether tapping \\\"Resident\\\" is a preview or an immediate permission change.\",\n      \"severity\": \"minor\",\n      \"status\": \"open\",\n      \"resolved\": false,\n      \"affectedScreenRowIds\": [\"hoa-persona-picker-dialog\"],\n      \"requiredFix\": \"Either add an explicit confirm action or add a line stating that the selected role applies immediately.\"\n    }\n  ]\n}\n```","ttft_ms":18203,"ttft_stream_ms":17378,"time_to_request_ms":15998,"type":"result","duration_ms":149728,"uuid":"985b2913-c24f-4514-ada1-b9fb2e0816bb"}
