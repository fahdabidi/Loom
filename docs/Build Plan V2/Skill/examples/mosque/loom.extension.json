{
  "specVersion": 4,
  "mode": "local-demo",
  "extensionId": "ext_mosque",
  "displayName": "Mosque Community",
  "version": "1.0.0",
  "communityType": "mosque",
  "permissions": [
    "content.publish",
    "events.write",
    "forms.submit",
    "payments.record",
    "protected.write",
    "protected.read",
    "notifications.send",
    "search.index"
  ],
  "assets": [
    {
      "assetId": "asset_card_mosque",
      "kind": "cardImage",
      "path": "assets/card.png"
    },
    {
      "assetId": "asset_logo_mosque",
      "kind": "logo",
      "path": "assets/logo.png"
    }
  ],
  "export": {
    "customSchemas": ["iftar_volunteer", "care_request"],
    "redactionPolicy": "protected-care-fields-redacted",
    "includedComponents": [
      "publishing-service",
      "events-service",
      "forms-voting-service",
      "wallet-dues-donations"
    ]
  }
}
