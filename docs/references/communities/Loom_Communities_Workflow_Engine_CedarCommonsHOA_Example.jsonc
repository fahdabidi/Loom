{
  "schemaVersion": 1,
  "packageId": "init_cedar_commons_hoa_2",
  "communityId": "community_cedar_commons_hoa",
  "communityHandle": "cedar-commons-hoa",
  "displayName": "Cedar Commons HOA",
  "extensionId": "ext_cedar_commons_hoa",
  "branding": {
    "accentColor": "#285A7B"
  },
  "seedDataFiles": [],
  "idempotencyKey": "cedar-commons-hoa-experience-v2-2026-08-11",

  "experience": {
    "experienceSchemaVersion": 2,
    "workflowGrammarVersion": 1,
    "displayName": "Cedar Commons HOA",
    "tagline": "Pay dues, reserve shared facilities, follow requests, and keep HOA records portable.",
    "accentColor": "#285A7B",
    "theme": {
      "accent": "#285A7B",
      "tabThemes": {
        "calendar": { "accent": "#356C85" },
        "giving": { "accent": "#2E6B4D" },
        "documents": { "accent": "#3D6478" },
        "requests": { "accent": "#4A6380" },
        "admin": { "accent": "#46566B" }
      }
    },
    "creatableAction": {
      "multiActionStyle": "speedDial",
      "presentationStyle": "slideOutBottom"
    },

    "personas": [
      {
        "personaId": "hoa-member",
        "label": "Homeowner",
        "roleLabel": "Homeowner",
        "description": "Pays dues, reads governing documents, reserves facilities, and submits property requests."
      },
      {
        "personaId": "hoa-board",
        "label": "Board",
        "roleLabel": "Board reviewer",
        "description": "Reviews property requests, records payment outcomes, publishes documents and notices, and manages exports."
      }
    ],

    "workflowDefinitions": {
      "hoa-dues-payment": {
        "initialState": "due",
        "visibility": {
          "default": "guarded",
          "readGuard": { "formula": "$viewer == payerPersonaId || $viewer == 'hoa-board'" }
        },
        "states": {
          "due": {
            "label": "Dues due",
            "tone": "warning",
            "editableFields": [
              "title",
              "amount",
              "dueDate",
              "dueTime",
              "payerPersonaId",
              "audiencePersonaIds",
              "recipientLabel",
              "entitlementLabel",
              "visibilityLabel",
              "paymentMethodLabel"
            ],
            "editGuard": { "allowedPersonaIds": ["hoa-board"] }
          },
          "processing": { "label": "Checkout started", "tone": "info" },
          "paid": { "label": "Paid", "tone": "positive" },
          "failed": { "label": "Payment failed", "tone": "negative" },
          "refund-requested": { "label": "Refund requested", "tone": "warning" },
          "refunded": { "label": "Refunded", "tone": "positive", "isTerminal": true }
        },
        "transitions": [
          // NEEDS IMPLEMENTATION (platform service): Payment processing is not implemented.
          // This transition records checkout intent only; it never fabricates gateway success.
          {
            "id": "start-checkout",
            "label": "Pay dues",
            "icon": "payments_outlined",
            "tone": "primary",
            "from": ["due"],
            "to": "processing",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "payerPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "Awaiting payment service" },
              {
                "op": "append",
                "key": "history",
                "value": { "event": "Checkout started", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "record-offline-payment",
            "label": "Record offline payment",
            "icon": "task_alt",
            "tone": "primary",
            "from": ["due", "processing", "failed"],
            "to": "paid",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "confirmationNote": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "Offline payment recorded" },
              { "op": "set", "key": "paidAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Offline payment recorded",
                  "note": "{input.confirmationNote}",
                  "actorPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "record-payment-failure",
            "label": "Record failure",
            "icon": "error_outline",
            "tone": "destructive",
            "from": ["processing"],
            "to": "failed",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "failureReason": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "Payment failed" },
              { "op": "set", "key": "failureReason", "value": "{input.failureReason}" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Payment failed",
                  "note": "{input.failureReason}",
                  "actorPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "retry-payment",
            "label": "Retry payment",
            "icon": "refresh",
            "tone": "primary",
            "from": ["failed"],
            "to": "processing",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "payerPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "retryRequestedAt", "value": "$timestamp" },
              { "op": "set", "key": "receiptStatus", "value": "Retry requested" },
              {
                "op": "append",
                "key": "history",
                "value": { "event": "Retry requested", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "cancel-checkout",
            "label": "Cancel checkout",
            "icon": "close",
            "tone": "secondary",
            "from": ["processing"],
            "to": "due",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "payerPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "Due" },
              {
                "op": "append",
                "key": "history",
                "value": { "event": "Checkout cancelled", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "change-payment-amount",
            "label": "Change amount",
            "icon": "edit",
            "tone": "secondary",
            "from": ["due", "failed"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "payerPersonaId" }
            },
            "inputs": {
              "amount": { "type": "number", "required": true }
            },
            "effects": [
              { "op": "set", "key": "amount", "value": "{input.amount}" },
              {
                "op": "append",
                "key": "history",
                "value": { "event": "Payment amount changed", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "edit-payment-method",
            "label": "Edit payment method",
            "icon": "edit",
            "tone": "secondary",
            "from": ["due", "failed"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "payerPersonaId" }
            },
            "inputs": {
              "paymentMethodLabel": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "paymentMethodLabel", "value": "{input.paymentMethodLabel}" },
              {
                "op": "append",
                "key": "history",
                "value": { "event": "Payment method updated", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "enable-autopay",
            "label": "Subscribe to quarterly autopay",
            "icon": "autorenew",
            "tone": "secondary",
            "from": ["due", "paid"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "payerPersonaId" },
              "instanceDataEquals": { "key": "autopayEnabled", "value": false }
            },
            "effects": [
              { "op": "set", "key": "autopayEnabled", "value": true },
              {
                "op": "append",
                "key": "history",
                "value": { "event": "Quarterly autopay enabled", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "disable-autopay",
            "label": "Cancel quarterly autopay",
            "icon": "cancel",
            "tone": "secondary",
            "from": ["due", "paid", "failed"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "payerPersonaId" },
              "instanceDataEquals": { "key": "autopayEnabled", "value": true }
            },
            "effects": [
              { "op": "set", "key": "autopayEnabled", "value": false },
              {
                "op": "append",
                "key": "history",
                "value": { "event": "Quarterly autopay cancelled", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "request-refund",
            "label": "Request refund",
            "icon": "assignment_return",
            "tone": "secondary",
            "from": ["paid"],
            "to": "refund-requested",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "payerPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "Refund requested" },
              {
                "op": "append",
                "key": "history",
                "value": { "event": "Refund requested", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "record-offline-refund",
            "label": "Record offline refund",
            "icon": "undo",
            "tone": "primary",
            "from": ["refund-requested"],
            "to": "refunded",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "refundNote": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "Offline refund recorded" },
              { "op": "set", "key": "refundedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Offline refund recorded",
                  "note": "{input.refundNote}",
                  "actorPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "decline-refund",
            "label": "Decline refund",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["refund-requested"],
            "to": "paid",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "declineReason": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "Refund declined" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Refund declined",
                  "note": "{input.declineReason}",
                  "actorPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["due", "processing", "failed"],
            "role": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["refund-requested"],
            "role": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["paid"],
            "role": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["refunded"],
            "role": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["due", "processing", "failed", "paid", "refund-requested", "refunded"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["due"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["due", "processing", "failed", "refund-requested"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New dues charge",
                "byPersonaIds": ["hoa-board"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "autopayEnabled": false,
                  "receiptStatus": "Due",
                  "history": []
                }
              }
            ]
          },
          {
            "states": ["paid", "refunded"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "amount": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "payments_outlined",
            "labelTemplate": "$ {value}",
            "displayContexts": ["tile", "detail"]
          },
          "dueDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "event",
            "labelTemplate": "Due {value}",
            "displayContexts": ["tile", "detail"]
          },
          "dueTime": {
            "type": "time",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "Deadline time {value}",
            "displayContexts": ["detail"]
          },
          "eventDate": {
            "type": "date",
            "formula": "dueDate",
            "displayContexts": []
          },
          "eventTime": {
            "type": "time",
            "formula": "dueTime",
            "displayContexts": []
          },
          "payerPersonaId": {
            "type": "personaId",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "person_outline",
            "labelTemplate": "Payer: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "audiencePersonaIds": {
            "type": "personaId[]",
            "required": true,
            "writableBy": "formEntry"
          },
          "recipientLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "account_balance",
            "labelTemplate": "Recipient: {value}",
            "displayContexts": ["detail"]
          },
          "entitlementLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "verified_user",
            "labelTemplate": "Entitlement: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "visibilityLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "visibility",
            "labelTemplate": "Visibility: {value}",
            "displayContexts": ["detail"]
          },
          "paymentMethodLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "credit_card",
            "labelTemplate": "Method: {value}",
            "displayContexts": ["detail"]
          },
          "autopayEnabled": {
            "type": "bool",
            "writableBy": "effect",
            "displayIcon": "autorenew",
            "labelTemplate": "Quarterly autopay: {value}",
            "displayContexts": ["detail"]
          },
          "receiptStatus": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "receipt_long",
            "labelTemplate": "Receipt: {value}",
            "displayContexts": ["tile", "detail"]
          },
          // NEEDS IMPLEMENTATION (platform service): payment receipt-ID generation is not implemented.
          // Declared for the receipt surface and never seeded or written by any effect.
          "receiptId": {
            "type": "text",
            "displayIcon": "confirmation_number",
            "labelTemplate": "Receipt ID: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "paidAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "schedule",
            "labelTemplate": "Paid {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "retryRequestedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true },
          "refundedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true },
          "failureReason": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "report_problem",
            "labelTemplate": "Failure: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "history": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "History entries: {value.length}",
            "displayContexts": ["detail"]
          }
        }
      },

      "hoa-member-document": {
        "initialState": "published",
        "visibility": { "default": "membersOnly" },
        "states": {
          "published": {
            "label": "Available",
            "tone": "positive",
            "editableFields": [
              "title",
              "version",
              "versionHistory",
              "publishedDate",
              "documentOwner",
              "provider",
              "sourceLabel",
              "documentUrl",
              "downloadUrl",
              "accessLabel",
              "auditLabel"
            ],
            "editGuard": { "allowedPersonaIds": ["hoa-board"] }
          },
          "archived": { "label": "Archived", "tone": "info" }
        },
        "transitions": [
          {
            "id": "record-open",
            "label": "Mark as read",
            "icon": "menu_book",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "openedPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "openedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "acknowledge-document",
            "label": "Acknowledge",
            "icon": "verified",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "acknowledgedPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "openedPersonaIds", "value": "$actor" },
              { "op": "appendUnique", "key": "acknowledgedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "mark-document-unread",
            "label": "Mark unread",
            "icon": "mark_email_unread",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "openedPersonaIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "openedPersonaIds", "value": "$actor" },
              { "op": "removeValue", "key": "acknowledgedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "request-document-access",
            "label": "Request access",
            "icon": "lock_open",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "accessRequestedPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "accessRequestedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "save-document",
            "label": "Save document",
            "icon": "bookmark_add",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "savedPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "savedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "remove-saved-document",
            "label": "Remove saved",
            "icon": "bookmark_remove",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "savedPersonaIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "savedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "confirm-document-download",
            "label": "Confirm downloaded",
            "icon": "download_done",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "downloadedPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "downloadedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "archive-document",
            "label": "Archive document",
            "icon": "archive",
            "tone": "destructive",
            "from": ["published"],
            "to": "archived",
            "guard": { "allowedPersonaIds": ["hoa-board"] }
          },
          {
            "id": "restore-document",
            "label": "Restore document",
            "icon": "unarchive",
            "tone": "primary",
            "from": ["archived"],
            "to": "published",
            "guard": { "allowedPersonaIds": ["hoa-board"] }
          }
        ],
        "renderBindings": [
          // NEEDS IMPLEMENTATION (pending archetype): documentLibrary is locked vocabulary but is not
          // yet in the Dart registry; unknown_card_surface_family is expected until that registry lands.
          {
            "states": ["published"],
            "role": "any",
            "tabId": "documents",
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Add HOA document",
                "byPersonaIds": ["hoa-board"],
                "scope": "tab",
                "presentation": "fab"
              }
            ]
          },
          {
            "states": ["published"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "summary"
          },
          {
            "states": ["archived"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "primary"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "displayIcon": "description",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "version": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "history_edu",
            "labelTemplate": "Version {value}",
            "displayContexts": ["tile", "detail"]
          },
          "versionHistory": {
            "type": "list",
            "writableBy": "formEntry",
            "displayIcon": "history",
            "labelTemplate": "Versions: {value.length}",
            "displayContexts": ["detail"]
          },
          "publishedDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "event_note",
            "labelTemplate": "Published {value}",
            "displayContexts": ["tile", "detail"]
          },
          "documentOwner": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "badge",
            "labelTemplate": "Owner: {value}",
            "displayContexts": ["detail"]
          },
          "provider": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "cloud_outlined",
            "labelTemplate": "Provider: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "sourceLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "source",
            "labelTemplate": "Source: {value}",
            "displayContexts": ["detail"]
          },
          // NEEDS IMPLEMENTATION: type:url/openMode is the correct declared shape, but its shared
          // external/embedded renderer is still proposed in field-types.md.
          "documentUrl": {
            "type": "url",
            "required": true,
            "writableBy": "formEntry",
            "openMode": "choice",
            "displayIcon": "open_in_browser",
            "labelTemplate": "Open {value}",
            "displayContexts": ["detail"]
          },
          "downloadUrl": {
            "type": "url",
            "required": true,
            "writableBy": "formEntry",
            "openMode": "external",
            "displayIcon": "download",
            "labelTemplate": "Download {value}",
            "displayContexts": ["detail"]
          },
          "accessLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "policy",
            "labelTemplate": "Access: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "auditLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "fact_check",
            "labelTemplate": "Audit: {value}",
            "displayContexts": ["detail"]
          },
          "openedPersonaIds": { "type": "personaId[]", "writableBy": "effect" },
          "acknowledgedPersonaIds": { "type": "personaId[]", "writableBy": "effect" },
          "accessRequestedPersonaIds": { "type": "personaId[]", "writableBy": "effect" },
          "savedPersonaIds": { "type": "personaId[]", "writableBy": "effect" },
          "downloadedPersonaIds": { "type": "personaId[]", "writableBy": "effect" },
          "memberAccessState": {
            "type": "text",
            "formula": "if(contains(acknowledgedPersonaIds, $viewer), 'acknowledged', if(contains(accessRequestedPersonaIds, $viewer), 'access-requested', if(contains(openedPersonaIds, $viewer), 'read', 'available')))",
            "displayIcon": "visibility",
            "labelTemplate": "Your state: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "downloadState": {
            "type": "text",
            "formula": "if(contains(downloadedPersonaIds, $viewer), 'downloaded', 'not-downloaded')",
            "displayIcon": "download_done",
            "labelTemplate": "Download state: {value}",
            "displayContexts": ["detail"]
          }
          // NEEDS IMPLEMENTATION: document sharing is not an effect or type:url open mode in grammar v1;
          // it is intentionally not represented by a fake "shared" state.
        }
      },

      "hoa-facility-reservation": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "Reservation open",
            "tone": "info",
            "editableFields": [
              "title",
              "facility",
              "eventDate",
              "eventTime",
              "reservationWindow",
              "locationDetails"
            ],
            "editGuard": { "actorEqualsField": { "key": "requesterPersonaId" } }
          },
          "reserved": { "label": "Reserved", "tone": "positive" },
          "conflict": {
            "label": "Conflict",
            "tone": "negative",
            "editableFields": [
              "title",
              "facility",
              "eventDate",
              "eventTime",
              "reservationWindow",
              "locationDetails"
            ],
            "editGuard": { "actorEqualsField": { "key": "requesterPersonaId" } }
          },
          "cancelled": { "label": "Cancelled", "tone": "info" }
        },
        "transitions": [
          {
            "id": "reserve-facility",
            "label": "Reserve facility",
            "icon": "event_available",
            "tone": "primary",
            "from": ["open"],
            "to": "reserved",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" },
              "locationOverlap": {
                "locationField": "facility",
                "dateField": "eventDate",
                "timeField": "eventTime",
                "durationMinutes": 120
              }
            },
            "effects": [
              { "op": "set", "key": "reservedByPersonaId", "value": "$actor" },
              { "op": "set", "key": "reservedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "board-reserve-facility",
            "label": "Reserve for homeowner",
            "icon": "event_available",
            "tone": "primary",
            "from": ["open"],
            "to": "reserved",
            "guard": {
              "allowedPersonaIds": ["hoa-board"],
              "locationOverlap": {
                "locationField": "facility",
                "dateField": "eventDate",
                "timeField": "eventTime",
                "durationMinutes": 120
              }
            },
            "effects": [
              { "op": "set", "key": "reservedByPersonaId", "value": "{requesterPersonaId}" },
              { "op": "set", "key": "reservedAt", "value": "$timestamp" }
            ]
          },
          // NEEDS IMPLEMENTATION: locationOverlap correctly blocks double-booking, but a failed guard
          // cannot automatically move the instance to the visible conflict state. Board flagging below
          // is an explicit audit action, not a claim of automatic state mutation.
          {
            "id": "flag-reservation-conflict",
            "label": "Flag conflict",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["open"],
            "to": "conflict",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "conflictNote": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "conflictNote", "value": "{input.conflictNote}" }
            ]
          },
          {
            "id": "revise-conflicted-reservation",
            "label": "Revise reservation",
            "icon": "edit_calendar",
            "tone": "primary",
            "from": ["conflict"],
            "to": "open",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "conflictNote", "value": null }
            ]
          },
          {
            "id": "board-revise-conflicted-reservation",
            "label": "Return to open",
            "icon": "edit_calendar",
            "tone": "secondary",
            "from": ["conflict"],
            "to": "open",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "conflictNote", "value": null }
            ]
          },
          {
            "id": "change-reservation",
            "label": "Change reservation",
            "icon": "event_repeat",
            "tone": "secondary",
            "from": ["reserved"],
            "to": "open",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "reservedByPersonaId", "value": null },
              { "op": "set", "key": "reservedAt", "value": null }
            ]
          },
          {
            "id": "board-change-reservation",
            "label": "Return for changes",
            "icon": "event_repeat",
            "tone": "secondary",
            "from": ["reserved"],
            "to": "open",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "reservedByPersonaId", "value": null },
              { "op": "set", "key": "reservedAt", "value": null }
            ]
          },
          {
            "id": "cancel-reservation",
            "label": "Cancel reservation",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["open", "reserved", "conflict"],
            "to": "cancelled",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "cancelledAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "board-cancel-reservation",
            "label": "Board cancel",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["open", "reserved", "conflict"],
            "to": "cancelled",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "cancelledAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "reopen-reservation",
            "label": "Reopen request",
            "icon": "restore",
            "tone": "secondary",
            "from": ["cancelled"],
            "to": "open",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "cancelledAt", "value": null }
            ]
          },
          {
            "id": "board-reopen-reservation",
            "label": "Board reopen",
            "icon": "restore",
            "tone": "secondary",
            "from": ["cancelled"],
            "to": "open",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "cancelledAt", "value": null }
            ]
          },
          {
            "id": "enable-reservation-reminder",
            "label": "Add reminder",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": ["reserved"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" },
              "instanceDataEquals": { "key": "reminderEnabled", "value": false }
            },
            "effects": [
              { "op": "set", "key": "reminderEnabled", "value": true }
            ]
          },
          {
            "id": "disable-reservation-reminder",
            "label": "Remove reminder",
            "icon": "notifications_off",
            "tone": "secondary",
            "from": ["reserved"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" },
              "instanceDataEquals": { "key": "reminderEnabled", "value": true }
            },
            "effects": [
              { "op": "set", "key": "reminderEnabled", "value": false }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["open", "reserved", "conflict"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Reserve a facility",
                "byPersonaIds": ["hoa-member", "hoa-board"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "requesterPersonaId": "$actor",
                  "audiencePersonaIds": ["$actor"],
                  "durationMinutes": 120,
                  "reminderEnabled": false
                }
              }
            ]
          },
          {
            "states": ["cancelled"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "primary"
          },
          {
            "states": ["reserved", "conflict"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "facility": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "displayIcon": "meeting_room",
            "labelTemplate": "Facility: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "calendar_today",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventTime": {
            "type": "time",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "durationMinutes": {
            "type": "number",
            "required": true,
            "displayIcon": "timer",
            "labelTemplate": "{value} minutes",
            "displayContexts": ["detail"]
          },
          "reservationWindow": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "date_range",
            "labelTemplate": "Window: {value}",
            "displayContexts": ["detail"]
          },
          "locationDetails": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "location_on_outlined",
            "labelTemplate": "Location: {value}",
            "displayContexts": ["detail"]
          },
          "requesterPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "person_outline",
            "labelTemplate": "Requested by {value}",
            "displayContexts": ["tile", "detail"]
          },
          "audiencePersonaIds": { "type": "personaId[]", "required": true },
          "reservedByPersonaId": {
            "type": "personaId?",
            "writableBy": "effect",
            "displayIcon": "how_to_reg",
            "labelTemplate": "Reserved for {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "reservedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true },
          "cancelledAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true },
          "conflictNote": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "event_busy",
            "labelTemplate": "Conflict: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "reminderEnabled": {
            "type": "bool",
            "writableBy": "effect",
            "displayIcon": "notifications",
            "labelTemplate": "Reminder enabled: {value}",
            "displayContexts": ["detail"]
          },
          "dueAt": {
            "type": "date?",
            "formula": "if(reminderEnabled, subtractHours(combineDateAndTime(eventDate, eventTime), 24), null)",
            "displayIcon": "alarm",
            "labelTemplate": "Reminder due {value}",
            "displayContexts": ["detail"]
          },
          "reminderState": {
            "type": "text",
            "formula": "if(reminderEnabled, 'on', 'off')",
            "displayIcon": "notifications_active",
            "labelTemplate": "Reminder: {value}",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "hoa-architectural-request": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "formula": "$viewer == requesterPersonaId || $viewer == 'hoa-board'" }
        },
        "states": {
          "draft": {
            "label": "Draft",
            "tone": "info",
            "editableFields": [
              "title",
              "propertyLot",
              "changeDetails",
              "attachmentUrl",
              "documentCheckpoint",
              "paymentCheckpoint",
              "ownerResponse"
            ],
            "editGuard": { "actorEqualsField": { "key": "requesterPersonaId" } }
          },
          "submitted": { "label": "Submitted", "tone": "info" },
          "under-review": { "label": "Under review", "tone": "warning" },
          "changes-needed": {
            "label": "Changes needed",
            "tone": "warning",
            "editableFields": [
              "changeDetails",
              "attachmentUrl",
              "documentCheckpoint",
              "paymentCheckpoint",
              "ownerResponse"
            ],
            "editGuard": { "actorEqualsField": { "key": "requesterPersonaId" } }
          },
          "approved": { "label": "Approved", "tone": "positive" },
          "denied": { "label": "Denied", "tone": "negative" },
          "reopened": { "label": "Reopened", "tone": "warning" },
          "withdrawn": { "label": "Withdrawn", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "submit-request",
            "label": "Submit request",
            "icon": "send",
            "tone": "primary",
            "from": ["draft"],
            "to": "submitted",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "requestInstanceId", "value": "{id}" },
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              { "op": "set", "key": "currentStep", "value": "Submitted to the architectural committee" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "submitted", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "createInstance",
                "workflowType": "hoa-committee-decision",
                "fields": {
                  "requestInstanceId": "{id}",
                  "requestTitle": "{title}",
                  "propertyLot": "{propertyLot}",
                  "changeDetails": "{changeDetails}",
                  "attachmentUrl": "{attachmentUrl}",
                  "requesterPersonaId": "{requesterPersonaId}",
                  "audiencePersonaIds": "{audiencePersonaIds}",
                  "submittedAt": "$timestamp",
                  "currentStep": "Awaiting committee review",
                  "documentCheckpoint": "{documentCheckpoint}",
                  "paymentCheckpoint": "{paymentCheckpoint}",
                  "comments": [],
                  "statusHistory": [
                    { "status": "submitted", "actorPersonaId": "$actor", "at": "$timestamp" }
                  ],
                  "ownerNotificationState": "Not sent"
                }
              }
            ]
          },
          {
            "id": "withdraw-draft",
            "label": "Discard draft",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["draft"],
            "to": "withdrawn",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            }
          },
          {
            "id": "begin-review",
            "label": "Begin review",
            "icon": "rate_review",
            "tone": "primary",
            "from": ["submitted", "reopened"],
            "to": "under-review",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "currentStep", "value": "Committee review in progress" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "under-review", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "request-changes-case",
            "label": "Request changes",
            "icon": "edit_note",
            "tone": "secondary",
            "from": ["under-review"],
            "to": "changes-needed",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "currentStep", "value": "Owner changes requested" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "changes-needed", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "approve-case",
            "label": "Approve request",
            "icon": "check_circle",
            "tone": "primary",
            "from": ["under-review"],
            "to": "approved",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "currentStep", "value": "Approved by the board" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "approved", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "deny-case",
            "label": "Deny request",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["under-review"],
            "to": "denied",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "currentStep", "value": "Denied by the board" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "denied", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "reopen-case",
            "label": "Reopen request",
            "icon": "restore",
            "tone": "secondary",
            "from": ["approved", "denied"],
            "to": "reopened",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "currentStep", "value": "Reopened for board review" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "reopened", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "resubmit-request",
            "label": "Resubmit request",
            "icon": "send",
            "tone": "primary",
            "from": ["changes-needed"],
            "to": "submitted",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              { "op": "set", "key": "currentStep", "value": "Revisions resubmitted" },
              { "op": "set", "key": "requestedChanges", "value": null },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "resubmitted", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "createInstance",
                "workflowType": "hoa-committee-decision",
                "fields": {
                  "requestInstanceId": "{requestInstanceId}",
                  "requestTitle": "{title}",
                  "propertyLot": "{propertyLot}",
                  "changeDetails": "{changeDetails}",
                  "attachmentUrl": "{attachmentUrl}",
                  "requesterPersonaId": "{requesterPersonaId}",
                  "audiencePersonaIds": "{audiencePersonaIds}",
                  "submittedAt": "$timestamp",
                  "currentStep": "Revised request awaiting review",
                  "documentCheckpoint": "{documentCheckpoint}",
                  "paymentCheckpoint": "{paymentCheckpoint}",
                  "comments": [
                    { "authorPersonaId": "$actor", "body": "{ownerResponse}", "at": "$timestamp" }
                  ],
                  "statusHistory": [
                    { "status": "resubmitted", "actorPersonaId": "$actor", "at": "$timestamp" }
                  ],
                  "ownerNotificationState": "Not sent"
                }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-committee-decision",
                  "filter": { "requestInstanceId": "{requestInstanceId}", "$state": "changes-needed" },
                  "sortKey": "submittedAt",
                  "limit": 1
                },
                "transitionId": "owner-resubmitted"
              }
            ]
          },
          {
            "id": "withdraw-request",
            "label": "Withdraw request",
            "icon": "cancel_schedule_send",
            "tone": "destructive",
            "from": ["submitted", "under-review", "changes-needed", "reopened"],
            "to": "withdrawn",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "currentStep", "value": "Withdrawn by owner" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "withdrawn", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-committee-decision",
                  "filter": { "requestInstanceId": "{requestInstanceId}", "$state": "submitted" },
                  "sortKey": "submittedAt",
                  "limit": 1
                },
                "transitionId": "owner-withdraw"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-committee-decision",
                  "filter": { "requestInstanceId": "{requestInstanceId}", "$state": "under-review" },
                  "sortKey": "submittedAt",
                  "limit": 1
                },
                "transitionId": "owner-withdraw"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-committee-decision",
                  "filter": { "requestInstanceId": "{requestInstanceId}", "$state": "changes-needed" },
                  "sortKey": "submittedAt",
                  "limit": 1
                },
                "transitionId": "owner-withdraw"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-committee-decision",
                  "filter": { "requestInstanceId": "{requestInstanceId}", "$state": "reopened" },
                  "sortKey": "submittedAt",
                  "limit": 1
                },
                "transitionId": "owner-withdraw"
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["draft", "submitted", "under-review", "changes-needed", "reopened"],
            "role": "any",
            "tabId": "requests",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "audienceMemberField": "audiencePersonaIds",
            "actions": [
              {
                "kind": "create",
                "label": "Submit property request",
                "byPersonaIds": ["hoa-member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "requesterPersonaId": "$actor",
                  "audiencePersonaIds": ["$actor"],
                  "statusHistory": []
                }
              }
            ]
          },
          {
            "states": ["approved", "denied", "withdrawn"],
            "role": "any",
            "tabId": "requests",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["submitted", "under-review", "changes-needed", "approved", "denied", "reopened"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["under-review", "reopened"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["submitted", "under-review", "changes-needed", "approved", "denied", "reopened", "withdrawn"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "propertyLot": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "displayIcon": "home_work",
            "labelTemplate": "Property: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "changeDetails": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 1200,
            "displayIcon": "architecture",
            "labelTemplate": "Change: {value}",
            "displayContexts": ["detail"]
          },
          // NEEDS IMPLEMENTATION: type:url external opening is the correct document-attachment shape,
          // but the shared URL renderer remains proposed in field-types.md.
          "attachmentUrl": {
            "type": "url",
            "writableBy": "formEntry",
            "openMode": "external",
            "displayIcon": "attach_file",
            "labelTemplate": "Attachment: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "requesterPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "person_outline",
            "labelTemplate": "Requester: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "audiencePersonaIds": { "type": "personaId[]", "required": true },
          "requestInstanceId": { "type": "text", "writableBy": "effect", "hideWhenEmpty": true },
          "submittedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "send_time_extension",
            "labelTemplate": "Submitted {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "currentStep": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "timeline",
            "labelTemplate": "Current step: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "reviewerPersonaId": {
            "type": "personaId?",
            "writableBy": "effect",
            "displayIcon": "gavel",
            "labelTemplate": "Reviewer: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "reviewDate": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event",
            "labelTemplate": "Review date: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "reviewTime": {
            "type": "time?",
            "writableBy": "effect",
            "displayIcon": "schedule",
            "labelTemplate": "Review time: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "eventDate": { "type": "date?", "formula": "reviewDate", "displayContexts": [] },
          "eventTime": { "type": "time?", "formula": "reviewTime", "displayContexts": [] },
          "requestedChanges": {
            "type": "textarea",
            "writableBy": "effect",
            "maxLength": 1000,
            "displayIcon": "edit_note",
            "labelTemplate": "Requested changes: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "boardComments": {
            "type": "textarea",
            "writableBy": "effect",
            "maxLength": 1000,
            "displayIcon": "comment",
            "labelTemplate": "Board comment: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "documentCheckpoint": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "attach_file",
            "labelTemplate": "Document checkpoint: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "paymentCheckpoint": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "price_check",
            "labelTemplate": "Payment checkpoint: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "ownerResponse": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 800,
            "displayIcon": "reply",
            "labelTemplate": "Owner response: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "ownerNotificationState": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "notifications",
            "labelTemplate": "Owner notice: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "statusHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "Status events: {value.length}",
            "displayContexts": ["detail"]
          }
        }
      },

      "hoa-committee-decision": {
        "initialState": "submitted",
        "visibility": {
          "default": "guarded",
          "readGuard": { "formula": "$viewer == requesterPersonaId || $viewer == 'hoa-board'" }
        },
        "states": {
          "submitted": { "label": "Submitted", "tone": "info" },
          "under-review": { "label": "Under review", "tone": "warning" },
          "changes-needed": { "label": "Changes needed", "tone": "warning" },
          "approved": { "label": "Approved", "tone": "positive" },
          "denied": { "label": "Denied", "tone": "negative" },
          "reopened": { "label": "Reopened", "tone": "warning" },
          "superseded": { "label": "Superseded by revision", "tone": "info", "isTerminal": true },
          "withdrawn": { "label": "Owner withdrew", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "begin-committee-review",
            "label": "Begin review",
            "icon": "rate_review",
            "tone": "primary",
            "from": ["submitted"],
            "to": "under-review",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "reviewDate": { "type": "text", "required": true },
              "reviewTime": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "reviewerPersonaId", "value": "$actor" },
              { "op": "set", "key": "reviewDate", "value": "{input.reviewDate}" },
              { "op": "set", "key": "reviewTime", "value": "{input.reviewTime}" },
              { "op": "set", "key": "currentStep", "value": "Committee review in progress" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "under-review", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-architectural-request",
                  "filter": { "requestInstanceId": "{requestInstanceId}" },
                  "limit": 1
                },
                "transitionId": "begin-review"
              },
              { "op": "set", "key": "reviewerPersonaId", "value": "$actor", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "reviewDate", "value": "{input.reviewDate}", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "reviewTime", "value": "{input.reviewTime}", "relatedInstance": "requestInstanceId" }
            ]
          },
          {
            "id": "approve-request",
            "label": "Approve request",
            "icon": "check_circle",
            "tone": "primary",
            "from": ["under-review"],
            "to": "approved",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "boardComment": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "decision", "value": "Approved" },
              { "op": "set", "key": "decidedAt", "value": "$timestamp" },
              { "op": "set", "key": "currentStep", "value": "Approved" },
              { "op": "set", "key": "ownerNotificationState", "value": "Sent" },
              {
                "op": "append",
                "key": "comments",
                "value": { "authorPersonaId": "$actor", "body": "{input.boardComment}", "at": "$timestamp" }
              },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "approved", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-architectural-request",
                  "filter": { "requestInstanceId": "{requestInstanceId}" },
                  "limit": 1
                },
                "transitionId": "approve-case"
              },
              { "op": "set", "key": "reviewerPersonaId", "value": "$actor", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "boardComments", "value": "{input.boardComment}", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "ownerNotificationState", "value": "Sent", "relatedInstance": "requestInstanceId" },
              {
                "op": "createInstance",
                "workflowType": "hoa-owner-notification",
                "fields": {
                  "title": "Architectural request approved",
                  "body": "{input.boardComment}",
                  "senderPersonaId": "$actor",
                  "audiencePersonaIds": "{audiencePersonaIds}",
                  "sentAt": "$timestamp",
                  "deliveryState": "Sent",
                  "relatedRequestInstanceId": "{requestInstanceId}",
                  "readPersonaIds": []
                }
              }
            ]
          },
          {
            "id": "request-owner-changes",
            "label": "Request changes",
            "icon": "edit_note",
            "tone": "secondary",
            "from": ["under-review"],
            "to": "changes-needed",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "requestedChanges": { "type": "text", "required": true },
              "boardComment": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "decision", "value": "Changes requested" },
              { "op": "set", "key": "requestedChanges", "value": "{input.requestedChanges}" },
              { "op": "set", "key": "currentStep", "value": "Waiting for owner revisions" },
              { "op": "set", "key": "ownerNotificationState", "value": "Sent" },
              {
                "op": "append",
                "key": "comments",
                "value": { "authorPersonaId": "$actor", "body": "{input.boardComment}", "at": "$timestamp" }
              },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "changes-needed", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-architectural-request",
                  "filter": { "requestInstanceId": "{requestInstanceId}" },
                  "limit": 1
                },
                "transitionId": "request-changes-case"
              },
              { "op": "set", "key": "reviewerPersonaId", "value": "$actor", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "requestedChanges", "value": "{input.requestedChanges}", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "boardComments", "value": "{input.boardComment}", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "ownerNotificationState", "value": "Sent", "relatedInstance": "requestInstanceId" },
              {
                "op": "createInstance",
                "workflowType": "hoa-owner-notification",
                "fields": {
                  "title": "Changes requested for architectural request",
                  "body": "{input.requestedChanges}",
                  "senderPersonaId": "$actor",
                  "audiencePersonaIds": "{audiencePersonaIds}",
                  "sentAt": "$timestamp",
                  "deliveryState": "Sent",
                  "relatedRequestInstanceId": "{requestInstanceId}",
                  "readPersonaIds": []
                }
              }
            ]
          },
          {
            "id": "deny-request",
            "label": "Deny request",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["under-review"],
            "to": "denied",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "boardComment": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "decision", "value": "Denied" },
              { "op": "set", "key": "decidedAt", "value": "$timestamp" },
              { "op": "set", "key": "currentStep", "value": "Denied" },
              { "op": "set", "key": "ownerNotificationState", "value": "Sent" },
              {
                "op": "append",
                "key": "comments",
                "value": { "authorPersonaId": "$actor", "body": "{input.boardComment}", "at": "$timestamp" }
              },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "denied", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-architectural-request",
                  "filter": { "requestInstanceId": "{requestInstanceId}" },
                  "limit": 1
                },
                "transitionId": "deny-case"
              },
              { "op": "set", "key": "reviewerPersonaId", "value": "$actor", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "boardComments", "value": "{input.boardComment}", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "ownerNotificationState", "value": "Sent", "relatedInstance": "requestInstanceId" },
              {
                "op": "createInstance",
                "workflowType": "hoa-owner-notification",
                "fields": {
                  "title": "Architectural request denied",
                  "body": "{input.boardComment}",
                  "senderPersonaId": "$actor",
                  "audiencePersonaIds": "{audiencePersonaIds}",
                  "sentAt": "$timestamp",
                  "deliveryState": "Sent",
                  "relatedRequestInstanceId": "{requestInstanceId}",
                  "readPersonaIds": []
                }
              }
            ]
          },
          {
            "id": "reopen-decision",
            "label": "Reopen decision",
            "icon": "restore",
            "tone": "secondary",
            "from": ["approved", "denied"],
            "to": "reopened",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "reopenReason": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "decision", "value": "Reopened" },
              { "op": "set", "key": "currentStep", "value": "Reopened for review" },
              { "op": "set", "key": "ownerNotificationState", "value": "Sent" },
              {
                "op": "append",
                "key": "comments",
                "value": { "authorPersonaId": "$actor", "body": "{input.reopenReason}", "at": "$timestamp" }
              },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "reopened", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-architectural-request",
                  "filter": { "requestInstanceId": "{requestInstanceId}" },
                  "limit": 1
                },
                "transitionId": "reopen-case"
              },
              { "op": "set", "key": "boardComments", "value": "{input.reopenReason}", "relatedInstance": "requestInstanceId" },
              { "op": "set", "key": "ownerNotificationState", "value": "Sent", "relatedInstance": "requestInstanceId" },
              {
                "op": "createInstance",
                "workflowType": "hoa-owner-notification",
                "fields": {
                  "title": "Architectural decision reopened",
                  "body": "{input.reopenReason}",
                  "senderPersonaId": "$actor",
                  "audiencePersonaIds": "{audiencePersonaIds}",
                  "sentAt": "$timestamp",
                  "deliveryState": "Sent",
                  "relatedRequestInstanceId": "{requestInstanceId}",
                  "readPersonaIds": []
                }
              }
            ]
          },
          {
            "id": "resume-review",
            "label": "Resume review",
            "icon": "rate_review",
            "tone": "primary",
            "from": ["reopened"],
            "to": "under-review",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "reviewerPersonaId", "value": "$actor" },
              { "op": "set", "key": "currentStep", "value": "Committee review resumed" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "under-review", "actorPersonaId": "$actor", "at": "$timestamp" }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "hoa-architectural-request",
                  "filter": { "requestInstanceId": "{requestInstanceId}" },
                  "limit": 1
                },
                "transitionId": "begin-review"
              }
            ]
          },
          {
            "id": "owner-resubmitted",
            "label": "Owner resubmitted",
            "icon": "update",
            "tone": "secondary",
            "from": ["changes-needed"],
            "to": "superseded",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "currentStep", "value": "Superseded by revised submission" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "superseded", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "owner-withdraw",
            "label": "Owner withdrew",
            "icon": "cancel_schedule_send",
            "tone": "destructive",
            "from": ["submitted", "under-review", "changes-needed", "reopened"],
            "to": "withdrawn",
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorEqualsField": { "key": "requesterPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "currentStep", "value": "Owner withdrew request" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "withdrawn", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["submitted", "under-review", "approved", "denied", "reopened"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["changes-needed", "superseded", "withdrawn"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "summary"
          },
          {
            "states": ["submitted", "under-review", "changes-needed", "approved", "denied", "reopened", "superseded", "withdrawn"],
            "role": "any",
            "tabId": "requests",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary",
            "audienceMemberField": "audiencePersonaIds"
          }
        ],
        "instanceDataSchema": {
          "requestInstanceId": { "type": "text", "required": true },
          "requestTitle": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "architecture",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "propertyLot": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "home_work",
            "labelTemplate": "Property: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "changeDetails": {
            "type": "textarea",
            "required": true,
            "displayIcon": "description",
            "labelTemplate": "Requested change: {value}",
            "displayContexts": ["detail"]
          },
          "attachmentUrl": {
            "type": "url",
            "openMode": "external",
            "displayIcon": "attach_file",
            "labelTemplate": "Attachment: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "requesterPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "person_outline",
            "labelTemplate": "Requester: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "audiencePersonaIds": { "type": "personaId[]", "required": true },
          "submittedAt": {
            "type": "date",
            "required": true,
            "sortable": true,
            "displayIcon": "send_time_extension",
            "labelTemplate": "Submitted {value}",
            "displayContexts": ["tile", "detail"]
          },
          "currentStep": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "timeline",
            "labelTemplate": "Current step: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "reviewerPersonaId": {
            "type": "personaId?",
            "writableBy": "effect",
            "displayIcon": "gavel",
            "labelTemplate": "Reviewer: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "reviewDate": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event",
            "labelTemplate": "Review date: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "reviewTime": {
            "type": "time?",
            "writableBy": "effect",
            "displayIcon": "schedule",
            "labelTemplate": "Review time: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "documentCheckpoint": {
            "type": "text",
            "required": true,
            "displayIcon": "attach_file",
            "labelTemplate": "Documents: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "paymentCheckpoint": {
            "type": "text",
            "required": true,
            "displayIcon": "price_check",
            "labelTemplate": "Payment: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "requestedChanges": {
            "type": "textarea",
            "writableBy": "effect",
            "displayIcon": "edit_note",
            "labelTemplate": "Requested changes: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "decision": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "how_to_vote",
            "labelTemplate": "Decision: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "decidedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "schedule",
            "labelTemplate": "Decided {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "comments": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "comment",
            "labelTemplate": "Comments: {value.length}",
            "displayContexts": ["detail"]
          },
          "statusHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "History events: {value.length}",
            "displayContexts": ["detail"]
          },
          "ownerNotificationState": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "notifications",
            "labelTemplate": "Owner notice: {value}",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "hoa-owner-notification": {
        "initialState": "sent",
        "visibility": {
          "default": "guarded",
          "readGuard": { "formula": "contains(audiencePersonaIds, $viewer) || $viewer == senderPersonaId" }
        },
        "states": {
          "sent": {
            "label": "Sent",
            "tone": "positive",
            "editableFields": ["title", "body"],
            "editGuard": { "allowedPersonaIds": ["hoa-board"] }
          },
          "withdrawn": { "label": "Withdrawn", "tone": "warning" }
        },
        "transitions": [
          {
            "id": "mark-notification-read",
            "label": "Mark read",
            "icon": "mark_email_read",
            "tone": "primary",
            "from": ["sent"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "readPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "readPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "mark-notification-unread",
            "label": "Mark unread",
            "icon": "mark_email_unread",
            "tone": "secondary",
            "from": ["sent"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["hoa-member"],
              "actorInList": { "key": "readPersonaIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "readPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "withdraw-notification",
            "label": "Withdraw notice",
            "icon": "undo",
            "tone": "destructive",
            "from": ["sent"],
            "to": "withdrawn",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "deliveryState", "value": "Withdrawn" },
              { "op": "set", "key": "withdrawnAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "resend-notification",
            "label": "Resend notice",
            "icon": "send",
            "tone": "primary",
            "from": ["withdrawn"],
            "to": "sent",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "deliveryState", "value": "Sent" },
              { "op": "set", "key": "sentAt", "value": "$timestamp" },
              { "op": "set", "key": "withdrawnAt", "value": null }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["sent"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary",
            "audienceMemberField": "audiencePersonaIds"
          },
          {
            "states": ["sent", "withdrawn"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Send owner notice",
                "byPersonaIds": ["hoa-board"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "senderPersonaId": "$actor",
                  "audiencePersonaIds": ["hoa-member"],
                  "sentAt": "$timestamp",
                  "deliveryState": "Sent",
                  "readPersonaIds": []
                }
              }
            ]
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "displayIcon": "campaign",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "body": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 2000,
            "displayIcon": "message",
            "labelTemplate": "{value}",
            "displayContexts": ["detail"]
          },
          "senderPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "person_outline",
            "labelTemplate": "Sender: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "audiencePersonaIds": {
            "type": "personaId[]",
            "required": true,
            "displayIcon": "groups_outlined",
            "labelTemplate": "Audience: {value.length}",
            "displayContexts": ["detail"]
          },
          "sentAt": {
            "type": "date",
            "required": true,
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "schedule",
            "labelTemplate": "Sent {value}",
            "displayContexts": ["tile", "detail"]
          },
          "deliveryState": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "outbox",
            "labelTemplate": "Delivery: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "relatedRequestInstanceId": {
            "type": "text",
            "displayIcon": "link",
            "labelTemplate": "Related request: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "readPersonaIds": { "type": "personaId[]", "writableBy": "effect" },
          "withdrawnAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true },
          "memberReadState": {
            "type": "text",
            "formula": "if(contains(readPersonaIds, $viewer), 'read', 'received-unread')",
            "displayIcon": "mark_email_read",
            "labelTemplate": "Your state: {value}",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "hoa-export-evidence": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "allowedPersonaIds": ["hoa-board"] }
        },
        "states": {
          "draft": {
            "label": "Choose export scope",
            "tone": "info",
            "editableFields": ["exportLabel", "scope", "redactionPreview", "provider"],
            "editGuard": { "allowedPersonaIds": ["hoa-board"] }
          },
          "preview": { "label": "Redaction preview", "tone": "info" },
          "generating": { "label": "Generating", "tone": "warning" },
          "ready": { "label": "Ready for download", "tone": "positive" },
          "transferring": { "label": "Transfer in progress", "tone": "warning" },
          "transferred": { "label": "Transferred", "tone": "positive" },
          "failed": {
            "label": "Export failed",
            "tone": "negative",
            "editableFields": ["exportLabel", "scope", "redactionPreview", "provider"],
            "editGuard": { "allowedPersonaIds": ["hoa-board"] }
          },
          "rolled-back": { "label": "Rollback requested", "tone": "warning" },
          "cancelled": { "label": "Cancelled", "tone": "info" }
        },
        "transitions": [
          {
            "id": "preview-export",
            "label": "Preview redactions",
            "icon": "preview",
            "tone": "primary",
            "from": ["draft", "failed"],
            "to": "preview",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "exportStatus", "value": "Preview ready" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "preview", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "change-export-scope",
            "label": "Change scope",
            "icon": "tune",
            "tone": "secondary",
            "from": ["preview", "ready"],
            "to": "draft",
            "guard": { "allowedPersonaIds": ["hoa-board"] }
          },
          {
            "id": "generate-export",
            "label": "Generate export",
            "icon": "archive",
            "tone": "primary",
            "from": ["preview"],
            "to": "generating",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "generatedAt", "value": "$timestamp" },
              { "op": "set", "key": "exportStatus", "value": "Awaiting checksum service" },
              { "op": "set", "key": "checksumStatus", "value": "awaiting-platform" },
              { "op": "set", "key": "verificationStatus", "value": "awaiting-checksum" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "generating", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "record-platform-verification",
            "label": "Record checksum verification",
            "icon": "verified",
            "tone": "primary",
            "from": ["generating"],
            "to": "ready",
            "guard": {
              "allowedPersonaIds": ["hoa-board"],
              "instanceDataEquals": { "key": "checksumStatus", "value": "passed" },
              "formula": "if(checksum == null, false, true)"
            },
            "effects": [
              { "op": "set", "key": "verificationStatus", "value": "platform-verified" },
              { "op": "set", "key": "exportStatus", "value": "Verified and ready" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "verified", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "approve-manual-export-review",
            "label": "Approve manual review",
            "icon": "fact_check",
            "tone": "secondary",
            "from": ["generating"],
            "to": "ready",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "verificationNote": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "verificationStatus", "value": "manual-review" },
              { "op": "set", "key": "verificationNote", "value": "{input.verificationNote}" },
              { "op": "set", "key": "exportStatus", "value": "Manual review complete; transfer remains disabled" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "manual-review", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "record-export-failure",
            "label": "Record failure",
            "icon": "error_outline",
            "tone": "destructive",
            "from": ["generating", "transferring"],
            "to": "failed",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "inputs": {
              "failureReason": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "failureReason", "value": "{input.failureReason}" },
              { "op": "set", "key": "exportStatus", "value": "Failed" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": {
                  "status": "failed",
                  "note": "{input.failureReason}",
                  "actorPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "retry-export",
            "label": "Retry export",
            "icon": "refresh",
            "tone": "primary",
            "from": ["failed", "rolled-back"],
            "to": "preview",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "failureReason", "value": null },
              { "op": "set", "key": "exportStatus", "value": "Retrying from preview" }
            ]
          },
          {
            "id": "request-export-download",
            "label": "Request export download",
            "icon": "download",
            "tone": "primary",
            "from": ["ready", "transferred"],
            "to": null,
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            // NEEDS IMPLEMENTATION: exportWizard/platform must supply the generated archive and its
            // download location; this transition records the request without fabricating a file URL.
            "effects": [
              { "op": "set", "key": "downloadRequestedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "download-requested", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          // NEEDS IMPLEMENTATION (platform service): checksum generation and transfer-ID generation.
          // checksum and transferId are declared below and never written by any effect. Per solved pattern
          // 14, transfer progress is intentionally not gated on either unavailable platform-service value.
          {
            "id": "start-export-transfer",
            "label": "Start transfer",
            "icon": "send",
            "tone": "primary",
            "from": ["ready"],
            "to": "transferring",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "exportStatus", "value": "Transfer requested" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "transfer-requested", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "record-transfer-complete",
            "label": "Record transfer complete",
            "icon": "cloud_done",
            "tone": "primary",
            "from": ["transferring"],
            "to": "transferred",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "exportStatus", "value": "Transferred" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "transferred", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "rollback-transfer",
            "label": "Request rollback",
            "icon": "settings_backup_restore",
            "tone": "destructive",
            "from": ["transferred"],
            "to": "rolled-back",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "rollbackStatus", "value": "Rollback requested" },
              { "op": "set", "key": "exportStatus", "value": "Rollback requested" },
              {
                "op": "append",
                "key": "statusHistory",
                "value": { "status": "rollback-requested", "actorPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "cancel-export",
            "label": "Cancel export",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["draft", "preview", "generating", "ready", "transferring", "failed"],
            "to": "cancelled",
            "guard": { "allowedPersonaIds": ["hoa-board"] },
            "effects": [
              { "op": "set", "key": "exportStatus", "value": "Cancelled" }
            ]
          },
          {
            "id": "reopen-export",
            "label": "Reopen export",
            "icon": "restore",
            "tone": "secondary",
            "from": ["cancelled"],
            "to": "draft",
            "guard": { "allowedPersonaIds": ["hoa-board"] }
          }
        ],
        "renderBindings": [
          // NEEDS IMPLEMENTATION (pending archetype): exportWizard is locked vocabulary but is not yet
          // in the Dart registry; unknown_card_surface_family is expected until that registry lands.
          {
            "states": [
              "draft",
              "preview",
              "generating",
              "ready",
              "transferring",
              "transferred",
              "failed",
              "rolled-back",
              "cancelled"
            ],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New HOA export",
                "byPersonaIds": ["hoa-board"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "exportStatus": "Draft",
                  "checksumStatus": "not-requested",
                  "verificationStatus": "not-started",
                  "statusHistory": []
                }
              }
            ]
          }
        ],
        "instanceDataSchema": {
          "exportLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "displayIcon": "inventory_2",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "scope": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "select_all",
            "labelTemplate": "Scope: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "redactionPreview": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 1200,
            "displayIcon": "policy",
            "labelTemplate": "Redaction preview: {value}",
            "displayContexts": ["detail"]
          },
          "provider": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "cloud_outlined",
            "labelTemplate": "Provider: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "exportStatus": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "timeline",
            "labelTemplate": "Status: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "checksumStatus": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "verified_user",
            "labelTemplate": "Checksum status: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "verificationStatus": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "fact_check",
            "labelTemplate": "Verification: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "verificationNote": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "notes",
            "labelTemplate": "Verification note: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          // NEEDS IMPLEMENTATION (platform service): checksum/integrity-hash generation is not implemented.
          // Declared for export proof and never seeded or written by any effect.
          "checksum": {
            "type": "text",
            "displayIcon": "fingerprint",
            "labelTemplate": "Checksum: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          // NEEDS IMPLEMENTATION (platform service): opaque export transfer-ID generation is not implemented.
          // Declared for transfer proof and never seeded or written by any effect.
          "transferId": {
            "type": "text",
            "displayIcon": "swap_horiz",
            "labelTemplate": "Transfer ID: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "generatedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "schedule",
            "labelTemplate": "Generated {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "downloadRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "download",
            "labelTemplate": "Download requested {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "failureReason": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "error_outline",
            "labelTemplate": "Failure: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "rollbackStatus": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "settings_backup_restore",
            "labelTemplate": "Rollback: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "statusHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "Audit events: {value.length}",
            "displayContexts": ["detail"]
          }
        }
      }
    },

