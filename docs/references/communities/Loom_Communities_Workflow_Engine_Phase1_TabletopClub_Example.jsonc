// Loom_Communities_Workflow_Engine_Phase1_TabletopClub_Example.jsonc
//
// Tabletop Club community definition — the full desired experience, migrated to the
// engine-native specVersion 4 package grammar and its roleId/fanId identity model.
//
// Every workflow, state, transition, guard, effect, formula, and render binding below is written in
// the grammar the real engine already parses (`LoomWorkflowStateMachine.fromJson`,
// workflow_models.dart:341-371) and executes (`LocalWorkflowEngineApi` — real guards, real effects
// incl. branch/createInstance/cross-instance set, real formula evaluator). Nothing here is a
// decorative fixture: a real backend would run this as-is; the demo runs the same API against a local
// WorkflowDatabase (real interface, stubbed transitions).
//
// Platform/App-Shell capabilities that JSON cannot supply are recorded in the delivery's
// Gaps / assumptions section; no unsupported JSON construct is used as a placeholder for them.
//
// Replaces the previous draft of this file, which mixed the legacy shallow form (flat `workflows[]` +
// bespoke `tournamentBallot`/`marketplaceListings` blocks) with new content. Two substantive model
// corrections carried into this version:
//   1. The "afternoon tournament" calendar RSVP and the ballot's tournament event were two separate
//      things describing ONE real-world event. They are now a single `tournament-event` instance whose
//      `goingFanIds` is what the ballot's cross-instance eligibility guard actually reads.
//   2. The old `tabletop-committee-decision` card asserted "a member proposed Wingspan" as a scripted
//      fact with no workflow that let a member propose anything. Replaced by a real
//      `game-purchase-proposal` type: a member really submits, an organizer really decides, and the
//      member really sees the outcome on their own proposal.

{
  // ---- Package envelope ----
  "specVersion": 4,
  "packageId": "init_verify_tabletop_club_2",
  "communityId": "community_verify_tabletop_club",
  "communityHandle": "tabletop-club",
  "displayName": "Tabletop Club",
  "extensionId": "ext_verify_tabletop_club",
  "branding": {
    "logo": "seed/assets/tabletop-logo.png",
    "cardImage": "seed/assets/tabletop-card.png",
    "heroImage": "seed/assets/tabletop-hero.png",
    "accentColor": "#C4703F",
    "altText": "Tabletop club members around a game table"
  },
  "seedDataFiles": [],
  "idempotencyKey": "init-verify-tabletop-club-v2",

  "experience": {
    // ---- Engine-native experience ----

    "displayName": "Tabletop Club",
    "tagline": "Board game nights, tournaments, loaner games, and dues for local tabletop fans.",
    "accentColor": "#C4703F",

    // Deliberate, tested community -> tab -> workflow theme cascade (b26_package_driven_experience_test).
    // Every card derives fill/border/heading/body/button color from this accent automatically; the
    // Giving tab intentionally deepens it. Do not hardcode colors in any card.
    "theme": {
      "accent": "#C4703F",
      "tabThemes": {
        "giving": { "accent": "#8A5A34" }
      },
      // Community-configurable agenda date rail: the first two entries reproduce the default and the
      // third adds a small badge showing how many events land on that day.
      "calendar": {
        "dateRail": {
          "entries": [
            { "kind": "dateToken", "token": "weekdayAbbrev", "style": "label" },
            { "kind": "dateToken", "token": "dayOfMonth", "style": "circleHighlight", "colorSource": "accent" },
            { "kind": "formula", "formula": "count(dayInstances)", "style": "badge", "colorSource": "styleField" }
          ]
        }
      }
    },

    // Resolves (1) which FAB layout renders when two or more create actions target the same tab, and
    // (2) how the tapped action's own archetype
    // card surface is presented. Calendar is the first tab to need the multi-action case: event-rsvp's
    // "New event" today, and tournament-event's "New tournament" once CALR.3b lands -- both creatable,
    // both on tabId "calendar". The community default keeps creation forms as the "expand and hover"
    // popup everywhere; Calendar overrides to a bottom slide-out sheet specifically, since a full
    // event/tournament form (title/date/time/location/capacity) reads more comfortably in a larger
    // sheet than a small hovering popup -- multiActionStyle is left unset in the override, so Calendar
    // still inherits speedDial from the community default (proving the two fields resolve
    // independently, not all-or-nothing).
    "creatableAction": {
      "multiActionStyle": "speedDial",
      "presentationStyle": "popup"
    },
    "tabCreatableActionStyles": {
      "calendar": {
        "presentationStyle": "slideOutBottom"
      }
    },

    // Notifications Experience, PROPOSED (new phase, 2026-07-31) -- picks which of the four generic
    // presentation styles (bell/dedicatedTab/fixedCard/fab) this community uses for the real, per-persona
    // `notification` workflow type instances (see below). Tabletop Club picks "bell": community-wide chrome
    // in the shared AppBar, visible on every tab including Calendar, needing zero Calendar-specific UI --
    // the other three styles ship equally real and independently tested, just not activated here.
    "notificationPresentation": {
      "style": "bell"
    },

    "roles": [
      {
        "roleId": "tabletop-organizer",
        "label": "Organizer",
        "roleLabel": "Organizer",
        "description": "Plans game nights and tournaments, manages the game library, decides purchase proposals, and collects dues."
      },
      {
        "roleId": "tabletop-member",
        "label": "Member",
        "roleLabel": "Member",
        "description": "RSVPs to game nights and tournaments, borrows games, proposes purchases, votes on the tournament ballot, and pays dues."
      }
    ],

    // =============================================================================================
    // WORKFLOW DEFINITIONS — the reusable TYPES (like classes). One definition, many instances.
    // =============================================================================================
    "workflowDefinitions": {

      // -------------------------------------------------------------------------------------------
      // CALENDAR — a plain event with real RSVP. Capacity/waitlist are computed by real formulas, not
      // regex-parsed from a label string (the anti-pattern the archetype audit found).
      //
      // NOTE: V2's Calendar_RSVP design doc modeled this with a `responseModel: { kind: simpleRsvp }`
      // sugar block. The engine does NOT parse `responseModel` (see JSON_Schema_Versions.md, "Known
      // not-yet-in-grammar"). Going/maybe/not-going/waitlist are therefore modeled here with plain
      // transitions + effects + formulas, which the engine executes today — no new engine capability.
      // -------------------------------------------------------------------------------------------
      "event-rsvp": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "RSVP open",
            "tone": "positive",
            // IMPLEMENTED 2026-07-25 (CALR.10a) -- editGuard genuinely gates who sees these editors;
            // spec-version.json resolvedInGrammar.editGuard. NOTE (CAL.Calendar2.0, PROPOSED): today
            // this guard is only checked by the App Shell's own UI -- updateInstanceFields itself does
            // not yet call evaluateGuard against it, a real gap CAL.Calendar2.0 closes engine-side.
            //
            // allDay/eventEndDate/locationType/videoLink are NEW 2026-07-26 (CAL.Calendar2.3/.4/.5,
            // PROPOSED). These four are plain instanceDataSchema fields using only already-implemented
            // grammar (formEntry + editableFields) -- genuinely functional today via the generic editor,
            // no engine change needed for storage/editing itself. What's NOT yet built: the App Shell
            // doesn't yet conditionally hide eventTime when allDay is set, doesn't yet place a
            // multi-day instance on every date between eventDate and eventEndDate (month/week/day
            // grouping today assumes one day per instance), and doesn't yet conditionally show
            // videoLink only when locationType == "video".
            "editableFields": [
              "title", "eventDate", "eventTime", "location", "host", "capacity",
              "allDay", "eventEndDate", "locationType", "videoLink"
            ],
            "editGuard": { "allowedRoleIds": ["tabletop-organizer"] }
          },
          "cancelled": { "label": "Cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "cancel-event",
            "action": "cancel",
            "label": "Cancel event",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["open"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [
              { "op": "transitionRelated", "transitionId": "cancel-pending-response",
                "relatedQuery": { "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "pending" } } },
              { "op": "transitionRelated", "transitionId": "cancel-going-response",
                "relatedQuery": { "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "going" } } },
              { "op": "transitionRelated", "transitionId": "cancel-maybe-response",
                "relatedQuery": { "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "maybe" } } },
              { "op": "transitionRelated", "transitionId": "cancel-declined-response",
                "relatedQuery": { "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "declined" } } },
              { "op": "transitionRelated", "transitionId": "cancel-waitlisted-response",
                "relatedQuery": { "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "waitlisted" } } }
            ]
          },
          {
            // IMPLEMENTED 2026-07-25 (CAL.Recurrence, effects.md op 12). Orthogonal, no-state-change
            // transition (to: null) -- spawns count-1 real sibling instances via bespoke Dart date
            // arithmetic, stamps this instance's own seriesId in place as occurrence 0. The
            // "seriesId == null" formula guard self-removes this button after it fires once, since a
            // series can only be created from its anchor a single time.
            "id": "make-recurring",
            "action": "edit",
            "label": "Make recurring",
            "icon": "event_repeat",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-organizer"],
              "formula": "seriesId == null"
            },
            // Optional recurrenceRule fields (interval/byDayOfWeek/byMonthDay/bySetPos) are genuinely
            // omittable per-call -- an absent {input.x} token resolves to null, not a stringified
            // literal (fixed as part of this same implementation pass).
            "inputs": {
              "freq": { "type": "text", "required": true },
              "interval": { "type": "number" },
              "count": { "type": "number", "required": true },
              // byDayOfWeek is split into two mode-scoped inputs sharing one output key
              // (writesTo) because its cardinality genuinely differs by mode: weekly
              // recurrence allows any number of weekdays, but the monthly "last/Nth
              // weekday" mode requires exactly one (recurrence_evaluator.dart enforces
              // this -- bySetPos requires byDayOfWeek.length == 1). maxSelections lets
              // the same multi-select chip widget enforce that cap in the UI itself,
              // rather than round-tripping a StateError from the engine.
              "byDayOfWeekWeekly": {
                "type": "list",
                "options": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"],
                "visibleWhen": "freq == 'weekly'",
                "writesTo": "byDayOfWeek"
              },
              "byDayOfWeekMonthly": {
                "type": "list",
                "options": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"],
                "maxSelections": 1,
                "visibleWhen": "freq == 'monthly'",
                "modeGroup": "monthlyPattern",
                "modeValue": "lastOrNthWeekday",
                "writesTo": "byDayOfWeek"
              },
              "byMonthDay": {
                "type": "number",
                "visibleWhen": "freq == 'monthly'",
                "modeGroup": "monthlyPattern",
                "modeValue": "dayOfMonth"
              },
              "bySetPos": {
                "type": "text",
                "options": ["first", "second", "third", "fourth", "last"],
                "visibleWhen": "freq == 'monthly'",
                "modeGroup": "monthlyPattern",
                "modeValue": "lastOrNthWeekday"
              }
            },
            "effects": [
              { "op": "generateRecurringInstances",
                "workflowType": "event-rsvp",
                "anchorField": "eventDate",
                "fields": {
                  "title": "{title}",
                  "eventDate": "{eventDate}",
                  "eventTime": "{eventTime}",
                  "location": "{location}",
                  "host": "{host}",
                  "capacity": "{capacity}",
                  "category": "{category}",
                  "seriesId": "$newSeriesId"
                },
                "recurrenceRule": {
                  "freq": "{input.freq}",
                  "interval": "{input.interval}",
                  "count": "{input.count}",
                  "byDayOfWeek": "{input.byDayOfWeek}",
                  "byMonthDay": "{input.byMonthDay}",
                  "bySetPos": "{input.bySetPos}"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          { "states": ["open"], "audience": "any", "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "New event", "byRoleIds": ["tabletop-organizer"],
                "scope": "tab", "presentation": "fab" }
            ],
            // Points the generic archetype at the per-member response table instead of a hardcoded
            // field-name assumption — a second calendar-bound archetype with a different response
            // shape would declare its own responseTable, no App Shell code change needed.
            "responseTable": {
              "workflowType": "event-rsvp-response",
              "eventField": "eventId",
              "pendingStates": ["pending"]
            },
            "filterableFacets": [
              { "field": "isFull", "label": "Full events" },
              { "field": "hasWaitlist", "label": "Has waitlist" },
              { "field": "goingCount", "label": "Number accepted" }
            ],
            // Data-driven card color: cardStyleId is computed from this instance's own `category`
            // value (see instanceDataSchema below) — no App Shell code change needed for a community
            // to add its own categories, same rationale as responseTable/filterableFacets above.
            "styleField": "cardStyleId"
          },
          { "states": ["cancelled"], "audience": "any", "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp", "bindingKind": "summary" },
          { "states": ["open"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "event-rsvp", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "eventDate": { "type": "date", "required": true, "writableBy": "formEntry", "storage": "inline",
            "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "eventTime": { "type": "time", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "schedule", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "location": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "location_on_outlined", "labelTemplate": "{value}", "displayContexts": ["detail"] },
          "host": { "type": "text", "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "person_outline", "labelTemplate": "Host: {value}", "displayContexts": ["detail"] },
          "capacity": { "type": "number", "required": true, "writableBy": "formEntry", "storage": "inline",
            "sortable": true, "displayIcon": "groups_outlined", "labelTemplate": "{value} seats" },

          // Organizer-set reminder offset plus the computed timestamp. Combining eventDate and eventTime
          // avoids the midnight-only cutoff error that occurs when subtracting from a date alone.
          "reminderOffsetHours": { "type": "number", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": [] },
          "reminderAt": { "type": "date",
            "formula": "subtractHours(combineDateAndTime(eventDate, eventTime), if(reminderOffsetHours == null, 24, reminderOffsetHours))" },

          // NEW 2026-07-26 (CAL.Calendar2.3/.4/.5, PROPOSED). Plain formEntry fields, functional today
          // for storage/editing via the generic editor -- see the "open" state's own comment above for
          // exactly what App Shell rendering work is still outstanding for each.
          "allDay": { "type": "bool", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": [] },
          "eventEndDate": { "type": "date", "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "event", "labelTemplate": "Through {value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },
          "locationType": { "type": "text", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": [] },
          "videoLink": { "type": "url?", "writableBy": "formEntry", "storage": "inline", "openMode": "choice",
            "displayIcon": "videocam_outlined", "labelTemplate": "{value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },

          // QUERY-BACKED: every response row for this event (GAP-4 pattern) — one row per community
          // member, bulk-created via createInstances the moment this event is created. Not stored
          // here; read from the event-rsvp-response table on demand, same pattern as
          // tournament-ballot's `ballots`.
          "responses": { "type": "list",
            "source": "query(event-rsvp-response where eventId == id)" },

          // Computed — real formulas over the response rows, re-evaluated on every read. Architecturally
          // the same pattern as tournament-ballot's voteCounts/winner/isTie: the engine implements the
          // interpreter once (groupCount, mapGet); this JSON only ever composes it.
          "responseCounts": { "type": "map", "formula": "groupCount(responses, '$state')",
            "displayContexts": [] },
          "goingCount": { "type": "number", "formula": "mapGet(responseCounts, 'going')",
            "displayIcon": "groups_outlined", "labelTemplate": "Going: {value}",
            "displayContexts": ["tile", "detail"] },
          "maybeCount": { "type": "number", "formula": "mapGet(responseCounts, 'maybe')" },
          "declinedCount": { "type": "number", "formula": "mapGet(responseCounts, 'declined')" },
          "waitlistedCount": { "type": "number", "formula": "mapGet(responseCounts, 'waitlisted')",
            "displayIcon": "hourglass_empty", "labelTemplate": "Waitlist: {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "seatsRemaining": { "type": "number", "formula": "capacity - goingCount",
            "displayIcon": "event_seat", "labelTemplate": "{value} seats left",
            "displayContexts": ["detail"] },
          "isFull": { "type": "bool", "formula": "goingCount >= capacity" },
          "hasWaitlist": { "type": "bool", "formula": "waitlistedCount > 0" },

          // Community-authored category, used only to select this card's visual style below — not
          // rendered as a fact pill itself (displayContexts: []).
          "category": { "type": "text", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": [] },
          // Nested if() maps the category value to a small integer — the same pattern already proven
          // by tournament-ballot.dueAt's reminderOffset mapping. No new formula function needed.
          "cardStyleId": { "type": "number",
            "formula": "if(category == 'tournament', 1, if(category == 'social', 2, 0))",
            "displayContexts": [] },

          // IMPLEMENTED 2026-07-25 (CAL.Recurrence). Stamped once by make-recurring's own effect --
          // never writable by a member/organizer directly, and never present on the seeded fixture data
          // below (every seeded event is a standalone instance until an organizer opts it into a
          // series live). Shared by every instance make-recurring generates from the same anchor.
          "seriesId": { "type": "text", "writableBy": "effect", "storage": "inline",
            "displayContexts": [] }
        }
      },

      // -------------------------------------------------------------------------------------------
      // EVENT RSVP RESPONSE — one ROW per (event, persona). Same rationale as tournament-vote
      // (atomic, auditable, no shared list to read-modify-write) with one real difference: a vote is
      // insert-only and immutable, but an RSVP response is MUTABLE — a member can change their mind,
      // so this type has real transitions between real states, not a single terminal one.
      //
      // The event-rsvp archetype provisions a row per member when an event is created, all starting in
      // "pending". This makes every RSVP action a plain, race-free applyTransition on an
      // already-existing row — never a racy "does a row exist yet" check.
      // -------------------------------------------------------------------------------------------
      "event-rsvp-response": {
        "initialState": "pending",
        "visibility": { "default": "membersOnly" },
        "states": {
          "pending":    { "label": "No response yet", "tone": "info" },
          "going":      { "label": "Going",      "tone": "positive" },
          "maybe":      { "label": "Maybe",      "tone": "info" },
          "declined":   { "label": "Can't go",   "tone": "negative" },
          "waitlisted": { "label": "Waitlisted", "tone": "secondary" },
          "cancelled": { "label": "Event cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "respond-going",
            "action": "respond",
            "label": "Going",
            "icon": "event_available",
            "tone": "primary",
            "from": ["pending", "maybe", "declined", "waitlisted"],
            "to": "going",
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              // Count going response rows live. The current guard implementation safely supports only
              // `count`; partySize remains collected for the planned plus-one upgrade, but is not used
              // for enforcement until relatedAggregate.field is implemented.
              "relatedAggregate": {
                "workflowType": "event-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count",
                "comparator": "<",
                "compareTo": { "relatedInstanceField": "eventId", "field": "capacity" }
              }
            },
            // NEW 2026-07-26 (CAL.Calendar2.5b, PROPOSED). dietaryNotes/comments are both optional -- an
            // omitted GAP-1 input resolves to null (CAL.Recurrence.1 fix2's exact-match behavior), not a
            // stringified literal, so leaving either blank is safe.
            // partySize (CAL.Calendar2.8, PROPOSED) is REQUIRED, unlike those two: it feeds directly into
            // the capacity guard's `sum` above, and every existing seeded response row was backfilled
            // with `partySize: 1` (see workflowInstances below) so summing over it never silently
            // undercounts pre-existing attendees. Collecting these from a member uses CAL.Calendar2.1's
            // generic input dialog -- the transition itself already works today via a direct
            // applyTransition(..., inputs: {...}) call.
            "inputs": {
              "dietaryNotes": { "type": "text" },
              "comments": { "type": "text" },
              "partySize": { "type": "number", "required": true }
            },
            "effects": [
              { "op": "set", "key": "dietaryNotes", "value": "{input.dietaryNotes}" },
              { "op": "set", "key": "comments", "value": "{input.comments}" },
              { "op": "set", "key": "partySize", "value": "{input.partySize}" }
            ]
          },
          {
            "id": "respond-maybe",
            "action": "respond",
            "label": "Maybe",
            "icon": "help_outline",
            "tone": "secondary",
            "from": ["pending", "going", "declined", "waitlisted"],
            "to": "maybe",
            "guard": { "allowedRoleIds": ["tabletop-member", "tabletop-organizer"] },
            // IMPLEMENTED 2026-07-25 (transitionRelated, effects.md op 11). Fires unconditionally on
            // every leave, regardless of which state was left. Correctness comes from respond-going's
            // OWN relatedAggregate guard re-evaluating live against the resolved target: if no seat
            // actually opened (this row wasn't "going", or the event is still full), the target's guard
            // fails and this is a silent no-op, not an error.
            // onSuccessEffects (CAL.Notify.1/.3, PROPOSED) -- only runs when the promotion genuinely
            // happens (the target's own relatedAggregate guard passed), never on the silent-no-op path.
            // Interpolated against the TARGET row's own data, so {fanId} resolves to the promoted
            // member, not whoever left the "going" state.
            "effects": [
              { "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{eventId}", "$state": "waitlisted" },
                  "sortKey": "rsvpedAt",
                  "limit": 1
                },
                "transitionId": "respond-going",
                "onSuccessEffects": [
                  { "op": "createInstance",
                    "workflowType": "notification",
                    "fields": {
                      "recipientFanId": "{fanId}",
                      "title": "You're off the waitlist!",
                      "body": "A seat opened up and you've been added to the going list.",
                      "createdAt": "$timestamp"
                    } }
                ] }
            ]
          },
          {
            "id": "respond-declined",
            "action": "respond",
            "label": "Can't go",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["pending", "going", "maybe", "waitlisted"],
            "to": "declined",
            "guard": { "allowedRoleIds": ["tabletop-member", "tabletop-organizer"] },
            // IMPLEMENTED 2026-07-25 -- see respond-maybe's identical note above.
            // onSuccessEffects (CAL.Notify.1/.3, PROPOSED) -- see respond-maybe's identical note above.
            "effects": [
              { "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{eventId}", "$state": "waitlisted" },
                  "sortKey": "rsvpedAt",
                  "limit": 1
                },
                "transitionId": "respond-going",
                "onSuccessEffects": [
                  { "op": "createInstance",
                    "workflowType": "notification",
                    "fields": {
                      "recipientFanId": "{fanId}",
                      "title": "You're off the waitlist!",
                      "body": "A seat opened up and you've been added to the going list.",
                      "createdAt": "$timestamp"
                    } }
                ] }
            ]
          },
          {
            // Only offered once the event is genuinely full — a real relatedAggregate guard, so the
            // button cannot appear (or fire) while seats remain. Same intent as the old formula guard,
            // now evaluated against the live row count instead of a stored list's size.
            "id": "respond-waitlist",
            "action": "join_waitlist",
            "label": "Join waitlist",
            "icon": "groups",
            "tone": "secondary",
            "from": ["pending", "maybe", "declined"],
            "to": "waitlisted",
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "relatedAggregate": {
                "workflowType": "event-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count",
                "comparator": ">=",
                "compareTo": { "relatedInstanceField": "eventId", "field": "capacity" }
              }
            },
            // Stamps the FIFO ordering field transitionRelated's sortKey reads above -- instance ids are
            // randomly generated, not time-ordered, so waitlist position needs its own explicit timestamp.
            "effects": [
              { "op": "set", "key": "rsvpedAt", "value": "$timestamp" }
            ]
          },
          {
            // Notifications Experience, PROPOSED (CAL.Notify2.9). Orthogonal transition (to: null --
            // the response's own RSVP state never changes) that exists purely to stamp the reminderSentAt
            // idempotency field via a real engine-enforced effect -- reminderSentAt is writableBy:"effect",
            // so updateInstanceFields refuses it outright; only a transition's own effect can write it.
            // The client-orchestrated "check due, create once" logic (App Shell) calls this on ITS OWN
            // response row only. This transition creates the actual notification and stamps the
            // idempotency field in the same engine transaction; the App Shell supplies notification
            // title/body/createdAt as inputs. It is never rendered as a user-facing button (the App Shell explicitly
            // excludes this id from the automatic action-chip row; see CAL.Notify2.9's own ticket).
            // "declined" is deliberately excluded from "from" -- a member who declined doesn't want a
            // reminder for an event they're not attending.
            "id": "send-reminder",
            "action": "set_reminder",
            "label": "Send reminder",
            "from": ["pending", "maybe", "going", "waitlisted"],
            "to": null,
            "guard": { "actorEqualsField": { "key": "fanId" } },
            "inputs": {
              "notificationTitle": { "type": "text", "required": true },
              "notificationBody": { "type": "text", "required": true },
              "notificationCreatedAt": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "createInstance",
                "workflowType": "notification",
                "fields": {
                  "recipientFanId": "{fanId}",
                  "title": "{input.notificationTitle}",
                  "body": "{input.notificationBody}",
                  "createdAt": "{input.notificationCreatedAt}"
                } },
              { "op": "set", "key": "reminderSentAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "cancel-pending-response", "action": "cancel", "label": "Close cancelled event response",
            "from": ["pending"], "to": "cancelled",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [ { "op": "set", "key": "responseBeforeCancellation", "value": "pending" } ]
          },
          {
            "id": "cancel-going-response", "action": "cancel", "label": "Close cancelled event response",
            "from": ["going"], "to": "cancelled",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [ { "op": "set", "key": "responseBeforeCancellation", "value": "going" } ]
          },
          {
            "id": "cancel-maybe-response", "action": "cancel", "label": "Close cancelled event response",
            "from": ["maybe"], "to": "cancelled",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [ { "op": "set", "key": "responseBeforeCancellation", "value": "maybe" } ]
          },
          {
            "id": "cancel-declined-response", "action": "cancel", "label": "Close cancelled event response",
            "from": ["declined"], "to": "cancelled",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [ { "op": "set", "key": "responseBeforeCancellation", "value": "declined" } ]
          },
          {
            "id": "cancel-waitlisted-response", "action": "cancel", "label": "Close cancelled event response",
            "from": ["waitlisted"], "to": "cancelled",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [ { "op": "set", "key": "responseBeforeCancellation", "value": "waitlisted" } ]
          }
        ],
        "renderBindings": [],
        "instanceDataSchema": {
          "eventId":   { "type": "text", "required": true, "storage": "inline" },
          "fanId": { "type": "fanId", "required": true, "storage": "inline" },
          // IMPLEMENTED 2026-07-25 -- stamped by respond-waitlist's own `set` effect above, read as
          // the sortKey by respond-maybe/respond-declined's transitionRelated effects. Written by
          // effect only, never by the member directly.
          "rsvpedAt":  { "type": "date?", "writableBy": "effect", "storage": "inline" },

          // NEW 2026-07-26 (CAL.Calendar2.5b, PROPOSED). Written by respond-going's own new `set`
          // effects above via {input.x} tokens -- writableBy stays "effect" (never formEntry) because
          // the member never edits this row directly; the value arrives as a transition input instead.
          "dietaryNotes": { "type": "text", "writableBy": "effect", "storage": "inline" },
          "comments": { "type": "text", "writableBy": "effect", "storage": "inline" },

          // NEW 2026-07-26 (CAL.Calendar2.8, PROPOSED). Feeds the capacity guard's `sum` aggregate above
          // -- writableBy "effect" for the same reason as dietaryNotes/comments. Every seeded response
          // row below is backfilled with `partySize: 1` so the guard's sum never silently undercounts
          // pre-existing attendees the moment this op lands.
          "partySize": { "type": "number", "writableBy": "effect", "storage": "inline" },

          // Notifications Experience, PROPOSED (new phase, 2026-07-31). Idempotency stamp for the new
          // client-orchestrated reminder check: written once a reminder notification has genuinely been
          // created for this (event, persona) pair, so a later poll never creates a second one for the
          // same response row.
          "reminderSentAt": { "type": "date?", "writableBy": "effect", "storage": "inline" },
          "responseBeforeCancellation": { "type": "text", "writableBy": "effect", "storage": "inline",
            "displayIcon": "history", "labelTemplate": "Last RSVP: {value}",
            "hideWhenEmpty": true, "displayContexts": ["detail"] }
        }
      },

      // -------------------------------------------------------------------------------------------
      // TOURNAMENT EVENT — the same real-world event the members RSVP to on Calendar AND the event the
      // ballot's cross-instance eligibility guard reads (`goingFanIds`). One instance, two render
      // bindings. `selectedGame` starts "TBD" and is written by the ballot's close transition via a
      // real cross-instance `set` effect — never by hand.
      // -------------------------------------------------------------------------------------------
      "tournament-event": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "Signups open",
            "tone": "positive",
            // IMPLEMENTED editGuard (CALR.10a) + NEW 2026-07-26 allDay/eventEndDate/locationType/
            // videoLink (CAL.Calendar2.3/.4/.5, PROPOSED) -- see the identical, fuller note on
            // event-rsvp's "open" state above; applies here unchanged.
            "editableFields": [
              "title", "eventDate", "eventTime", "location", "host", "minimumAttendance",
              "allDay", "eventEndDate", "locationType", "videoLink"
            ],
            "editGuard": { "allowedRoleIds": ["tabletop-organizer"] }
          },
          "cancelled": { "label": "Cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "rsvp-going",
            "action": "respond",
            "label": "I'm going",
            "icon": "event_available",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "actorInList": { "key": "goingFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "goingFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "rsvp-withdraw",
            "action": "withdraw_response",
            "label": "Can't make it",
            "icon": "event_busy",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "actorInList": { "key": "goingFanIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "goingFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "cancel-tournament",
            "action": "cancel",
            "label": "Cancel tournament",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["open"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] }
          }
        ],
        "renderBindings": [
          // Shows on Calendar as a real event...
          { "states": ["open"], "audience": "any", "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp", "bindingKind": "primary",
            // Event CREATION only — RSVP tracking (goingFanIds) deliberately NOT converted to the
            // event-rsvp-response table pattern in this pass: tournament-event has no capacity ceiling
            // (only a minimumAttendance quorum, inverted semantics from event-rsvp's guard), so reusing
            // that type verbatim would be wrong. Tracked as an explicit, named gap — see the gap list —
            // not silently extended here.
            "actions": [
              { "kind": "create", "label": "New tournament", "byRoleIds": ["tabletop-organizer"],
                "scope": "tab", "presentation": "fab" },
              // Instance-scoped: a button ON this tournament's own card that creates a ballot for it.
              // {context.id} = this tournament instance's id, which is exactly the ballot's eventId.
              // Grammar v2 owns an action on the archetype whose card hosts it (the tournament), not on
              // the type it creates (the ballot) — so this moved here off tournament-ballot's binding.
              { "kind": "create", "workflowType": "tournament-ballot",
                "label": "Create ballot for this tournament", "byRoleIds": ["tabletop-organizer"],
                "scope": "instance", "presentation": "button",
                "prefill": { "eventId": "{context.id}" } }
            ],
            "styleField": "cardStyleId" },
          // ...and on Home as the attendance/context card sitting alongside the ballot card.
          // (Ballot is a Home card, NOT its own tab — the dedicated 'ballot' tab is removed at 1.30.)
          { "states": ["open"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "votePoll", "bindingKind": "summary" },
          { "states": ["cancelled"], "audience": "any", "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp", "bindingKind": "summary" },
          { "states": ["cancelled"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "votePoll", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "eventDate": { "type": "date", "required": true, "writableBy": "formEntry", "storage": "inline",
            "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "eventTime": { "type": "time", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "schedule", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "location": { "type": "text", "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "location_on_outlined", "labelTemplate": "{value}", "displayContexts": ["detail"] },
          "host": { "type": "text", "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "person_outline", "labelTemplate": "Host: {value}", "displayContexts": ["detail"] },
          "minimumAttendance": { "type": "number", "required": true, "writableBy": "formEntry",
            "storage": "inline", "displayIcon": "groups_outlined",
            "labelTemplate": "Min. attendance: {value}", "displayContexts": ["detail"] },

          // Notifications Experience, PROPOSED (new phase, 2026-07-31) -- see the fuller comment on
          // event-rsvp's own copy of this field above; identical status here (reminderAt withheld until
          // CAL.Notify2.9 implements combineDateAndTime).
          "reminderOffsetHours": { "type": "number", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": [] },
          "reminderAt": { "type": "date",
            "formula": "subtractHours(combineDateAndTime(eventDate, eventTime), if(reminderOffsetHours == null, 24, reminderOffsetHours))" },

          // NEW 2026-07-26 (CAL.Calendar2.3/.4/.5, PROPOSED) -- see the fuller comment on event-rsvp's
          // own copy of these same fields above; identical status here.
          "allDay": { "type": "bool", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": [] },
          "eventEndDate": { "type": "date", "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "event", "labelTemplate": "Through {value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },
          "locationType": { "type": "text", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": [] },
          "videoLink": { "type": "url?", "writableBy": "formEntry", "storage": "inline", "openMode": "choice",
            "displayIcon": "videocam_outlined", "labelTemplate": "{value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },

          "goingFanIds": { "type": "fanId[]", "writableBy": "effect", "storage": "inline" },
          "selectedGame": { "type": "text", "writableBy": "effect", "storage": "inline",
            "displayIcon": "casino", "labelTemplate": "Selected game: {value}",
            "displayContexts": ["tile", "detail"] },

          // Computed — the live "Accepted: N / M" display and the quorum gate.
          "accepted": { "type": "number", "formula": "size(goingFanIds)",
            "displayIcon": "groups_outlined", "labelTemplate": "Accepted: {value}",
            "displayContexts": ["tile", "detail"] },
          "quorumMet": { "type": "bool", "formula": "size(goingFanIds) >= minimumAttendance" },

          // Constant style slot — every tournament-event instance is conceptually one category
          // ("tournament"), unlike event-rsvp which varies per instance's own `category` field. Still a
          // real formula (not a stored value), same styleField mechanism, distinguishing tournaments
          // from event-rsvp's own calendar cards regardless of event-rsvp's own category variation.
          "cardStyleId": { "type": "number", "formula": "1", "displayContexts": [] }
        }
      },

      // -------------------------------------------------------------------------------------------
      // TOURNAMENT BALLOT — the real votePoll archetype. Rich candidates (tap for detail popup),
      // cross-instance eligibility (only personas who RSVP'd going on the linked tournament-event may
      // vote — enforced by the engine's guard, not hidden client-side), a real deadline + scheduled
      // reminder (dueAt drives the engine's `dueNotifications({asOf})` API), a real formula-computed
      // tally, and a REAL runoff on a tie (branch + createInstance spawns a second ballot containing
      // only the tied candidates — not a dead-end terminal state).
      // -------------------------------------------------------------------------------------------
      "tournament-ballot": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          // Nothing is user-editable on an EXISTING ballot — a vote is not a field on the ballot, it
          // is a ROW in the `tournament-vote` table (see below). `editableFields` here is consumed only
          // once, at creation time, by this binding's own `creatable` form — not a later edit surface.
          "open":   { "label": "Voting open", "tone": "positive",
            "editableFields": ["candidates", "deadline", "reminderOffset", "notificationsEnabled"],
            "editGuard": { "allowedRoleIds": ["tabletop-organizer"] } },
          "closed": { "label": "Closed", "tone": "info", "isTerminal": true },
          "cancelled": { "label": "Cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "cast-vote",
            "action": "vote",
            "label": "Vote",
            "icon": "how_to_vote",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            // The choice travels WITH the transition. There is no shared scratch field, so two
            // members voting at the same moment cannot overwrite each other. (The old design wrote a
            // shared `pendingChoice` field first and then fired a parameterless transition — a real
            // race: A picks Catan, B picks Azul, A's vote lands as Azul.)
            "inputs": {
              "choice": { "type": "text", "required": true }
            },
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              // Cross-instance eligibility: the actor must appear in `goingFanIds` on the instance
              // named by this ballot's `eventId` field. Real engine guard — a non-RSVP'd persona is
              // genuinely blocked at applyTransition, not merely hidden.
              "relatedInstanceField": "eventId",
              "relatedListField": "goingFanIds"
            },
            "effects": [
              // INSERT one row into the vote table. Atomic; no read-modify-write of a shared list.
              { "op": "createInstance",
                "workflowType": "tournament-vote",
                "fields": {
                  "ballotId": "{id}",
                  "voterFanId": "$actor",
                  "choice": "{input.choice}"
                } }
            ]
          },
          {
            "id": "close-vote",
            "action": "close",
            "label": "Close vote",
            "icon": "how_to_vote_outlined",
            "tone": "primary",
            "from": ["open"],
            "to": "closed",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [
              {
                "op": "branch",
                "if": "isTie",
                "then": [
                  // Real runoff: spawn a NEW ballot carrying only the tied candidates. Its votes are
                  // separate rows (they carry the new ballotId), so the tally starts clean with no
                  // field to reset.
                  // dueAt is deliberately NOT copied — it is now a computed field (see
                  // instanceDataSchema below); the runoff ballot derives its own dueAt fresh from the
                  // deadline/reminderOffset copied here, exactly like every other computed field.
                  { "op": "createInstance",
                    "workflowType": "tournament-ballot",
                    "fields": {
                      "eventId": "{eventId}",
                      "candidates": "{tiedCandidates}",
                      "round": "runoff",
                      "deadline": "{deadline}",
                      "reminderOffset": "{reminderOffset}",
                      "notificationsEnabled": "{notificationsEnabled}"
                    } },
                  { "op": "set", "key": "outcome", "value": "runoff" }
                ],
                "else": [
                  { "op": "set", "key": "outcome", "value": "decided" },
                  // Cross-instance write: push the winner onto the tournament event's selectedGame.
                  { "op": "set", "key": "selectedGame", "value": "{winner}",
                    "relatedInstance": "eventId" }
                ]
              }
            ]
          },
          {
            "id": "cancel-vote",
            "action": "close",
            "label": "Cancel ballot",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["open"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [
              { "op": "set", "key": "outcome", "value": "cancelled" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["open"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "votePoll", "bindingKind": "primary",
            // Per-candidate Vote buttons. The repeater walks `candidates` and, for each one, offers
            // `cast-vote` with that candidate's id supplied as the transition's `choice` input.
            // THIS is what makes "vote for THIS candidate" declarative instead of a Dart convention.
            // Ballot CREATION is not declared here. Grammar v2 owns an action on the archetype whose
            // card hosts it, so "Create ballot for this tournament" is an instance-scoped action on
            // tournament-event's own binding (it renders as a button on the tournament card, supplying
            // {context.id} as this ballot's eventId). This binding only renders and votes on an
            // already-created ballot.
            "repeater": {
              "source": "candidates",
              "itemActions": [
                { "transitionId": "cast-vote", "inputs": { "choice": "{item.id}" } }
              ]
            }
          },
          { "states": ["closed", "cancelled"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "votePoll", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "eventId": { "type": "text", "required": true, "storage": "inline" },

          // Rich candidate objects — tapping one opens its detail popup (name + description).
          // writableBy: "formEntry" added 2026-07-18 -- these four are named in the "open" state's
          // editableFields (this ticket's own creatable-form addition) and the validator's
          // effect_field_in_editable_fields rule correctly requires that pairing. Found and reported,
          // not silently patched, by the CALR.1 implementation agent -- a genuine spec gap in the
          // 2026-07-17 creatable addition, fixed here by the verification agent per the frozen-spec
          // rule ("the verification agent owns any spec correction").
          "candidates": { "type": "list", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayContexts": ["detail"] },
          "round": { "type": "text", "storage": "inline", "labelTemplate": "Round: {value}",
            "hideWhenEmpty": true },

          // Deadline + scheduled reminder. `dueAt` is what the engine's real
          // dueNotifications({asOf}) API reads to decide the reminder is due.
          "deadline": { "type": "date", "writableBy": "formEntry", "storage": "inline", "sortable": true,
            "displayIcon": "schedule", "labelTemplate": "Voting closes: {value}",
            "displayContexts": ["tile", "detail"], "hideWhenEmpty": true },
          "reminderOffset": { "type": "text", "writableBy": "formEntry", "storage": "inline" },
          "notificationsEnabled": { "type": "bool", "writableBy": "formEntry", "storage": "inline" },
          // Computed, not stored — dueAt = deadline minus reminderOffset's real duration. Vocabulary:
          // 'at-time'=0h, 'one-hour'=1h, 'one-day'=24h, 'one-week'=168h (matches the existing seeded
          // vocabulary in part24_form_entry_controls.dart's _reminderOffsets and
          // part15_evidence_catalog.dart's validated set). Replaces a hand-seeded, driftable value with
          // a real formula, same rationale as every other computed field in this file.
          "dueAt": { "type": "date",
            "formula": "subtractHours(deadline, if(reminderOffset == 'one-week', 168, if(reminderOffset == 'one-day', 24, if(reminderOffset == 'one-hour', 1, 0))))" },
          "isExpiringSoon": { "type": "bool", "formula": "isPast(dueAt)" },

          "outcome": { "type": "text", "writableBy": "effect", "storage": "inline" },

          // QUERY-BACKED: the vote rows belonging to this ballot. Not stored on the ballot; read from
          // the `tournament-vote` table on demand. This is what lets a table of rows compose with the
          // formula vocabulary — every formula below is UNCHANGED from the list-field design.
          "ballots": { "type": "list",
            "source": "query(tournament-vote where ballotId == id)" },

          // Computed tally / winner / tie — four one-line formulas replace what used to be bespoke
          // per-community Dart (Book Club hardcoded two candidate names as literal field keys).
          "voteCounts": { "type": "map", "formula": "groupCount(ballots, choice)" },
          "totalVotes": { "type": "number", "formula": "size(ballots)",
            "displayIcon": "how_to_vote", "labelTemplate": "{value} votes cast" },
          "winner": { "type": "text", "formula": "argMaxKey(voteCounts)" },
          "tiedCandidates": { "type": "list", "formula": "topKeys(voteCounts)" },
          "isTie": { "type": "bool", "formula": "size(tiedCandidates) > 1" }
        }
      },

      // -------------------------------------------------------------------------------------------
      // TOURNAMENT VOTE — one ROW per vote. This is a table: workflowType = table, instance = row,
      // instanceDataSchema = columns.
      //
      // Why a row and not an entry in a list field on the ballot:
      //   * ATOMIC. Casting a vote is an INSERT. Two concurrent voters cannot conflict — there is no
      //     shared list to read-modify-write, and no shared scratch field to overwrite.
      //   * DERIVED, never stored. The tally is groupCount over these rows. No counter to increment,
      //     so no counter can drift from the votes it claims to summarise.
      //   * It keeps the facts. voterFanId + choice means a vote can be audited, changed, or limited to
      //     one-per-person. A bare per-option counter throws all of that away.
      //
      // It renders nowhere on its own (no renderBindings) — it exists to be aggregated.
      // -------------------------------------------------------------------------------------------
      "tournament-vote": {
        "initialState": "cast",
        "visibility": { "default": "membersOnly" },
        "states": {
          "cast": { "label": "Vote cast", "tone": "positive", "isTerminal": true }
        },
        "transitions": [],
        "renderBindings": [],
        "instanceDataSchema": {
          "ballotId": { "type": "text",      "required": true, "storage": "inline", "sortable": true },
          "voterFanId":  { "type": "fanId", "required": true, "storage": "inline" },
          "choice":   { "type": "text",      "required": true, "storage": "inline", "sortable": true }
        }
      },

      // -------------------------------------------------------------------------------------------
      // NOTIFICATION — targeted per-persona notifications (CAL.Notify, PROPOSED). Rows are created
      // exclusively via other transitions' effects (e.g. respond-maybe/respond-declined's waitlist-
      // promotion effects above and send-reminder) -- there is no user-facing "create" action for this type.
      // `mark-read` is gated by `actorEqualsField` (guards.md kind 10, PROPOSED) so only the actual
      // recipient can dismiss their own notification -- neither `instanceDataEquals` (fixed literal)
      // nor `actorInList` (list membership) can express "actor must equal this scalar field's value".
      // Rendering deliberately temporary on Calendar, not Home -- see tabletop-club.md/spec-version.json
      // for the full narrative and the Phase B migration note.
      // -------------------------------------------------------------------------------------------
      "notification": {
        "initialState": "unread",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "recipientFanId" } },
          "fields": { "recipient": "recipientFanId" }
        },
        "states": {
          "unread": { "label": "Unread", "tone": "info" },
          "read": { "label": "Read", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "mark-read",
            "label": "Mark read",
            "icon": "done",
            "tone": "secondary",
            "from": ["unread"],
            "to": "read",
            "guard": { "actorEqualsField": { "key": "recipientFanId" } }
          }
        ],
        "renderBindings": [],
        "instanceDataSchema": {
          "recipientFanId": { "type": "fanId", "required": true, "writableBy": "effect", "storage": "inline" },
          "title":     { "type": "text", "required": true, "writableBy": "effect", "storage": "inline" },
          "body":      { "type": "text", "required": true, "writableBy": "effect", "storage": "inline" },
          "createdAt": { "type": "date", "required": true, "writableBy": "effect", "storage": "inline", "sortable": true }
        }
      },

      // -------------------------------------------------------------------------------------------
      // MARKETPLACE — the club game library. Availability (available/onLoan) is orthogonal
      // instanceData, NOT a top-level state (the V2 Marketplace design doc's key finding: an item can
      // be on loan AND have people queued simultaneously, so "queued" was never a real state — that
      // modeling error is exactly what produced the "queued listing has zero available actions" bug).
      //
      // Borrowing requires dues to be paid — a real cross-workflow guard
      // (`requiresWorkflowsComplete`), not an honor system.
      // -------------------------------------------------------------------------------------------
      "equipment-loan": {
        "initialState": "published",
        "visibility": { "default": "membersOnly" },
        "states": {
          "published": { "label": "In library", "tone": "positive",
            "editableFields": ["title", "category", "condition", "description"],
            "editGuard": { "allowedRoleIds": ["tabletop-organizer"] } },
          "delisted": { "label": "Delisted", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "borrow",
            "action": "request",
            "label": "Request loan",
            "icon": "arrow_forward",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member"],
              "instanceDataEquals": { "key": "availabilityState", "value": "available" },
              "requiresWorkflowsComplete": ["tabletop-club-dues-payment"]
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "onLoan" },
              { "op": "set", "key": "holderFanId", "value": "$actor" }
            ]
            // (was linkedWorkflowId: "tabletop-game-loan" — removed 2026-07-15: that type is no longer a
            // throwaway confirmation stub, it is now the real peer game-sharing type. The borrow effects
            // above ARE the action; the linked confirmation surface added nothing.)
          },
          {
            // Allowed whether or not the item is currently out: queue-behind-a-loan (common) and
            // reserve-ahead on a high-demand item that's technically free (also valid).
            "id": "join-queue",
            "action": "join_queue",
            "label": "Join queue",
            "icon": "add_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member"],
              "actorInList": { "key": "queuedFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "queuedFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "leave-queue",
            "action": "leave_queue",
            "label": "Leave queue",
            "icon": "remove_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member"],
              "actorInList": { "key": "queuedFanIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "queuedFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "return",
            "action": "return",
            "label": "Return",
            "icon": "keyboard_return",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            "guard": {
              "instanceDataEquals": { "key": "availabilityState", "value": "onLoan" },
              "actorEqualsField": { "key": "holderFanId" }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "available" },
              { "op": "set", "key": "holderFanId", "value": null },
              { "op": "set", "key": "dueDate", "value": null }
            ]
          },
          {
            "id": "organizer-return",
            "action": "return",
            "label": "Record return",
            "icon": "assignment_return",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-organizer"],
              "instanceDataEquals": { "key": "availabilityState", "value": "onLoan" }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "available" },
              { "op": "set", "key": "holderFanId", "value": null },
              { "op": "set", "key": "dueDate", "value": null }
            ]
          },
          {
            "id": "delist",
            "action": "delist",
            "label": "Delist",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["published"],
            "to": "delisted",
            "guard": {
              "allowedRoleIds": ["tabletop-organizer"],
              "instanceDataEquals": { "key": "availabilityState", "value": "available" },
              "formula": "size(queuedFanIds) == 0"
            }
          }
        ],
        "renderBindings": [
          { "states": ["published"], "audience": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "primary",
            // Transition-FAB pattern (grammar v2, NOT YET APP-SHELL-IMPLEMENTED — see
            // spec-version.json -> proposedNotImplemented.actionsGrammar): "borrow" is already a
            // fully-declared transition with its own guard/effects a few lines up. This entry only
            // changes how it PRESENTS -- pulled out of the automatic button row into its own
            // contextual FAB, since "request a loan" is this card's single primary action, while
            // join-queue/leave-queue/return/delist stay in the row exactly as before. No
            // byRoleIds/workflowType/prefill here: "borrow"'s own guard above remains the sole
            // eligibility check.
            "actions": [
              { "kind": "create", "label": "Add club game", "byRoleIds": ["tabletop-organizer"],
                "scope": "tab", "presentation": "fab",
                "prefill": { "availabilityState": "available", "queuedFanIds": [] } },
              { "kind": "transition", "transitionId": "borrow", "label": "Request loan",
                "presentation": "fab" }
            ] },
          { "states": ["delisted"], "audience": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "maxLength": 80, "writableBy": "formEntry",
            "storage": "inline", "searchable": true, "sortable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "category": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "sortable": true, "displayContexts": ["tile", "detail"] },
          "condition": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "sortable": true, "displayIcon": "verified_outlined", "labelTemplate": "{value}",
            "displayContexts": ["detail"] },
          "description": { "type": "textarea", "maxLength": 500, "writableBy": "formEntry",
            "storage": "inline", "searchable": true, "displayContexts": ["detail"] },
          "availabilityState": { "type": "text", "writableBy": "effect", "storage": "inline",
            "displayContexts": ["tile", "detail"] },
          "holderFanId": { "type": "fanId?", "writableBy": "effect", "storage": "inline",
            "displayIcon": "person_outline", "labelTemplate": "Holder: {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "queuedFanIds": { "type": "fanId[]", "writableBy": "effect", "storage": "inline",
            "displayIcon": "groups_outlined", "labelTemplate": "Queue: {value.length}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "dueDate": { "type": "date?", "writableBy": "effect", "storage": "inline", "sortable": true,
            "displayIcon": "schedule", "labelTemplate": "Due back {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },

          // Computed — "you are #N in the queue", replacing hand-counted queue math.
          "queueLength": { "type": "number", "formula": "size(queuedFanIds)" },
          "isAvailable": { "type": "bool", "formula": "availabilityState == 'available'" }
        }
      },

      "equipment-giveaway": {
        "initialState": "available",
        "visibility": { "default": "membersOnly" },
        "states": {
          "available": { "label": "Free to a good home", "tone": "positive",
            "editableFields": ["title", "category", "condition", "description"],
            "editGuard": { "allowedRoleIds": ["tabletop-organizer"] } },
          "claimed": { "label": "Claimed", "tone": "positive", "isTerminal": true },
          "withdrawn": { "label": "Withdrawn", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "claim",
            "action": "claim",
            "label": "Claim giveaway",
            "icon": "check_circle",
            "tone": "primary",
            "from": ["available"],
            "to": "claimed",
            "guard": { "allowedRoleIds": ["tabletop-member"] },
            "effects": [
              { "op": "set", "key": "claimedByFanId", "value": "$actor" },
              { "op": "removeFromTileGrid" }
            ]
            // (was linkedWorkflowId: "tabletop-game-loan" — removed 2026-07-15, see the borrow note above.)
          },
          {
            "id": "withdraw-giveaway",
            "action": "delist",
            "label": "Withdraw giveaway",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["available"],
            "to": "withdrawn",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] }
          }
        ],
        "renderBindings": [
          { "states": ["available"], "audience": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "Offer club giveaway",
                "byRoleIds": ["tabletop-organizer"], "scope": "tab", "presentation": "fab" }
            ] },
          { "states": ["claimed", "withdrawn"], "audience": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "searchable": true, "sortable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "category": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "sortable": true, "displayContexts": ["tile", "detail"] },
          "condition": { "type": "text", "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "verified_outlined", "labelTemplate": "{value}", "displayContexts": ["detail"] },
          "description": { "type": "textarea", "writableBy": "formEntry", "storage": "inline",
            "searchable": true, "displayContexts": ["detail"] },
          "claimedByFanId": { "type": "fanId?", "writableBy": "effect", "storage": "inline",
            "displayIcon": "person_outline", "labelTemplate": "Claimed by: {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] }
        }
      },

      // -------------------------------------------------------------------------------------------
      // PEER GAME SHARING — a member shares a game they PERSONALLY own with the whole community.
      // Distinct from equipment-loan/equipment-giveaway (the club's OWN collectively-owned library,
      // organizer-managed). Modeled on Book Club's book-shared-library: list/edit/delist your own item,
      // request -> owner approves -> hold + due date, queue behind an active loan, return, renew, report
      // an issue. Product spec: communities/tabletop-club.md §3 ("peer-to-peer game sharing").
      //
      // MODELING (per guide/06-product-doc-to-json.md §3): the lifecycle is ONLY `published -> delisted`
      // (listing visibility). Everything else — availability, current holder, the pending request
      // awaiting the owner, the queue, the due date — is orthogonal DATA on the same `published`
      // instance (`to: null` transitions), because those coexist: a game can be on loan AND have a queue
      // AND have a next-borrower awaiting approval all at once.
      //
      // OWNER-ONLY actions (approve/decline/delist) use a `formula` guard `ownerFanId == $actor` — a
      // real engine guard; formula guards bind $actor (guard_evaluator.dart:39-46). No new grammar.
      //
      // KNOWN GAPS (flagged, never faked):
      // The create action pre-fills ownerFanId from the individual $actor. The remaining expressiveness
      // gap is queue-head promotion on return: the formula/effect grammar has no list-head extraction
      // primitive, so the queued member re-requests and the owner still approves every hand-off.
      // -------------------------------------------------------------------------------------------
      "tabletop-game-loan": {
        "initialState": "published",
        "visibility": { "default": "membersOnly" },
        "states": {
          "published": { "label": "Shared with the club", "tone": "positive",
                         "editableFields": ["title", "category", "condition", "description"],
                         "editGuard": { "actorEqualsField": { "key": "ownerFanId" } } },
          "delisted": { "label": "Delisted", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "request-borrow",
            "action": "request",
            "label": "Request to borrow",
            "icon": "pan_tool_alt",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "instanceDataEquals": { "key": "availabilityState", "value": "available" },
              "requiresWorkflowsComplete": ["tabletop-club-dues-payment"],
              // Any member EXCEPT the owner, and only when no one is already awaiting approval. No `!=`
              // or `!` operator exists, so both conditions are restructured with if().
              "formula": "if(ownerFanId == $actor, false, if(pendingRequestFanId == null, true, false))"
            },
            "effects": [
              { "op": "set", "key": "pendingRequestFanId", "value": "$actor" }
            ]
          },
          {
            "id": "approve-request",
            "action": "decide_request",
            "label": "Approve request",
            "icon": "check_circle",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            // Owner-only: it is THEIR game, so THEY decide who borrows it next — the key difference from
            // the club library's open-access borrow rule.
            "guard": { "actorEqualsField": { "key": "ownerFanId" } },
            "inputs": {
              "dueDate": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "holderFanId", "value": "{pendingRequestFanId}" },
              { "op": "set", "key": "availabilityState", "value": "loaned" },
              { "op": "set", "key": "dueDate", "value": "{input.dueDate}" },
              { "op": "append", "key": "custodyHistory",
                "value": { "holderFanId": "{pendingRequestFanId}", "approvedByFanId": "$actor",
                           "dueDate": "{input.dueDate}", "approvedAt": "$timestamp" } },
              { "op": "set", "key": "pendingRequestFanId", "value": null }
            ]
          },
          {
            "id": "decline-request",
            "action": "decide_request",
            "label": "Decline request",
            "icon": "cancel",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": { "actorEqualsField": { "key": "ownerFanId" } },
            "effects": [
              { "op": "set", "key": "pendingRequestFanId", "value": null }
            ]
          },
          {
            "id": "join-queue",
            "action": "join_queue",
            "label": "Join queue",
            "icon": "add_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            // Allowed whether or not it is currently out (reserve-ahead), like the club library's queue —
            // but never for the owner's own game.
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "actorInList": { "key": "queuedFanIds", "present": false },
              "instanceDataEquals": { "key": "availabilityState", "value": "loaned" },
              "formula": "if(ownerFanId == $actor, false, true)"
            },
            "effects": [
              { "op": "appendUnique", "key": "queuedFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "leave-queue",
            "action": "leave_queue",
            "label": "Leave queue",
            "icon": "remove_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "actorInList": { "key": "queuedFanIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "queuedFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "return-game",
            "action": "return",
            "label": "Return",
            "icon": "keyboard_return",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            // Only the current holder returns it.
            "guard": {
              "instanceDataEquals": { "key": "availabilityState", "value": "loaned" },
              "formula": "holderFanId == $actor"
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "available" },
              { "op": "set", "key": "holderFanId", "value": null },
              { "op": "set", "key": "dueDate", "value": null },
              { "op": "append", "key": "custodyHistory",
                "value": { "returnedByFanId": "$actor", "returnedAt": "$timestamp" } }
              // KNOWN GAP: if the queue is non-empty, promote its head to
              // pendingRequestFanId (every hand-off still goes through the owner). No list-head
              // function exists in the formula vocabulary, so the next borrower re-requests for now.
            ]
          },
          {
            "id": "renew",
            "action": "renew",
            "label": "Renew loan",
            "icon": "update",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            // Holder may renew ONLY when nobody is waiting (product spec §3). A guard allows one `formula`
            // key, so both conditions (holder AND empty queue) are folded into one expression.
            "guard": { "formula": "if(holderFanId == $actor, size(queuedFanIds) == 0, false)" },
            "inputs": {
              "newDueDate": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "dueDate", "value": "{input.newDueDate}" },
              { "op": "set", "key": "renewedAt", "value": "$timestamp" },
              { "op": "append", "key": "custodyHistory",
                "value": { "renewedByFanId": "$actor", "newDueDate": "{input.newDueDate}",
                           "renewedAt": "$timestamp" } }
            ]
          },
          {
            "id": "report-issue",
            "action": "report_issue",
            "label": "Report an issue",
            "icon": "report_problem",
            "tone": "destructive",
            "from": ["published"],
            "to": null,
            // Holder or owner may flag a lost/damaged game; it goes unavailable and is flagged for the
            // owner's attention.
            "guard": { "formula": "if(holderFanId == $actor, true, ownerFanId == $actor)" },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "reported" },
              { "op": "set", "key": "issueReported", "value": true },
              { "op": "append", "key": "custodyHistory",
                "value": { "reportedByFanId": "$actor", "reportedAt": "$timestamp" } }
            ]
          },
          {
            "id": "delist",
            "action": "delist",
            "label": "Delist my game",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["published"],
            "to": "delisted",
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": { "key": "availabilityState", "value": "available" },
              "formula": "pendingRequestFanId == null"
            }
          }
        ],
        "renderBindings": [
          { "states": ["published"], "audience": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "primary",
            // Any member can share a game they own; ownerFanId is prefilled from $actor.
            "actions": [
              { "kind": "create", "label": "Share a game",
                "byRoleIds": ["tabletop-member", "tabletop-organizer"],
                "scope": "tab", "presentation": "fab",
                "prefill": { "ownerFanId": "$actor", "availabilityState": "available",
                             "queuedFanIds": [], "issueReported": false,
                             "custodyHistory": [] } }
            ] },
          { "states": ["delisted"], "audience": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "maxLength": 80, "writableBy": "formEntry",
            "storage": "inline", "searchable": true, "sortable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "category": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "sortable": true, "displayContexts": ["tile", "detail"] },
          "condition": { "type": "text", "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "verified_outlined", "labelTemplate": "{value}", "displayContexts": ["detail"] },
          "description": { "type": "textarea", "maxLength": 500, "writableBy": "formEntry",
            "storage": "inline", "searchable": true, "displayContexts": ["detail"] },
          // The distinguishing field vs. the club library: WHICH member personally owns this listing.
          "ownerFanId": { "type": "fanId", "required": true, "writableBy": "effect",
            "storage": "inline", "displayIcon": "person", "labelTemplate": "Shared by {value}",
            "displayContexts": ["tile", "detail"] },
          "availabilityState": { "type": "text", "writableBy": "effect", "storage": "inline",
            "displayContexts": ["tile", "detail"] },
          "holderFanId": { "type": "fanId?", "writableBy": "effect", "storage": "inline",
            "displayIcon": "person_outline", "labelTemplate": "With {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "pendingRequestFanId": { "type": "fanId?", "writableBy": "effect", "storage": "inline",
            "displayIcon": "pan_tool_alt", "labelTemplate": "Awaiting approval: {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "queuedFanIds": { "type": "fanId[]", "writableBy": "effect", "storage": "inline",
            "displayIcon": "groups_outlined", "labelTemplate": "Queue: {value.length}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "dueDate": { "type": "date?", "writableBy": "effect", "storage": "inline", "sortable": true,
            "displayIcon": "schedule", "labelTemplate": "Due back {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "renewedAt": { "type": "date?", "writableBy": "effect", "storage": "inline",
            "hideWhenEmpty": true },
          "issueReported": { "type": "bool", "writableBy": "effect", "storage": "inline" },
          "custodyHistory": { "type": "list", "writableBy": "effect", "storage": "inline",
            "displayIcon": "history", "labelTemplate": "{value.length} custody events",
            "hideWhenEmpty": true, "displayContexts": ["detail"] },

          // Computed — derived on read, never stored, never seeded.
          "queueLength": { "type": "number", "formula": "size(queuedFanIds)" },
          "isAvailable": { "type": "bool", "formula": "availabilityState == 'available'" }
        }
      },

      // -------------------------------------------------------------------------------------------
      // GIVING — quarterly dues. `borrow` above genuinely depends on this being complete.
      // -------------------------------------------------------------------------------------------
      "tabletop-club-dues-payment": {
        "initialState": "unpaid",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "payerFanId" } },
          "fields": { "parties": ["payerFanId", { "role": "tabletop-organizer" }] }
        },
        "states": {
          "unpaid": { "label": "Unpaid", "tone": "warning",
            "editableFields": ["payerFanId", "amountLabel", "purpose", "recipient", "cadence", "entitlement"],
            "editGuard": { "allowedRoleIds": ["tabletop-organizer"] } },
          "paid": { "label": "Paid", "tone": "positive", "isTerminal": true },
          "waived": { "label": "Waived or cancelled", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "pay",
            "label": "Pay $15",
            "icon": "payments_outlined",
            "tone": "primary",
            "from": ["unpaid"],
            "to": "paid",
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "actorEqualsField": { "key": "payerFanId" }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "complete" },
              { "op": "set", "key": "paidAt", "value": "$timestamp" }
              // PLATFORM GAP: a real generated receipt id. Payment
              // processing + ID generation are the two opaque platform services named in
              // ComputationModel.md §8 — they cannot be field math, so they stay engine-provided and
              // demo-stubbed (canned success + generated id). Today `receiptId` would be hardcoded,
              // which is exactly the anti-pattern the audit flagged, so it is deliberately absent
              // rather than faked.
            ]
          },
          {
            "id": "cancel-dues-charge",
            "label": "Waive or cancel charge",
            "icon": "money_off",
            "tone": "destructive",
            "from": ["unpaid"],
            "to": "waived",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "waived" }
            ]
          }
        ],
        "renderBindings": [
          { "states": ["unpaid"], "audience": "any", "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout", "bindingKind": "primary" },
          { "states": ["paid", "waived"], "audience": "any", "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout", "bindingKind": "summary" },
          { "states": ["unpaid", "paid", "waived"], "audience": "any", "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline", "bindingKind": "summary",
            "actions": [
              { "kind": "create", "label": "New dues charge",
                "byRoleIds": ["tabletop-organizer"], "scope": "tab", "presentation": "fab",
                "prefill": { "receiptStatus": "" } }
            ] }
        ],
        "instanceDataSchema": {
          "payerFanId": { "type": "fanId", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "person_outline", "labelTemplate": "Payer: {value}",
            "displayContexts": ["detail"] },
          "amountLabel": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "payments_outlined", "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "purpose": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "receipt_long", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "recipient": { "type": "text", "writableBy": "formEntry", "storage": "inline", "displayIcon": "account_balance_outlined",
            "labelTemplate": "Recipient: {value}", "displayContexts": ["detail"] },
          "cadence": { "type": "text", "writableBy": "formEntry", "storage": "inline", "displayIcon": "repeat",
            "labelTemplate": "{value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "entitlement": { "type": "text", "writableBy": "formEntry", "storage": "inline", "displayIcon": "verified_outlined",
            "labelTemplate": "{value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "receiptStatus": { "type": "text", "writableBy": "effect", "storage": "inline" },
          // NEEDS IMPLEMENTATION (platform service): real receipt-id generation. Declared for the
          // payment surface, never seeded and never written by a JSON effect.
          "receiptId": { "type": "text?", "writableBy": "effect", "storage": "inline",
            "displayIcon": "confirmation_number", "labelTemplate": "Receipt: {value}",
            "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "paidAt": { "type": "date?", "writableBy": "effect", "storage": "inline",
            "displayIcon": "schedule", "labelTemplate": "Paid {value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] }
        }
      },

      // -------------------------------------------------------------------------------------------
      // NOTE: a standalone "collaborative table" (user-created, dynamic columns) was drafted and then
      // deliberately DROPPED from this specification's scope (2026-07-14) — the "define your own
      // columns at runtime" affordance was judged not worth the complexity for this milestone. The
      // underlying grammar additions that made it possible (`inputs`/`{input.x}` on transitions,
      // `renderBindings[].creatable`, `instanceDataSchema[].source` query-backed fields) are NOT
      // dropped — they are still required by tournament-ballot below (votes-as-rows) and by
      // game-purchase-proposal/discussion-thread (creatable). Only the free-form user-defined-schema
      // table feature itself is out of scope. See Loom_Communities_Workflow_Engine_3_LanguageGaps.md.
      // -------------------------------------------------------------------------------------------

      // -------------------------------------------------------------------------------------------
      // GAME PURCHASE PROPOSALS — replaces the old scripted "tabletop-committee-decision" card.
      // A member really writes a proposal, really submits it, the organizer really sees every pending
      // one in a live queue and really decides, and the member really sees the outcome on THEIR OWN
      // proposal (not a hardcoded "Wingspan" string). Rejected/changes-requested loops back.
      //
      // Creation of a NEW proposal is declared on the `draft` render binding below (`creatable`) —
      // the member gets a real "+ Propose a game" affordance rather than being limited to editing one
      // pre-seeded draft.
      // -------------------------------------------------------------------------------------------
      "game-purchase-proposal": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "allowedRoleIds": ["tabletop-organizer"] },
          "fields": { "parties": ["proposedByFanId", { "role": "tabletop-organizer" }] }
        },
        "states": {
          "draft": {
            "label": "Draft",
            "editableFields": ["gameName", "reason"],
            "editGuard": { "actorEqualsField": { "key": "proposedByFanId" } }
          },
          "pending": { "label": "Awaiting decision", "tone": "info" },
          "changes-requested": {
            "label": "Changes requested",
            "tone": "warning",
            "editableFields": ["gameName", "reason"],
            "editGuard": { "actorEqualsField": { "key": "proposedByFanId" } }
          },
          "approved": { "label": "Approved", "tone": "positive", "isTerminal": true },
          "rejected": { "label": "Rejected", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "submit",
            "label": "Submit proposal",
            "icon": "send",
            "tone": "primary",
            "from": ["draft", "changes-requested"],
            "to": "pending",
            "guard": {
              "allowedRoleIds": ["tabletop-member"],
              "actorEqualsField": { "key": "proposedByFanId" }
            },
            "effects": [
              { "op": "set", "key": "proposedByFanId", "value": "$actor" },
              { "op": "set", "key": "submittedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "approve",
            "label": "Approve",
            "icon": "check_circle",
            "tone": "primary",
            "from": ["pending"],
            "to": "approved",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [
              { "op": "set", "key": "decidedByFanId", "value": "$actor" },
              { "op": "set", "key": "decidedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "request-changes",
            "label": "Request changes",
            "icon": "undo",
            "tone": "secondary",
            "from": ["pending"],
            "to": "changes-requested",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [
              { "op": "set", "key": "decidedByFanId", "value": "$actor" }
            ]
          },
          {
            "id": "reject",
            "label": "Reject",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["pending"],
            "to": "rejected",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [
              { "op": "set", "key": "decidedByFanId", "value": "$actor" },
              { "op": "set", "key": "decidedAt", "value": "$timestamp" }
            ]
          }
        ],
        "renderBindings": [
          // Member composes / revises on Home. A tab-scoped create action gives a real "+ Propose a
          // game" affordance — a member may author as many proposals as they like, not just edit one
          // pre-seeded draft.
          { "states": ["draft", "changes-requested"], "audience": "actor", "tabId": "home",
            "cardSurfaceFamily": "formEntry", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "Propose a game", "byRoleIds": ["tabletop-member"],
                "scope": "tab", "presentation": "fab",
                "prefill": { "proposedByFanId": "$actor" } }
            ] },
          // Member watches their own submitted proposal's real status.
          { "states": ["pending", "approved", "rejected"], "audience": "actor", "tabId": "home",
            "cardSurfaceFamily": "statusTimeline", "bindingKind": "summary" },
          // Organizer's live pending queue — a Repeater bound to queryInstances(state == pending), so a
          // newly submitted proposal simply appears. This is the real "decision" surface.
          { "states": ["pending"], "audience": "receiver", "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem", "bindingKind": "primary" },
          { "states": ["changes-requested", "approved", "rejected"], "audience": "any", "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "gameName": { "type": "text", "required": true, "maxLength": 80, "writableBy": "formEntry",
            "storage": "inline", "searchable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "reason": { "type": "textarea", "required": true, "maxLength": 500, "writableBy": "formEntry",
            "storage": "inline", "displayContexts": ["detail"] },
          "proposedByFanId": { "type": "fanId", "required": true, "writableBy": "effect", "storage": "inline",
            "displayIcon": "person_outline", "labelTemplate": "Proposed by {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "submittedAt": { "type": "date?", "writableBy": "effect", "storage": "inline", "sortable": true,
            "displayIcon": "schedule", "labelTemplate": "Submitted {value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },
          "decidedByFanId": { "type": "fanId?", "writableBy": "effect", "storage": "inline",
            "displayIcon": "gavel", "labelTemplate": "Decided by {value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },
          "decidedAt": { "type": "date?", "writableBy": "effect", "storage": "inline",
            "hideWhenEmpty": true }
        }
      },

      // -------------------------------------------------------------------------------------------
      // ANNOUNCEMENTS — organizer publishes; members read on Home.
      // -------------------------------------------------------------------------------------------
      "tabletop-meetup-announcement": {
        "initialState": "draft",
        "visibility": { "default": "membersOnly" },
        "states": {
          "draft": { "label": "Draft", "editableFields": ["title", "body"],
            "editGuard": { "allowedRoleIds": ["tabletop-organizer"] } },
          "published": { "label": "Published", "tone": "positive", "isTerminal": true },
          "withdrawn": { "label": "Withdrawn", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "publish",
            "label": "Publish announcement",
            "icon": "campaign",
            "tone": "primary",
            "from": ["draft"],
            "to": "published",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] },
            "effects": [
              { "op": "set", "key": "publishedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "withdraw-announcement",
            "label": "Discard announcement",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["draft"],
            "to": "withdrawn",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] }
          }
        ],
        "renderBindings": [
          { "states": ["draft"], "audience": "actor", "tabId": "admin",
            "cardSurfaceFamily": "formEntry", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "New announcement",
                "byRoleIds": ["tabletop-organizer"], "scope": "tab", "presentation": "fab" }
            ] },
          { "states": ["published"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "notificationInbox", "bindingKind": "summary" },
          { "states": ["withdrawn"], "audience": "actor", "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "body": { "type": "textarea", "required": true, "maxLength": 500, "writableBy": "formEntry",
            "storage": "inline", "displayContexts": ["detail"] },
          "publishedAt": { "type": "date?", "writableBy": "effect", "storage": "inline",
            "displayIcon": "schedule", "labelTemplate": "Published {value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] }
        }
      },

      // -------------------------------------------------------------------------------------------
      // MESSAGES — the App Shell's fixed, always-present tab (structurally guaranteed for every
      // community; the label is renameable but the tab cannot be removed). Threads are real engine
      // instances; posting a message is a real transition appending to a real list.
      //
      // "Start a new thread" is declared on the render binding below (`creatable`) — the reported
      // missing action.
      //
      // sendInvite/acceptInvite/declineInvite + an 'invite pending' state are named in the tab's
      // renderer contract (part11_shell_models.dart:911-951) but have never existed. They remain an
      // explicitly deferred, named gap — not silently dropped.
      // -------------------------------------------------------------------------------------------
      "discussion-thread": {
        "initialState": "open",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorInList": { "key": "participantFanIds", "present": true } },
          "fields": { "participants": ["participantFanIds"] }
        },
        "states": {
          // These are what the `creatable` form collects when a member starts a new thread. Without
          // them, a created thread would have no subject — and `subject` is required.
          "open": { "label": "Open", "tone": "positive",
                    "editableFields": ["subject", "participantFanIds"],
                    "editGuard": { "actorEqualsField": { "key": "threadOwnerFanId" } } },
          "archived": { "label": "Archived", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "post-message",
            "label": "Post message",
            "icon": "send",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "actorInList": { "key": "participantFanIds", "present": true }
            },
            // The body travels WITH the transition. The old design wrote a shared `pendingMessage`
            // field on the thread and then fired a parameterless transition — two members typing at
            // once and one posts the other's text.
            "inputs": { "body": { "type": "text", "required": true } },
            "effects": [
              { "op": "append", "key": "messages",
                "value": { "senderFanId": "$actor", "body": "{input.body}", "timestamp": "$timestamp" } },
              { "op": "set", "key": "unread", "value": true }
            ]
          },
          {
            "id": "mark-read",
            "label": "Mark read",
            "icon": "mark_email_read",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["tabletop-member", "tabletop-organizer"],
              "actorInList": { "key": "participantFanIds", "present": true }
            },
            "effects": [
              { "op": "set", "key": "unread", "value": false }
            ]
          },
          {
            "id": "archive",
            "label": "Archive",
            "icon": "archive",
            "tone": "secondary",
            "from": ["open"],
            "to": "archived",
            "guard": { "actorEqualsField": { "key": "threadOwnerFanId" } }
          },
          {
            "id": "organizer-archive",
            "label": "Archive as organizer",
            "icon": "admin_panel_settings",
            "tone": "destructive",
            "from": ["open"],
            "to": "archived",
            "guard": { "allowedRoleIds": ["tabletop-organizer"] }
          }
        ],
        "renderBindings": [
          // A tab-scoped create action is the reported-missing "start a new thread" affordance.
          { "states": ["open"], "audience": "any", "tabId": "messages",
            "cardSurfaceFamily": "discussionThread", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "New thread",
                "byRoleIds": ["tabletop-member", "tabletop-organizer"],
                "scope": "tab", "presentation": "fab",
                "prefill": { "threadOwnerFanId": "$actor", "participantFanIds": ["$actor"],
                             "messages": [], "unread": false } }
            ] },
          { "states": ["archived"], "audience": "any", "tabId": "messages",
            "cardSurfaceFamily": "discussionThread", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "subject": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "threadOwnerFanId": { "type": "fanId", "required": true, "writableBy": "effect",
            "storage": "inline", "displayIcon": "person_outline",
            "labelTemplate": "Started by {value}", "displayContexts": ["detail"] },
          // formEntry so the `creatable` form can collect it (an audienceSelector-style member picker)
          // when a member starts a new thread.
          "participantFanIds": { "type": "fanId[]", "writableBy": "formEntry",
            "storage": "inline",
            "displayIcon": "groups_outlined", "labelTemplate": "{value.length} participants",
            "displayContexts": ["detail"] },
          "messages": { "type": "list", "writableBy": "effect", "storage": "inline",
            "displayContexts": ["detail"] },
          // KNOWN LIMITATION (GAP-3): a single bool for the whole thread, so the sender's own post
          // marks it unread for the sender too. Per-persona unread needs "every participant except
          // the actor", which no effect op can express. Deliberately not faked.
          "unread": { "type": "bool", "writableBy": "effect", "storage": "inline" },
          "messageCount": { "type": "number", "formula": "size(messages)",
            "displayIcon": "forum", "labelTemplate": "{value}", "displayContexts": ["tile"] }
        }
      }
    },

    // =============================================================================================
    // WORKFLOW INSTANCES — the actual DATA (like objects). One entry per real card in the app.
    // =============================================================================================
    "workflowInstances": [

      // ---- Calendar: Friday game night ----------------------------------------------------------
      {
        "instanceId": "event-friday-game-night",
        "workflowType": "event-rsvp",
        "currentState": "open",
        "createdByFanId": "tabletop-organizer",
        "instanceData": {
          "title": "Friday game night",
          "eventDate": "2026-07-10",
          "eventTime": "19:00",
          "location": "Community room",
          "host": "Alex Chen (Organizer)",
          "capacity": 20,
          "category": "social"
          // Response state (going/maybe/declined/waitlisted/pending) lives entirely in the
          // event-rsvp-response rows below, one per real seeded account — not on this instance.
        }
      },

      // ---- event-rsvp-response rows for Friday game night ------------------------------------
      // One row per real seeded account (tabletop-organizer + tabletop-member-03..14, per
      // part30_local_auth_api.dart's _seedTabletopAccounts) — bulk-created the moment the event
      // above was created, mirroring what CAL.1/CAL.3's real createInstances flow will do going
      // forward. States preserve the exact same scenario the old goingFanIds/maybePersonaIds
      // response lists encoded: 11 members going, the organizer maybe, member-14 never having responded.
      { "instanceId": "resp-friday-organizer", "workflowType": "event-rsvp-response",
        "currentState": "maybe", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-organizer", "partySize": 1 } },
      { "instanceId": "resp-friday-member-03", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-03", "partySize": 1 } },
      { "instanceId": "resp-friday-member-04", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-04", "partySize": 1 } },
      { "instanceId": "resp-friday-member-05", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-05", "partySize": 1 } },
      { "instanceId": "resp-friday-member-06", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-06", "partySize": 1 } },
      { "instanceId": "resp-friday-member-07", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-07", "partySize": 1 } },
      { "instanceId": "resp-friday-member-08", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-08", "partySize": 1 } },
      { "instanceId": "resp-friday-member-09", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-09", "partySize": 1 } },
      { "instanceId": "resp-friday-member-10", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-10", "partySize": 1 } },
      { "instanceId": "resp-friday-member-11", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-11", "partySize": 1 } },
      { "instanceId": "resp-friday-member-12", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-12", "partySize": 1 } },
      { "instanceId": "resp-friday-member-13", "workflowType": "event-rsvp-response",
        "currentState": "going", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-13", "partySize": 1 } },
      { "instanceId": "resp-friday-member-14", "workflowType": "event-rsvp-response",
        "currentState": "pending", "createdByFanId": "tabletop-organizer",
        "instanceData": { "eventId": "event-friday-game-night", "fanId": "tabletop-member-14", "partySize": 1 } },

      // ---- Calendar + Home: the summer tournament (drives ballot eligibility) --------------------
      {
        "instanceId": "event-summer-tournament",
        "workflowType": "tournament-event",
        "currentState": "open",
        "createdByFanId": "tabletop-organizer",
        "instanceData": {
          "title": "Summer tournament",
          "eventDate": "2026-07-10",
          "eventTime": "13:00",
          "location": "Main hall",
          "host": "Priya Nair (Tournament Lead)",
          "minimumAttendance": 8,
          // These are the personas the ballot's cross-instance guard will actually check.
          "goingFanIds": [
            "tabletop-member", "tabletop-member-03", "tabletop-member-04",
            "tabletop-member-05", "tabletop-member-06", "tabletop-member-07",
            "tabletop-member-08", "tabletop-member-09"
          ],
          // "TBD" until the ballot closes and writes the winner here via a cross-instance set effect.
          "selectedGame": "TBD"
        }
      },

      // ---- Home: the tournament ballot ----------------------------------------------------------
      {
        "instanceId": "ballot-summer-tournament",
        "workflowType": "tournament-ballot",
        "currentState": "open",
        "createdByFanId": "tabletop-organizer",
        "instanceData": {
          "eventId": "event-summer-tournament",
          "round": "initial",
          "candidates": [
            { "id": "catan", "name": "Catan",
              "description": "Classic trading and building game for 3-4 players." },
            { "id": "azul", "name": "Azul",
              "description": "Tile-drafting game with beautiful Portuguese-tile aesthetics." },
            { "id": "wingspan", "name": "Wingspan",
              "description": "Engine-building card game about birds, for 1-5 players." }
          ],
          // Deliberately chosen so BOTH conditions hold on a 2026-07-14 walkthrough:
          //   deadline is still in the FUTURE  -> the ballot is legitimately open
          //   dueAt has already PASSED         -> the "closing soon" reminder is genuinely due
          // dueAt is now COMPUTED (deadline minus reminderOffset's real duration) -- not seeded here.
          // one-week = 168h, so dueAt evaluates to 2026-07-13T18:00:00.000Z, unchanged from before.
          "deadline": "2026-07-20T18:00:00.000Z",
          "reminderOffset": "one-week",
          "notificationsEnabled": true,
          "outcome": ""
          // NOTE: no `ballots` here. It is a QUERY-BACKED field (source: query(tournament-vote ...)),
          // so it is derived, never stored — and seeding it would be an error. The votes live as rows
          // in the `tournament-vote` table below.
        }
      },

      // ---- The vote rows. One row per vote: this is the table. -----------------------------------
      // Tally: catan 2, wingspan 1, azul 1 -> winner = catan, no tie. An organizer can force a tie
      // (and therefore a real runoff) live, by voting for wingspan or azul.
      {
        "instanceId": "vote-m03-catan", "workflowType": "tournament-vote", "currentState": "cast",
        // createdByFanId is the gated ROLE that created this record (matches how guards actually
        // authenticate: allowedRoleIds does a literal string match against the acting persona, and
        // this app only ever runs as one of the two declared roles). The specific walk-on member is
        // carried by `voterFanId` below, which is display/tally data, not a gate-checked identity.
        "createdByFanId": "tabletop-member",
        "instanceData": { "ballotId": "ballot-summer-tournament",
                          "voterFanId": "tabletop-member-03", "choice": "catan" }
      },
      {
        "instanceId": "vote-m04-wingspan", "workflowType": "tournament-vote", "currentState": "cast",
        "createdByFanId": "tabletop-member",
        "instanceData": { "ballotId": "ballot-summer-tournament",
                          "voterFanId": "tabletop-member-04", "choice": "wingspan" }
      },
      {
        "instanceId": "vote-m05-catan", "workflowType": "tournament-vote", "currentState": "cast",
        "createdByFanId": "tabletop-member",
        "instanceData": { "ballotId": "ballot-summer-tournament",
                          "voterFanId": "tabletop-member-05", "choice": "catan" }
      },
      {
        "instanceId": "vote-m06-azul", "workflowType": "tournament-vote", "currentState": "cast",
        "createdByFanId": "tabletop-member",
        "instanceData": { "ballotId": "ballot-summer-tournament",
                          "voterFanId": "tabletop-member-06", "choice": "azul" }
      },

