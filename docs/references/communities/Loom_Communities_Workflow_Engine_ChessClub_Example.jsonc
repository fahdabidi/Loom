{
  "schemaVersion": 1,
  "packageId": "init_chess_club_1",
  "communityId": "community_chess_club",
  "communityHandle": "chess-club",
  "displayName": "Chess Club",
  "extensionId": "ext_chess_club",
  "branding": { "accentColor": "#355C3A" },
  "seedDataFiles": [],
  "idempotencyKey": "chess-club-community-json-v2-2026-08-11",

  "experience": {
    "experienceSchemaVersion": 2,
    "workflowGrammarVersion": 1,
    "displayName": "Chess Club",
    "tagline": "Schedule matches, share results, run club nights, and follow the local ladder.",
    "accentColor": "#355C3A",

    "personas": [
      {
        "personaId": "chess-organizer",
        "label": "Organizer",
        "roleLabel": "Organizer",
        "description": "Schedules club activity, assigns pairings, resolves results, publishes rankings, and manages exports and rules."
      },
      {
        "personaId": "chess-member",
        "label": "Player",
        "roleLabel": "Member",
        "description": "Schedules and plays matches, records results, joins discussions, and follows club activity."
      }
    ],

    "workflowDefinitions": {
      "chess-match-meetup": {
        "initialState": "proposed",
        "visibility": { "default": "membersOnly" },
        "states": {
          "proposed": {
            "label": "Match proposed",
            "tone": "info",
            "editableFields": [
              "matchTitle",
              "proposerName",
              "opponentName",
              "eventDate",
              "eventTime",
              "expiresAt",
              "location",
              "boardLabel",
              "roundLabel"
            ],
            "editGuard": { "allowedPersonaIds": ["chess-member"] }
          },
          "accepted": { "label": "Match accepted", "tone": "positive" },
          "declined": { "label": "Match declined", "tone": "negative" },
          "rescheduled": { "label": "New time proposed", "tone": "warning" },
          "completed": { "label": "Match completed", "tone": "positive", "isTerminal": true },
          "cancelled": { "label": "Meetup cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "accept-match",
            "label": "Accept match",
            "icon": "check_circle",
            "tone": "primary",
            "from": ["proposed", "declined", "rescheduled"],
            "to": "accepted",
            "guard": {
              "allowedPersonaIds": ["chess-member"],
              "formula": "isBefore(now(), expiresAt)",
              "locationOverlap": {
                "locationField": "boardLabel",
                "dateField": "eventDate",
                "timeField": "eventTime",
                "durationMinutes": 90
              }
            },
            "effects": [
              { "op": "set", "key": "acceptedAt", "value": "$timestamp" },
              { "op": "append", "key": "matchHistory", "value": { "action": "accepted", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "decline-match",
            "label": "Decline",
            "icon": "cancel",
            "tone": "secondary",
            "from": ["proposed", "rescheduled"],
            "to": "declined",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "effects": [
              { "op": "set", "key": "declinedAt", "value": "$timestamp" },
              { "op": "append", "key": "matchHistory", "value": { "action": "declined", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "reschedule-match",
            "label": "Reschedule",
            "icon": "edit_calendar",
            "tone": "secondary",
            "from": ["proposed", "accepted", "declined", "rescheduled"],
            "to": "rescheduled",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "inputs": {
              "eventDate": { "type": "text", "required": true },
              "eventTime": { "type": "text", "required": true },
              "expiresAt": { "type": "text", "required": true },
              "location": { "type": "text", "required": true },
              "boardLabel": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "eventDate", "value": "{input.eventDate}" },
              { "op": "set", "key": "eventTime", "value": "{input.eventTime}" },
              { "op": "set", "key": "expiresAt", "value": "{input.expiresAt}" },
              { "op": "set", "key": "location", "value": "{input.location}" },
              { "op": "set", "key": "boardLabel", "value": "{input.boardLabel}" },
              { "op": "set", "key": "rescheduledAt", "value": "$timestamp" },
              { "op": "append", "key": "matchHistory", "value": { "action": "rescheduled", "actorPersonaId": "$actor", "at": "$timestamp", "eventDate": "{input.eventDate}", "eventTime": "{input.eventTime}" } }
            ]
          },
          {
            "id": "suggest-new-time",
            "label": "Suggest new time",
            "icon": "schedule_send",
            "tone": "secondary",
            "from": ["proposed", "declined", "rescheduled"],
            "to": "rescheduled",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "inputs": {
              "eventDate": { "type": "text", "required": true },
              "eventTime": { "type": "text", "required": true },
              "expiresAt": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "eventDate", "value": "{input.eventDate}" },
              { "op": "set", "key": "eventTime", "value": "{input.eventTime}" },
              { "op": "set", "key": "expiresAt", "value": "{input.expiresAt}" },
              { "op": "set", "key": "rescheduledAt", "value": "$timestamp" },
              { "op": "append", "key": "matchHistory", "value": { "action": "new-time-suggested", "actorPersonaId": "$actor", "at": "$timestamp", "eventDate": "{input.eventDate}", "eventTime": "{input.eventTime}" } }
            ]
          },
          {
            "id": "add-reminder",
            "label": "Add reminder",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": ["proposed", "accepted", "rescheduled"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["chess-member", "chess-organizer"],
              "instanceDataEquals": { "key": "reminderState", "value": "not-added" }
            },
            "effects": [
              { "op": "set", "key": "reminderState", "value": "added" },
              { "op": "set", "key": "reminderAddedAt", "value": "$timestamp" },
              { "op": "append", "key": "matchHistory", "value": { "action": "reminder-added", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "record-result",
            "label": "Record result",
            "icon": "scoreboard",
            "tone": "primary",
            "from": ["accepted"],
            "to": "completed",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "inputs": {
              "score": { "type": "text", "required": true },
              "outcome": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "completedAt", "value": "$timestamp" },
              { "op": "append", "key": "matchHistory", "value": { "action": "result-recorded", "actorPersonaId": "$actor", "at": "$timestamp", "score": "{input.score}", "outcome": "{input.outcome}" } },
              {
                "op": "createInstance",
                "workflowType": "chess-match-result",
                "fields": {
                  "resultTitle": "{matchTitle}",
                  "playerOneName": "{proposerName}",
                  "playerTwoName": "{opponentName}",
                  "roundLabel": "{roundLabel}",
                  "score": "{input.score}",
                  "outcome": "{input.outcome}",
                  "statusMessage": "Draft result created from accepted meetup",
                  "resultHistory": [
                    { "action": "recorded-from-meetup", "actorPersonaId": "$actor", "at": "$timestamp", "score": "{input.score}", "outcome": "{input.outcome}" }
                  ]
                }
              }
            ]
          },
          {
            "id": "cancel-meetup",
            "label": "Cancel meetup",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["proposed", "accepted", "declined", "rescheduled"],
            "to": "cancelled",
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "effects": [
              { "op": "set", "key": "cancelledAt", "value": "$timestamp" },
              { "op": "append", "key": "matchHistory", "value": { "action": "cancelled", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["proposed", "accepted", "declined", "rescheduled"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Propose match",
                "byPersonaIds": ["chess-member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "proposedByPersonaId": "$actor",
                  "proposedAt": "$timestamp",
                  "reminderState": "not-added",
                  "matchHistory": []
                }
              }
            ]
          },
          {
            "states": ["completed", "cancelled"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          },
          {
            "states": ["proposed", "accepted", "rescheduled"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "matchTitle": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "proposerName": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "person_outline", "labelTemplate": "Challenger: {value}", "displayContexts": ["tile", "detail"] },
          "opponentName": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "person_search", "labelTemplate": "Opponent: {value}", "displayContexts": ["tile", "detail"] },
          "eventDate": { "type": "date", "required": true, "writableBy": "formEntry", "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "eventTime": { "type": "time", "required": true, "writableBy": "formEntry", "displayIcon": "schedule", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "expiresAt": { "type": "date", "required": true, "writableBy": "formEntry", "displayIcon": "hourglass_bottom", "labelTemplate": "Respond by {value}", "displayContexts": ["detail"] },
          "location": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "location_on_outlined", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "boardLabel": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "grid_on", "labelTemplate": "Board {value}", "displayContexts": ["tile", "detail"] },
          "roundLabel": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "format_list_numbered", "labelTemplate": "{value}", "displayContexts": ["detail"] },
          "proposedByPersonaId": { "type": "personaId", "required": true, "writableBy": "effect", "displayIcon": "badge", "labelTemplate": "Proposed by {value}", "displayContexts": ["detail"] },
          "proposedAt": { "type": "date", "required": true, "writableBy": "effect", "displayIcon": "send_time_extension", "labelTemplate": "Proposed {value}", "displayContexts": ["detail"] },
          "reminderState": { "type": "text", "required": true, "writableBy": "effect", "displayIcon": "notifications", "labelTemplate": "Reminder: {value}", "displayContexts": ["tile", "detail"] },
          "reminderAddedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "notifications_active", "labelTemplate": "Reminder added {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "acceptedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "event_available", "labelTemplate": "Accepted {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "declinedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "event_busy", "labelTemplate": "Declined {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "rescheduledAt": { "type": "date?", "writableBy": "effect", "displayIcon": "update", "labelTemplate": "Rescheduled {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "completedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "sports_score", "labelTemplate": "Completed {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "cancelledAt": { "type": "date?", "writableBy": "effect", "displayIcon": "cancel_schedule_send", "labelTemplate": "Cancelled {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "matchHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "History: {value.length}", "displayContexts": ["detail"] },
          "dueAt": { "type": "date?", "formula": "if(reminderState == 'added', subtractHours(combineDateAndTime(eventDate, eventTime), 24), null)", "displayIcon": "alarm", "labelTemplate": "Reminder due {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] }
        }
      },

      "chess-match-result": {
        "initialState": "draft",
        "visibility": { "default": "membersOnly" },
        "states": {
          "draft": {
            "label": "Draft result",
            "tone": "info",
            "editableFields": ["resultTitle", "playerOneName", "playerTwoName", "roundLabel", "score", "outcome"],
            "editGuard": { "allowedPersonaIds": ["chess-member"] }
          },
          "submitted": { "label": "Result submitted", "tone": "info" },
          "correction-requested": {
            "label": "Correction requested",
            "tone": "warning",
            "editableFields": ["score", "outcome", "correctionNote"],
            "editGuard": { "allowedPersonaIds": ["chess-member"] }
          },
          "disputed": { "label": "Result disputed", "tone": "negative" },
          "final": { "label": "Saved result", "tone": "positive" },
          "undone": {
            "label": "Result undone",
            "tone": "warning",
            "editableFields": ["score", "outcome", "correctionNote"],
            "editGuard": { "allowedPersonaIds": ["chess-member"] }
          },
          "voided": { "label": "Result voided", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "submit-score",
            "label": "Submit score",
            "icon": "send",
            "tone": "primary",
            "from": ["draft"],
            "to": "submitted",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "effects": [
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              { "op": "set", "key": "statusMessage", "value": "Awaiting save or opponent review" },
              { "op": "append", "key": "resultHistory", "value": { "action": "score-submitted", "actorPersonaId": "$actor", "at": "$timestamp", "score": "{score}", "outcome": "{outcome}" } }
            ]
          },
          {
            "id": "save-result",
            "label": "Save result",
            "icon": "save",
            "tone": "primary",
            "from": ["submitted"],
            "to": "final",
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "effects": [
              { "op": "set", "key": "savedAt", "value": "$timestamp" },
              { "op": "set", "key": "statusMessage", "value": "Result saved" },
              { "op": "append", "key": "resultHistory", "value": { "action": "saved", "actorPersonaId": "$actor", "at": "$timestamp" } },
              {
                "op": "createInstance",
                "workflowType": "chess-rankings-table",
                "fields": {
                  "playerName": "{playerOneName}",
                  "changeEvidence": "Submitted result {score} ({outcome}) against {playerTwoName}; organizer must enter verified rank, rating, and delta.",
                  "rankChangeConfirmed": false,
                  "publicationHistory": []
                }
              },
              {
                "op": "createInstance",
                "workflowType": "chess-rankings-table",
                "fields": {
                  "playerName": "{playerTwoName}",
                  "changeEvidence": "Submitted result {score} ({outcome}) against {playerOneName}; organizer must enter verified rank, rating, and delta.",
                  "rankChangeConfirmed": false,
                  "publicationHistory": []
                }
              }
            ]
          },
          {
            "id": "edit-score",
            "label": "Edit score",
            "icon": "edit",
            "tone": "secondary",
            "from": ["submitted", "final"],
            "to": "correction-requested",
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "effects": [
              { "op": "set", "key": "statusMessage", "value": "Score opened for correction" },
              { "op": "append", "key": "resultHistory", "value": { "action": "edit-requested", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "dispute-result",
            "label": "Dispute result",
            "icon": "report_problem",
            "tone": "destructive",
            "from": ["submitted", "final"],
            "to": "disputed",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "inputs": { "reason": { "type": "text", "required": true } },
            "effects": [
              { "op": "set", "key": "disputeReason", "value": "{input.reason}" },
              { "op": "set", "key": "disputedAt", "value": "$timestamp" },
              { "op": "set", "key": "statusMessage", "value": "Organizer review required" },
              { "op": "append", "key": "resultHistory", "value": { "action": "disputed", "actorPersonaId": "$actor", "at": "$timestamp", "reason": "{input.reason}" } }
            ]
          },
          {
            "id": "request-correction",
            "label": "Request correction",
            "icon": "undo",
            "tone": "secondary",
            "from": ["disputed"],
            "to": "correction-requested",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "inputs": { "note": { "type": "text", "required": true } },
            "effects": [
              { "op": "set", "key": "correctionNote", "value": "{input.note}" },
              { "op": "set", "key": "statusMessage", "value": "Player correction requested" },
              { "op": "append", "key": "resultHistory", "value": { "action": "correction-requested", "actorPersonaId": "$actor", "at": "$timestamp", "note": "{input.note}" } }
            ]
          },
          {
            "id": "confirm-disputed-result",
            "label": "Confirm result",
            "icon": "verified",
            "tone": "primary",
            "from": ["disputed"],
            "to": "final",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "resolvedAt", "value": "$timestamp" },
              { "op": "set", "key": "statusMessage", "value": "Dispute resolved; result confirmed" },
              { "op": "append", "key": "resultHistory", "value": { "action": "dispute-confirmed", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "correct-result",
            "label": "Correct result",
            "icon": "published_with_changes",
            "tone": "primary",
            "from": ["correction-requested", "disputed"],
            "to": "submitted",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "inputs": {
              "score": { "type": "text", "required": true },
              "outcome": { "type": "text", "required": true },
              "note": { "type": "text" }
            },
            "effects": [
              { "op": "set", "key": "score", "value": "{input.score}" },
              { "op": "set", "key": "outcome", "value": "{input.outcome}" },
              { "op": "set", "key": "correctionNote", "value": "{input.note}" },
              { "op": "set", "key": "correctedAt", "value": "$timestamp" },
              { "op": "set", "key": "statusMessage", "value": "Corrected result resubmitted" },
              { "op": "append", "key": "resultHistory", "value": { "action": "corrected", "actorPersonaId": "$actor", "at": "$timestamp", "score": "{input.score}", "outcome": "{input.outcome}", "note": "{input.note}" } }
            ]
          },
          {
            "id": "undo-result",
            "label": "Undo result",
            "icon": "undo",
            "tone": "destructive",
            "from": ["submitted", "final"],
            "to": "undone",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "effects": [
              { "op": "set", "key": "undoneAt", "value": "$timestamp" },
              { "op": "set", "key": "statusMessage", "value": "Result undone; edit and resubmit or void" },
              { "op": "append", "key": "resultHistory", "value": { "action": "undone", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "resubmit-result",
            "label": "Resubmit result",
            "icon": "replay",
            "tone": "primary",
            "from": ["undone"],
            "to": "submitted",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "effects": [
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              { "op": "set", "key": "statusMessage", "value": "Result resubmitted" },
              { "op": "append", "key": "resultHistory", "value": { "action": "resubmitted", "actorPersonaId": "$actor", "at": "$timestamp", "score": "{score}", "outcome": "{outcome}" } }
            ]
          },
          {
            "id": "record-standing-impact",
            "label": "Record standings impact",
            "icon": "leaderboard",
            "tone": "secondary",
            "from": ["final"],
            "to": null,
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "inputs": { "impactNote": { "type": "text", "required": true } },
            "effects": [
              { "op": "set", "key": "rankingImpactNote", "value": "{input.impactNote}" },
              { "op": "set", "key": "rankingImpactRecordedAt", "value": "$timestamp" },
              { "op": "append", "key": "resultHistory", "value": { "action": "standings-impact-recorded", "actorPersonaId": "$actor", "at": "$timestamp", "note": "{input.impactNote}" } }
            ]
          },
          {
            "id": "discard-draft",
            "label": "Discard draft",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["draft"],
            "to": "voided",
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "effects": [
              { "op": "set", "key": "statusMessage", "value": "Draft discarded" },
              { "op": "append", "key": "resultHistory", "value": { "action": "draft-discarded", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "void-result",
            "label": "Void result",
            "icon": "block",
            "tone": "destructive",
            "from": ["undone"],
            "to": "voided",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "statusMessage", "value": "Result voided" },
              { "op": "append", "key": "resultHistory", "value": { "action": "voided", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["draft", "correction-requested", "undone"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Record match",
                "byPersonaIds": ["chess-member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "statusMessage": "Draft result", "resultHistory": [] }
              }
            ]
          },
          {
            "states": ["submitted", "disputed", "final"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "primary"
          },
          {
            "states": ["disputed"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["voided"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "resultTitle": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "playerOneName": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "person_outline", "labelTemplate": "White: {value}", "displayContexts": ["tile", "detail"] },
          "playerTwoName": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "person_2_outlined", "labelTemplate": "Black: {value}", "displayContexts": ["tile", "detail"] },
          "roundLabel": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "format_list_numbered", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "score": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "scoreboard", "labelTemplate": "Score: {value}", "displayContexts": ["tile", "detail"] },
          "outcome": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "emoji_events", "labelTemplate": "Result: {value}", "displayContexts": ["tile", "detail"] },
          "correctionNote": { "type": "textarea", "writableBy": "formEntry", "maxLength": 500, "displayIcon": "edit_note", "labelTemplate": "Correction: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "disputeReason": { "type": "textarea", "writableBy": "effect", "maxLength": 500, "displayIcon": "report_problem", "labelTemplate": "Dispute: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "statusMessage": { "type": "text", "writableBy": "effect", "displayIcon": "info_outline", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "submittedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "send", "labelTemplate": "Submitted {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "savedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "save", "labelTemplate": "Saved {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "disputedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "gavel", "labelTemplate": "Disputed {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "resolvedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "verified", "labelTemplate": "Resolved {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "correctedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "published_with_changes", "labelTemplate": "Corrected {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "undoneAt": { "type": "date?", "writableBy": "effect", "displayIcon": "undo", "labelTemplate": "Undone {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "rankingImpactNote": { "type": "text", "writableBy": "effect", "displayIcon": "leaderboard", "labelTemplate": "Standings: {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "rankingImpactRecordedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "update", "labelTemplate": "Impact recorded {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "resultHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "History: {value.length}", "displayContexts": ["detail"] }
        }
      },

      "chess-club-night": {
        "initialState": "scheduled",
        "visibility": {
          "default": "guarded",
          "readGuard": { "allowedPersonaIds": ["chess-organizer", "chess-member"] }
        },
        "states": {
          "scheduled": {
            "label": "Club night scheduled",
            "tone": "info",
            "editableFields": ["eventTitle", "eventKind", "eventDate", "eventTime", "location", "pairingNote"],
            "editGuard": { "allowedPersonaIds": ["chess-organizer"] }
          },
          "reminded": { "label": "Reminder sent", "tone": "positive" },
          "cancelled": { "label": "Club night cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "send-reminder",
            "label": "Send reminder",
            "icon": "notifications_active",
            "tone": "primary",
            "from": ["scheduled"],
            "to": "reminded",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "reminderSentAt", "value": "$timestamp" },
              { "op": "set", "key": "reminderSentByPersonaId", "value": "$actor" },
              { "op": "set", "key": "reminderStatus", "value": "sent" },
              { "op": "append", "key": "reminderHistory", "value": { "recipientPersonaId": "{recipientPersonaId}", "sentByPersonaId": "$actor", "sentAt": "$timestamp" } }
            ]
          },
          {
            "id": "rsvp-club-night",
            "label": "RSVP",
            "icon": "event_available",
            "tone": "primary",
            "from": ["scheduled", "reminded"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["chess-member"],
              "actorInList": { "key": "attendingPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "attendingPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "withdraw-club-night-rsvp",
            "label": "Withdraw RSVP",
            "icon": "event_busy",
            "tone": "secondary",
            "from": ["scheduled", "reminded"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["chess-member"],
              "actorInList": { "key": "attendingPersonaIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "attendingPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "cancel-club-night",
            "label": "Cancel club night",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["scheduled", "reminded"],
            "to": "cancelled",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "cancelledAt", "value": "$timestamp" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["scheduled", "reminded"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Schedule club night",
                "byPersonaIds": ["chess-organizer"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "recipientPersonaId": "chess-member",
                  "reminderStatus": "scheduled",
                  "reminderHistory": [],
                  "attendingPersonaIds": []
                }
              }
            ]
          },
          {
            "states": ["reminded"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "summary"
          },
          {
            "states": ["cancelled"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "eventTitle": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "eventKind": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "category", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "eventDate": { "type": "date", "required": true, "writableBy": "formEntry", "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "eventTime": { "type": "time", "required": true, "writableBy": "formEntry", "displayIcon": "schedule", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "location": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "location_on_outlined", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "pairingNote": { "type": "textarea", "required": true, "writableBy": "formEntry", "maxLength": 500, "displayIcon": "casino", "labelTemplate": "Pairings: {value}", "displayContexts": ["tile", "detail"] },
          "recipientPersonaId": { "type": "personaId", "required": true, "writableBy": "effect", "displayIcon": "groups_outlined", "labelTemplate": "For {value}", "displayContexts": ["detail"] },
          "reminderStatus": { "type": "text", "required": true, "writableBy": "effect", "displayIcon": "notifications", "labelTemplate": "Reminder: {value}", "displayContexts": ["tile", "detail"] },
          "reminderSentAt": { "type": "date?", "writableBy": "effect", "displayIcon": "notification_important", "labelTemplate": "Sent {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "reminderSentByPersonaId": { "type": "personaId?", "writableBy": "effect", "displayIcon": "badge", "labelTemplate": "Sent by {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "reminderHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "Reminder history: {value.length}", "displayContexts": ["detail"] },
          "attendingPersonaIds": { "type": "personaId[]", "writableBy": "effect", "displayIcon": "groups_outlined", "labelTemplate": "RSVPs: {value.length}", "displayContexts": ["tile", "detail"] },
          "cancelledAt": { "type": "date?", "writableBy": "effect", "displayIcon": "cancel_schedule_send", "labelTemplate": "Cancelled {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "attendingCount": { "type": "number", "formula": "size(attendingPersonaIds)", "displayIcon": "how_to_reg", "labelTemplate": "Attending: {value}", "displayContexts": ["tile", "detail"] }
        }
      },

      "chess-discussion-thread": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "Open discussion",
            "tone": "positive",
            "editableFields": ["subject"],
            "editGuard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] }
          },
          "archived": { "label": "Archived", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "reply",
            "label": "Reply",
            "icon": "send",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "inputs": { "body": { "type": "text", "required": true } },
            "effects": [
              { "op": "append", "key": "messages", "value": { "senderPersonaId": "$actor", "body": "{input.body}", "timestamp": "$timestamp" } }
            ]
          },
          {
            "id": "mute-thread",
            "label": "Mute",
            "icon": "notifications_off",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["chess-member", "chess-organizer"],
              "actorInList": { "key": "mutedPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "mutedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "unmute-thread",
            "label": "Unmute",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["chess-member", "chess-organizer"],
              "actorInList": { "key": "mutedPersonaIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "mutedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "mark-read",
            "label": "Mark read",
            "icon": "mark_email_read",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "effects": [
              { "op": "appendUnique", "key": "readPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "archive-thread",
            "label": "Archive",
            "icon": "archive",
            "tone": "destructive",
            "from": ["open"],
            "to": "archived",
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "effects": [
              { "op": "set", "key": "archivedAt", "value": "$timestamp" },
              { "op": "set", "key": "archivedByPersonaId", "value": "$actor" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["open"],
            "role": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New discussion",
                "byPersonaIds": ["chess-member", "chess-organizer"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "messages": [], "mutedPersonaIds": [], "readPersonaIds": [] }
              }
            ]
          },
          {
            "states": ["archived"],
            "role": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "subject": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "sortable": true, "displayIcon": "forum", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "messages": { "type": "list", "writableBy": "effect", "displayIcon": "chat_bubble_outline", "labelTemplate": "Messages: {value.length}", "displayContexts": ["detail"] },
          "mutedPersonaIds": { "type": "personaId[]", "writableBy": "effect", "displayIcon": "notifications_off", "labelTemplate": "Muted by: {value.length}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "readPersonaIds": { "type": "personaId[]", "writableBy": "effect", "displayIcon": "done_all", "labelTemplate": "Read by: {value.length}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "archivedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "archive", "labelTemplate": "Archived {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "archivedByPersonaId": { "type": "personaId?", "writableBy": "effect", "displayIcon": "badge", "labelTemplate": "Archived by {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "messageCount": { "type": "number", "formula": "size(messages)", "displayIcon": "tag", "labelTemplate": "{value} messages", "displayContexts": ["tile", "detail"] }
        }
      },

      "chess-export-package": {
        "initialState": "ready",
        "visibility": {
          "default": "guarded",
          "readGuard": { "allowedPersonaIds": ["chess-organizer", "chess-member"] }
        },
        "states": {
          "ready": {
            "label": "Ready to export",
            "tone": "info",
            "editableFields": ["exportLabel", "exportScope"],
            "editGuard": { "allowedPersonaIds": ["chess-organizer"] }
          },
          "generated": { "label": "Export generated", "tone": "positive" },
          "rolled-back": { "label": "Export rolled back", "tone": "warning" },
          "cancelled": { "label": "Export cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "generate-export",
            "label": "Generate export",
            "icon": "archive",
            "tone": "primary",
            "from": ["ready", "rolled-back"],
            "to": "generated",
            "guard": {
              "allowedPersonaIds": ["chess-organizer"],
              "formula": "size(exportScope) > 0"
            },
            "effects": [
              { "op": "set", "key": "generatedAt", "value": "$timestamp" },
              { "op": "set", "key": "generatedByPersonaId", "value": "$actor" },
              { "op": "set", "key": "statusMessage", "value": "Export generated; checksum pending platform verification" },
              { "op": "append", "key": "exportHistory", "value": { "action": "generated", "actorPersonaId": "$actor", "at": "$timestamp", "scope": "{exportScope}" } }
            ]
          },
          {
            "id": "rollback-export",
            "label": "Roll back",
            "icon": "settings_backup_restore",
            "tone": "destructive",
            "from": ["generated"],
            "to": "rolled-back",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "rolledBackAt", "value": "$timestamp" },
              { "op": "set", "key": "rolledBackByPersonaId", "value": "$actor" },
              { "op": "set", "key": "statusMessage", "value": "Export rolled back" },
              { "op": "append", "key": "exportHistory", "value": { "action": "rolled-back", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "change-scope",
            "label": "Change scope",
            "icon": "tune",
            "tone": "secondary",
            "from": ["generated", "rolled-back"],
            "to": "ready",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "statusMessage", "value": "Scope reopened for editing" },
              { "op": "append", "key": "exportHistory", "value": { "action": "scope-reopened", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "cancel-export",
            "label": "Cancel export",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["ready", "rolled-back"],
            "to": "cancelled",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "statusMessage", "value": "Export cancelled" },
              { "op": "append", "key": "exportHistory", "value": { "action": "cancelled", "actorPersonaId": "$actor", "at": "$timestamp" } }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["ready", "generated", "rolled-back"],
            "role": "any",
            "tabId": "admin",
            // NEEDS IMPLEMENTATION (archetype): exportWizard is a locked pending family and is not yet in the Dart registry.
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New export",
                "byPersonaIds": ["chess-organizer"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "statusMessage": "Ready to generate", "exportHistory": [] }
              }
            ]
          },
          {
            "states": ["generated", "rolled-back"],
            "role": "any",
            "tabId": "home",
            // NEEDS IMPLEMENTATION (archetype): exportWizard is a locked pending family and is not yet in the Dart registry.
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "summary"
          },
          {
            "states": ["cancelled"],
            "role": "any",
            "tabId": "admin",
            // NEEDS IMPLEMENTATION (archetype): exportWizard is a locked pending family and is not yet in the Dart registry.
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "exportLabel": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "exportScope": { "type": "list", "required": true, "writableBy": "formEntry", "displayIcon": "checklist", "labelTemplate": "Scope: {value}", "displayContexts": ["tile", "detail"] },
          "statusMessage": { "type": "text", "writableBy": "effect", "displayIcon": "info_outline", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "generatedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "schedule", "labelTemplate": "Generated {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "generatedByPersonaId": { "type": "personaId?", "writableBy": "effect", "displayIcon": "badge", "labelTemplate": "Generated by {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "rolledBackAt": { "type": "date?", "writableBy": "effect", "displayIcon": "settings_backup_restore", "labelTemplate": "Rolled back {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "rolledBackByPersonaId": { "type": "personaId?", "writableBy": "effect", "displayIcon": "manage_accounts", "labelTemplate": "Rolled back by {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "exportHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "History: {value.length}", "displayContexts": ["detail"] },
          // NEEDS IMPLEMENTATION (platform service): checksum/integrity-hash generation is not implemented; this field is declared and never seeded or effect-written.
          "checksum": { "type": "text?", "writableBy": "effect", "displayIcon": "fingerprint", "labelTemplate": "Checksum: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] }
        }
      },

      "chess-pairing-queue": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "Pairing queue open",
            "tone": "positive",
            "editableFields": ["queueTitle"],
            "editGuard": { "allowedPersonaIds": ["chess-organizer"] }
          },
          "assigned": { "label": "Pairings in progress", "tone": "info" },
          "closed": { "label": "Pairing queue closed", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "join-queue",
            "label": "Join queue",
            "icon": "person_add",
            "tone": "secondary",
            "from": ["open", "assigned"],
            "to": null,
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "inputs": { "playerName": { "type": "text", "required": true } },
            "effects": [
              { "op": "appendUnique", "key": "waitingPlayerNames", "value": "{input.playerName}" }
            ]
          },
          {
            "id": "withdraw-from-queue",
            "label": "Leave queue",
            "icon": "person_remove",
            "tone": "secondary",
            "from": ["open", "assigned"],
            "to": null,
            "guard": { "allowedPersonaIds": ["chess-member"] },
            "inputs": { "playerName": { "type": "text", "required": true } },
            "effects": [
              { "op": "removeValue", "key": "waitingPlayerNames", "value": "{input.playerName}" }
            ]
          },
          {
            "id": "assign-pairing",
            "label": "Assign pairing",
            "icon": "casino",
            "tone": "primary",
            "from": ["open", "assigned"],
            "to": "assigned",
            "guard": {
              "allowedPersonaIds": ["chess-organizer"],
              "formula": "size(waitingPlayerNames) >= 2"
            },
            "inputs": {
              "playerOne": { "type": "text", "required": true },
              "playerTwo": { "type": "text", "required": true },
              "boardLabel": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "append", "key": "assignmentHistory", "value": { "playerOne": "{input.playerOne}", "playerTwo": "{input.playerTwo}", "boardLabel": "{input.boardLabel}", "assignedByPersonaId": "$actor", "assignedAt": "$timestamp" } },
              { "op": "removeValue", "key": "waitingPlayerNames", "value": "{input.playerOne}" },
              { "op": "removeValue", "key": "waitingPlayerNames", "value": "{input.playerTwo}" }
            ]
          },
          {
            "id": "close-queue",
            "label": "Close queue",
            "icon": "lock",
            "tone": "destructive",
            "from": ["open", "assigned"],
            "to": "closed",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "closedAt", "value": "$timestamp" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["open", "assigned"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New pairing queue",
                "byPersonaIds": ["chess-organizer"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "queueOpenedAt": "$timestamp", "waitingPlayerNames": [], "assignmentHistory": [] }
              }
            ]
          },
          {
            "states": ["open", "assigned"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["closed"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "queueTitle": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "queueOpenedAt": { "type": "date", "required": true, "writableBy": "effect", "sortable": true, "displayIcon": "schedule", "labelTemplate": "Opened {value}", "displayContexts": ["detail"] },
          "waitingPlayerNames": { "type": "list", "writableBy": "effect", "displayIcon": "groups_outlined", "labelTemplate": "Waiting in order: {value}", "displayContexts": ["tile", "detail"] },
          "assignmentHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "Assignments: {value.length}", "displayContexts": ["tile", "detail"] },
          "closedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "lock_clock", "labelTemplate": "Closed {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "queueLength": { "type": "number", "formula": "size(waitingPlayerNames)", "displayIcon": "format_list_numbered", "labelTemplate": "Waiting: {value}", "displayContexts": ["tile", "detail"] },
          "assignmentCount": { "type": "number", "formula": "size(assignmentHistory)", "displayIcon": "pin", "labelTemplate": "Paired: {value}", "displayContexts": ["tile", "detail"] }
        }
      },

      "chess-rankings-table": {
        "initialState": "draft",
        "visibility": { "default": "public" },
        "states": {
          "draft": {
            "label": "Ranking update draft",
            "tone": "warning",
            "editableFields": ["rank", "playerName", "score", "delta", "changeEvidence", "rankChangeConfirmed"],
            "editGuard": { "allowedPersonaIds": ["chess-organizer"] },
            "readGuard": { "allowedPersonaIds": ["chess-organizer"] }
          },
          "current": { "label": "Current ranking", "tone": "positive" },
          "retired": { "label": "Retired ranking row", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "publish-ranking",
            "label": "Publish ranking",
            "icon": "publish",
            "tone": "primary",
            "from": ["draft"],
            "to": "current",
            "guard": {
              "allowedPersonaIds": ["chess-organizer"],
              "formula": "if(rank == null, false, if(score == null, false, if(delta == null, false, rankChangeConfirmed == true)))"
            },
            "effects": [
              { "op": "set", "key": "lastUpdated", "value": "$timestamp" },
              { "op": "set", "key": "publishedByPersonaId", "value": "$actor" },
              { "op": "set", "key": "rankChangeConfirmed", "value": false },
              { "op": "append", "key": "publicationHistory", "value": { "action": "published", "actorPersonaId": "$actor", "at": "$timestamp", "rank": "{rank}", "score": "{score}", "delta": "{delta}", "evidence": "{changeEvidence}" } }
            ]
          },
          {
            "id": "revise-ranking",
            "label": "Revise ranking",
            "icon": "edit",
            "tone": "secondary",
            "from": ["current"],
            "to": "draft",
            "guard": { "allowedPersonaIds": ["chess-organizer"] }
          },
          {
            "id": "retire-ranking",
            "label": "Retire row",
            "icon": "archive",
            "tone": "destructive",
            "from": ["current"],
            "to": "retired",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "retiredAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "discard-ranking-draft",
            "label": "Discard draft",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["draft"],
            "to": "retired",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "retiredAt", "value": "$timestamp" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["draft"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New ranking update",
                "byPersonaIds": ["chess-organizer"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "rankChangeConfirmed": false, "publicationHistory": [] }
              }
            ]
          },
          {
            "states": ["current"],
            "role": "any",
            "tabId": "home",
            // NEEDS IMPLEMENTATION (archetype): table is a locked pending family and is not yet in the Dart registry.
            "cardSurfaceFamily": "table",
            "bindingKind": "primary"
          },
          {
            "states": ["current", "retired"],
            "role": "any",
            "tabId": "admin",
            // NEEDS IMPLEMENTATION (archetype): table is a locked pending family and is not yet in the Dart registry.
            "cardSurfaceFamily": "table",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "rank": { "type": "number", "writableBy": "formEntry", "sortable": true, "displayIcon": "format_list_numbered", "labelTemplate": "Rank {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "playerName": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "sortable": true, "displayIcon": "person_outline", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "score": { "type": "number", "writableBy": "formEntry", "sortable": true, "displayIcon": "military_tech", "labelTemplate": "Rating {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          // NEEDS IMPLEMENTATION: automatic Elo/rating delta computation requires pow/exp functions not present in formulas.md; delta is organizer-entered and must be backed by real match evidence.
          "delta": { "type": "number", "writableBy": "formEntry", "sortable": true, "displayIcon": "trending_up", "labelTemplate": "Delta {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "changeEvidence": { "type": "textarea", "required": true, "writableBy": "formEntry", "maxLength": 500, "displayIcon": "fact_check", "labelTemplate": "Evidence: {value}", "displayContexts": ["detail"] },
          "rankChangeConfirmed": { "type": "bool", "required": true, "writableBy": "formEntry", "displayIcon": "verified", "labelTemplate": "Real change confirmed: {value}", "displayContexts": ["detail"] },
          "lastUpdated": { "type": "date?", "writableBy": "effect", "sortable": true, "displayIcon": "update", "labelTemplate": "Updated {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "publishedByPersonaId": { "type": "personaId?", "writableBy": "effect", "displayIcon": "badge", "labelTemplate": "Published by {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "publicationHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "Publications: {value.length}", "displayContexts": ["detail"] },
          "retiredAt": { "type": "date?", "writableBy": "effect", "displayIcon": "archive", "labelTemplate": "Retired {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] }
        }
      },

      "chess-rules-documents": {
        "initialState": "available",
        "visibility": { "default": "membersOnly" },
        "states": {
          "available": {
            "label": "Rules available",
            "tone": "positive",
            "editableFields": ["documentTitle", "versionLabel", "sourceLabel", "documentUrl", "downloadUrl"],
            "editGuard": { "allowedPersonaIds": ["chess-organizer"] }
          },
          "embedded-opened": { "label": "Opened embedded", "tone": "info" },
          "external-opened": { "label": "Opened externally", "tone": "info" },
          "downloaded": { "label": "Downloaded", "tone": "positive" },
          "archived": { "label": "Archived", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "record-embedded-open",
            "label": "Record embedded open",
            "icon": "open_in_browser",
            "tone": "secondary",
            "from": ["available", "embedded-opened", "external-opened", "downloaded"],
            "to": "embedded-opened",
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "effects": [
              { "op": "append", "key": "openHistory", "value": { "mode": "embedded", "actorPersonaId": "$actor", "openedAt": "$timestamp" } }
            ]
          },
          {
            "id": "record-external-open",
            "label": "Record external open",
            "icon": "open_in_new",
            "tone": "secondary",
            "from": ["available", "embedded-opened", "external-opened", "downloaded"],
            "to": "external-opened",
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "effects": [
              { "op": "append", "key": "openHistory", "value": { "mode": "external", "actorPersonaId": "$actor", "openedAt": "$timestamp" } }
            ]
          },
          {
            "id": "record-download",
            "label": "Record download",
            "icon": "download",
            "tone": "primary",
            "from": ["available", "embedded-opened", "external-opened", "downloaded"],
            "to": "downloaded",
            "guard": { "allowedPersonaIds": ["chess-member", "chess-organizer"] },
            "effects": [
              { "op": "appendUnique", "key": "downloadedPersonaIds", "value": "$actor" },
              { "op": "append", "key": "openHistory", "value": { "mode": "download", "actorPersonaId": "$actor", "openedAt": "$timestamp" } }
            ]
          },
          {
            "id": "archive-document",
            "label": "Archive document",
            "icon": "archive",
            "tone": "destructive",
            "from": ["available", "embedded-opened", "external-opened", "downloaded"],
            "to": "archived",
            "guard": { "allowedPersonaIds": ["chess-organizer"] },
            "effects": [
              { "op": "set", "key": "archivedAt", "value": "$timestamp" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["available", "embedded-opened", "external-opened", "downloaded"],
            "role": "any",
            "tabId": "home",
            // NEEDS IMPLEMENTATION (archetype): documentLibrary is a locked pending family and is not yet in the Dart registry.
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Add rules document",
                "byPersonaIds": ["chess-organizer"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "openHistory": [], "downloadedPersonaIds": [] }
              }
            ]
          },
          {
            "states": ["archived"],
            "role": "any",
            "tabId": "admin",
            // NEEDS IMPLEMENTATION (archetype): documentLibrary is a locked pending family and is not yet in the Dart registry.
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "documentTitle": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "sortable": true, "displayIcon": "description", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "versionLabel": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "history_edu", "labelTemplate": "Version {value}", "displayContexts": ["tile", "detail"] },
          "sourceLabel": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "source", "labelTemplate": "Source: {value}", "displayContexts": ["detail"] },
          // NEEDS IMPLEMENTATION (field renderer prerequisite): type:url/openMode is proposed and not yet consumed by the shared renderer; declared in its forward-compatible shape.
          "documentUrl": { "type": "url", "required": true, "writableBy": "formEntry", "openMode": "choice", "displayIcon": "open_in_browser", "labelTemplate": "Open {value}", "displayContexts": ["tile", "detail"] },
          // NEEDS IMPLEMENTATION (field renderer prerequisite): external URL launching is proposed and not yet consumed by the shared renderer.
          "downloadUrl": { "type": "url", "required": true, "writableBy": "formEntry", "openMode": "external", "displayIcon": "download", "labelTemplate": "Download {value}", "displayContexts": ["detail"] },
          "openHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "Open history: {value.length}", "displayContexts": ["tile", "detail"] },
          "downloadedPersonaIds": { "type": "personaId[]", "writableBy": "effect", "displayIcon": "download_done", "labelTemplate": "Downloaded by: {value.length}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "archivedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "archive", "labelTemplate": "Archived {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] }
        }
      }
    },

