// Platform Social / Member Social Space — specVersion 4 migration.
// The six shipped workflow types intentionally implement the product doc's eight rows:
// platform-message-thread covers messages-entry + message-stream, and platform-connection
// covers connections-entry + connection-invite. This avoids duplicate state machines.
{
  "specVersion": 4,
  "packageId": "init_member_social_space_1",
  "communityId": "community_member_social_space",
  "communityHandle": "member-social-space",
  "displayName": "Platform Social",
  "extensionId": "ext_member_social_space",
  "branding": { "accentColor": "#3D5AFE" },
  "seedDataFiles": [],
  "idempotencyKey": "init_member_social_space_1_spec4",

  "experience": {
    "displayName": "Platform Social",
    "tagline": "Message, connect, and stay in control of your community relationships.",
    "accentColor": "#3D5AFE",
    "theme": {
      "accent": "#3D5AFE",
      "tabThemes": {
        "admin": { "accent": "#283593" }
      }
    },
    "notifications": {
      "allowedChannels": ["inbox", "push"],
      "default": ["inbox", "push"]
    },

    // The four legacy personas are named people, not roles. Per identity-types.md case 2,
    // their two distinct roleLabel values collapse to these two role declarations.
    "roles": [
      {
        "roleId": "member",
        "label": "Member",
        "roleLabel": "Member",
        "description": "Messages, connects with, invites, and blocks other community members."
      },
      {
        "roleId": "moderator",
        "label": "Moderator",
        "roleLabel": "Moderator",
        "description": "Reviews social safety state and verifies required sponsored surfaces remain available."
      }
    ],

    "workflowDefinitions": {
      "platform-message-thread": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "participantAFanId" } },
          "fields": {
            "participants": ["participantAFanId", "participantBFanId"]
          }
        },
        "states": {
          "draft": {
            "label": "Draft",
            "tone": "info",
            "editableFields": ["participantBFanId"],
            "editGuard": { "actorEqualsField": { "key": "participantAFanId" } }
          },
          "open": { "label": "Open", "tone": "positive" },
          "archived": { "label": "Archived", "tone": "info" }
        },
        "transitions": [
          {
            "id": "start-thread",
            "label": "Start conversation",
            "icon": "send",
            "tone": "primary",
            "from": ["draft"],
            "to": "open",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "participantAFanId" }
            },
            "effects": [
              { "op": "set", "key": "participantAFanId", "value": "$actor" },
              { "op": "set", "key": "blockedByFanId", "value": null }
            ]
          },
          {
            "id": "post-message",
            "label": "Send",
            "icon": "send",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            "inputs": { "body": { "type": "text", "required": true } },
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "($actor == participantAFanId || $actor == participantBFanId) && !blockedActive"
            },
            "effects": [
              {
                "op": "append",
                "key": "messages",
                "value": {
                  "senderFanId": "$actor",
                  "body": "{input.body}",
                  "timestamp": "$timestamp"
                }
              },
              {
                "op": "branch",
                "if": "$actor == participantAFanId",
                "then": [
                  { "op": "set", "key": "unreadForB", "value": true },
                  { "op": "set", "key": "unreadForA", "value": false }
                ],
                "else": [
                  { "op": "set", "key": "unreadForA", "value": true },
                  { "op": "set", "key": "unreadForB", "value": false }
                ]
              }
            ]
          },
          {
            "id": "mark-read",
            "label": "Mark read",
            "icon": "mark_email_read",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "$actor == participantAFanId || $actor == participantBFanId"
            },
            "effects": [
              {
                "op": "branch",
                "if": "$actor == participantAFanId",
                "then": [
                  { "op": "set", "key": "unreadForA", "value": false }
                ],
                "else": [
                  { "op": "set", "key": "unreadForB", "value": false }
                ]
              }
            ]
          },
          {
            // discussionThread owns mutedByFanIds. This transition intentionally declares no
            // duplicate field/effect; the archetype performs the per-viewer bookkeeping.
            "id": "mute",
            "label": "Mute",
            "icon": "notifications_off",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "$actor == participantAFanId || $actor == participantBFanId"
            }
          },
          {
            // discussionThread owns mutedByFanIds; see the paired mute transition.
            "id": "unmute",
            "label": "Unmute",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "$actor == participantAFanId || $actor == participantBFanId"
            }
          },
          {
            "id": "archive",
            "label": "Archive",
            "icon": "archive",
            "tone": "destructive",
            "from": ["open"],
            "to": "archived",
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "$actor == participantAFanId || $actor == participantBFanId"
            }
          },
          {
            "id": "unarchive",
            "label": "Unarchive",
            "icon": "unarchive",
            "tone": "secondary",
            "from": ["archived"],
            "to": "open",
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "$actor == participantAFanId || $actor == participantBFanId"
            }
          }
        ],
        "renderBindings": [
          {
            "states": ["draft"],
            "audience": "actor",
            "tabId": "home",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New message",
                "byRoleIds": ["member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "participantAFanId": "$actor",
                  "messages": [],
                  "unreadForA": false,
                  "unreadForB": false,
                  "blockedActive": false
                }
              }
            ]
          },
          {
            "states": ["open", "archived"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "primary"
          },
          {
            "states": ["draft"],
            "audience": "actor",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New message",
                "byRoleIds": ["member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "participantAFanId": "$actor",
                  "messages": [],
                  "unreadForA": false,
                  "unreadForB": false,
                  "blockedActive": false
                }
              }
            ]
          },
          {
            "states": ["open", "archived"],
            "audience": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "primary"
          }
        ],
        "instanceDataSchema": {
          "participantAFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "person_outline",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "participantBFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "person_add_outlined",
            "labelTemplate": "With {value}",
            "displayContexts": ["tile", "detail"]
          },
          "messages": {
            "type": "list",
            "writableBy": "platform",
            "displayIcon": "forum",
            "labelTemplate": "{value.length} messages",
            "displayContexts": ["tile", "detail"]
          },
          // Retained to carry the shipped seeds' exact unread state. No readByFanIds field is
          // declared; that canonical set remains archetype-owned.
          "unreadForA": { "type": "bool", "writableBy": "platform", "displayContexts": [] },
          "unreadForB": { "type": "bool", "writableBy": "platform", "displayContexts": [] },
          "isUnreadForViewer": {
            "type": "bool",
            "formula": "if($viewer == participantAFanId, unreadForA, unreadForB)",
            "displayIcon": "mark_email_unread_outlined",
            "labelTemplate": "Unread: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "blockedActive": { "type": "bool", "writableBy": "platform", "displayContexts": [] },
          // Privacy-sensitive: required by the unblock guard but never rendered to either party.
          "blockedByFanId": { "type": "fanId?", "writableBy": "effect", "displayContexts": [] },
          "messageCount": {
            "type": "number",
            "formula": "size(messages)",
            "displayIcon": "chat_bubble_outline",
            "labelTemplate": "{value} messages",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "platform-connection": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "allowedRoleIds": ["moderator"] },
          "fields": {
            "parties": ["inviterFanId", "inviteeFanId"]
          }
        },
        "states": {
          "draft": {
            "label": "Draft",
            "tone": "info",
            "editableFields": ["reason", "inviteeFanId", "expiresAt"],
            "editGuard": { "actorEqualsField": { "key": "inviterFanId" } }
          },
          "invited": { "label": "Invite sent", "tone": "info" },
          "connected": { "label": "Connected", "tone": "positive" },
          "declined": { "label": "Declined", "tone": "negative", "isTerminal": true },
          "blocked": { "label": "Blocked", "tone": "negative" }
        },
        "transitions": [
          {
            "id": "send-invite",
            "label": "Send invite",
            "icon": "send",
            "tone": "primary",
            "from": ["draft"],
            "to": "invited",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "inviterFanId" }
            }
          },
          {
            "id": "accept-invite",
            "label": "Accept",
            "icon": "check_circle",
            "tone": "primary",
            "from": ["invited"],
            "to": "connected",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "inviteeFanId" },
              "formula": "if(expiresAt == null, true, !isPast(expiresAt))"
            },
            "effects": [
              { "op": "set", "key": "respondedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "decline-invite",
            "label": "Decline",
            "icon": "cancel",
            "tone": "secondary",
            "from": ["invited"],
            "to": "declined",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "inviteeFanId" }
            },
            "effects": [
              { "op": "set", "key": "respondedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "cancel-invite",
            "label": "Cancel invite",
            "icon": "undo",
            "tone": "destructive",
            "from": ["invited"],
            "to": "declined",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "inviterFanId" }
            },
            "effects": [
              { "op": "set", "key": "respondedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "block",
            "label": "Block",
            "icon": "block",
            "tone": "destructive",
            "from": ["invited", "connected"],
            "to": "blocked",
            "inputs": { "reason": { "type": "text", "required": true } },
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "$actor == inviterFanId || $actor == inviteeFanId"
            },
            "effects": [
              { "op": "set", "key": "blockedByFanId", "value": "$actor" },
              { "op": "set", "key": "respondedAt", "value": "$timestamp" },
              {
                "op": "set",
                "key": "safetyMessage",
                "value": "Contact unavailable. Messaging and invitations are disabled."
              },
              {
                "op": "branch",
                "if": "$actor == inviterFanId",
                "then": [
                  {
                    "op": "createInstance",
                    "workflowType": "platform-blocked-target",
                    "fields": {
                      "connectionId": "{id}",
                      "blockerFanId": "$actor",
                      "targetFanId": "{inviteeFanId}",
                      "blockReason": "{input.reason}"
                    }
                  }
                ],
                "else": [
                  {
                    "op": "createInstance",
                    "workflowType": "platform-blocked-target",
                    "fields": {
                      "connectionId": "{id}",
                      "blockerFanId": "$actor",
                      "targetFanId": "{inviterFanId}",
                      "blockReason": "{input.reason}"
                    }
                  }
                ]
              },
              {
                "op": "branch",
                "if": "messageThreadId == null",
                "then": [],
                "else": [
                  {
                    "op": "set",
                    "key": "blockedActive",
                    "value": true,
                    "relatedInstance": "messageThreadId"
                  },
                  {
                    "op": "set",
                    "key": "blockedByFanId",
                    "value": "$actor",
                    "relatedInstance": "messageThreadId"
                  }
                ]
              }
            ]
          },
          {
            "id": "keep-blocked",
            "label": "Keep blocked",
            "icon": "verified_user",
            "tone": "secondary",
            "from": ["blocked"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "blockedByFanId" }
            },
            "effects": [
              { "op": "set", "key": "blockReviewedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "appeal-block",
            "label": "Appeal block",
            "icon": "support_agent",
            "tone": "secondary",
            "from": ["blocked"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "($actor == inviterFanId || $actor == inviteeFanId) && if($actor == blockedByFanId, false, true)"
            },
            "effects": [
              { "op": "set", "key": "appealRequestedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "unblock",
            "label": "Unblock",
            "icon": "lock_open",
            "tone": "primary",
            "from": ["blocked"],
            "to": "connected",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "blockedByFanId" }
            },
            "effects": [
              { "op": "set", "key": "blockedByFanId", "value": null },
              { "op": "set", "key": "safetyMessage", "value": null },
              {
                "op": "branch",
                "if": "messageThreadId == null",
                "then": [],
                "else": [
                  {
                    "op": "set",
                    "key": "blockedActive",
                    "value": false,
                    "relatedInstance": "messageThreadId"
                  },
                  {
                    "op": "set",
                    "key": "blockedByFanId",
                    "value": null,
                    "relatedInstance": "messageThreadId"
                  }
                ]
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["draft"],
            "audience": "actor",
            "tabId": "home",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Send connection invite",
                "byRoleIds": ["member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "inviterFanId": "$actor" }
              }
            ]
          },
          {
            "states": ["invited", "connected", "blocked"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["declined"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          },
          {
            "states": ["invited"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "summary"
          },
          {
            "states": ["invited", "connected", "declined", "blocked"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "inviterFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "person_outline",
            "labelTemplate": "Invited by {value}",
            "displayContexts": ["tile", "detail"]
          },
          "inviteeFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "person_add_outlined",
            "labelTemplate": "Invitee: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "reason": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 300,
            "displayIcon": "chat_bubble_outline",
            "labelTemplate": "{value}",
            "displayContexts": ["detail"]
          },
          "messageThreadId": { "type": "text?", "displayContexts": [] },
          // Never rendered. The blocked party sees safetyMessage, not who initiated the block.
          "blockedByFanId": { "type": "fanId?", "writableBy": "effect", "displayContexts": [] },
          "respondedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "hideWhenEmpty": true,
            "displayIcon": "schedule",
            "labelTemplate": "Responded {value}",
            "displayContexts": ["detail"]
          },
          "expiresAt": {
            "type": "date?",
            "writableBy": "formEntry",
            "hideWhenEmpty": true,
            "displayIcon": "event_busy_outlined",
            "labelTemplate": "Invite expires {value}",
            "displayContexts": ["tile", "detail"]
          },
          "safetyMessage": {
            "type": "text?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "shield_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "blockReviewedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "fact_check_outlined",
            "labelTemplate": "Reviewed {value}",
            "displayContexts": ["detail"]
          },
          "appealRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "support_agent",
            "labelTemplate": "Appeal requested {value}",
            "displayContexts": ["detail"]
          }
        }
      },

      "platform-blocked-target": {
        "initialState": "active",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "blockerFanId" } },
          "fields": {
            "parties": ["blockerFanId", { "role": "moderator" }]
          }
        },
        "states": {
          "active": { "label": "Block active", "tone": "negative" },
          "closed": { "label": "Reviewed", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "confirm-block",
            "label": "Confirm block",
            "icon": "fact_check",
            "tone": "primary",
            "from": ["active"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "blockerFanId" }
            },
            "effects": [
              { "op": "set", "key": "confirmedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "close-review",
            "label": "Mark reviewed",
            "icon": "task_alt",
            "tone": "secondary",
            "from": ["active"],
            "to": "closed",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "blockerFanId" }
            },
            "effects": [
              { "op": "set", "key": "reviewedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "moderator-close-review",
            "label": "Close safety review",
            "icon": "admin_panel_settings",
            "tone": "secondary",
            "from": ["active"],
            "to": "closed",
            "guard": { "allowedRoleIds": ["moderator"] },
            "effects": [
              { "op": "set", "key": "reviewedAt", "value": "$timestamp" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["active"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["closed"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "summary"
          },
          {
            "states": ["active"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["closed"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "connectionId": { "type": "text", "required": true, "writableBy": "effect", "displayContexts": [] },
          "blockerFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "person_outline",
            "labelTemplate": "Block owner: {value}",
            "displayContexts": ["detail"]
          },
          "targetFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "block",
            "labelTemplate": "Target: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "blockReason": {
            "type": "textarea",
            "required": true,
            "writableBy": "effect",
            "maxLength": 500,
            "displayIcon": "report_outlined",
            "labelTemplate": "Reason: {value}",
            "displayContexts": ["detail"]
          },
          "confirmedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "check_circle_outline",
            "labelTemplate": "Confirmed {value}",
            "displayContexts": ["detail"]
          },
          "reviewedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "fact_check_outlined",
            "labelTemplate": "Reviewed {value}",
            "displayContexts": ["detail"]
          }
        }
      },

      "platform-in-stream-ad": {
        "initialState": "filled",
        "visibility": { "default": "public" },
        "states": {
          "filled": { "label": "Filled", "tone": "positive" }
        },
        "transitions": [
          {
            // notificationInbox owns impressionedByFanIds.
            "id": "record-impression",
            "label": "View",
            "icon": "visibility",
            "tone": "secondary",
            "from": ["filled"],
            "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] }
          },
          {
            // notificationInbox owns clickedByFanIds; sponsorUrl supplies the real openable target.
            "id": "open-sponsor-link",
            "label": "Open sponsor",
            "icon": "open_in_new",
            "tone": "primary",
            "from": ["filled"],
            "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] }
          },
          {
            // notificationInbox owns dismissedByFanIds.
            "id": "dismiss-ad",
            "label": "Dismiss",
            "icon": "close",
            "tone": "secondary",
            "from": ["filled"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "instanceDataEquals": { "key": "dismissible", "value": true }
            }
          },
          {
            "id": "report-sponsor",
            "label": "Report sponsor",
            "icon": "flag",
            "tone": "destructive",
            "from": ["filled"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member", "moderator"],
              "actorInList": { "key": "reportedByFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "reportedByFanIds", "value": "$actor" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["filled"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Provision sponsored item",
                "byRoleIds": ["moderator"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "sponsorName": "Riverside Outdoors Co.",
                  "disclosureText": "Sponsored",
                  "bodyText": "Gear up for your next trail day — 15% off backpacks this week.",
                  "contentContext": "Between community updates in the Home stream.",
                  "sponsorUrl": "https://riverside-outdoors.example/trail-day",
                  "dismissible": true,
                  "reportedByFanIds": []
                }
              }
            ]
          }
        ],
        "instanceDataSchema": {
          "sponsorName": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "storefront_outlined",
            "labelTemplate": "Sponsor: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "disclosureText": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "info_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "bodyText": {
            "type": "text?",
            "writableBy": "platform",
            "hideWhenEmpty": true,
            "displayIcon": "campaign_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "contentContext": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "view_stream_outlined",
            "labelTemplate": "Context: {value}",
            "displayContexts": ["detail"]
          },
          "sponsorUrl": {
            "type": "url",
            "required": true,
            "writableBy": "platform",
            "openMode": "external",
            "displayIcon": "open_in_new",
            "labelTemplate": "Open sponsor",
            "displayContexts": ["detail"]
          },
          "dismissible": { "type": "bool", "required": true, "writableBy": "platform", "displayContexts": [] },
          "reportedByFanIds": { "type": "fanId[]", "writableBy": "platform", "displayContexts": [] },
          "reportCount": {
            "type": "number",
            "formula": "size(reportedByFanIds)",
            "displayIcon": "flag_outlined",
            "labelTemplate": "Reports: {value}",
            "displayContexts": ["detail"]
          }
        }
      },

      "platform-top-banner-no-fill": {
        "initialState": "no-fill",
        "visibility": { "default": "public" },
        "states": {
          "no-fill": { "label": "No fill", "tone": "warning" }
        },
        "transitions": [
          {
            "id": "refresh-slot",
            "label": "Refresh slot",
            "icon": "refresh",
            "tone": "secondary",
            "from": ["no-fill"],
            "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] },
            "effects": [
              { "op": "set", "key": "lastRefreshedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "inspect-reason",
            "label": "Inspect no-fill reason",
            "icon": "manage_search",
            "tone": "secondary",
            "from": ["no-fill"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member", "moderator"],
              "actorInList": { "key": "reasonInspectedByFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "reasonInspectedByFanIds", "value": "$actor" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["no-fill"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Provision banner slot",
                "byRoleIds": ["moderator"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "disclosureText": "Ad space reserved",
                  "noFillReason": "No eligible sponsor available for this slot right now.",
                  "slotLayoutStatus": "Reserved banner space remains available.",
                  "reasonInspectedByFanIds": []
                }
              }
            ]
          }
        ],
        "instanceDataSchema": {
          "disclosureText": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "info_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "noFillReason": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "report_gmailerrorred_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "slotLayoutStatus": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "view_day_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "lastRefreshedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "refresh",
            "labelTemplate": "Refreshed {value}",
            "displayContexts": ["detail"]
          },
          "reasonInspectedByFanIds": { "type": "fanId[]", "writableBy": "platform", "displayContexts": [] }
        }
      },

      "platform-sensitive-no-fill": {
        "initialState": "suppressed",
        "visibility": { "default": "public" },
        "states": {
          "suppressed": { "label": "Suppressed", "tone": "info" }
        },
        "transitions": [
          {
            // notificationInbox owns acknowledgedByFanIds.
            "id": "acknowledge-suppression",
            "label": "Continue",
            "icon": "check",
            "tone": "primary",
            "from": ["suppressed"],
            "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] }
          },
          {
            "id": "review-policy",
            "label": "Review policy",
            "icon": "policy",
            "tone": "secondary",
            "from": ["suppressed"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["member", "moderator"],
              "actorInList": { "key": "policyReviewedByFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "policyReviewedByFanIds", "value": "$actor" }
            ]
          },
          {
            // notificationInbox owns dismissedByFanIds, used here as the explanation-hide record.
            "id": "hide-explanation",
            "label": "Hide explanation",
            "icon": "visibility_off",
            "tone": "secondary",
            "from": ["suppressed"],
            "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] }
          }
        ],
        "renderBindings": [
          {
            "states": ["suppressed"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Provision protected no-fill",
                "byRoleIds": ["moderator"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "disclosureText": "Ad suppressed in this context",
                  "noFillReason": "Ads are not shown alongside sensitive or protected content.",
                  "protectedContextLabel": "Protected community content",
                  "layoutStatus": "Protected content remains visible without an ad.",
                  "policyReviewedByFanIds": []
                }
              }
            ]
          }
        ],
        "instanceDataSchema": {
          "disclosureText": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "info_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "noFillReason": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "shield_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "protectedContextLabel": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "privacy_tip_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "layoutStatus": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "view_agenda_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["detail"]
          },
          "policyReviewedByFanIds": { "type": "fanId[]", "writableBy": "platform", "displayContexts": [] }
        }
      }
    },

