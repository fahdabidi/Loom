// Member Social Space — canonical JSON, authored 2026-08-10.
//
// Engine-native Loom community package for "Member Social Space" (product doc:
// docs/references/communities/member-social-space-product-experience.md). Built strictly from
// docs/references per the loom-calendar-experience-authoring Skill; no legacy JSON/Dart for this
// community existed to copy from. 6 workflow types cover the doc's 8 §6 rows (messages-entry +
// message-stream merged into platform-message-thread; connections-entry + connection-invite merged
// into platform-connection; the 3 ad-slot rows kept as 3 separate single-state types after an
// initial single-shared-type attempt hit a real unreachable_state error with no ad-decisioning
// backend to legitimately drive transitions between them).
//
// Independently judged after authoring and found to have 2 real issues, fixed here before merge:
//   1. CJM.6 (see docs/Build Plan V2/Community JSON Migration Tracker.md §2): both
//      platform-message-thread's and platform-connection's tab-scoped create actions used
//      `"$actor"` in `prefill` to stamp participantAPersonaId/inviterPersonaId, with NO fallback
//      transition to stamp it otherwise -- both types landed directly in a live state at creation
//      with full guard/readGuard enforcement already active, so every subsequent action was
//      permanently broken. Fixed per docs/references/reference/solved-patterns.md pattern 7: added
//      a "draft" pre-stamp state to each type, with a first transition (start-thread /
//      send-invite) that stamps the actor-identity field via a normal effect instead.
//   2. The doc's own correction note requires a blocked member see only that contact is
//      unavailable, never the blocker's identity -- `blockedByPersonaId` was rendered directly
//      (`displayContexts: ["tile","detail"]`) on both platform-message-thread and
//      platform-connection, readable by both participants including the blocked one. Fixed by
//      setting `displayContexts: []` on both fields -- the value stays readable to the engine (the
//      unblock transition's own guard) but is never rendered on any card.
//
// See docs/references/communities/member-social-space-product-experience.md §10 for the full review
// log.
//
// Migrated to specVersion 4 2026-08-17 via the loom-calendar-experience-authoring Skill
// (call_skill_authoring_agent.sh, GitHub-fetch channel) -- mechanical rename only, no behavior
// change: experience.personas[] -> experience.roles[] (2 roles: member, moderator, derived from the
// 4 personas' shared roleLabel values), every allowedPersonaIds/byPersonaIds guard/action ->
// allowedRoleIds/byRoleIds, every person-shaped instance-data field -> its *FanId(s) equivalent,
// every renderBindings[].role -> audience. Independently verified: identical validator
// error/warning count and content before and after (3 pre-existing errors, 3 pre-existing warnings,
// unrelated to this migration -- see the tracker).

{
  "specVersion": 4,
  "packageId": "init_member_social_space_1",
  "communityId": "community_member_social_space",
  "communityHandle": "member-social-space",
  "displayName": "Member Social Space",
  "extensionId": "ext_member_social_space",
  "branding": { "accentColor": "#3D5AFE" },
  "seedDataFiles": [],

  "experience": {
    "displayName": "Member Social Space",
    "tagline": "Message, connect, and stay in control of your community relationships.",
    "accentColor": "#3D5AFE",

    "roles": [
      { "roleId": "member", "label": "Member" },
      { "roleId": "moderator", "label": "Moderator" }
    ],

    "workflowDefinitions": {

      "platform-message-thread": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "formula": "$viewer == participantAFanId || $viewer == participantBFanId" }
        },
        "states": {
          "draft": { "label": "Draft", "tone": "info",
                    "editableFields": ["participantBFanId"],
                    "editGuard": { "allowedRoleIds": ["member"] },
                    "readGuard": { "allowedRoleIds": ["member"] } },
          "open": { "label": "Open", "tone": "positive",
                    "editableFields": ["participantBFanId"],
                    "editGuard": { "actorEqualsField": { "key": "participantAFanId" } } },
          "archived": { "label": "Archived", "tone": "info" }
        },
        "transitions": [
          {
            "id": "start-thread", "label": "Start conversation", "icon": "send", "tone": "primary",
            "from": ["draft"], "to": "open",
            "guard": { "allowedRoleIds": ["member"] },
            "effects": [ { "op": "set", "key": "participantAFanId", "value": "$actor" } ]
          },
          {
            "id": "post-message", "label": "Send", "icon": "send", "tone": "primary",
            "from": ["open"], "to": null,
            "inputs": { "body": { "type": "text", "required": true } },
            "guard": {
              "formula": "($actor == participantAFanId || $actor == participantBFanId) && !blockedActive"
            },
            "effects": [
              { "op": "append", "key": "messages",
                "value": { "senderFanId": "$actor", "body": "{input.body}", "timestamp": "$timestamp" } },
              { "op": "branch", "if": "$actor == participantAFanId",
                "then": [
                  { "op": "set", "key": "unreadForB", "value": true },
                  { "op": "set", "key": "unreadForA", "value": false }
                ],
                "else": [
                  { "op": "set", "key": "unreadForA", "value": true },
                  { "op": "set", "key": "unreadForB", "value": false }
                ] }
            ]
          },
          {
            "id": "mark-read", "label": "Mark read", "icon": "mark_email_read", "tone": "secondary",
            "from": ["open"], "to": null,
            "guard": { "formula": "$actor == participantAFanId || $actor == participantBFanId" },
            "effects": [
              { "op": "branch", "if": "$actor == participantAFanId",
                "then": [ { "op": "set", "key": "unreadForA", "value": false } ],
                "else": [ { "op": "set", "key": "unreadForB", "value": false } ] }
            ]
          },
          {
            "id": "mute", "label": "Mute", "icon": "notifications_off", "tone": "secondary",
            "from": ["open"], "to": null,
            "guard": {
              "formula": "$actor == participantAFanId || $actor == participantBFanId",
              "actorInList": { "key": "mutedByFanIds", "present": false }
            },
            "effects": [ { "op": "appendUnique", "key": "mutedByFanIds", "value": "$actor" } ]
          },
          {
            "id": "unmute", "label": "Unmute", "icon": "notifications_active", "tone": "secondary",
            "from": ["open"], "to": null,
            "guard": {
              "formula": "$actor == participantAFanId || $actor == participantBFanId",
              "actorInList": { "key": "mutedByFanIds", "present": true }
            },
            "effects": [ { "op": "removeValue", "key": "mutedByFanIds", "value": "$actor" } ]
          },
          {
            "id": "archive", "label": "Archive", "icon": "archive", "tone": "destructive",
            "from": ["open"], "to": "archived",
            "guard": { "formula": "$actor == participantAFanId || $actor == participantBFanId" }
          },
          {
            "id": "unarchive", "label": "Unarchive", "icon": "unarchive", "tone": "secondary",
            "from": ["archived"], "to": "open",
            "guard": { "formula": "$actor == participantAFanId || $actor == participantBFanId" }
          }
        ],
        "renderBindings": [
          { "states": ["draft"], "audience": "any", "tabId": "messages",
            "cardSurfaceFamily": "discussionThread", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "New message",
                "byRoleIds": ["member"],
                "scope": "tab", "presentation": "fab" }
            ] },
          { "states": ["open"], "audience": "any", "tabId": "messages",
            "cardSurfaceFamily": "discussionThread", "bindingKind": "primary" },
          { "states": ["archived"], "audience": "any", "tabId": "messages",
            "cardSurfaceFamily": "discussionThread", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "participantAFanId": { "type": "fanId?", "writableBy": "effect",
                                      "displayIcon": "person_outline", "labelTemplate": "{value}",
                                      "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "participantBFanId": { "type": "fanId", "required": true, "writableBy": "formEntry",
                                      "displayIcon": "person_add_outlined", "labelTemplate": "With {value}",
                                      "displayContexts": ["tile", "detail"] },
          "messages": { "type": "list", "writableBy": "effect",
                        "displayIcon": "forum", "labelTemplate": "{value.length} messages",
                        "displayContexts": ["tile", "detail"] },
          "unreadForA": { "type": "bool", "writableBy": "effect", "displayContexts": [] },
          "unreadForB": { "type": "bool", "writableBy": "effect", "displayContexts": [] },
          "isUnreadForViewer": { "type": "bool",
                                  "formula": "if($viewer == participantAFanId, unreadForA, unreadForB)",
                                  "displayIcon": "mark_email_unread_outlined",
                                  "labelTemplate": "Unread: {value}", "displayContexts": ["tile", "detail"] },
          "mutedByFanIds": { "type": "fanId[]", "writableBy": "effect",
                                  "displayIcon": "notifications_off_outlined",
                                  "labelTemplate": "Muted by {value.length}", "hideWhenEmpty": true,
                                  "displayContexts": ["detail"] },
          "blockedActive": { "type": "bool", "writableBy": "effect", "displayContexts": [] },
          "blockedByFanId": { "type": "fanId?", "writableBy": "effect",
                                   "displayContexts": [] },
          "messageCount": { "type": "number", "formula": "size(messages)",
                             "displayIcon": "chat_bubble_outline", "labelTemplate": "{value} messages",
                             "displayContexts": ["tile", "detail"] }
        }
      },

      "platform-connection": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "formula": "$viewer == inviterFanId || $viewer == inviteeFanId || $viewer == 'platform-moderator-dakota'"
          }
        },
        "states": {
          "draft": { "label": "Draft", "tone": "info",
                     "editableFields": ["reason", "inviteeFanId"],
                     "editGuard": { "allowedRoleIds": ["member"] },
                     "readGuard": { "allowedRoleIds": ["member"] } },
          "invited": { "label": "Invite sent", "tone": "info" },
          "connected": { "label": "Connected", "tone": "positive" },
          "declined": { "label": "Declined", "tone": "negative", "isTerminal": true },
          "blocked": { "label": "Blocked", "tone": "negative" }
        },
        "transitions": [
          {
            "id": "send-invite", "label": "Send invite", "icon": "send", "tone": "primary",
            "from": ["draft"], "to": "invited",
            "guard": { "allowedRoleIds": ["member"] },
            "effects": [ { "op": "set", "key": "inviterFanId", "value": "$actor" } ]
          },
          {
            "id": "accept-invite", "label": "Accept", "icon": "check_circle", "tone": "primary",
            "from": ["invited"], "to": "connected",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "inviteeFanId" }
            },
            "effects": [ { "op": "set", "key": "respondedAt", "value": "$timestamp" } ]
          },
          {
            "id": "decline-invite", "label": "Decline", "icon": "cancel", "tone": "secondary",
            "from": ["invited"], "to": "declined",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "inviteeFanId" }
            },
            "effects": [ { "op": "set", "key": "respondedAt", "value": "$timestamp" } ]
          },
          {
            "id": "cancel-invite", "label": "Cancel invite", "icon": "undo", "tone": "destructive",
            "from": ["invited"], "to": "declined",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "inviterFanId" }
            },
            "effects": [ { "op": "set", "key": "respondedAt", "value": "$timestamp" } ]
          },
          {
            "id": "block", "label": "Block", "icon": "block", "tone": "destructive",
            "from": ["invited", "connected"], "to": "blocked",
            "inputs": { "reason": { "type": "text", "required": true } },
            "guard": {
              "allowedRoleIds": ["member"],
              "formula": "$actor == inviterFanId || $actor == inviteeFanId"
            },
            "effects": [
              { "op": "set", "key": "blockedByFanId", "value": "$actor" },
              { "op": "branch", "if": "$actor == inviterFanId",
                "then": [
                  { "op": "createInstance", "workflowType": "platform-blocked-target",
                    "fields": { "connectionId": "{id}", "blockerFanId": "$actor",
                                "targetFanId": "{inviteeFanId}", "blockReason": "{input.reason}" } }
                ],
                "else": [
                  { "op": "createInstance", "workflowType": "platform-blocked-target",
                    "fields": { "connectionId": "{id}", "blockerFanId": "$actor",
                                "targetFanId": "{inviterFanId}", "blockReason": "{input.reason}" } }
                ] },
              { "op": "set", "key": "blockedActive", "value": true, "relatedInstance": "messageThreadId" },
              { "op": "set", "key": "blockedByFanId", "value": "$actor", "relatedInstance": "messageThreadId" }
            ]
          },
          {
            "id": "unblock", "label": "Unblock", "icon": "lock_open", "tone": "primary",
            "from": ["blocked"], "to": "connected",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "blockedByFanId" }
            },
            "effects": [
              { "op": "set", "key": "blockedByFanId", "value": null },
              { "op": "set", "key": "blockedActive", "value": false, "relatedInstance": "messageThreadId" },
              { "op": "set", "key": "blockedByFanId", "value": null, "relatedInstance": "messageThreadId" }
            ]
          }
        ],
        "renderBindings": [
          { "states": ["draft"], "audience": "any", "tabId": "messages",
            "cardSurfaceFamily": "approvalQueueItem", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "Send connection invite",
                "byRoleIds": ["member"],
                "scope": "tab", "presentation": "fab" }
            ] },
          { "states": ["invited"], "audience": "any", "tabId": "messages",
            "cardSurfaceFamily": "approvalQueueItem", "bindingKind": "primary" },
          { "states": ["invited"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "notificationInbox", "bindingKind": "summary" },
          { "states": ["connected", "declined", "blocked"], "audience": "any", "tabId": "messages",
            "cardSurfaceFamily": "statusTimeline", "bindingKind": "summary" },
          { "states": ["invited", "connected", "declined", "blocked"], "audience": "any", "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "inviterFanId": { "type": "fanId?", "writableBy": "effect",
                                 "displayIcon": "person_outline", "labelTemplate": "Invited by {value}",
                                 "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "inviteeFanId": { "type": "fanId", "required": true, "writableBy": "formEntry",
                                 "displayIcon": "person_add_outlined", "labelTemplate": "Invitee: {value}",
                                 "displayContexts": ["tile", "detail"] },
          "reason": { "type": "textarea", "required": true, "writableBy": "formEntry", "maxLength": 300,
                      "displayIcon": "chat_bubble_outline", "labelTemplate": "{value}",
                      "displayContexts": ["detail"] },
          "messageThreadId": { "type": "text?", "writableBy": "effect", "displayContexts": [] },
          "blockedByFanId": { "type": "fanId?", "writableBy": "effect",
                                   "displayContexts": [] },
          "respondedAt": { "type": "date?", "writableBy": "effect", "sortable": true, "hideWhenEmpty": true,
                            "displayIcon": "schedule", "labelTemplate": "Responded {value}",
                            "displayContexts": ["detail"] }
        }
      },

      "platform-blocked-target": {
        "initialState": "active",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "blockerFanId" } }
        },
        "states": {
          "active": { "label": "Block active", "tone": "negative" },
          "closed": { "label": "Reviewed", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "confirm-block", "label": "Confirm block", "icon": "fact_check", "tone": "primary",
            "from": ["active"], "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "blockerFanId" }
            },
            "effects": [ { "op": "set", "key": "confirmedAt", "value": "$timestamp" } ]
          },
          {
            "id": "close-review", "label": "Mark reviewed", "icon": "task_alt", "tone": "secondary",
            "from": ["active"], "to": "closed",
            "guard": {
              "allowedRoleIds": ["member"],
              "actorEqualsField": { "key": "blockerFanId" }
            },
            "effects": [ { "op": "set", "key": "reviewedAt", "value": "$timestamp" } ]
          }
        ],
        "renderBindings": [
          { "states": ["active"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "approvalQueueItem", "bindingKind": "primary" },
          { "states": ["closed"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "approvalQueueItem", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "connectionId": { "type": "text", "required": true, "writableBy": "effect", "displayContexts": [] },
          "blockerFanId": { "type": "fanId", "required": true, "writableBy": "effect",
                                 "displayIcon": "person_outline", "labelTemplate": "{value}",
                                 "displayContexts": ["detail"] },
          "targetFanId": { "type": "fanId", "required": true, "writableBy": "effect",
                                "displayIcon": "block", "labelTemplate": "Target: {value}",
                                "displayContexts": ["tile", "detail"] },
          "blockReason": { "type": "textarea", "required": true, "writableBy": "effect", "maxLength": 500,
                            "displayIcon": "report_outlined", "labelTemplate": "Reason: {value}",
                            "displayContexts": ["detail"] },
          "confirmedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true,
                            "displayIcon": "check_circle_outline", "labelTemplate": "Confirmed {value}",
                            "displayContexts": ["detail"] },
          "reviewedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true,
                           "displayIcon": "fact_check_outlined", "labelTemplate": "Reviewed {value}",
                           "displayContexts": ["detail"] }
        }
      },

      "platform-in-stream-ad": {
        "initialState": "filled",
        "visibility": { "default": "public" },
        "states": {
          "filled": { "label": "Filled", "tone": "positive" }
        },
        "transitions": [
          {
            "id": "record-impression", "label": "View", "icon": "visibility", "tone": "secondary",
            "from": ["filled"], "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] },
            "effects": [ { "op": "appendUnique", "key": "impressionedByFanIds", "value": "$actor" } ]
          },
          {
            "id": "open-sponsor-link", "label": "Open sponsor", "icon": "open_in_new", "tone": "primary",
            "from": ["filled"], "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] },
            "effects": [ { "op": "appendUnique", "key": "clickedByFanIds", "value": "$actor" } ]
          },
          {
            "id": "dismiss-ad", "label": "Dismiss", "icon": "close", "tone": "secondary",
            "from": ["filled"], "to": null,
            "guard": {
              "allowedRoleIds": ["member"],
              "instanceDataEquals": { "key": "dismissible", "value": true }
            },
            "effects": [ { "op": "appendUnique", "key": "dismissedByFanIds", "value": "$actor" } ]
          },
          {
            "id": "report-sponsor", "label": "Report sponsor", "icon": "flag", "tone": "destructive",
            "from": ["filled"], "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] },
            "effects": [ { "op": "appendUnique", "key": "reportedByFanIds", "value": "$actor" } ]
          }
        ],
        "renderBindings": [
          { "states": ["filled"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "notificationInbox", "bindingKind": "primary" }
        ],
        "instanceDataSchema": {
          "sponsorName": { "type": "text", "required": true, "writableBy": "effect",
                            "displayIcon": "storefront_outlined", "labelTemplate": "Sponsor: {value}",
                            "displayContexts": ["tile", "detail"] },
          "disclosureText": { "type": "text", "required": true, "writableBy": "effect",
                               "displayIcon": "info_outlined", "labelTemplate": "{value}",
                               "displayContexts": ["tile", "detail"] },
          "bodyText": { "type": "text?", "writableBy": "effect", "hideWhenEmpty": true,
                        "displayContexts": ["detail"] },
          "dismissible": { "type": "bool", "required": true, "writableBy": "effect", "displayContexts": [] },
          "impressionedByFanIds": { "type": "fanId[]", "writableBy": "effect", "displayContexts": [] },
          "clickedByFanIds": { "type": "fanId[]", "writableBy": "effect", "displayContexts": [] },
          "dismissedByFanIds": { "type": "fanId[]", "writableBy": "effect", "displayContexts": [] },
          "reportedByFanIds": { "type": "fanId[]", "writableBy": "effect", "displayContexts": [] },
          "impressionCount": { "type": "number", "formula": "size(impressionedByFanIds)",
                                "displayIcon": "visibility_outlined", "labelTemplate": "{value} views",
                                "displayContexts": ["tile", "detail"] },
          "clickCount": { "type": "number", "formula": "size(clickedByFanIds)",
                           "displayIcon": "touch_app_outlined", "labelTemplate": "{value} clicks",
                           "displayContexts": ["detail"] }
        }
      },

      "platform-top-banner-no-fill": {
        "initialState": "no-fill",
        "visibility": { "default": "public" },
        "states": {
          "no-fill": { "label": "No fill", "tone": "warning" }
        },
        "transitions": [
          {
            "id": "refresh-slot", "label": "Refresh slot", "icon": "refresh", "tone": "secondary",
            "from": ["no-fill"], "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] },
            "effects": [ { "op": "set", "key": "lastRefreshedAt", "value": "$timestamp" } ]
          },
          {
            "id": "inspect-reason", "label": "Inspect no-fill reason", "icon": "manage_search", "tone": "secondary",
            "from": ["no-fill"], "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] },
            "effects": [ { "op": "appendUnique", "key": "reasonInspectedByFanIds", "value": "$actor" } ]
          }
        ],
        "renderBindings": [
          { "states": ["no-fill"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "notificationInbox", "bindingKind": "primary" }
        ],
        "instanceDataSchema": {
          "disclosureText": { "type": "text", "required": true, "writableBy": "effect",
                               "displayIcon": "info_outlined", "labelTemplate": "{value}",
                               "displayContexts": ["tile", "detail"] },
          "noFillReason": { "type": "text", "required": true, "writableBy": "effect",
                             "displayIcon": "report_gmailerrorred_outlined", "labelTemplate": "{value}",
                             "displayContexts": ["tile", "detail"] },
          "lastRefreshedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true,
                                "displayIcon": "refresh", "labelTemplate": "Refreshed {value}",
                                "displayContexts": ["detail"] },
          "reasonInspectedByFanIds": { "type": "fanId[]", "writableBy": "effect",
                                            "displayContexts": [] }
        }
      },

      "platform-sensitive-no-fill": {
        "initialState": "suppressed",
        "visibility": { "default": "public" },
        "states": {
          "suppressed": { "label": "Suppressed", "tone": "info" }
        },
        "transitions": [
          {
            "id": "acknowledge-suppression", "label": "Continue", "icon": "check", "tone": "primary",
            "from": ["suppressed"], "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] },
            "effects": [ { "op": "appendUnique", "key": "acknowledgedByFanIds", "value": "$actor" } ]
          },
          {
            "id": "review-policy", "label": "Review policy", "icon": "policy", "tone": "secondary",
            "from": ["suppressed"], "to": null,
            "guard": { "allowedRoleIds": ["member", "moderator"] },
            "effects": [ { "op": "appendUnique", "key": "policyReviewedByFanIds", "value": "$actor" } ]
          }
        ],
        "renderBindings": [
          { "states": ["suppressed"], "audience": "any", "tabId": "home",
            "cardSurfaceFamily": "notificationInbox", "bindingKind": "primary" }
        ],
        "instanceDataSchema": {
          "disclosureText": { "type": "text", "required": true, "writableBy": "effect",
