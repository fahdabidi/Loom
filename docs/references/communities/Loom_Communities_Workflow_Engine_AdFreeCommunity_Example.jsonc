      },
      {
        "tabId": "admin",
        "label": "Admin",
        "rendererContractId": "engine-native-generic-list",
        "iconKey": "admin",
        "description": "Settlement, allocation correction, and audit operations.",
        "visibleRoleIds": ["ad-off-owner"],
        "requiredPermission": "community.surface.navigation.configure"
      }
    ]
  }
