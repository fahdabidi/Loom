{
  "specVersion": 4,
  "packageId": "init_ad_off_4",
  "communityId": "community_ad_off",
  "communityHandle": "ad-off",
  "displayName": "Ad-Off",
  "extensionId": "ext_ad_off",
  "branding": {
    "accentColor": "#2F6F6B"
  },
  "seedDataFiles": [],
  "idempotencyKey": "ad-off-community-spec-4-2026-08-18",
  "experience": {
    "displayName": "Ad-Off",
    "tagline": "Clear ad-free purchases, private entitlements, receipts, and community funding impact.",
    "accentColor": "#2F6F6B",
    "theme": {
      "accent": "#2F6F6B",
      "tabThemes": {
        "giving": {
          "accent": "#2F6F6B"
        },
        "admin": {
          "accent": "#425466"
        }
      }
    },
    "creatableAction": {
      "multiActionStyle": "speedDial",
      "presentationStyle": "slideOutBottom"
    },
    "roles": [
      {
        "roleId": "member",
        "label": "Member"
      },
      {
        "roleId": "owner",
        "label": "Owner"
      }
    ],
    "workflowDefinitions": {
      "ad-off-member-checkout": {
        "initialState": "available",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "actorEqualsField": {
              "key": "payerFanId"
            }
          },
          "fields": {
            "parties": [
              "payerFanId",
              {
                "role": "owner"
              }
            ]
          }
        },
        "states": {
          "available": {
            "label": "Ad-free available",
            "tone": "info",
            "editableFields": [
              "offerTitle",
              "amount",
              "currency",
              "coverage",
              "durationLabel",
              "paymentMethodLabel",
              "recipientLabel",
              "visibilityDisclosure",
              "renewalDate",
              "expiryDate",
              "affectedAdSurfaces"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "member"
              ]
            },
            "readGuard": {
              "allowedRoleIds": [
                "member"
              ]
            }
          },
          "reviewing": {
            "label": "Review purchase",
            "tone": "info",
            "editableFields": [
              "amount",
              "coverage",
              "durationLabel",
              "paymentMethodLabel",
              "visibilityDisclosure",
              "renewalDate",
              "expiryDate",
              "affectedAdSurfaces"
            ],
            "editGuard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            }
          },
          "payment-pending": {
            "label": "Payment pending confirmation",
            "tone": "warning"
          },
          "payment-failed": {
            "label": "Payment failed",
            "tone": "negative",
            "editableFields": [
              "amount",
              "paymentMethodLabel"
            ],
            "editGuard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            }
          },
          "purchased": {
            "label": "Ad-free active",
            "tone": "positive"
          },
          "refund-requested": {
            "label": "Refund requested",
            "tone": "warning"
          },
          "cancelled": {
            "label": "Subscription cancelled",
            "tone": "info",
            "isTerminal": true
          },
          "refunded": {
            "label": "Refunded",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "start-checkout",
            "label": "Review purchase",
            "icon": "shopping_cart_checkout",
            "tone": "primary",
            "from": [
              "available"
            ],
            "to": "reviewing",
            "guard": {
              "allowedRoleIds": [
                "member"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "payerFanId",
                "value": "$actor"
              },
              {
                "op": "set",
                "key": "reviewStartedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "submit-payment",
            "label": "Submit payment",
            "icon": "payments_outlined",
            "tone": "primary",
            "from": [
              "reviewing"
            ],
            "to": "payment-pending",
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "paymentRequestedAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "receiptStatus",
                "value": "awaiting confirmation"
              }
            ]
          },
          {
            "id": "cancel-checkout",
            "label": "Cancel checkout",
            "icon": "close",
            "tone": "destructive",
            "from": [
              "reviewing"
            ],
            "to": "cancelled",
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            }
          },
          {
            "id": "record-payment-confirmed",
            "label": "Record payment confirmed",
            "icon": "verified",
            "tone": "primary",
            "from": [
              "payment-pending"
            ],
            "to": "purchased",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "paidAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "receiptStatus",
                "value": "issued; receipt ID pending platform service"
              },
              {
                "op": "set",
                "key": "entitlementStatus",
                "value": "active"
              },
              {
                "op": "createInstance",
                "workflowType": "ad-off-entitlement-status",
                "fields": {
                  "entitlementTitle": "Personal ad-free entitlement",
                  "memberFanId": "{payerFanId}",
                  "entitlementScope": "personal",
                  "planLabel": "{offerTitle}",
                  "renewalDate": "{renewalDate}",
                  "expiryDate": "{expiryDate}",
                  "affectedSurfaces": "{affectedAdSurfaces}",
                  "managementPathLabel": "Manage or renew through Ad-Off checkout",
                  "sourceCheckoutId": "{id}"
                }
              },
              {
                "op": "createInstance",
                "workflowType": "ad-off-receipt-evidence",
                "fields": {
                  "receiptTitle": "Personal ad-free purchase receipt",
                  "receiptKind": "personal",
                  "amount": "{amount}",
                  "currency": "{currency}",
                  "payerFanId": "{payerFanId}",
                  "issuedAt": "$timestamp",
                  "sourceCheckoutId": "{id}",
                  "entitlementLinkLabel": "View personal ad-free entitlement"
                }
              },
              {
                "op": "createInstance",
                "workflowType": "ad-off-ad-suppression",
                "fields": {
                  "memberFanId": "{payerFanId}",
                  "sourceCheckoutId": "{id}",
                  "suppressedSurfaces": "{affectedAdSurfaces}",
                  "suppressionReason": "Active personal ad-free entitlement",
                  "suppressedAt": "$timestamp",
                  "managementPathLabel": "Manage from personal ad-free entitlement",
                  "noFillReason": "Ad slot suppressed by active ad-free entitlement"
                }
              }
            ]
          },
          {
            "id": "record-payment-failed",
            "label": "Record payment failed",
            "icon": "error_outline",
            "tone": "destructive",
            "from": [
              "payment-pending"
            ],
            "to": "payment-failed",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "inputs": {
              "reason": {
                "type": "text",
                "required": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "paymentFailureReason",
                "value": "{input.reason}"
              },
              {
                "op": "set",
                "key": "receiptStatus",
                "value": "not issued"
              }
            ]
          },
          {
            "id": "retry-payment",
            "label": "Retry payment",
            "icon": "refresh",
            "tone": "primary",
            "from": [
              "payment-failed"
            ],
            "to": "reviewing",
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "retryStartedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "cancel-failed-checkout",
            "label": "Cancel failed checkout",
            "icon": "close",
            "tone": "destructive",
            "from": [
              "payment-failed"
            ],
            "to": "cancelled",
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            }
          },
          {
            "id": "manage-subscription",
            "label": "Manage subscription",
            "icon": "manage_accounts",
            "tone": "secondary",
            "from": [
              "purchased"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            },
            "linkedWorkflowId": "ad-off-entitlement-status",
            "effects": [
              {
                "op": "set",
                "key": "managedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "request-refund",
            "label": "Request refund",
            "icon": "request_quote",
            "tone": "secondary",
            "from": [
              "purchased"
            ],
            "to": "refund-requested",
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "refundRequestedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "cancel-subscription",
            "label": "Cancel subscription",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "purchased"
            ],
            "to": "cancelled",
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "entitlementStatus",
                "value": "inactive"
              },
              {
                "op": "set",
                "key": "cancelledAt",
                "value": "$timestamp"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "ad-off-entitlement-status",
                  "filter": {
                    "sourceCheckoutId": "{id}",
                    "$state": "active"
                  },
                  "limit": 1
                },
                "transitionId": "deactivate-entitlement"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "ad-off-ad-suppression",
                  "filter": {
                    "sourceCheckoutId": "{id}",
                    "$state": "suppressed"
                  },
                  "limit": 1
                },
                "transitionId": "restore-ads"
              }
            ]
          },
          {
            "id": "approve-refund",
            "label": "Approve refund",
            "icon": "check_circle",
            "tone": "primary",
            "from": [
              "refund-requested"
            ],
            "to": "refunded",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "refundedAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "receiptStatus",
                "value": "refunded"
              },
              {
                "op": "set",
                "key": "entitlementStatus",
                "value": "inactive"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "ad-off-entitlement-status",
                  "filter": {
                    "sourceCheckoutId": "{id}",
                    "$state": "active"
                  },
                  "limit": 1
                },
                "transitionId": "record-entitlement-refunded"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "ad-off-ad-suppression",
                  "filter": {
                    "sourceCheckoutId": "{id}",
                    "$state": "suppressed"
                  },
                  "limit": 1
                },
                "transitionId": "record-ads-restored"
              }
            ]
          },
          {
            "id": "decline-refund",
            "label": "Decline refund",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "refund-requested"
            ],
            "to": "purchased",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            }
          }
        ],
        "renderBindings": [
          {
            "states": [
              "available"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Start personal ad-free checkout",
                "byRoleIds": [
                  "member"
                ],
                "scope": "tab",
                "presentation": "fab"
              }
            ]
          },
          {
            "states": [
              "reviewing",
              "payment-pending",
              "payment-failed",
              "purchased",
              "refund-requested"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": [
              "cancelled",
              "refunded"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          },
          {
            "states": [
              "available",
              "reviewing",
              "payment-failed",
              "purchased"
            ],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "offerTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "amount": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "payments_outlined",
            "labelTemplate": "Price: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "currency": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "currency_exchange",
            "labelTemplate": "Currency: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "coverage": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "ads_click",
            "labelTemplate": "Coverage: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "durationLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "Duration: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "paymentMethodLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "credit_card",
            "labelTemplate": "Payment method: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "recipientLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "account_balance",
            "labelTemplate": "Recipient: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "visibilityDisclosure": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 300,
            "displayIcon": "privacy_tip_outlined",
            "labelTemplate": "Visibility: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "renewalDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "event_repeat",
            "labelTemplate": "Renews: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "expiryDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "event_busy",
            "labelTemplate": "Expires: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "affectedAdSurfaces": {
            "type": "list",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "view_quilt_outlined",
            "labelTemplate": "Ad surfaces covered: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "payerFanId": {
            "type": "fanId?",
            "writableBy": "effect",
            "displayIcon": "person_outline",
            "labelTemplate": "Payer: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "reviewStartedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "rate_review_outlined",
            "labelTemplate": "Review started: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "paymentRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "outgoing_mail",
            "labelTemplate": "Payment submitted: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "paidAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "task_alt",
            "labelTemplate": "Recorded paid: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "receiptStatus": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "receipt_long",
            "labelTemplate": "Receipt: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "entitlementStatus": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "verified_user_outlined",
            "labelTemplate": "Entitlement: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "paymentFailureReason": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "error_outline",
            "labelTemplate": "Failure: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "retryStartedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "refresh",
            "labelTemplate": "Retry started: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "managedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "manage_history",
            "labelTemplate": "Last managed: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "refundRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "request_quote",
            "labelTemplate": "Refund requested: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "cancelledAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event_busy",
            "labelTemplate": "Cancelled: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "refundedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "currency_exchange",
            "labelTemplate": "Refunded: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          // NEEDS IMPLEMENTATION (platform service): the payment gateway must supply a real confirmation identifier; this field is declared and never written by an effect.
          "paymentConfirmationId": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "fingerprint",
            "labelTemplate": "Payment confirmation: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          }
        }
      },
      "ad-off-community-checkout": {
        "initialState": "available",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "actorEqualsField": {
              "key": "fundingMemberFanId"
            }
          },
          "fields": {
            "parties": [
              "fundingMemberFanId",
              {
                "role": "owner"
              }
            ]
          }
        },
        "states": {
          "available": {
            "label": "Community ad-free funding available",
            "tone": "info",
            "editableFields": [
              "offerTitle",
              "fundedAmount",
              "currency",
              "fundedCoverage",
              "paymentMethodLabel",
              "recipientLabel",
              "visibilityDisclosure",
              "fundingPeriodStart",
              "fundingPeriodEnd",
              "affectedAdSurfaces",
              "utilityAllocationSummary"
            ],
            "editGuard": {
              "allowedRoleIds": [
                "member",
                "owner"
              ]
            },
            "readGuard": {
              "allowedRoleIds": [
                "member",
                "owner"
              ]
            }
          },
          "reviewing": {
            "label": "Review community funding",
            "tone": "info",
            "editableFields": [
              "fundedAmount",
              "fundedCoverage",
              "paymentMethodLabel",
              "fundingPeriodStart",
              "fundingPeriodEnd",
              "affectedAdSurfaces",
              "utilityAllocationSummary"
            ],
            "editGuard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            }
          },
          "funding-pending": {
            "label": "Funding pending confirmation",
            "tone": "warning"
          },
          "funding-failed": {
            "label": "Funding failed",
            "tone": "negative",
            "editableFields": [
              "fundedAmount",
              "paymentMethodLabel"
            ],
            "editGuard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            }
          },
          "funded": {
            "label": "Community ad-free funded",
            "tone": "positive"
          },
          "refund-requested": {
            "label": "Community funding refund requested",
            "tone": "warning"
          },
          "cancelled": {
            "label": "Community funding cancelled",
            "tone": "info",
            "isTerminal": true
          },
          "refunded": {
            "label": "Community funding refunded",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "start-community-checkout",
            "label": "Review community funding",
            "icon": "volunteer_activism",
            "tone": "primary",
            "from": [
              "available"
            ],
            "to": "reviewing",
            "guard": {
              "allowedRoleIds": [
                "member",
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "fundingMemberFanId",
                "value": "$actor"
              },
              {
                "op": "set",
                "key": "reviewStartedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "submit-community-funding",
            "label": "Submit community funding",
            "icon": "payments_outlined",
            "tone": "primary",
            "from": [
              "reviewing"
            ],
            "to": "funding-pending",
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "fundingRequestedAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "fundingStatusLabel",
                "value": "awaiting confirmation"
              }
            ]
          },
          {
            "id": "cancel-community-checkout",
            "label": "Cancel checkout",
            "icon": "close",
            "tone": "destructive",
            "from": [
              "reviewing"
            ],
            "to": "cancelled",
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            }
          },
          {
            "id": "record-funding-confirmed",
            "label": "Record funding confirmed",
            "icon": "verified",
            "tone": "primary",
            "from": [
              "funding-pending"
            ],
            "to": "funded",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "fundedAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "fundingStatusLabel",
                "value": "funded; settlement ID pending platform service"
              },
              {
                "op": "createInstance",
                "workflowType": "ad-off-receipt-evidence",
                "fields": {
                  "receiptTitle": "Community ad-free funding receipt",
                  "receiptKind": "community",
                  "amount": "{fundedAmount}",
                  "currency": "{currency}",
                  "payerFanId": "{fundingMemberFanId}",
                  "issuedAt": "$timestamp",
                  "sourceCheckoutId": "{id}",
                  "entitlementLinkLabel": "View community ad-free status",
                  "settlementSummary": "{utilityAllocationSummary}"
                }
              },
              {
                "op": "createInstance",
                "workflowType": "ad-off-settlement-utility",
                "fields": {
                  "fundingMemberFanId": "{fundingMemberFanId}",
                  "sourceCheckoutId": "{id}",
                  "fundedAmount": "{fundedAmount}",
                  "currency": "{currency}",
                  "fundedCoverage": "{fundedCoverage}",
                  "utilityImpact": "{utilityAllocationSummary}",
                  "allocationStatus": "pending allocation review",
                  "auditStatus": "open"
                }
              },
              {
                "op": "createInstance",
                "workflowType": "ad-off-community-entitlement-status",
                "fields": {
                  "statusTitle": "Community-funded ad-free coverage",
                  "fundingMemberFanId": "{fundingMemberFanId}",
                  "fundedCoverage": "{fundedCoverage}",
                  "fundingPeriodStart": "{fundingPeriodStart}",
                  "fundingPeriodEnd": "{fundingPeriodEnd}",
                  "utilityImpact": "{utilityAllocationSummary}",
                  "affectedSurfaces": "{affectedAdSurfaces}",
                  "sourceCheckoutId": "{id}"
                }
              }
            ]
          },
          {
            "id": "record-funding-failed",
            "label": "Record funding failed",
            "icon": "error_outline",
            "tone": "destructive",
            "from": [
              "funding-pending"
            ],
            "to": "funding-failed",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "inputs": {
              "reason": {
                "type": "text",
                "required": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "fundingFailureReason",
                "value": "{input.reason}"
              },
              {
                "op": "set",
                "key": "fundingStatusLabel",
                "value": "not funded"
              }
            ]
          },
          {
            "id": "retry-community-funding",
            "label": "Retry funding",
            "icon": "refresh",
            "tone": "primary",
            "from": [
              "funding-failed"
            ],
            "to": "reviewing",
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "retryStartedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "cancel-failed-community-checkout",
            "label": "Cancel failed checkout",
            "icon": "close",
            "tone": "destructive",
            "from": [
              "funding-failed"
            ],
            "to": "cancelled",
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            }
          },
          {
            "id": "manage-community-funding",
            "label": "Manage community funding",
            "icon": "manage_accounts",
            "tone": "secondary",
            "from": [
              "funded"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            },
            "linkedWorkflowId": "ad-off-community-entitlement-status",
            "effects": [
              {
                "op": "set",
                "key": "managedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "request-community-refund",
            "label": "Request funding refund",
            "icon": "request_quote",
            "tone": "secondary",
            "from": [
              "funded"
            ],
            "to": "refund-requested",
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "refundRequestedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "cancel-community-funding",
            "label": "Cancel community funding",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "funded"
            ],
            "to": "cancelled",
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "cancelledAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "fundingStatusLabel",
                "value": "cancelled"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "ad-off-community-entitlement-status",
                  "filter": {
                    "sourceCheckoutId": "{id}",
                    "$state": "active"
                  },
                  "limit": 1
                },
                "transitionId": "cancel-community-entitlement"
              }
            ]
          },
          {
            "id": "approve-community-refund",
            "label": "Approve funding refund",
            "icon": "check_circle",
            "tone": "primary",
            "from": [
              "refund-requested"
            ],
            "to": "refunded",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "refundedAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "fundingStatusLabel",
                "value": "refunded"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "ad-off-community-entitlement-status",
                  "filter": {
                    "sourceCheckoutId": "{id}",
                    "$state": "active"
                  },
                  "limit": 1
                },
                "transitionId": "record-community-refund"
              }
            ]
          },
          {
            "id": "decline-community-refund",
            "label": "Decline funding refund",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "refund-requested"
            ],
            "to": "funded",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            }
          }
        ],
        "renderBindings": [
          {
            "states": [
              "available"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Fund community ad-free coverage",
                "byRoleIds": [
                  "member",
                  "owner"
                ],
                "scope": "tab",
                "presentation": "fab"
              }
            ]
          },
          {
            "states": [
              "reviewing",
              "funding-pending",
              "funding-failed",
              "funded",
              "refund-requested"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": [
              "cancelled",
              "refunded"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          },
          {
            "states": [
              "available",
              "reviewing",
              "funding-pending",
              "funding-failed",
              "funded",
              "refund-requested"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": [
              "cancelled",
              "refunded"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "offerTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "fundedAmount": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "volunteer_activism",
            "labelTemplate": "Funded amount: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "currency": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "currency_exchange",
            "labelTemplate": "Currency: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "fundedCoverage": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "groups_outlined",
            "labelTemplate": "Coverage: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "paymentMethodLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "credit_card",
            "labelTemplate": "Payment method: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "recipientLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "account_balance",
            "labelTemplate": "Recipient: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "visibilityDisclosure": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 300,
            "displayIcon": "privacy_tip_outlined",
            "labelTemplate": "Visibility: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "fundingPeriodStart": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "event_available",
            "labelTemplate": "Coverage starts: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "fundingPeriodEnd": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "event_busy",
            "labelTemplate": "Coverage ends: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "affectedAdSurfaces": {
            "type": "list",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "view_quilt_outlined",
            "labelTemplate": "Ad surfaces covered: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "utilityAllocationSummary": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "account_tree_outlined",
            "labelTemplate": "Utility impact: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "fundingMemberFanId": {
            "type": "fanId?",
            "writableBy": "effect",
            "displayIcon": "person_outline",
            "labelTemplate": "Community payer: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "reviewStartedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "rate_review_outlined",
            "labelTemplate": "Review started: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "fundingRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "outgoing_mail",
            "labelTemplate": "Funding submitted: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "fundedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "task_alt",
            "labelTemplate": "Recorded funded: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "fundingStatusLabel": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "monitor_heart_outlined",
            "labelTemplate": "Funding status: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "fundingFailureReason": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "error_outline",
            "labelTemplate": "Failure: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "retryStartedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "refresh",
            "labelTemplate": "Retry started: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "managedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "manage_history",
            "labelTemplate": "Last managed: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "refundRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "request_quote",
            "labelTemplate": "Refund requested: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "cancelledAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event_busy",
            "labelTemplate": "Cancelled: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "refundedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "currency_exchange",
            "labelTemplate": "Refunded: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          // NEEDS IMPLEMENTATION (platform service): the payment gateway must supply a real funding confirmation identifier; this field is declared and never written by an effect.
          "paymentConfirmationId": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "fingerprint",
            "labelTemplate": "Funding confirmation: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          }
        }
      },
      "ad-off-entitlement-status": {
        "initialState": "active",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "actorEqualsField": {
              "key": "memberFanId"
            }
          },
          "fields": {
            "parties": [
              "memberFanId",
              {
                "role": "owner"
              }
            ]
          }
        },
        "states": {
          "active": {
            "label": "Ad-free active",
            "tone": "positive"
          },
          "inactive": {
            "label": "Ad-free inactive",
            "tone": "warning"
          }
        },
        "transitions": [
          {
            "id": "manage-or-renew-entitlement",
            "label": "Manage or renew entitlement",
            "icon": "manage_accounts",
            "tone": "primary",
            "from": [
              "active"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "memberFanId"
              }
            },
            "linkedWorkflowId": "ad-off-member-checkout",
            "effects": [
              {
                "op": "set",
                "key": "lastManagedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "deactivate-entitlement",
            "label": "Cancel entitlement",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "active"
            ],
            "to": "inactive",
            "guard": {
              "actorEqualsField": {
                "key": "memberFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "inactiveAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "inactiveReason",
                "value": "cancelled by member"
              }
            ]
          },
          {
            "id": "record-entitlement-refunded",
            "label": "Record entitlement refunded",
            "icon": "currency_exchange",
            "tone": "destructive",
            "from": [
              "active"
            ],
            "to": "inactive",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "inactiveAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "inactiveReason",
                "value": "purchase refunded"
              }
            ]
          },
          {
            "id": "start-new-checkout",
            "label": "Subscribe again",
            "icon": "shopping_cart_checkout",
            "tone": "primary",
            "from": [
              "inactive"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "memberFanId"
              }
            },
            "linkedWorkflowId": "ad-off-member-checkout"
          }
        ],
        "renderBindings": [
          {
            "states": [
              "active",
              "inactive"
            ],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": [
              "active",
              "inactive"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "entitlementTitle": {
            "type": "text",
            "required": true,
            "displayIcon": "verified_user_outlined",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "memberFanId": {
            "type": "fanId",
            "required": true,
            "displayIcon": "person_outline",
            "labelTemplate": "Entitled member: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "entitlementScope": {
            "type": "text",
            "required": true,
            "displayIcon": "person_pin_circle_outlined",
            "labelTemplate": "Scope: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "planLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "subscriptions_outlined",
            "labelTemplate": "Plan: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "renewalDate": {
            "type": "date",
            "required": true,
            "sortable": true,
            "displayIcon": "event_repeat",
            "labelTemplate": "Renews: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "expiryDate": {
            "type": "date",
            "required": true,
            "sortable": true,
            "displayIcon": "event_busy",
            "labelTemplate": "Expires: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "affectedSurfaces": {
            "type": "list",
            "required": true,
            "displayIcon": "view_quilt_outlined",
            "labelTemplate": "Ads suppressed on: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "managementPathLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "settings_outlined",
            "labelTemplate": "Management: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "sourceCheckoutId": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "link",
            "labelTemplate": "Purchase record: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "lastManagedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "manage_history",
            "labelTemplate": "Last managed: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "inactiveAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event_busy",
            "labelTemplate": "Inactive since: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "inactiveReason": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "info_outline",
            "labelTemplate": "Inactive reason: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "daysUntilExpiry": {
            "type": "number",
            "formula": "daysUntil(expiryDate)",
            "displayIcon": "hourglass_bottom",
            "labelTemplate": "Days until expiry: {value}",
            "displayContexts": [
              "detail"
            ]
          }
        }
      },
      "ad-off-receipt-evidence": {
        "initialState": "issued",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "actorEqualsField": {
              "key": "payerFanId"
            }
          },
          "fields": {
            "parties": [
              "payerFanId",
              {
                "role": "owner"
              }
            ]
          }
        },
        "states": {
          "issued": {
            "label": "Receipt issued",
            "tone": "positive"
          },
          "refund-requested": {
            "label": "Refund requested",
            "tone": "warning"
          },
          "refunded": {
            "label": "Receipt refunded",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "view-receipt",
            "label": "View receipt details",
            "icon": "receipt_long",
            "tone": "primary",
            "from": [
              "issued"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "lastViewedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "request-receipt-export",
            "label": "Request receipt export",
            "icon": "download_outlined",
            "tone": "secondary",
            "from": [
              "issued"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              },
              "formula": "receiptDocumentUrl == null"
            },
            "effects": [
              {
                "op": "set",
                "key": "exportRequestedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "view-personal-entitlement",
            "label": "View personal entitlement",
            "icon": "verified_user_outlined",
            "tone": "secondary",
            "from": [
              "issued"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              },
              "instanceDataEquals": {
                "key": "receiptKind",
                "value": "personal"
              }
            },
            "linkedWorkflowId": "ad-off-entitlement-status"
          },
          {
            "id": "view-community-entitlement",
            "label": "View community status",
            "icon": "groups_outlined",
            "tone": "secondary",
            "from": [
              "issued"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              },
              "instanceDataEquals": {
                "key": "receiptKind",
                "value": "community"
              }
            },
            "linkedWorkflowId": "ad-off-community-entitlement-status"
          },
          {
            "id": "request-receipt-refund",
            "label": "Request refund",
            "icon": "request_quote",
            "tone": "secondary",
            "from": [
              "issued"
            ],
            "to": "refund-requested",
            "guard": {
              "actorEqualsField": {
                "key": "payerFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "refundRequestedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "approve-receipt-refund",
            "label": "Approve refund",
            "icon": "check_circle",
            "tone": "primary",
            "from": [
              "refund-requested"
            ],
            "to": "refunded",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "refundedAt",
                "value": "$timestamp"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "ad-off-entitlement-status",
                  "filter": {
                    "sourceCheckoutId": "{sourceCheckoutId}",
                    "$state": "active"
                  },
                  "limit": 1
                },
                "transitionId": "record-entitlement-refunded"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "ad-off-ad-suppression",
                  "filter": {
                    "sourceCheckoutId": "{sourceCheckoutId}",
                    "$state": "suppressed"
                  },
                  "limit": 1
                },
                "transitionId": "record-ads-restored"
              }
            ]
          },
          {
            "id": "decline-receipt-refund",
            "label": "Decline refund",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "refund-requested"
            ],
            "to": "issued",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            }
          }
        ],
        "renderBindings": [
          {
            "states": [
              "issued",
              "refund-requested"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": [
              "refunded"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          },
          {
            "states": [
              "issued",
              "refund-requested"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": [
              "refunded"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "receiptTitle": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "receipt_long",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "receiptKind": {
            "type": "text",
            "required": true,
            "displayIcon": "category_outlined",
            "labelTemplate": "Receipt type: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "amount": {
            "type": "number",
            "required": true,
            "displayIcon": "payments_outlined",
            "labelTemplate": "Amount: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "currency": {
            "type": "text",
            "required": true,
            "displayIcon": "currency_exchange",
            "labelTemplate": "Currency: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "payerFanId": {
            "type": "fanId",
            "required": true,
            "displayIcon": "person_outline",
            "labelTemplate": "Payer: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "issuedAt": {
            "type": "date",
            "required": true,
            "sortable": true,
            "displayIcon": "event_available",
            "labelTemplate": "Issued: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "sourceCheckoutId": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "link",
            "labelTemplate": "Purchase record: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "entitlementLinkLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "verified_user_outlined",
            "labelTemplate": "Entitlement: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "settlementSummary": {
            "type": "textarea",
            "displayIcon": "account_tree_outlined",
            "labelTemplate": "Settlement / utility: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "lastViewedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "visibility_outlined",
            "labelTemplate": "Last viewed: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "exportRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "download_outlined",
            "labelTemplate": "Export requested: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "refundRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "request_quote",
            "labelTemplate": "Refund requested: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "refundedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "currency_exchange",
            "labelTemplate": "Refunded: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          // NEEDS IMPLEMENTATION (platform service): real receipt-ID generation is not implemented; this field is declared and never written by an effect.
          "receiptId": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "fingerprint",
            "labelTemplate": "Receipt ID: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          // NEEDS IMPLEMENTATION (platform service): the payment/receipt service must supply a real receipt artifact URL; this field is declared and never written by an effect.
          "receiptDocumentUrl": {
            "type": "url?",
            "writableBy": "effect",
            "openMode": "choice",
            "displayIcon": "open_in_new",
            "labelTemplate": "Open receipt: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          }
        }
      },
      "ad-off-ad-suppression": {
        "initialState": "suppressed",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "actorEqualsField": {
              "key": "memberFanId"
            }
          },
          "fields": {
            "parties": [
              "memberFanId",
              {
                "role": "owner"
              }
            ]
          }
        },
        "states": {
          "suppressed": {
            "label": "Ads suppressed",
            "tone": "positive"
          },
          "inactive": {
            "label": "Ad suppression inactive",
            "tone": "warning"
          }
        },
        "transitions": [
          {
            "id": "manage-ad-free",
            "label": "Manage ad-free",
            "icon": "manage_accounts",
            "tone": "primary",
            "from": [
              "suppressed"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "memberFanId"
              }
            },
            "linkedWorkflowId": "ad-off-entitlement-status",
            "effects": [
              {
                "op": "set",
                "key": "lastManagedAt",
                "value": "$timestamp"
              }
            ]
          },
          {
            "id": "restore-ads",
            "label": "Restore ads",
            "icon": "restore",
            "tone": "destructive",
            "from": [
              "suppressed"
            ],
            "to": "inactive",
            "guard": {
              "actorEqualsField": {
                "key": "memberFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "restoredAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "restorationReason",
                "value": "restored by member"
              }
            ]
          },
          {
            "id": "record-ads-restored",
            "label": "Record ads restored",
            "icon": "restore",
            "tone": "destructive",
            "from": [
              "suppressed"
            ],
            "to": "inactive",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "restoredAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "restorationReason",
                "value": "purchase cancelled or refunded"
              }
            ]
          },
          {
            "id": "start-restoration-checkout",
            "label": "Turn ads off again",
            "icon": "shopping_cart_checkout",
            "tone": "primary",
            "from": [
              "inactive"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "memberFanId"
              }
            },
            "linkedWorkflowId": "ad-off-member-checkout"
          }
        ],
        "renderBindings": [
          {
            "states": [
              "suppressed",
              "inactive"
            ],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": [
              "suppressed",
              "inactive"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "memberFanId": {
            "type": "fanId",
            "required": true,
            "displayIcon": "person_outline",
            "labelTemplate": "Member: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "sourceCheckoutId": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "link",
            "labelTemplate": "Purchase record: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "suppressedSurfaces": {
            "type": "list",
            "required": true,
            "displayIcon": "view_quilt_outlined",
            "labelTemplate": "Suppressed ad surfaces: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "suppressionReason": {
            "type": "text",
            "required": true,
            "displayIcon": "block",
            "labelTemplate": "Reason: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "suppressedAt": {
            "type": "date",
            "required": true,
            "sortable": true,
            "displayIcon": "schedule",
            "labelTemplate": "Suppressed since: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "managementPathLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "settings_outlined",
            "labelTemplate": "Management path: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "noFillReason": {
            "type": "text",
            "required": true,
            "displayIcon": "ad_units_outlined",
            "labelTemplate": "Ad decision: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "lastManagedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "manage_history",
            "labelTemplate": "Last managed: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "restoredAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "restore",
            "labelTemplate": "Ads restored: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "restorationReason": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "info_outline",
            "labelTemplate": "Restoration reason: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          }
        }
      },
      "ad-off-settlement-utility": {
        "initialState": "pending-review",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "actorEqualsField": {
              "key": "fundingMemberFanId"
            }
          },
          "fields": {
            "parties": [
              "fundingMemberFanId",
              {
                "role": "owner"
              }
            ]
          }
        },
        "states": {
          "pending-review": {
            "label": "Allocation pending review",
            "tone": "warning"
          },
          "under-review": {
            "label": "Allocation under review",
            "tone": "info"
          },
          "corrections-requested": {
            "label": "Corrections requested",
            "tone": "warning"
          },
          "settled": {
            "label": "Allocation settled",
            "tone": "positive",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "start-allocation-review",
            "label": "Start allocation review",
            "icon": "fact_check_outlined",
            "tone": "primary",
            "from": [
              "pending-review"
            ],
            "to": "under-review",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "reviewedAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "auditStatus",
                "value": "review in progress"
              }
            ]
          },
          {
            "id": "request-allocation-correction",
            "label": "Request correction",
            "icon": "edit_note",
            "tone": "secondary",
            "from": [
              "under-review"
            ],
            "to": "corrections-requested",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "inputs": {
              "correctionNote": {
                "type": "text",
                "required": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "correctionNote",
                "value": "{input.correctionNote}"
              },
              {
                "op": "set",
                "key": "auditStatus",
                "value": "correction required"
              }
            ]
          },
          {
            "id": "apply-allocation-correction",
            "label": "Apply correction",
            "icon": "published_with_changes",
            "tone": "primary",
            "from": [
              "corrections-requested"
            ],
            "to": "under-review",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "inputs": {
              "allocationStatus": {
                "type": "text",
                "required": true
              },
              "utilityImpact": {
                "type": "text",
                "required": true
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "allocationStatus",
                "value": "{input.allocationStatus}"
              },
              {
                "op": "set",
                "key": "utilityImpact",
                "value": "{input.utilityImpact}"
              },
              {
                "op": "set",
                "key": "correctionAppliedAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "auditStatus",
                "value": "correction applied"
              }
            ]
          },
          {
            "id": "settle-allocation",
            "label": "Settle allocation",
            "icon": "task_alt",
            "tone": "primary",
            "from": [
              "under-review"
            ],
            "to": "settled",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "settledAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "allocationStatus",
                "value": "settled"
              },
              {
                "op": "set",
                "key": "auditStatus",
                "value": "audit complete; settlement ID pending platform service"
              }
            ]
          },
          {
            "id": "view-community-checkout",
            "label": "View funding checkout",
            "icon": "payments_outlined",
            "tone": "secondary",
            "from": [
              "pending-review",
              "under-review",
              "corrections-requested"
            ],
            "to": null,
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            },
            "linkedWorkflowId": "ad-off-community-checkout"
          }
        ],
        "renderBindings": [
          {
            "states": [
              "pending-review",
              "under-review",
              "corrections-requested"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": [
              "settled"
            ],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          },
          {
            "states": [
              "pending-review",
              "under-review",
              "corrections-requested",
              "settled"
            ],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "fundingMemberFanId": {
            "type": "fanId",
            "required": true,
            "displayIcon": "person_outline",
            "labelTemplate": "Funding member: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "sourceCheckoutId": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "link",
            "labelTemplate": "Funding record: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "fundedAmount": {
            "type": "number",
            "required": true,
            "displayIcon": "payments_outlined",
            "labelTemplate": "Funded amount: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "currency": {
            "type": "text",
            "required": true,
            "displayIcon": "currency_exchange",
            "labelTemplate": "Currency: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "fundedCoverage": {
            "type": "text",
            "required": true,
            "displayIcon": "groups_outlined",
            "labelTemplate": "Funded coverage: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "utilityImpact": {
            "type": "textarea",
            "required": true,
            "writableBy": "effect",
            "maxLength": 500,
            "displayIcon": "account_tree_outlined",
            "labelTemplate": "Utility impact: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "allocationStatus": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "pie_chart_outline",
            "labelTemplate": "Allocation: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "auditStatus": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "fact_check_outlined",
            "labelTemplate": "Audit: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "reviewedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "rate_review_outlined",
            "labelTemplate": "Review started: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "correctionNote": {
            "type": "textarea",
            "writableBy": "effect",
            "maxLength": 500,
            "displayIcon": "edit_note",
            "labelTemplate": "Correction: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "correctionAppliedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "published_with_changes",
            "labelTemplate": "Correction applied: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "settledAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "task_alt",
            "labelTemplate": "Settled: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          // NEEDS IMPLEMENTATION (platform service): real settlement-ID generation is not implemented; this field is declared and never written by an effect.
          "settlementId": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "fingerprint",
            "labelTemplate": "Settlement ID: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "tile",
              "detail"
            ]
          }
        }
      },
      "ad-off-community-entitlement-status": {
        "initialState": "active",
        "visibility": {
          "default": "membersOnly"
        },
        "states": {
          "active": {
            "label": "Community ad-free active",
            "tone": "positive"
          },
          "inactive": {
            "label": "Community ad-free inactive",
            "tone": "warning"
          },
          "refunded": {
            "label": "Community funding refunded",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "manage-community-entitlement",
            "label": "Manage community coverage",
            "icon": "manage_accounts",
            "tone": "primary",
            "from": [
              "active"
            ],
            "to": null,
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "linkedWorkflowId": "ad-off-community-checkout"
          },
          {
            "id": "end-community-entitlement",
            "label": "End community coverage",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "active"
            ],
            "to": "inactive",
            "guard": {
              "allowedRoleIds": [
                "owner"
              ]
            },
            "effects": [
              {
                "op": "set",
                "key": "inactiveAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "inactiveReason",
                "value": "ended by owner"
              }
            ]
          },
          {
            "id": "cancel-community-entitlement",
            "label": "Record funding cancelled",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "active"
            ],
            "to": "inactive",
            "guard": {
              "actorEqualsField": {
                "key": "fundingMemberFanId"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "inactiveAt",
                "value": "$timestamp"
              },
              {
                "op": "set",
                "key": "inactiveReason",
                "value": "funding cancelled"
              }
