        "instanceDataSchema": {
          "statusTitle": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "verified_user_outlined",
            "labelTemplate": "{value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "fundingMemberFanId": {
            "type": "fanId",
            "required": true,
            "displayContexts": []
          },
          "fundedCoverage": {
            "type": "text",
            "required": true,
            "displayIcon": "groups_outlined",
            "labelTemplate": "Coverage: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "fundingPeriodStart": {
            "type": "date",
            "required": true,
            "sortable": true,
            "displayIcon": "event_available",
            "labelTemplate": "Starts: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "fundingPeriodEnd": {
            "type": "date",
            "required": true,
            "sortable": true,
            "displayIcon": "event_busy",
            "labelTemplate": "Ends: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "utilityImpact": {
            "type": "textarea",
            "required": true,
            "displayIcon": "account_tree_outlined",
            "labelTemplate": "Utility impact: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "affectedSurfaces": {
            "type": "list",
            "required": true,
            "displayIcon": "view_quilt_outlined",
            "labelTemplate": "Ads suppressed on: {value}",
            "displayContexts": [
              "tile",
              "detail"
            ]
          },
          "sourceCheckoutId": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "link",
            "labelTemplate": "Funding record: {value}",
            "displayContexts": [
              "detail"
            ]
          },
          "inactiveAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event_busy",
            "labelTemplate": "Inactive since: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "inactiveReason": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "info_outline",
            "labelTemplate": "Inactive reason: {value}",
            "hideWhenEmpty": true,
            "displayContexts": [
              "detail"
            ]
          },
          "daysRemaining": {
            "type": "number",
            "formula": "daysUntil(fundingPeriodEnd)",
            "displayIcon": "hourglass_bottom",
            "labelTemplate": "Days remaining: {value}",
            "displayContexts": [
              "detail"
            ]
          }
        }
      }
