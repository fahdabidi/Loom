        "instanceData": {
          "photoTitle": "Lighthouse at dusk",
          "photoImage": "seed://photos/lighthouse-dusk.jpg",
          "promptOrTopic": "Weekly theme: silhouettes",
          "notes": "Shot at f/8, 1/250s, ISO 200. I would like feedback on the exposure balance between the sky and the lighthouse.",
          "consentNote": "Photographed in a public park; no identifiable people appear in frame.",
          "authorFanId": "camera-club-member",
          "submittedAt": "2026-08-17T17:00:00Z",
          "comments": [
            {
              "senderFanId": "camera-club-organizer",
              "body": "The silhouette reads clearly. Please also consider whether a tighter crop would strengthen the horizon line.",
              "timestamp": "2026-08-18T02:15:00Z"
            }
          ]
        }
      },
      {
        "instanceId": "critique-night-market-reflections",
        "workflowType": "critique-submission",
        "currentState": "reviewed",
        "createdByFanId": "camera-club-member",
        "instanceData": {
          "photoTitle": "Night market reflections",
          "photoImage": "seed://photos/night-market-reflections.jpg",
          "promptOrTopic": "Color and motion",
          "notes": "Handheld at 1/30s to retain some motion blur in the crowd.",
          "consentNote": "Wide public scene; faces are not individually identifiable.",
          "authorFanId": "camera-club-member",
          "submittedAt": "2026-08-10T20:00:00Z",
          "reviewedByFanId": "camera-club-organizer",
          "reviewedAt": "2026-08-12T19:30:00Z",
          "comments": [
            {
              "senderFanId": "camera-club-organizer",
              "body": "Strong layering and color separation. The slower shutter supports the sense of movement without losing the vendor as an anchor.",
              "timestamp": "2026-08-12T19:30:00Z"
            }
          ]
        }
