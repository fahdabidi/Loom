{
  "schemaVersion": 1,
  "packageId": "init_riverside_youth_soccer_v2",
  "communityId": "community_riverside_youth_soccer",
  "communityHandle": "riverside-youth-soccer",
  "displayName": "Riverside Youth Soccer",
  "extensionId": "ext_youth_soccer",
  "branding": {
    // NEEDS IMPLEMENTATION (asset): the target requires a team badge but supplies no badge asset.
    // No nonexistent branding.logo path is fabricated.
    "accentColor": "#176B87"
  },
  "seedDataFiles": [],
  "idempotencyKey": "init-riverside-youth-soccer-v2",

  "appShell": {
    // NEEDS IMPLEMENTATION (grammar v1): exact per-persona tab labels/order and persona-specific pin
    // ordering are not expressible. visiblePersonaIds and tab-level pins are the tightest real shape.
    "tabs": [
      {
        "tabId": "home",
        "label": "Home",
        "rendererContractId": "engine-native-generic-list",
        "iconKey": "home",
        "description": "Next practice, registration progress, receipts, and team reminders.",
        "pinnedWorkflowIds": [
          "soccer-practice-schedule",
          "soccer-guardian-join-approval",
          "soccer-registration-payment",
          "soccer-reminder-notification"
        ]
      },
      {
        "tabId": "messages",
        "label": "Messages",
        "rendererContractId": "engine-native-generic-list",
        "iconKey": "forum",
        "description": "Team discussions for guardians and coaches.",
        "pinnedWorkflowIds": ["soccer-team-discussion"],
        "visiblePersonaIds": ["soccer-guardian", "soccer-coach"]
      },
      {
        "tabId": "calendar",
        "label": "Calendar",
        "rendererContractId": "engine-native-generic-list",
        "iconKey": "calendar_today",
        "description": "Practices, games, attendance, reminders, and calendar-sync requests.",
        "pinnedWorkflowIds": ["soccer-practice-schedule"],
        "visiblePersonaIds": ["soccer-guardian", "soccer-coach"]
      },
      {
        "tabId": "giving",
        "label": "Giving",
        "rendererContractId": "engine-native-generic-list",
        "iconKey": "payments",
        "description": "Registration checkout, payment status, and private receipt access.",
        "pinnedWorkflowIds": ["soccer-registration-payment"],
        "visiblePersonaIds": ["soccer-guardian"]
      },
      {
        "tabId": "admin",
        "label": "Admin",
        "rendererContractId": "engine-native-generic-list",
        "iconKey": "admin_panel_settings",
        "description": "Guardian approval, reminder operations, and owner export controls.",
        "pinnedWorkflowIds": [
          "soccer-guardian-join-approval",
          "soccer-practice-schedule",
          "soccer-export-metadata"
        ],
        "visiblePersonaIds": ["soccer-coach", "soccer-owner"]
      },
      {
        "tabId": "team",
        "label": "Team",
        "rendererContractId": "engine-native-generic-list",
        "iconKey": "groups",
        "description": "Protected roster rows and guardian-controlled minor-data consent.",
        "pinnedWorkflowIds": ["soccer-team-roster", "soccer-minor-redaction"],
        "visiblePersonaIds": ["soccer-guardian", "soccer-coach"]
      },
      {
        "tabId": "documents",
        "label": "Documents",
        "rendererContractId": "engine-native-generic-list",
        "iconKey": "folder",
        "description": "Waivers, policies, versions, acknowledgement, and access requests.",
        "pinnedWorkflowIds": ["soccer-waiver-document"],
        "visiblePersonaIds": ["soccer-guardian", "soccer-coach"]
      }
    ]
  },

  "experience": {
    "experienceSchemaVersion": 2,
    "workflowGrammarVersion": 1,
    "displayName": "Riverside Youth Soccer",
    "tagline": "Registration, schedules, team communication, and protected youth data in one place.",
    "accentColor": "#176B87",
    "theme": {
      "accent": "#176B87",
      "tabThemes": {
        "calendar": { "accent": "#2E7D32" },
        "giving": { "accent": "#B85C00" },
        "admin": { "accent": "#4051B5" },
        "team": { "accent": "#176B87" },
        "documents": { "accent": "#00796B" }
      }
    },
    "creatableAction": {
      "multiActionStyle": "speedDial",
      "presentationStyle": "slideOutBottom"
    },
    "personas": [
      {
        "personaId": "soccer-guardian",
        "label": "Guardian",
        "roleLabel": "Guardian",
        "description": "Registers a player, pays fees, manages consent, follows schedules, and receives reminders."
      },
      {
        "personaId": "soccer-coach",
        "label": "Coach",
        "roleLabel": "Coach",
        "description": "Reviews guardian requests, manages protected roster rows and schedules, and sends reminders."
      },
      {
        "personaId": "soccer-owner",
        "label": "League Owner",
        "roleLabel": "Owner",
        "description": "Creates redacted, portable league metadata exports."
      }
    ],

    "workflowDefinitions": {
      "soccer-guardian-join-approval": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
          }
        },
        "states": {
          "draft": {
            "label": "Draft registration request",
            "tone": "info",
            "editableFields": [
              "caseTitle",
              "playerLabel",
              "requestDetails",
              "registrationFeeLabel",
              "waiverTitle",
              "waiverVersion",
              "waiverUrl"
            ],
            "editGuard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            }
          },
          "submitted": {
            "label": "Submitted to coach",
            "tone": "info"
          },
          "under-review": {
            "label": "Under coach review",
            "tone": "warning"
          },
          "missing-info": {
            "label": "Missing information",
            "tone": "warning",
            "editableFields": [
              "caseTitle",
              "playerLabel",
              "requestDetails",
              "registrationFeeLabel",
              "waiverTitle",
              "waiverVersion",
              "waiverUrl"
            ],
            "editGuard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            }
          },
          "approved": {
            "label": "Approved and added to roster",
            "tone": "positive"
          },
          "rejected": {
            "label": "Registration rejected",
            "tone": "negative",
            "editableFields": ["requestDetails"],
            "editGuard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            }
          },
          "withdrawn": {
            "label": "Withdrawn by guardian",
            "tone": "info",
            "editableFields": ["requestDetails"],
            "editGuard": { "allowedPersonaIds": ["soccer-guardian"] }
          }
        },
        "transitions": [
          {
            "id": "submit-request",
            "label": "Send registration request",
            "icon": "send",
            "tone": "primary",
            "from": ["draft"],
            "to": "submitted",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "guardianPersonaId", "value": "$actor" },
              { "op": "set", "key": "paymentCheckpoint", "value": "unpaid" },
              { "op": "set", "key": "waiverCheckpoint", "value": "unread" },
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Registration request submitted",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "createInstance",
                "workflowType": "soccer-registration-payment",
                "fields": {
                  "registrationCaseId": "{id}",
                  "guardianPersonaId": "{guardianPersonaId}",
                  "playerLabel": "{playerLabel}",
                  "amountLabel": "{registrationFeeLabel}",
                  "purpose": "Riverside season registration",
                  "consentRequiredLabel": "Guardian payment authorization required",
                  "consentConfirmed": false,
                  "receiptStatus": "not-issued",
                  "paymentHistory": []
                }
              },
              {
                "op": "createInstance",
                "workflowType": "soccer-waiver-document",
                "fields": {
                  "registrationCaseId": "{id}",
                  "documentTitle": "{waiverTitle}",
                  "documentVersion": "{waiverVersion}",
                  "documentUrl": "{waiverUrl}",
                  "sourceLabel": "Riverside Youth Soccer",
                  "accessLabel": "Members may open; acknowledgement is tracked",
                  "acknowledgedPersonaIds": [],
                  "accessRequestedPersonaIds": [],
                  "askedCoachPersonaIds": [],
                  "acknowledgementHistory": []
                }
              }
            ]
          },
          {
            "id": "review-request",
            "label": "Review request",
            "icon": "rate_review",
            "tone": "primary",
            "from": ["submitted"],
            "to": "under-review",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "coachReviewerPersonaId", "value": "$actor" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Coach review started",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "request-changes",
            "label": "Request changes",
            "icon": "edit_note",
            "tone": "secondary",
            "from": ["under-review"],
            "to": "missing-info",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "inputs": {
              "missingItems": { "type": "list", "required": true },
              "reviewerComment": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "missingItems", "value": "{input.missingItems}" },
              { "op": "set", "key": "reviewerComment", "value": "{input.reviewerComment}" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Coach requested changes",
                  "comment": "{input.reviewerComment}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "revise-request",
            "label": "Save revision",
            "icon": "edit",
            "tone": "secondary",
            "from": ["missing-info", "rejected"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Guardian revised request",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "resubmit-request",
            "label": "Resubmit request",
            "icon": "send",
            "tone": "primary",
            "from": ["missing-info", "rejected"],
            "to": "submitted",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              { "op": "set", "key": "missingItems", "value": [] },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Guardian resubmitted request",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "reject-request",
            "label": "Reject request",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["under-review"],
            "to": "rejected",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "inputs": {
              "reason": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "reviewerComment", "value": "{input.reason}" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Registration request rejected",
                  "comment": "{input.reason}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "approve-request",
            "label": "Approve and add to roster",
            "icon": "verified",
            "tone": "primary",
            "from": ["under-review"],
            "to": "approved",
            "guard": {
              "allowedPersonaIds": ["soccer-coach"],
              "formula": "waiverCheckpoint == 'acknowledged' && paymentCheckpoint == 'paid'"
            },
            "effects": [
              { "op": "set", "key": "approvedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Coach approved registration and created roster/privacy rows",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "createInstance",
                "workflowType": "soccer-team-roster",
                "fields": {
                  "registrationCaseId": "{id}",
                  "playerDisplayLabel": "{playerLabel}",
                  "guardianPersonaId": "{guardianPersonaId}",
                  "roleLabel": "Player",
                  "approvalState": "approved",
                  "waiverStatus": "{waiverCheckpoint}",
                  "redactionState": "redacted",
                  "redactedMinorFields": ["Full birth date", "Medical notes", "Home address"],
                  "previousRedactionState": "redacted",
                  "previousRedactedMinorFields": ["Full birth date", "Medical notes", "Home address"],
                  "rosterHistory": [
                    {
                      "event": "Player added automatically from approved registration",
                      "at": "$timestamp"
                    }
                  ]
                }
              },
              {
                "op": "createInstance",
                "workflowType": "soccer-minor-redaction",
                "fields": {
                  "registrationCaseId": "{id}",
                  "playerLabel": "{playerLabel}",
                  "guardianPersonaId": "{guardianPersonaId}",
                  "protectedFieldLabels": ["Full birth date", "Medical notes", "Home address"],
                  "allowedCoachMetadata": ["Player display label", "Approval status", "Waiver status"],
                  "redactionPreview": ["Birth date hidden", "Medical notes hidden", "Address hidden"],
                  "consentChoice": "private-by-default",
                  "consentHistory": []
                }
              }
            ]
          },
          {
            "id": "withdraw-request",
            "label": "Withdraw request",
            "icon": "remove_circle_outline",
            "tone": "destructive",
            "from": ["draft", "submitted", "under-review", "missing-info"],
            "to": "withdrawn",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Guardian withdrew request",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "attach-registration-document",
            "label": "Attach registration document",
            "icon": "attach_file",
            "tone": "secondary",
            "from": [
              "draft",
              "submitted",
              "under-review",
              "missing-info",
              "approved",
              "rejected",
              "withdrawn"
            ],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "inputs": {
              "documentTitle": { "type": "text", "required": true },
              "documentVersion": { "type": "text", "required": true },
              "documentUrl": { "type": "text", "required": true }
            },
            "effects": [
              {
                "op": "createInstance",
                "workflowType": "soccer-waiver-document",
                "fields": {
                  "registrationCaseId": "{id}",
                  "documentTitle": "{input.documentTitle}",
                  "documentVersion": "{input.documentVersion}",
                  "documentUrl": "{input.documentUrl}",
                  "sourceLabel": "Guardian registration attachment",
                  "accessLabel": "Members may open; acknowledgement is tracked",
                  "acknowledgedPersonaIds": [],
                  "accessRequestedPersonaIds": [],
                  "askedCoachPersonaIds": [],
                  "acknowledgementHistory": []
                }
              },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Guardian attached a registration document",
                  "title": "{input.documentTitle}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "reopen-request",
            "label": "Reopen registration",
            "icon": "restart_alt",
            "tone": "secondary",
            "from": ["approved", "rejected", "withdrawn"],
            "to": "submitted",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "history",
                "value": {
                  "event": "Guardian reopened registration",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["draft", "missing-info", "rejected", "withdrawn"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Register a player",
                "byPersonaIds": ["soccer-guardian"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "guardianPersonaId": "$actor",
                  "missingItems": [],
                  "history": []
                }
              }
            ]
          },
          {
            "states": ["submitted", "under-review", "approved"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "primary"
          },
          {
            "states": ["submitted", "under-review"],
            "role": "receiver",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["approved", "rejected", "withdrawn"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "caseTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "playerLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "sports_soccer",
            "labelTemplate": "Player: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "requestDetails": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "description",
            "labelTemplate": "Request: {value}",
            "displayContexts": ["detail"]
          },
          "registrationFeeLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "payments",
            "labelTemplate": "Fee: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "waiverTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "waiverVersion": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "waiverUrl": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "guardianPersonaId": {
            "type": "personaId?",
            "writableBy": "effect",
            "displayIcon": "family_restroom",
            "labelTemplate": "Guardian: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "coachReviewerPersonaId": {
            "type": "personaId?",
            "writableBy": "effect",
            "displayIcon": "sports",
            "labelTemplate": "Reviewer: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "paymentCheckpoint": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "paid",
            "labelTemplate": "Payment: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "waiverCheckpoint": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "fact_check",
            "labelTemplate": "Waiver: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "missingItems": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "rule",
            "labelTemplate": "Missing: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "reviewerComment": {
            "type": "textarea",
            "writableBy": "effect",
            "displayIcon": "comment",
            "labelTemplate": "Coach note: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "submittedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "schedule",
            "labelTemplate": "Submitted {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "approvedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "verified",
            "labelTemplate": "Approved {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "history": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "History: {value.length} entries",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "soccer-team-roster": {
        "initialState": "active",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
          }
        },
        "states": {
          "active": {
            "label": "Active roster row",
            "tone": "positive",
            "editableFields": ["playerDisplayLabel", "roleLabel", "approvalState", "waiverStatus"],
            "editGuard": { "allowedPersonaIds": ["soccer-coach"] }
          },
          "archived": {
            "label": "Archived roster row",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "save-roster-update",
            "label": "Save roster update",
            "icon": "save",
            "tone": "primary",
            "from": ["active"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "inputs": {
              "changeNote": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "updatedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Roster row saved",
                  "note": "{input.changeNote}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "mark-waiver-acknowledged",
            "label": "Mark waiver acknowledged",
            "icon": "fact_check",
            "tone": "secondary",
            "from": ["active"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "waiverStatus", "value": "acknowledged" },
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Waiver marked acknowledged",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "request-guardian-update",
            "label": "Request guardian update",
            "icon": "contact_support",
            "tone": "secondary",
            "from": ["active"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "inputs": {
              "requestNote": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "approvalState", "value": "update-requested" },
              { "op": "set", "key": "guardianUpdateRequest", "value": "{input.requestNote}" },
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Guardian update requested",
                  "note": "{input.requestNote}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "redact-fields",
            "label": "Redact protected fields",
            "icon": "visibility_off",
            "tone": "secondary",
            "from": ["active"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "inputs": {
              "fieldsToRedact": { "type": "list", "required": true }
            },
            "effects": [
              { "op": "set", "key": "previousRedactionState", "value": "{redactionState}" },
              { "op": "set", "key": "previousRedactedMinorFields", "value": "{redactedMinorFields}" },
              { "op": "set", "key": "redactionState", "value": "redacted" },
              { "op": "set", "key": "redactedMinorFields", "value": "{input.fieldsToRedact}" },
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Coach changed roster redaction",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "undo-last-redaction-change",
            "label": "Undo redaction change",
            "icon": "undo",
            "tone": "secondary",
            "from": ["active"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "redactionState", "value": "{previousRedactionState}" },
              { "op": "set", "key": "redactedMinorFields", "value": "{previousRedactedMinorFields}" },
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Coach undid the last redaction change",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "apply-private-consent",
            "label": "Apply private roster view",
            "icon": "lock",
            "tone": "secondary",
            "from": ["active"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "previousRedactionState", "value": "{redactionState}" },
              { "op": "set", "key": "previousRedactedMinorFields", "value": "{redactedMinorFields}" },
              { "op": "set", "key": "redactionState", "value": "redacted" },
              {
                "op": "set",
                "key": "redactedMinorFields",
                "value": ["Full birth date", "Medical notes", "Home address"]
              },
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Guardian applied private consent",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "apply-shared-consent",
            "label": "Share approved coach fields",
            "icon": "shield",
            "tone": "secondary",
            "from": ["active"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "previousRedactionState", "value": "{redactionState}" },
              { "op": "set", "key": "previousRedactedMinorFields", "value": "{redactedMinorFields}" },
              { "op": "set", "key": "redactionState", "value": "guardian-approved-limited-share" },
              {
                "op": "set",
                "key": "redactedMinorFields",
                "value": ["Full birth date", "Medical notes", "Home address"]
              },
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Guardian approved limited coach metadata",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "apply-correction-request",
            "label": "Flag privacy correction",
            "icon": "report_problem",
            "tone": "secondary",
            "from": ["active"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "approvalState", "value": "privacy-correction-requested" },
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Guardian requested a privacy correction",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "archive-roster-row",
            "label": "Archive roster row",
            "icon": "archive",
            "tone": "destructive",
            "from": ["active"],
            "to": "archived",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              {
                "op": "append",
                "key": "rosterHistory",
                "value": {
                  "event": "Roster row archived",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["active"],
            "role": "any",
            "tabId": "team",
            "cardSurfaceFamily": "table",
            "bindingKind": "primary"
          },
          {
            "states": ["archived"],
            "role": "any",
            "tabId": "team",
            "cardSurfaceFamily": "table",
            "bindingKind": "summary"
          },
          {
            "states": ["active"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "table",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "registrationCaseId": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "link",
            "labelTemplate": "Registration case: {value}",
            "displayContexts": ["detail"]
          },
          "playerDisplayLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "displayIcon": "sports_soccer",
            "labelTemplate": "Player: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "guardianPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "family_restroom",
            "labelTemplate": "Guardian: {value}",
            "displayContexts": ["detail"]
          },
          "roleLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "badge",
            "labelTemplate": "Role: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "approvalState": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "verified_user",
            "labelTemplate": "Approval: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "waiverStatus": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "fact_check",
            "labelTemplate": "Waiver: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "redactionState": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "privacy_tip",
            "labelTemplate": "Privacy: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "redactedMinorFields": {
            "type": "list",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "visibility_off",
            "labelTemplate": "Redacted fields: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "previousRedactionState": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "displayContexts": []
          },
          "previousRedactedMinorFields": {
            "type": "list",
            "required": true,
            "writableBy": "effect",
            "displayContexts": []
          },
          "guardianUpdateRequest": {
            "type": "textarea",
            "writableBy": "effect",
            "displayIcon": "contact_support",
            "labelTemplate": "Guardian update: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "updatedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "update",
            "labelTemplate": "Updated {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "rosterHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "Roster history: {value.length} entries",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "soccer-minor-redaction": {
        "initialState": "review-pending",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
          }
        },
        "states": {
          "review-pending": {
            "label": "Privacy review pending",
            "tone": "warning"
          },
          "consent-confirmed": {
            "label": "Privacy consent confirmed",
            "tone": "positive"
          },
          "correction-requested": {
            "label": "Privacy correction requested",
            "tone": "warning"
          }
        },
        "transitions": [
          {
            "id": "confirm-private-consent",
            "label": "Confirm private-by-default",
            "icon": "lock",
            "tone": "primary",
            "from": ["review-pending", "correction-requested"],
            "to": "consent-confirmed",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "consentChoice", "value": "private-by-default" },
              {
                "op": "set",
                "key": "redactionPreview",
                "value": ["Birth date hidden", "Medical notes hidden", "Address hidden"]
              },
              { "op": "set", "key": "confirmedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "consentHistory",
                "value": {
                  "event": "Guardian confirmed private-by-default consent",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "soccer-team-roster",
                  "filter": { "registrationCaseId": "{registrationCaseId}", "$state": "active" },
                  "limit": 1
                },
                "transitionId": "apply-private-consent"
              }
            ]
          },
          {
            "id": "share-approved-coach-fields",
            "label": "Share approved coach fields",
            "icon": "shield",
            "tone": "primary",
            "from": ["review-pending", "consent-confirmed", "correction-requested"],
            "to": "consent-confirmed",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "consentChoice", "value": "limited-coach-share" },
              {
                "op": "set",
                "key": "redactionPreview",
                "value": [
                  "Full birth date hidden",
                  "Medical notes hidden",
                  "Player display label shared",
                  "Waiver and approval status shared"
                ]
              },
              { "op": "set", "key": "confirmedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "consentHistory",
                "value": {
                  "event": "Guardian approved limited coach metadata",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "soccer-team-roster",
                  "filter": { "registrationCaseId": "{registrationCaseId}", "$state": "active" },
                  "limit": 1
                },
                "transitionId": "apply-shared-consent"
              }
            ]
          },
          {
            "id": "change-consent",
            "label": "Change consent",
            "icon": "edit",
            "tone": "secondary",
            "from": ["consent-confirmed"],
            "to": "review-pending",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "consentChoice", "value": "reviewing" },
              {
                "op": "append",
                "key": "consentHistory",
                "value": {
                  "event": "Guardian reopened consent review",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "soccer-team-roster",
                  "filter": { "registrationCaseId": "{registrationCaseId}", "$state": "active" },
                  "limit": 1
                },
                "transitionId": "apply-private-consent"
              }
            ]
          },
          {
            "id": "hide-protected-field",
            "label": "Hide another field",
            "icon": "visibility_off",
            "tone": "secondary",
            "from": ["review-pending", "consent-confirmed", "correction-requested"],
            "to": "consent-confirmed",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "inputs": {
              "fieldLabel": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "appendUnique", "key": "redactionPreview", "value": "{input.fieldLabel}" },
              { "op": "set", "key": "consentChoice", "value": "custom-private" },
              { "op": "set", "key": "confirmedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "consentHistory",
                "value": {
                  "event": "Guardian hid an additional protected field",
                  "field": "{input.fieldLabel}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "soccer-team-roster",
                  "filter": { "registrationCaseId": "{registrationCaseId}", "$state": "active" },
                  "limit": 1
                },
                "transitionId": "apply-private-consent"
              }
            ]
          },
          {
            "id": "request-privacy-correction",
            "label": "Request correction",
            "icon": "report_problem",
            "tone": "destructive",
            "from": ["review-pending", "consent-confirmed"],
            "to": "correction-requested",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "inputs": {
              "correctionReason": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "correctionReason", "value": "{input.correctionReason}" },
              {
                "op": "append",
                "key": "consentHistory",
                "value": {
                  "event": "Guardian requested privacy correction",
                  "reason": "{input.correctionReason}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "soccer-team-roster",
                  "filter": { "registrationCaseId": "{registrationCaseId}", "$state": "active" },
                  "limit": 1
                },
                "transitionId": "apply-correction-request"
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["review-pending", "consent-confirmed", "correction-requested"],
            "role": "any",
            "tabId": "team",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary"
          },
          {
            "states": ["consent-confirmed"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "registrationCaseId": {
            "type": "text",
            "required": true,
            "searchable": true,
            "displayIcon": "link",
            "labelTemplate": "Registration case: {value}",
            "displayContexts": ["detail"]
          },
          "playerLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "sports_soccer",
            "labelTemplate": "Player: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "guardianPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "family_restroom",
            "labelTemplate": "Guardian: {value}",
            "displayContexts": ["detail"]
          },
          "protectedFieldLabels": {
            "type": "list",
            "required": true,
            "displayIcon": "lock",
            "labelTemplate": "Protected fields: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "allowedCoachMetadata": {
            "type": "list",
            "required": true,
            "displayIcon": "shield",
            "labelTemplate": "Coach may see: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "redactionPreview": {
            "type": "list",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "preview",
            "labelTemplate": "Redaction preview: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "consentChoice": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "privacy_tip",
            "labelTemplate": "Consent: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "correctionReason": {
            "type": "textarea",
            "writableBy": "effect",
            "displayIcon": "report_problem",
            "labelTemplate": "Correction requested: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "confirmedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "verified",
            "labelTemplate": "Confirmed {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "consentHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "Consent history: {value.length} entries",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "soccer-registration-payment": {
        "initialState": "unpaid",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
          }
        },
        "states": {
          "unpaid": {
            "label": "Registration fee unpaid",
            "tone": "warning",
            "editableFields": ["paymentMethodNote"],
            "editGuard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            }
          },
          "processing": {
            "label": "Checkout started",
            "tone": "info"
          },
          "failed": {
            "label": "Payment failed",
            "tone": "negative",
            "editableFields": ["paymentMethodNote"],
            "editGuard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            }
          },
          "paid": {
            "label": "Registration paid",
            "tone": "positive"
          },
          "refunded": {
            "label": "Registration payment refunded",
            "tone": "info"
          }
        },
        "transitions": [
          {
            "id": "start-checkout",
            "label": "Pay registration fee",
            "icon": "payments",
            "tone": "primary",
            "from": ["unpaid"],
            "to": "processing",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              // NEEDS IMPLEMENTATION (platform service): payment gateway processing is not implemented.
              // This records checkout intent only and does not fabricate success or a receipt id.
              { "op": "set", "key": "consentConfirmed", "value": true },
              { "op": "set", "key": "receiptStatus", "value": "checkout-started" },
              {
                "op": "append",
                "key": "paymentHistory",
                "value": {
                  "event": "Guardian started checkout",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "record-offline-payment",
            "label": "Record verified offline payment",
            "icon": "verified",
            "tone": "primary",
            "from": ["processing"],
            "to": "paid",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "offline-payment-verified" },
              { "op": "set", "key": "paidAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "paymentHistory",
                "value": {
                  "event": "Coach verified an offline payment",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "set",
                "key": "paymentCheckpoint",
                "value": "paid",
                "relatedInstance": "registrationCaseId"
              }
            ]
          },
          {
            "id": "mark-payment-failed",
            "label": "Record payment failure",
            "icon": "error",
            "tone": "destructive",
            "from": ["processing"],
            "to": "failed",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "inputs": {
              "failureReason": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "failed" },
              { "op": "set", "key": "failureReason", "value": "{input.failureReason}" },
              {
                "op": "append",
                "key": "paymentHistory",
                "value": {
                  "event": "Payment failed",
                  "reason": "{input.failureReason}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "retry-payment",
            "label": "Retry payment",
            "icon": "refresh",
            "tone": "primary",
            "from": ["failed"],
            "to": "processing",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "checkout-retried" },
              {
                "op": "append",
                "key": "paymentHistory",
                "value": {
                  "event": "Guardian retried checkout",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "cancel-checkout",
            "label": "Cancel checkout",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["processing"],
            "to": "unpaid",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "not-issued" },
              {
                "op": "append",
                "key": "paymentHistory",
                "value": {
                  "event": "Guardian cancelled checkout",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "view-receipt",
            "label": "View receipt status",
            "icon": "receipt_long",
            "tone": "secondary",
            "from": ["paid", "refunded"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "lastReceiptViewedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "refund-payment",
            "label": "Record refund",
            "icon": "currency_exchange",
            "tone": "destructive",
            "from": ["paid"],
            "to": "refunded",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "refunded" },
              {
                "op": "append",
                "key": "paymentHistory",
                "value": {
                  "event": "Coach recorded refund",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "set",
                "key": "paymentCheckpoint",
                "value": "refunded",
                "relatedInstance": "registrationCaseId"
              }
            ]
          },
          {
            "id": "restart-after-refund",
            "label": "Start a new payment",
            "icon": "restart_alt",
            "tone": "secondary",
            "from": ["refunded"],
            "to": "unpaid",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "guardianPersonaId" }
            },
            "effects": [
              { "op": "set", "key": "receiptStatus", "value": "not-issued" },
              { "op": "set", "key": "consentConfirmed", "value": false }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["unpaid", "processing", "failed", "paid", "refunded"],
            "role": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary"
          },
          {
            "states": ["paid", "refunded"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "registrationCaseId": {
            "type": "text",
            "required": true,
            "displayContexts": []
          },
          "guardianPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "family_restroom",
            "labelTemplate": "Payer: {value}",
            "displayContexts": ["detail"]
          },
          "playerLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "sports_soccer",
            "labelTemplate": "Player: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "amountLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "payments",
            "labelTemplate": "Fee: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "purpose": {
            "type": "text",
            "required": true,
            "displayIcon": "receipt",
            "labelTemplate": "For: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "consentRequiredLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "gavel",
            "labelTemplate": "{value}",
            "displayContexts": ["detail"]
          },
          "consentConfirmed": {
            "type": "bool",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "check_box",
            "labelTemplate": "Payment consent: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "paymentMethodNote": {
            "type": "text",
            "writableBy": "formEntry",
            "displayIcon": "credit_card",
            "labelTemplate": "Payment note: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "receiptStatus": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "receipt_long",
            "labelTemplate": "Receipt status: {value}",
            "displayContexts": ["tile", "detail"]
          },
          // NEEDS IMPLEMENTATION (platform service): real payment receipt-id generation.
          // Declared for the real surface, never seeded and never written by an effect.
          "receiptId": {
            "type": "text?",
            "writableBy": "effect",
            "displayContexts": []
          },
          "receiptDisplay": {
            "type": "text?",
            "formula": "if($viewer == guardianPersonaId, receiptId, 'Private receipt')",
            "displayIcon": "lock",
            "labelTemplate": "Receipt: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "paidAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event_available",
            "labelTemplate": "Paid {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "failureReason": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "error_outline",
            "labelTemplate": "Failure: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "lastReceiptViewedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "visibility",
            "labelTemplate": "Receipt viewed {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "paymentHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "Payment history: {value.length} entries",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "soccer-practice-schedule": {
        "initialState": "upcoming",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
          }
        },
        "states": {
          "upcoming": {
            "label": "Upcoming practice",
            "tone": "positive",
            "editableFields": [
              "title",
              "eventDate",
              "eventTime",
              "location",
              "fieldName",
              "opponent",
              "capacity",
              "reminderChannel",
              "reminderBody"
            ],
            "editGuard": { "allowedPersonaIds": ["soccer-coach"] }
          },
          "rescheduled": {
            "label": "Practice rescheduled",
            "tone": "warning",
            "editableFields": [
              "title",
              "eventDate",
              "eventTime",
              "location",
              "fieldName",
              "opponent",
              "capacity",
              "reminderChannel",
              "reminderBody"
            ],
            "editGuard": { "allowedPersonaIds": ["soccer-coach"] }
          },
          "cancelled": {
            "label": "Practice cancelled",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "save-schedule-update",
            "action": "edit",
            "label": "Save schedule update",
            "icon": "save",
            "tone": "primary",
            "from": ["upcoming"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "updatedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "scheduleHistory",
                "value": {
                  "event": "Coach saved schedule update",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "mark-rescheduled",
            "action": "edit",
            "label": "Mark rescheduled",
            "icon": "event_repeat",
            "tone": "secondary",
            "from": ["upcoming", "rescheduled"],
            "to": "rescheduled",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "updatedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "scheduleHistory",
                "value": {
                  "event": "Practice rescheduled",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "send-next-reminder",
            "action": "set_reminder",
            "label": "Send next guardian reminder",
            "icon": "notifications_active",
            "tone": "primary",
            "from": ["upcoming", "rescheduled"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "soccer-practice-rsvp-response",
                  "filter": { "eventId": "{id}", "reminderStatus": "pending" },
                  "sortKey": "responseUpdatedAt",
                  "limit": 1
                },
                "transitionId": "send-reminder"
              },
              {
                "op": "append",
                "key": "reminderHistory",
                "value": {
                  "event": "Coach advanced the per-guardian reminder queue",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "request-calendar-sync",
            "action": "set_reminder",
            "label": "Request calendar sync",
            "icon": "calendar_month",
            "tone": "secondary",
            "from": ["upcoming", "rescheduled"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-guardian", "soccer-coach"],
              "instanceDataEquals": { "key": "syncState", "value": "not-synced" }
            },
            "effects": [
              // NEEDS IMPLEMENTATION: grammar v1 has no external-calendar synchronization effect.
              // The honest JSON records a request, never a fabricated successful sync.
              { "op": "set", "key": "syncState", "value": "requested" },
              { "op": "set", "key": "syncRequestedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "scheduleHistory",
                "value": {
                  "event": "Calendar sync requested",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "cancel-practice",
            "action": "cancel",
            "label": "Cancel practice",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["upcoming", "rescheduled"],
            "to": "cancelled",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              {
                "op": "append",
                "key": "scheduleHistory",
                "value": {
                  "event": "Practice cancelled",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["upcoming", "rescheduled"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "primary",
            // NEEDS IMPLEMENTATION (App Shell, CJM.5): the event-rsvp detail card still hardcodes
            // event-rsvp/event-rsvp-response instead of consuming this declared responseTable.
            "responseTable": {
              "workflowType": "soccer-practice-rsvp-response",
              "eventField": "eventId",
              "pendingStates": ["pending"]
            },
            "actions": [
              {
                "kind": "create",
                "label": "New practice",
                "byPersonaIds": ["soccer-coach"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "syncState": "not-synced",
                  "reminderHistory": [],
                  "scheduleHistory": []
                }
              },
              // NEEDS IMPLEMENTATION (App Shell): instance-scoped create actions are valid grammar
              // but are not yet rendered; this is the creation path for a guardian's per-event row.
              {
                "kind": "create",
                "workflowType": "soccer-practice-rsvp-response",
                "label": "RSVP to this practice",
                "byPersonaIds": ["soccer-guardian"],
                "scope": "instance",
                "presentation": "button",
                "prefill": {
                  "eventId": "{context.id}",
                  "personaId": "$actor",
                  "eventTitle": "{context.title}",
                  "eventDate": "{context.eventDate}",
                  "eventTime": "{context.eventTime}",
                  "location": "{context.location}",
                  "fieldName": "{context.fieldName}",
                  "reminderChannel": "{context.reminderChannel}",
                  "reminderBody": "{context.reminderBody}",
                  "reminderStatus": "pending",
                  "responseUpdatedAt": "$timestamp",
                  "responseHistory": []
                }
              }
            ]
          },
          {
            "states": ["cancelled"],
            "role": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          },
          {
            "states": ["upcoming", "rescheduled", "cancelled"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          },
          {
            "states": ["upcoming", "rescheduled"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "primary"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "displayIcon": "sports_soccer",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "calendar_today",
            "labelTemplate": "Date: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventTime": {
            "type": "time",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "Time: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "location": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "displayIcon": "location_on",
            "labelTemplate": "Location: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "fieldName": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "stadium",
            "labelTemplate": "Field: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "opponent": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "groups",
            "labelTemplate": "Opponent: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "capacity": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "group_add",
            "labelTemplate": "Capacity: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "reminderChannel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "notifications",
            "labelTemplate": "Reminder channel: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "reminderBody": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "campaign",
            "labelTemplate": "Reminder: {value}",
            "displayContexts": ["detail"]
          },
          "syncState": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "sync",
            "labelTemplate": "Calendar sync: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "syncRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "sync_alt",
            "labelTemplate": "Sync requested {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "updatedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "update",
            "labelTemplate": "Updated {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "responses": {
            "type": "list",
            "source": "query(soccer-practice-rsvp-response where eventId == id)",
            "displayIcon": "how_to_reg",
            "labelTemplate": "Responses: {value.length}",
            "displayContexts": ["tile", "detail"]
          },
          "reminderHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "notifications_active",
            "labelTemplate": "Reminder sends: {value.length}",
            "displayContexts": ["tile", "detail"]
          },
          "scheduleHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "Schedule history: {value.length}",
            "displayContexts": ["detail"]
          }
        }
      },

      "soccer-practice-rsvp-response": {
        "initialState": "pending",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
          }
        },
        "states": {
          "pending": { "label": "Response pending", "tone": "warning" },
          "going": { "label": "Going", "tone": "positive" },
          "maybe": { "label": "Maybe", "tone": "info" },
          "declined": { "label": "Not attending", "tone": "negative" },
          "waitlisted": { "label": "Waitlisted", "tone": "warning" }
        },
        "transitions": [
          {
            "id": "respond-going",
            "action": "respond",
            "label": "Going",
            "icon": "event_available",
            "tone": "primary",
            "from": ["pending", "going", "maybe", "declined", "waitlisted"],
            "to": "going",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "personaId" },
              "relatedAggregate": {
                "workflowType": "soccer-practice-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count",
                "comparator": "<",
                "compareTo": { "relatedInstanceField": "eventId", "field": "capacity" }
              }
            },
            "effects": [
              { "op": "set", "key": "responseUpdatedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "responseHistory",
                "value": { "response": "going", "byPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "respond-maybe",
            "action": "respond",
            "label": "Maybe",
            "icon": "help_outline",
            "tone": "secondary",
            "from": ["pending", "going", "maybe", "declined", "waitlisted"],
            "to": "maybe",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "personaId" }
            },
            "effects": [
              { "op": "set", "key": "responseUpdatedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "responseHistory",
                "value": { "response": "maybe", "byPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "respond-declined",
            "action": "respond",
            "label": "Not attending",
            "icon": "event_busy",
            "tone": "secondary",
            "from": ["pending", "going", "maybe", "declined", "waitlisted"],
            "to": "declined",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "personaId" }
            },
            "effects": [
              { "op": "set", "key": "responseUpdatedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "responseHistory",
                "value": { "response": "declined", "byPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "respond-waitlist",
            "action": "join_waitlist",
            "label": "Join waitlist",
            "icon": "hourglass_top",
            "tone": "secondary",
            "from": ["pending", "maybe", "declined"],
            "to": "waitlisted",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "personaId" },
              "relatedAggregate": {
                "workflowType": "soccer-practice-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count",
                "comparator": ">=",
                "compareTo": { "relatedInstanceField": "eventId", "field": "capacity" }
              }
            },
            "effects": [
              { "op": "set", "key": "responseUpdatedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "responseHistory",
                "value": { "response": "waitlisted", "byPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "cancel-rsvp",
            "action": "withdraw_response",
            "label": "Cancel RSVP",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["going", "maybe", "waitlisted"],
            "to": "declined",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorEqualsField": { "key": "personaId" }
            },
            "effects": [
              { "op": "set", "key": "responseUpdatedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "responseHistory",
                "value": { "response": "cancelled", "byPersonaId": "$actor", "at": "$timestamp" }
              }
            ]
          },
          {
            "id": "send-reminder",
            "action": "set_reminder",
            "label": "Send reminder to this guardian",
            "icon": "notifications_active",
            "tone": "primary",
            "from": ["pending", "going", "maybe", "declined", "waitlisted"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-coach"],
              "instanceDataEquals": { "key": "reminderStatus", "value": "pending" }
            },
            "effects": [
              { "op": "set", "key": "reminderStatus", "value": "sent" },
              { "op": "set", "key": "reminderSentAt", "value": "$timestamp" },
              {
                "op": "createInstance",
                "workflowType": "soccer-reminder-notification",
                "fields": {
                  "recipientPersonaId": "{personaId}",
                  "senderPersonaId": "$actor",
                  "relatedScheduleId": "{eventId}",
                  "eventTitle": "{eventTitle}",
                  "eventDate": "{eventDate}",
                  "eventTime": "{eventTime}",
                  "location": "{location}",
                  "audienceLabel": "Guardians for this practice",
                  "channel": "{reminderChannel}",
                  "messageBody": "{reminderBody}",
                  "sentAt": "$timestamp",
                  "deliveryStatus": "sent",
                  "changeRequests": []
                }
              }
            ]
          }
        ],
        // This is a support table consumed by soccer-practice-schedule.responseTable; it intentionally
        // has no standalone render binding, so it does not duplicate the event card on Calendar.
        "renderBindings": [],
        "instanceDataSchema": {
          "eventId": { "type": "text", "required": true },
          "personaId": { "type": "personaId", "required": true },
          "eventTitle": { "type": "text", "required": true },
          "eventDate": { "type": "date", "required": true },
          "eventTime": { "type": "time", "required": true },
          "location": { "type": "text", "required": true },
          "fieldName": { "type": "text", "required": true },
          "reminderChannel": { "type": "text", "required": true },
          "reminderBody": { "type": "textarea", "required": true },
          "reminderStatus": { "type": "text", "required": true, "writableBy": "effect" },
          "responseUpdatedAt": {
            "type": "date",
            "required": true,
            "writableBy": "effect",
            "sortable": true
          },
          "reminderSentAt": {
            "type": "date?",
            "writableBy": "effect"
          },
          "responseHistory": {
            "type": "list",
            "writableBy": "effect"
          }
        }
      },

      "soccer-waiver-document": {
        "initialState": "unread",
        "visibility": { "default": "membersOnly" },
        "states": {
          "unread": {
            "label": "Unread document",
            "tone": "warning",
            "editableFields": [
              "documentTitle",
              "documentVersion",
              "documentUrl",
              "sourceLabel",
              "accessLabel"
            ],
            "editGuard": { "allowedPersonaIds": ["soccer-coach"] }
          },
          "read": {
            "label": "Document read",
            "tone": "info"
          },
          "acknowledged": {
            "label": "Latest version acknowledged",
            "tone": "positive"
          },
          "access-requested": {
            "label": "Access requested",
            "tone": "warning"
          },
          "archived": {
            "label": "Document archived",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "mark-document-read",
            "action": "mark_read",
            "label": "Mark opened and read",
            "icon": "visibility",
            "tone": "primary",
            "from": ["unread"],
            "to": "read",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
            },
            "effects": [
              { "op": "set", "key": "lastOpenedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "acknowledgementHistory",
                "value": {
                  "event": "Document opened",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "acknowledge-latest-version",
            "action": "acknowledge",
            "label": "Acknowledge waiver",
            "icon": "fact_check",
            "tone": "primary",
            "from": ["read"],
            "to": "acknowledged",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian"],
              "actorInList": { "key": "acknowledgedPersonaIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "acknowledgedPersonaIds", "value": "$actor" },
              { "op": "set", "key": "acknowledgedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "acknowledgementHistory",
                "value": {
                  "event": "Guardian acknowledged latest version",
                  "version": "{documentVersion}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              },
              {
                "op": "branch",
                "if": "registrationCaseId == null",
                "then": [],
                "else": [
                  {
                    "op": "set",
                    "key": "waiverCheckpoint",
                    "value": "acknowledged",
                    "relatedInstance": "registrationCaseId"
                  }
                ]
              }
            ]
          },
          {
            "id": "request-document-access",
            "action": "request_access",
            "label": "Request access",
            "icon": "lock_open",
            "tone": "secondary",
            "from": ["unread", "read"],
            "to": "access-requested",
            "guard": { "allowedPersonaIds": ["soccer-guardian"] },
            "effects": [
              { "op": "appendUnique", "key": "accessRequestedPersonaIds", "value": "$actor" },
              {
                "op": "append",
                "key": "acknowledgementHistory",
                "value": {
                  "event": "Guardian requested document access",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "grant-document-access",
            "action": "grant_access",
            "label": "Grant access",
            "icon": "admin_panel_settings",
            "tone": "primary",
            "from": ["access-requested"],
            "to": "unread",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "accessLabel", "value": "Access granted" },
              {
                "op": "append",
                "key": "acknowledgementHistory",
                "value": {
                  "event": "Coach granted document access",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "withdraw-access-request",
            "action": "withdraw_access_request",
            "label": "Withdraw access request",
            "icon": "undo",
            "tone": "secondary",
            "from": ["access-requested"],
            "to": "unread",
            "guard": { "allowedPersonaIds": ["soccer-guardian"] },
            "effects": [
              { "op": "removeValue", "key": "accessRequestedPersonaIds", "value": "$actor" }
            ]
          },
          {
            "id": "mark-document-unread",
            "action": "mark_unread",
            "label": "Mark unread",
            "icon": "mark_email_unread",
            "tone": "secondary",
            "from": ["read", "acknowledged"],
            "to": "unread",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
            },
            "effects": [
              {
                "op": "append",
                "key": "acknowledgementHistory",
                "value": {
                  "event": "Document marked unread",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "prepare-new-document-version",
            "action": "upload",
            "label": "Prepare new version",
            "icon": "upgrade",
            "tone": "secondary",
            "from": ["unread", "read", "acknowledged", "access-requested"],
            "to": "unread",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              { "op": "set", "key": "acknowledgedPersonaIds", "value": [] },
              { "op": "set", "key": "acknowledgedAt", "value": null },
              {
                "op": "append",
                "key": "acknowledgementHistory",
                "value": {
                  "event": "Coach opened document fields for a new version and reset acknowledgements",
                  "previousVersion": "{documentVersion}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "ask-coach-about-document",
            "action": "request_follow_up",
            "label": "Ask coach",
            "icon": "contact_support",
            "tone": "secondary",
            "from": ["unread", "read", "acknowledged", "access-requested"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-guardian"] },
            "effects": [
              { "op": "appendUnique", "key": "askedCoachPersonaIds", "value": "$actor" },
              {
                "op": "append",
                "key": "acknowledgementHistory",
                "value": {
                  "event": "Guardian asked coach about document",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "archive-document",
            "action": "archive",
            "label": "Archive document",
            "icon": "archive",
            "tone": "destructive",
            "from": ["unread", "read", "acknowledged", "access-requested"],
            "to": "archived",
            "guard": { "allowedPersonaIds": ["soccer-coach"] },
            "effects": [
              {
                "op": "append",
                "key": "acknowledgementHistory",
                "value": {
                  "event": "Coach archived document",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["unread", "read", "acknowledged", "access-requested"],
            "role": "any",
            "tabId": "documents",
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Add team document",
                "byPersonaIds": ["soccer-coach"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "acknowledgedPersonaIds": [],
                  "accessRequestedPersonaIds": [],
                  "askedCoachPersonaIds": [],
                  "acknowledgementHistory": []
                }
              }
            ]
          },
          {
            "states": ["archived"],
            "role": "any",
            "tabId": "documents",
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "registrationCaseId": {
            "type": "text?",
            "displayContexts": []
          },
          "documentTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "displayIcon": "description",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "documentVersion": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "history_edu",
            "labelTemplate": "Version: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "documentUrl": {
            "type": "url",
            "required": true,
            "writableBy": "formEntry",
            "openMode": "choice",
            "displayIcon": "open_in_new",
            "labelTemplate": "Open {value}",
            "displayContexts": ["tile", "detail"]
          },
          "sourceLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "source",
            "labelTemplate": "Source: {value}",
            "displayContexts": ["detail"]
          },
          "accessLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "lock_open",
            "labelTemplate": "Access: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "acknowledgedPersonaIds": {
            "type": "personaId[]",
            "writableBy": "effect",
            "displayIcon": "fact_check",
            "labelTemplate": "Acknowledged: {value.length}",
            "displayContexts": ["tile", "detail"]
          },
          "accessRequestedPersonaIds": {
            "type": "personaId[]",
            "writableBy": "effect",
            "displayIcon": "person_add",
            "labelTemplate": "Access requests: {value.length}",
            "displayContexts": ["tile", "detail"]
          },
          "askedCoachPersonaIds": {
            "type": "personaId[]",
            "writableBy": "effect",
            "displayIcon": "contact_support",
            "labelTemplate": "Coach questions: {value.length}",
            "displayContexts": ["detail"]
          },
          "lastOpenedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "visibility",
            "labelTemplate": "Last opened {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "acknowledgedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "verified",
            "labelTemplate": "Acknowledged {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "acknowledgementHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "Document history: {value.length} entries",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "soccer-reminder-notification": {
        "initialState": "unread",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "formula": "$viewer == recipientPersonaId || $viewer == senderPersonaId"
          }
        },
        "states": {
          "unread": { "label": "Unread reminder", "tone": "warning" },
          "read": { "label": "Reminder read", "tone": "positive" },
          "muted": { "label": "Reminders muted", "tone": "info" }
        },
        "transitions": [
          {
            "id": "mark-reminder-read",
            "label": "Mark read",
            "icon": "mark_email_read",
            "tone": "primary",
            "from": ["unread"],
            "to": "read",
            "guard": { "actorEqualsField": { "key": "recipientPersonaId" } },
            "effects": [
              { "op": "set", "key": "readAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "keep-reminder-unread",
            "label": "Keep unread",
            "icon": "mark_email_unread",
            "tone": "secondary",
            "from": ["read"],
            "to": "unread",
            "guard": { "actorEqualsField": { "key": "recipientPersonaId" } },
            "effects": [
              { "op": "set", "key": "readAt", "value": null }
            ]
          },
          {
            "id": "mute-reminders",
            "label": "Mute reminders",
            "icon": "notifications_off",
            "tone": "destructive",
            "from": ["unread", "read"],
            "to": "muted",
            "guard": { "actorEqualsField": { "key": "recipientPersonaId" } },
            "effects": [
              { "op": "set", "key": "mutedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "unmute-reminders",
            "label": "Unmute reminders",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": ["muted"],
            "to": "unread",
            "guard": { "actorEqualsField": { "key": "recipientPersonaId" } },
            "effects": [
              { "op": "set", "key": "mutedAt", "value": null }
            ]
          },
          {
            "id": "request-reminder-change",
            "label": "Request reminder change",
            "icon": "edit_notifications",
            "tone": "secondary",
            "from": ["unread", "read", "muted"],
            "to": null,
            "guard": { "actorEqualsField": { "key": "recipientPersonaId" } },
            "inputs": {
              "changeRequest": { "type": "text", "required": true }
            },
            "effects": [
              {
                "op": "append",
                "key": "changeRequests",
                "value": {
                  "request": "{input.changeRequest}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "open-related-schedule",
            "label": "Open schedule",
            "icon": "calendar_today",
            "tone": "secondary",
            "from": ["unread", "read", "muted"],
            "to": null,
            "guard": { "actorEqualsField": { "key": "recipientPersonaId" } },
            "linkedWorkflowId": "soccer-practice-schedule"
          }
        ],
        "renderBindings": [
          {
            "states": ["unread", "read", "muted"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary"
          },
          {
            "states": ["unread", "read", "muted"],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "recipientPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "person",
            "labelTemplate": "Recipient: {value}",
            "displayContexts": ["detail"]
          },
          "senderPersonaId": {
            "type": "personaId",
            "required": true,
            "displayIcon": "sports",
            "labelTemplate": "From: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "relatedScheduleId": {
            "type": "text",
            "required": true,
            "displayContexts": []
          },
          "eventTitle": {
            "type": "text",
            "required": true,
            "displayIcon": "sports_soccer",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventDate": {
            "type": "date",
            "required": true,
            "displayIcon": "calendar_today",
            "labelTemplate": "Date: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventTime": {
            "type": "time",
            "required": true,
            "displayIcon": "schedule",
            "labelTemplate": "Time: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "location": {
            "type": "text",
            "required": true,
            "displayIcon": "location_on",
            "labelTemplate": "Location: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "audienceLabel": {
            "type": "text",
            "required": true,
            "displayIcon": "groups",
            "labelTemplate": "Audience: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "channel": {
            "type": "text",
            "required": true,
            "displayIcon": "notifications",
            "labelTemplate": "Channel: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "messageBody": {
            "type": "textarea",
            "required": true,
            "displayIcon": "campaign",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "sentAt": {
            "type": "date",
            "required": true,
            "sortable": true,
            "displayIcon": "send",
            "labelTemplate": "Sent {value}",
            "displayContexts": ["tile", "detail"]
          },
          "deliveryStatus": {
            "type": "text",
            "required": true,
            "displayIcon": "done_all",
            "labelTemplate": "Delivery: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "readAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "mark_email_read",
            "labelTemplate": "Read {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "mutedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "notifications_off",
            "labelTemplate": "Muted {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "changeRequests": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "edit_notifications",
            "labelTemplate": "Change requests: {value.length}",
            "displayContexts": ["detail"]
          }
        }
      },

      "soccer-export-metadata": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "allowedPersonaIds": ["soccer-owner"] }
        },
        "states": {
          "draft": {
            "label": "Draft export",
            "tone": "info",
            "editableFields": ["exportTitle"],
            "editGuard": { "allowedPersonaIds": ["soccer-owner"] }
          },
          "scope-selected": {
            "label": "Export scope selected",
            "tone": "info"
          },
          "redaction-reviewed": {
            "label": "Minor-data redaction reviewed",
            "tone": "warning"
          },
          "generating": {
            "label": "Export generation in progress",
            "tone": "info"
          },
          "completed": {
            "label": "Export ready",
            "tone": "positive"
          },
          "failed": {
            "label": "Export failed",
            "tone": "negative"
          },
          "cancelled": {
            "label": "Export cancelled",
            "tone": "info"
          },
          "rolled-back": {
            "label": "Export rolled back",
            "tone": "warning"
          }
        },
        "transitions": [
          {
            "id": "select-export-scope",
            "action": "configure_scope",
            "label": "Select export scope",
            "icon": "checklist",
            "tone": "primary",
            "from": ["draft", "failed", "cancelled", "rolled-back"],
            "to": "scope-selected",
            "guard": { "allowedPersonaIds": ["soccer-owner"] },
            "inputs": {
              "scope": { "type": "list", "required": true }
            },
            "effects": [
              { "op": "set", "key": "exportScope", "value": "{input.scope}" },
              { "op": "set", "key": "redactionConfirmed", "value": false },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner selected export scope",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "change-export-scope",
            "action": "configure_scope",
            "label": "Change scope",
            "icon": "edit",
            "tone": "secondary",
            "from": ["scope-selected", "redaction-reviewed"],
            "to": "scope-selected",
            "guard": { "allowedPersonaIds": ["soccer-owner"] },
            "inputs": {
              "scope": { "type": "list", "required": true }
            },
            "effects": [
              { "op": "set", "key": "exportScope", "value": "{input.scope}" },
              { "op": "set", "key": "redactionConfirmed", "value": false },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner changed export scope",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "review-redaction-preview",
            "action": "preview",
            "label": "Confirm redaction preview",
            "icon": "privacy_tip",
            "tone": "primary",
            "from": ["scope-selected"],
            "to": "redaction-reviewed",
            "guard": { "allowedPersonaIds": ["soccer-owner"] },
            "inputs": {
              "redactedFields": { "type": "list", "required": true }
            },
            "effects": [
              { "op": "set", "key": "redactedFields", "value": "{input.redactedFields}" },
              { "op": "set", "key": "redactionConfirmed", "value": true },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner confirmed minor-data redaction preview",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "start-export",
            "action": "run",
            "label": "Start export",
            "icon": "upload_file",
            "tone": "primary",
            "from": ["redaction-reviewed"],
            "to": "generating",
            "guard": {
              "allowedPersonaIds": ["soccer-owner"],
              "formula": "size(exportScope) > 0 && redactionConfirmed == true"
            },
            "effects": [
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner started export generation",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "record-export-ready",
            "action": "record_outcome",
            "label": "Record export ready",
            "icon": "task_alt",
            "tone": "primary",
            "from": ["generating"],
            "to": "completed",
            "guard": { "allowedPersonaIds": ["soccer-owner"] },
            "inputs": {
              "downloadUrl": { "type": "text", "required": true }
            },
            "effects": [
              // This is an owner-supplied real file location, not a fabricated export id or checksum.
              { "op": "set", "key": "downloadUrl", "value": "{input.downloadUrl}" },
              { "op": "set", "key": "completedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner recorded export file ready",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "mark-export-failed",
            "action": "record_outcome",
            "label": "Record export failure",
            "icon": "error",
            "tone": "destructive",
            "from": ["generating"],
            "to": "failed",
            "guard": { "allowedPersonaIds": ["soccer-owner"] },
            "inputs": {
              "failureReason": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "failureReason", "value": "{input.failureReason}" },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Export failed",
                  "reason": "{input.failureReason}",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "cancel-export",
            "action": "cancel",
            "label": "Cancel export",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["draft", "scope-selected", "redaction-reviewed", "generating"],
            "to": "cancelled",
            "guard": { "allowedPersonaIds": ["soccer-owner"] },
            "effects": [
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner cancelled export",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "retry-export",
            "action": "retry",
            "label": "Retry export",
            "icon": "refresh",
            "tone": "primary",
            "from": ["failed", "cancelled", "rolled-back"],
            "to": "generating",
            "guard": {
              "allowedPersonaIds": ["soccer-owner"],
              "formula": "size(exportScope) > 0 && redactionConfirmed == true"
            },
            "effects": [
              { "op": "set", "key": "failureReason", "value": null },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner retried export",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "record-download",
            "action": "record_outcome",
            "label": "Record download",
            "icon": "download",
            "tone": "secondary",
            "from": ["completed"],
            "to": null,
            "guard": { "allowedPersonaIds": ["soccer-owner"] },
            "effects": [
              { "op": "set", "key": "downloadedAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner recorded export download",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "rollback-export",
            "action": "rollback",
            "label": "Roll back export",
            "icon": "settings_backup_restore",
            "tone": "destructive",
            "from": ["completed"],
            "to": "rolled-back",
            "guard": { "allowedPersonaIds": ["soccer-owner"] },
            "effects": [
              { "op": "set", "key": "downloadUrl", "value": null },
              { "op": "set", "key": "rolledBackAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "exportHistory",
                "value": {
                  "event": "Owner rolled back export",
                  "byPersonaId": "$actor",
                  "at": "$timestamp"
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": [
              "draft",
              "scope-selected",
              "redaction-reviewed",
              "generating",
              "completed",
              "failed",
              "cancelled",
              "rolled-back"
            ],
            "role": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New redacted export",
                "byPersonaIds": ["soccer-owner"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "exportScope": [],
                  "redactedFields": ["Full birth date", "Medical notes", "Home address"],
                  "redactionConfirmed": false,
                  "exportHistory": []
                }
              }
            ]
          },
          {
            "states": ["completed", "failed"],
            "role": "any",
            "tabId": "home",
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "exportTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "exportScope": {
            "type": "list",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "checklist",
            "labelTemplate": "Scope: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "redactedFields": {
            "type": "list",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "visibility_off",
            "labelTemplate": "Redacted: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "redactionConfirmed": {
            "type": "bool",
            "required": true,
            "writableBy": "effect",
            "displayIcon": "privacy_tip",
            "labelTemplate": "Redaction confirmed: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "downloadUrl": {
            "type": "url?",
            "writableBy": "effect",
            "openMode": "external",
            "displayIcon": "download",
            "labelTemplate": "Download {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          // NEEDS IMPLEMENTATION (platform service): checksum/integrity-hash generation.
          // Declared, never seeded and never written by an effect.
          "checksum": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "fingerprint",
            "labelTemplate": "Checksum: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          // NEEDS IMPLEMENTATION (platform service): opaque transfer-id generation.
          // Declared, never seeded and never written by an effect.
          "transferId": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "swap_horiz",
            "labelTemplate": "Transfer id: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          // NEEDS IMPLEMENTATION (platform service): opaque export-receipt-id generation.
          // Declared, never seeded and never written by an effect.
          "exportReceiptId": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "receipt_long",
            "labelTemplate": "Export receipt: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "completedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "task_alt",
            "labelTemplate": "Completed {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "downloadedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "download_done",
            "labelTemplate": "Downloaded {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "rolledBackAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "settings_backup_restore",
            "labelTemplate": "Rolled back {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "failureReason": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "error_outline",
            "labelTemplate": "Failure: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "exportHistory": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "history",
            "labelTemplate": "Export history: {value.length} entries",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "soccer-team-discussion": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "Open thread",
            "tone": "positive",
            "editableFields": ["threadTitle"],
            "editGuard": {
              "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
            }
          },
          "replied": {
            "label": "Thread has replies",
            "tone": "info"
          },
          "archived": {
            "label": "Thread archived",
            "tone": "info",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "reply-to-thread",
            "label": "Reply",
            "icon": "reply",
            "tone": "primary",
            "from": ["open"],
            "to": "replied",
            "guard": {
              "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
            },
            "inputs": {
              "replyBody": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "lastMessage", "value": "{input.replyBody}" },
              { "op": "set", "key": "lastReplyAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "messages",
                "value": {
                  "senderPersonaId": "$actor",
                  "body": "{input.replyBody}",
                  "timestamp": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "reply-again",
            "label": "Reply",
            "icon": "reply",
            "tone": "primary",
            "from": ["replied"],
            "to": null,
            "guard": {
              "allowedPersonaIds": ["soccer-guardian", "soccer-coach"]
            },
            "inputs": {
              "replyBody": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "lastMessage", "value": "{input.replyBody}" },
              { "op": "set", "key": "lastReplyAt", "value": "$timestamp" },
              {
                "op": "append",
                "key": "messages",
                "value": {
                  "senderPersonaId": "$actor",
                  "body": "{input.replyBody}",
                  "timestamp": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "archive-thread",
            "label": "Archive thread",
            "icon": "archive",
            "tone": "destructive",
            "from": ["open", "replied"],
            "to": "archived",
            "guard": { "allowedPersonaIds": ["soccer-coach"] }
          }
        ],
        "renderBindings": [
          {
            "states": ["open", "replied"],
            "role": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New team thread",
                "byPersonaIds": ["soccer-guardian", "soccer-coach"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "messages": [] }
              }
            ]
          },
          {
            "states": ["archived"],
            "role": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "threadTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "displayIcon": "forum",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "lastMessage": {
            "type": "text",
            "writableBy": "effect",
            "displayIcon": "chat_bubble_outline",
            "labelTemplate": "Latest: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "lastReplyAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "displayIcon": "schedule",
            "labelTemplate": "Last reply {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "messages": {
            "type": "list",
            "writableBy": "effect",
            "displayIcon": "question_answer",
            "labelTemplate": "Replies: {value.length}",
            "displayContexts": ["tile", "detail"]
          }
        }
      }
    },

