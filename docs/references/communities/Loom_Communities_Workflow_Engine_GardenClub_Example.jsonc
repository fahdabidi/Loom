// Garden Club — canonical JSON, authored 2026-08-10.
//
// Garden Club community package, authored per
// .agents/skills/loom-calendar-experience-authoring/SKILL.md against
// docs/references/communities/garden-club-product-experience.md.
//
// Eight workflow types from the product doc's section 6 table:
//   1. garden-event-rsvp            (event-rsvp archetype, calendar tab)
//   2. garden-event-rsvp-response   (per-member response row, supports garden-event-rsvp)
//   3. garden-notification          (per-persona notice, created by send-reminder/request-loan/claim/sign-up)
//   4. plant-exchange-submission    (formEntry/statusTimeline/approvalQueueItem, home+admin)
//   5. garden-tool-loan             (equipment-loan archetype, marketplace) -- LOAN half
//   6. garden-tool-giveaway         (equipment-loan archetype, marketplace) -- GIVEAWAY half
//      (split from the product doc's single "garden-tool-loan-giveaway" row -- see report)
//   7. garden-export-custom-schemas (formEntry archetype, home+admin)
//   8. garden-volunteer-shift       (formEntry + approvalQueueItem, home+admin)
//
// Independently judged after authoring (Community JSON Migration Tracker §1c) and found to have 3 real
// issues, all fixed here before merge:
//   1. `garden-tool-loan`/`garden-tool-giveaway`'s `delist` had no owner/availability guard — reachable
//      while an item was on loan or claimed, stranding custody with no return path. Fixed: `delist` now
//      requires `actorEqualsField: ownerPersonaId` + `availabilityState == "available"`.
//   2. The doc's §6 "notifications" requirement for `garden-tool-loan-giveaway`/`garden-volunteer-shift`
//      was never wired to any effect. Fixed: `request-loan`, `claim`, and `sign-up` each now create a real
//      `garden-notification` instance.
//   3. The doc's own B25 §9 semantic-interaction-model row for `plant-exchange-submission` required
//      claim/reserve mechanics that contradicted the rest of the doc's draft→submitted→reviewed
//      submission-for-review shape (a copy-paste artifact from the marketplace flow) — corrected in the
//      product doc itself (see its §10 remediation log), not implemented here.
//
// See docs/references/communities/garden-club-product-experience.md §10 for the full review log.

{
  "schemaVersion": 1,
  "packageId": "init_garden_club_1",
  "communityId": "community_garden_club",
  "communityHandle": "garden-club",
  "displayName": "Garden Club",
  "extensionId": "ext_garden_club",
  "branding": { "accentColor": "#3F7D4A" },
  "seedDataFiles": [],
  "idempotencyKey": "init-garden-club-v1",

  "experience": {
    "experienceSchemaVersion": 2,
    "workflowGrammarVersion": 1,

    "displayName": "Garden Club",
    "tagline": "RSVP to garden events, share plants, coordinate care, and keep club records portable.",
    "accentColor": "#3F7D4A",
    "notificationPresentation": { "style": "bell" },

    "personas": [
      { "personaId": "garden-member", "label": "Member", "roleLabel": "Member",
        "description": "RSVPs to garden events, exchanges plants, borrows or gives away tools, and signs up for volunteer shifts." },
      { "personaId": "garden-coordinator", "label": "Coordinator", "roleLabel": "Coordinator",
        "description": "Organizes events, reviews plant exchange submissions, manages the shared tool marketplace, exports club records, and runs the volunteer roster." }
    ],

    "workflowDefinitions": {

      // =====================================================================
      // 1. GARDEN-EVENT-RSVP -- the event itself. Row-per-member response
      //    table (garden-event-rsvp-response) makes per-member reminders
      //    possible, per the worked calendar example.
      // =====================================================================
      "garden-event-rsvp": {
        "initialState": "open",
        "visibility": { "default": "public" },
        "states": {
          "open": {
            "label": "RSVP open", "tone": "positive",
            "editableFields": ["title", "eventDate", "eventTime", "location", "capacity", "reminderOffsetHours"],
            "editGuard": { "allowedPersonaIds": ["garden-coordinator"] }
          },
          "cancelled": { "label": "Cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "cancel-event", "label": "Cancel event", "icon": "cancel", "tone": "destructive",
            "from": ["open"], "to": "cancelled",
            "guard": { "allowedPersonaIds": ["garden-coordinator"] }
          },
          {
            "id": "make-recurring", "label": "Repeat this event", "icon": "event_repeat", "tone": "secondary",
            "from": ["open"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-coordinator"] },
            "inputs": {
              "freq": { "type": "text", "required": true },
              "count": { "type": "number", "required": true }
            },
            "effects": [
              {
                "op": "generateRecurringInstances",
                "workflowType": "garden-event-rsvp",
                "anchorField": "eventDate",
                "fields": {
                  "title": "{title}", "eventDate": "{eventDate}", "eventTime": "{eventTime}",
                  "location": "{location}", "capacity": "{capacity}",
                  "reminderOffsetHours": "{reminderOffsetHours}", "seriesId": "$newSeriesId"
                },
                "recurrenceRule": { "freq": "{input.freq}", "interval": 1, "count": "{input.count}" }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["open"], "role": "any", "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "New garden event", "byPersonaIds": ["garden-coordinator"],
                "scope": "tab", "presentation": "fab" }
            ],
            "responseTable": {
              "workflowType": "garden-event-rsvp-response",
              "eventField": "eventId",
              "pendingStates": ["pending"]
            }
          },
          { "states": ["cancelled"], "role": "any", "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "searchable": true, "sortable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "eventDate": { "type": "date", "required": true, "writableBy": "formEntry", "storage": "inline",
            "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "eventTime": { "type": "time", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "schedule", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "location": { "type": "text", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "location_on_outlined", "labelTemplate": "{value}", "displayContexts": ["detail"] },
          "capacity": { "type": "number", "required": true, "writableBy": "formEntry", "storage": "inline",
            "displayIcon": "groups_outlined", "labelTemplate": "{value} spots" },

          "reminderOffsetHours": { "type": "number", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": [] },
          "reminderAt": { "type": "date",
            "formula": "subtractHours(combineDateAndTime(eventDate, eventTime), if(reminderOffsetHours == null, 24, reminderOffsetHours))" },

          "responses": { "type": "list",
            "source": "query(garden-event-rsvp-response where eventId == id)" },
          "responseCounts": { "type": "map", "formula": "groupCount(responses, '$state')", "displayContexts": [] },
          "goingCount": { "type": "number", "formula": "mapGet(responseCounts, 'going')",
            "displayIcon": "groups_outlined", "labelTemplate": "Going: {value}",
            "displayContexts": ["tile", "detail"] },
          "waitlistedCount": { "type": "number", "formula": "mapGet(responseCounts, 'waitlisted')",
            "displayIcon": "hourglass_empty", "labelTemplate": "Waitlist: {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "seatsRemaining": { "type": "number", "formula": "capacity - goingCount",
            "displayIcon": "event_seat", "labelTemplate": "{value} spots left", "displayContexts": ["detail"] },
          "isFull": { "type": "bool", "formula": "goingCount >= capacity",
            "displayIcon": "event_busy", "labelTemplate": "Full: {value}" },
          "hasWaitlist": { "type": "bool", "formula": "waitlistedCount > 0",
            "displayIcon": "hourglass_empty", "labelTemplate": "Waitlist open: {value}" },

          "seriesId": { "type": "text", "writableBy": "effect", "storage": "inline",
            "displayContexts": [] }
        }
      },

      // =====================================================================
      // 2. GARDEN-EVENT-RSVP-RESPONSE -- one row per (event, member).
      // =====================================================================
      "garden-event-rsvp-response": {
        "initialState": "pending",
        "visibility": { "default": "public" },
        "states": {
          "pending": { "label": "No response yet", "tone": "info" },
          "going": { "label": "Going", "tone": "positive" },
          "maybe": { "label": "Maybe", "tone": "info" },
          "declined": { "label": "Not attending", "tone": "negative" },
          "waitlisted": { "label": "Waitlisted", "tone": "warning" }
        },
        "transitions": [
          {
            "id": "respond-going", "label": "Going", "icon": "event_available", "tone": "primary",
            "from": ["pending", "maybe", "declined", "waitlisted"], "to": "going",
            "guard": {
              "allowedPersonaIds": ["garden-member", "garden-coordinator"],
              "relatedAggregate": {
                "workflowType": "garden-event-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count", "comparator": "<",
                "compareTo": { "relatedInstanceField": "eventId", "field": "capacity" }
              }
            }
          },
          {
            "id": "respond-maybe", "label": "Maybe", "icon": "help_outline", "tone": "secondary",
            "from": ["pending", "going", "declined", "waitlisted"], "to": "maybe",
            "guard": { "allowedPersonaIds": ["garden-member", "garden-coordinator"] }
          },
          {
            "id": "respond-declined", "label": "Not attending", "icon": "event_busy", "tone": "destructive",
            "from": ["pending", "going", "maybe", "waitlisted"], "to": "declined",
            "guard": { "allowedPersonaIds": ["garden-member", "garden-coordinator"] }
          },
          {
            "id": "respond-waitlist", "label": "Join waitlist", "icon": "groups", "tone": "secondary",
            "from": ["pending", "maybe", "declined"], "to": "waitlisted",
            "guard": {
              "allowedPersonaIds": ["garden-member", "garden-coordinator"],
              "relatedAggregate": {
                "workflowType": "garden-event-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count", "comparator": ">=",
                "compareTo": { "relatedInstanceField": "eventId", "field": "capacity" }
              }
            }
          },
          {
            "id": "send-reminder", "label": "Send reminder",
            "from": ["pending", "maybe", "going", "waitlisted"], "to": null,
            "guard": { "actorEqualsField": { "key": "personaId" } },
            "inputs": {
              "notificationTitle": { "type": "text", "required": true },
              "notificationBody": { "type": "text", "required": true },
              "notificationCreatedAt": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "createInstance", "workflowType": "garden-notification",
                "fields": {
                  "recipientPersonaId": "{personaId}",
                  "title": "{input.notificationTitle}",
                  "body": "{input.notificationBody}",
                  "createdAt": "{input.notificationCreatedAt}"
                } },
              { "op": "set", "key": "reminderSentAt", "value": "$timestamp" }
            ]
          }
        ],
        "renderBindings": [],
        "instanceDataSchema": {
          "eventId": { "type": "text", "required": true, "storage": "inline" },
          "personaId": { "type": "text", "required": true, "storage": "inline" },
          "reminderSentAt": { "type": "text", "writableBy": "effect", "storage": "inline" }
        }
      },

      // =====================================================================
      // 3. GARDEN-NOTIFICATION -- generic per-persona notice.
      // =====================================================================
      "garden-notification": {
        "initialState": "unread",
        "visibility": { "default": "public" },
        "states": {
          "unread": { "label": "Unread", "tone": "info" },
          "read": { "label": "Read", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "mark-read", "label": "Mark read", "icon": "done", "tone": "secondary",
            "from": ["unread"], "to": "read",
            "guard": { "actorEqualsField": { "key": "recipientPersonaId" } }
          }
        ],
        "renderBindings": [],
        "instanceDataSchema": {
          "recipientPersonaId": { "type": "personaId", "required": true, "writableBy": "effect", "storage": "inline" },
          "title": { "type": "text", "required": true, "writableBy": "effect", "storage": "inline" },
          "body": { "type": "text", "required": true, "writableBy": "effect", "storage": "inline" },
          "createdAt": { "type": "text", "required": true, "writableBy": "effect", "storage": "inline", "sortable": true }
        }
      },

      // =====================================================================
      // 4. PLANT-EXCHANGE-SUBMISSION -- draft -> submitted -> reviewed,
      //    P3 approval-queue shape (member composes on Home, coordinator
      //    decides on Admin). Contact details masked until handoff approved.
      // =====================================================================
      "plant-exchange-submission": {
        "initialState": "draft",
        "visibility": { "default": "public" },
        "states": {
          "draft": { "label": "Draft", "tone": "info",
            "editableFields": ["plantVariety", "offerType", "notes", "pickupWindow", "contactInfo", "privacyAcknowledged"],
            "editGuard": { "actorEqualsField": { "key": "ownerPersonaId" } } },
          "submitted": { "label": "Submitted for review", "tone": "warning" },
          "reviewed": { "label": "Reviewed", "tone": "positive", "isTerminal": true },
          "withdrawn": { "label": "Withdrawn", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "submit", "label": "Submit", "icon": "send", "tone": "primary",
            "from": ["draft"], "to": "submitted",
            "guard": { "actorEqualsField": { "key": "ownerPersonaId" },
                       "instanceDataEquals": { "key": "privacyAcknowledged", "value": true } },
            "effects": [ { "op": "set", "key": "submittedAt", "value": "$timestamp" } ]
          },
          {
            "id": "review", "label": "Mark reviewed", "icon": "fact_check", "tone": "primary",
            "from": ["submitted"], "to": "reviewed",
            "guard": { "allowedPersonaIds": ["garden-coordinator"] },
            "effects": [
              { "op": "set", "key": "reviewedByPersonaId", "value": "$actor" },
              { "op": "set", "key": "handoffApproved", "value": true }
            ]
          },
          {
            "id": "withdraw", "label": "Withdraw", "icon": "undo", "tone": "destructive",
            "from": ["draft", "submitted"], "to": "withdrawn",
            "guard": { "actorEqualsField": { "key": "ownerPersonaId" } }
          }
        ],
        "renderBindings": [
          { "states": ["draft"], "role": "actor", "tabId": "home",
            "cardSurfaceFamily": "formEntry", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "Offer or request a plant", "byPersonaIds": ["garden-member"],
                "scope": "tab", "presentation": "fab", "prefill": { "ownerPersonaId": "$actor" } }
            ] },
          { "states": ["submitted"], "role": "actor", "tabId": "home",
            "cardSurfaceFamily": "statusTimeline", "bindingKind": "summary" },
          { "states": ["submitted"], "role": "receiver", "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem", "bindingKind": "primary" },
          { "states": ["reviewed"], "role": "any", "tabId": "home",
            "cardSurfaceFamily": "formEntry", "bindingKind": "summary" },
          { "states": ["withdrawn"], "role": "actor", "tabId": "home",
            "cardSurfaceFamily": "statusTimeline", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "plantVariety": { "type": "text", "required": true, "writableBy": "formEntry",
            "searchable": true, "labelTemplate": "{value}", "displayIcon": "eco",
            "displayContexts": ["tile", "detail"] },
          "offerType": { "type": "text", "required": true, "writableBy": "formEntry",
            "displayIcon": "swap_horiz", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "notes": { "type": "textarea", "writableBy": "formEntry", "maxLength": 500,
            "displayContexts": ["detail"] },
          "pickupWindow": { "type": "text", "writableBy": "formEntry",
            "displayIcon": "schedule", "labelTemplate": "Pickup: {value}",
            "displayContexts": ["tile", "detail"] },
          "contactInfo": { "type": "text", "writableBy": "formEntry", "displayContexts": [] },
          "privacyAcknowledged": { "type": "bool", "required": true, "writableBy": "formEntry",
            "displayContexts": [] },

          "ownerPersonaId": { "type": "personaId?", "writableBy": "effect",
            "displayIcon": "person_outline", "labelTemplate": "From {value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },
          "submittedAt": { "type": "date?", "writableBy": "effect", "sortable": true, "hideWhenEmpty": true },
          "reviewedByPersonaId": { "type": "personaId?", "writableBy": "effect", "hideWhenEmpty": true },
          "handoffApproved": { "type": "bool", "writableBy": "effect" },

          "contactInfoDisplay": { "type": "text",
            "formula": "if(handoffApproved || $viewer == ownerPersonaId, contactInfo, 'Hidden until approved')",
            "displayIcon": "contact_mail", "labelTemplate": "Contact: {value}", "displayContexts": ["detail"] }
        }
      },

      // =====================================================================
      // 5. GARDEN-TOOL-LOAN -- lending half of the marketplace. Split from
      //    GIVEAWAY (see report) because their states/transitions genuinely
      //    differ (borrow/queue/return cycle vs. one-way claim).
      // =====================================================================
      "garden-tool-loan": {
        "initialState": "published",
        "visibility": { "default": "public" },
        "states": {
          "published": { "label": "In library", "tone": "positive",
            "editableFields": ["title", "toolDescription"],
            "editGuard": { "actorEqualsField": { "key": "ownerPersonaId" } } },
          "delisted": { "label": "Delisted", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "request-loan", "label": "Request loan", "icon": "arrow_forward", "tone": "primary",
            "from": ["published"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-member"],
                       "instanceDataEquals": { "key": "availabilityState", "value": "available" } },
            "inputs": {
              "pickupWindow": { "type": "text", "required": true },
              "dueDate": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "onLoan" },
              { "op": "set", "key": "holderPersonaId", "value": "$actor" },
              { "op": "set", "key": "pickupWindow", "value": "{input.pickupWindow}" },
              { "op": "set", "key": "dueDate", "value": "{input.dueDate}" },
              { "op": "set", "key": "borrowedAt", "value": "$timestamp" },
              { "op": "createInstance", "workflowType": "garden-notification",
                "fields": {
                  "recipientPersonaId": "{ownerPersonaId}",
                  "title": "Loan requested",
                  "body": "{title} was requested for pickup {input.pickupWindow}.",
                  "createdAt": "$timestamp"
                } }
            ]
          },
          {
            "id": "join-queue", "label": "Join queue", "tone": "secondary",
            "from": ["published"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-member"],
                       "actorInList": { "key": "queuedPersonaIds", "present": false } },
            "effects": [ { "op": "appendUnique", "key": "queuedPersonaIds", "value": "$actor" } ]
          },
          {
            "id": "leave-queue", "label": "Leave queue", "tone": "secondary",
            "from": ["published"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-member"],
                       "actorInList": { "key": "queuedPersonaIds", "present": true } },
            "effects": [ { "op": "removeValue", "key": "queuedPersonaIds", "value": "$actor" } ]
          },
          {
            "id": "return-item", "label": "Return", "tone": "primary",
            "from": ["published"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-member", "garden-coordinator"],
                       "instanceDataEquals": { "key": "availabilityState", "value": "onLoan" } },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "available" },
              { "op": "set", "key": "holderPersonaId", "value": null },
              { "op": "set", "key": "dueDate", "value": null },
              { "op": "set", "key": "pickupWindow", "value": null }
            ]
          },
          {
            "id": "report-issue", "label": "Report issue", "icon": "report_problem", "tone": "secondary",
            "from": ["published"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-member", "garden-coordinator"] },
            "inputs": { "issueNote": { "type": "text", "required": true } },
            "effects": [
              { "op": "set", "key": "conditionNote", "value": "{input.issueNote}" },
              { "op": "set", "key": "flaggedByPersonaId", "value": "$actor" }
            ]
          },
          {
            "id": "delist", "label": "Delist", "icon": "delete_outline", "tone": "destructive",
            "from": ["published"], "to": "delisted",
            "guard": { "actorEqualsField": { "key": "ownerPersonaId" },
                       "instanceDataEquals": { "key": "availabilityState", "value": "available" } }
          }
        ],
        "renderBindings": [
          { "states": ["published"], "role": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "List a tool to loan", "byPersonaIds": ["garden-member"],
                "scope": "tab", "presentation": "fab",
                "prefill": { "ownerPersonaId": "$actor", "availabilityState": "available" } }
            ] },
          { "states": ["delisted"], "role": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry",
            "searchable": true, "sortable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "toolDescription": { "type": "textarea", "writableBy": "formEntry",
            "displayContexts": ["detail"] },
          "ownerPersonaId": { "type": "personaId?", "writableBy": "effect",
            "displayIcon": "person_outline", "labelTemplate": "Owner: {value}", "hideWhenEmpty": true },
          "availabilityState": { "type": "text", "writableBy": "effect" },
          "holderPersonaId": { "type": "personaId?", "writableBy": "effect",
            "displayIcon": "person_outline", "labelTemplate": "Borrower: {value}", "hideWhenEmpty": true },
          "queuedPersonaIds": { "type": "personaId[]", "writableBy": "effect",
            "displayIcon": "groups_outlined", "labelTemplate": "Queue: {value.length}", "hideWhenEmpty": true },
          "pickupWindow": { "type": "text?", "writableBy": "effect",
            "displayIcon": "schedule", "labelTemplate": "Pickup: {value}", "hideWhenEmpty": true },
          "dueDate": { "type": "date?", "writableBy": "effect",
            "displayIcon": "event_busy", "labelTemplate": "Due back {value}", "hideWhenEmpty": true },
          "borrowedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true },
          "conditionNote": { "type": "text?", "writableBy": "effect",
            "displayIcon": "verified_outlined", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "flaggedByPersonaId": { "type": "personaId?", "writableBy": "effect", "hideWhenEmpty": true },

          "queueLength": { "type": "number", "formula": "size(queuedPersonaIds)" },
          "isAvailable": { "type": "bool", "formula": "availabilityState == 'available'" },
          "isOverdue": { "type": "bool",
            "formula": "if(availabilityState == 'onLoan', isPast(dueDate), false)" }
        }
      },

      // =====================================================================
      // 6. GARDEN-TOOL-GIVEAWAY -- one-way transfer half of the marketplace.
      //    Declares a real "claim" transition (the mechanism the
      //    equipment-loan widget branches on).
      // =====================================================================
      "garden-tool-giveaway": {
        "initialState": "published",
        "visibility": { "default": "public" },
        "states": {
          "published": { "label": "Available to claim", "tone": "positive",
            "editableFields": ["title", "toolDescription"],
            "editGuard": { "actorEqualsField": { "key": "ownerPersonaId" } } },
          "given": { "label": "Given away", "tone": "positive", "isTerminal": true },
          "delisted": { "label": "Delisted", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "claim", "label": "Claim", "icon": "volunteer_activism", "tone": "primary",
            "from": ["published"], "to": "given",
            "guard": { "allowedPersonaIds": ["garden-member"],
                       "instanceDataEquals": { "key": "availabilityState", "value": "available" } },
            "inputs": { "pickupWindow": { "type": "text", "required": true } },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "given" },
              { "op": "set", "key": "claimantPersonaId", "value": "$actor" },
              { "op": "set", "key": "pickupWindow", "value": "{input.pickupWindow}" },
              { "op": "set", "key": "claimedAt", "value": "$timestamp" },
              { "op": "createInstance", "workflowType": "garden-notification",
                "fields": {
                  "recipientPersonaId": "{ownerPersonaId}",
                  "title": "Giveaway claimed",
                  "body": "{title} was claimed for pickup {input.pickupWindow}.",
                  "createdAt": "$timestamp"
                } }
            ]
          },
          {
            "id": "delist", "label": "Delist", "icon": "delete_outline", "tone": "destructive",
            "from": ["published"], "to": "delisted",
            "guard": { "actorEqualsField": { "key": "ownerPersonaId" },
                       "instanceDataEquals": { "key": "availabilityState", "value": "available" } }
          }
        ],
        "renderBindings": [
          { "states": ["published"], "role": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "Give away a tool", "byPersonaIds": ["garden-member"],
                "scope": "tab", "presentation": "fab",
                "prefill": { "ownerPersonaId": "$actor", "availabilityState": "available" } }
            ] },
          { "states": ["given"], "role": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "summary" },
          { "states": ["delisted"], "role": "any", "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry",
            "searchable": true, "sortable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "toolDescription": { "type": "textarea", "writableBy": "formEntry",
            "displayContexts": ["detail"] },
          "ownerPersonaId": { "type": "personaId?", "writableBy": "effect",
            "displayIcon": "person_outline", "labelTemplate": "Owner: {value}", "hideWhenEmpty": true },
          "availabilityState": { "type": "text", "writableBy": "effect" },
          "claimantPersonaId": { "type": "personaId?", "writableBy": "effect",
            "displayIcon": "person_outline", "labelTemplate": "Claimed by: {value}", "hideWhenEmpty": true },
          "pickupWindow": { "type": "text?", "writableBy": "effect",
            "displayIcon": "schedule", "labelTemplate": "Pickup: {value}", "hideWhenEmpty": true },
          "claimedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true },

          "isAvailable": { "type": "bool", "formula": "availabilityState == 'available'" }
        }
      },

      // =====================================================================
      // 7. GARDEN-EXPORT-CUSTOM-SCHEMAS -- portability review surface.
      //    Checksum is declared but NEVER computed (platform-services.md:
      //    checksum/hash generation is Not implemented -- AP-6 forbids
      //    fabricating it).
      // =====================================================================
      "garden-export-custom-schemas": {
        "initialState": "ready",
        "visibility": { "default": "membersOnly" },
        "states": {
          "ready": { "label": "Ready to export", "tone": "info",
            "editableFields": ["selectedSchemaIds", "destination"],
            "editGuard": { "allowedPersonaIds": ["garden-coordinator"] } },
          "exported": { "label": "Exported", "tone": "positive" },
          "error": { "label": "Export failed", "tone": "negative" },
          "cancelled": { "label": "Cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "verify-redaction", "label": "Verify redaction preview", "icon": "policy", "tone": "secondary",
            "from": ["ready"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-coordinator"] },
            "effects": [ { "op": "set", "key": "redactionPreviewReady", "value": true } ]
          },
          {
            "id": "run-export", "label": "Export", "icon": "file_download", "tone": "primary",
            "from": ["ready"], "to": "exported",
            "guard": { "allowedPersonaIds": ["garden-coordinator"],
                       "formula": "size(selectedSchemaIds) > 0",
                       "instanceDataEquals": { "key": "redactionPreviewReady", "value": true } },
            "effects": [
              { "op": "set", "key": "exportedAt", "value": "$timestamp" },
              { "op": "set", "key": "errorMessage", "value": null }
            ]
          },
          {
            "id": "report-export-failure", "label": "Report export failure", "icon": "error_outline", "tone": "secondary",
            "from": ["ready"], "to": "error",
            "guard": { "allowedPersonaIds": ["garden-coordinator"] },
            "inputs": { "errorNote": { "type": "text", "required": true } },
            "effects": [ { "op": "set", "key": "errorMessage", "value": "{input.errorNote}" } ]
          },
          {
            "id": "retry", "label": "Retry export", "icon": "refresh", "tone": "primary",
            "from": ["error"], "to": "ready",
            "guard": { "allowedPersonaIds": ["garden-coordinator"] },
            "effects": [ { "op": "set", "key": "errorMessage", "value": null } ]
          },
          {
            "id": "rollback", "label": "Rollback", "icon": "settings_backup_restore", "tone": "secondary",
            "from": ["exported"], "to": "ready",
            "guard": { "allowedPersonaIds": ["garden-coordinator"] },
            "effects": [
              { "op": "set", "key": "exportedAt", "value": null },
              { "op": "set", "key": "rolledBackAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "cancel-transfer", "label": "Cancel transfer", "icon": "cancel", "tone": "destructive",
            "from": ["ready", "exported"], "to": "cancelled",
            "guard": { "allowedPersonaIds": ["garden-coordinator"] }
          }
        ],
        "renderBindings": [
          { "states": ["ready", "exported", "error", "cancelled"], "role": "any", "tabId": "home",
            "cardSurfaceFamily": "formEntry", "bindingKind": "summary" },
          { "states": ["ready", "exported", "error", "cancelled"], "role": "any", "tabId": "admin",
            "cardSurfaceFamily": "formEntry", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "New export package", "byPersonaIds": ["garden-coordinator"],
                "scope": "tab", "presentation": "fab" }
            ] }
        ],
        "instanceDataSchema": {
          "selectedSchemaIds": { "type": "list", "required": true, "writableBy": "formEntry",
            "displayIcon": "schema", "labelTemplate": "{value.length} schemas selected",
            "displayContexts": ["tile", "detail"] },
          "destination": { "type": "text", "required": true, "writableBy": "formEntry",
            "displayIcon": "outbox", "labelTemplate": "To: {value}", "displayContexts": ["detail"] },
          "redactionPreviewReady": { "type": "bool", "writableBy": "effect",
            "displayIcon": "policy", "labelTemplate": "Redaction reviewed: {value}",
            "displayContexts": ["detail"] },
          // NEEDS IMPLEMENTATION (platform service): checksum/hash generation is a
          // Not-implemented platform service (platform-services.md). This field is
          // declared but never written by any effect -- present, never computed.
          "checksum": { "type": "text?", "writableBy": "effect",
            "displayIcon": "fingerprint", "labelTemplate": "Checksum: {value}", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },
          "exportedAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },
          "rolledBackAt": { "type": "date?", "writableBy": "effect", "hideWhenEmpty": true,
            "displayContexts": ["detail"] },
          "errorMessage": { "type": "text?", "writableBy": "effect", "hideWhenEmpty": true,
            "displayIcon": "error_outline", "displayContexts": ["detail"] },

          "scopeCount": { "type": "number", "formula": "size(selectedSchemaIds)",
            "labelTemplate": "{value} schemas", "displayContexts": ["tile"] }
        }
      },

      // =====================================================================
      // 8. GARDEN-VOLUNTEER-SHIFT -- open/closed shift; sign-up is data
      //    (many members simultaneously), per Step 2/3's decision rule.
      // =====================================================================
      "garden-volunteer-shift": {
        "initialState": "open",
        "visibility": { "default": "public" },
        "states": {
          "open": { "label": "Open for sign-up", "tone": "positive",
            "editableFields": ["shiftTitle", "shiftDate", "location", "capacity"],
            "editGuard": { "allowedPersonaIds": ["garden-coordinator"] } },
          "closed": { "label": "Closed", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "sign-up", "label": "Sign up", "icon": "how_to_reg", "tone": "primary",
            "from": ["open"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-member"],
                       "formula": "size(signedUpPersonaIds) < capacity",
                       "actorInList": { "key": "signedUpPersonaIds", "present": false } },
            "effects": [
              { "op": "appendUnique", "key": "signedUpPersonaIds", "value": "$actor" },
              { "op": "createInstance", "workflowType": "garden-notification",
                "fields": {
                  "recipientPersonaId": "$actor",
                  "title": "Signed up",
                  "body": "You're signed up for {shiftTitle} on {shiftDate}.",
                  "createdAt": "$timestamp"
                } }
            ]
          },
          {
            "id": "cancel-signup", "label": "Cancel sign-up", "icon": "event_busy", "tone": "secondary",
            "from": ["open"], "to": null,
            "guard": { "allowedPersonaIds": ["garden-member"],
                       "actorInList": { "key": "signedUpPersonaIds", "present": true } },
            "effects": [ { "op": "removeValue", "key": "signedUpPersonaIds", "value": "$actor" } ]
          },
          {
            "id": "close-shift", "label": "Close shift", "icon": "lock_outline", "tone": "destructive",
            "from": ["open"], "to": "closed",
            "guard": { "allowedPersonaIds": ["garden-coordinator"] }
          }
        ],
        "renderBindings": [
          { "states": ["open"], "role": "any", "tabId": "home",
            "cardSurfaceFamily": "formEntry", "bindingKind": "primary",
            "actions": [
              { "kind": "create", "label": "New volunteer shift", "byPersonaIds": ["garden-coordinator"],
                "scope": "tab", "presentation": "fab" }
            ] },
          { "states": ["closed"], "role": "any", "tabId": "home",
            "cardSurfaceFamily": "formEntry", "bindingKind": "summary" },
          { "states": ["open"], "role": "any", "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem", "bindingKind": "primary" },
          { "states": ["closed"], "role": "any", "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem", "bindingKind": "summary" }
        ],
        "instanceDataSchema": {
          "shiftTitle": { "type": "text", "required": true, "writableBy": "formEntry",
            "searchable": true, "sortable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "shiftDate": { "type": "date", "required": true, "writableBy": "formEntry",
            "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"] },
          "location": { "type": "text", "writableBy": "formEntry",
            "displayIcon": "location_on_outlined", "displayContexts": ["detail"] },
          "capacity": { "type": "number", "required": true, "writableBy": "formEntry",
            "displayIcon": "groups_outlined", "labelTemplate": "{value} spots" },
          "signedUpPersonaIds": { "type": "personaId[]", "writableBy": "effect",
            "displayIcon": "groups_outlined", "labelTemplate": "Signed up: {value.length}" },

          "signedUpCount": { "type": "number", "formula": "size(signedUpPersonaIds)",
            "labelTemplate": "Signed up: {value}", "displayContexts": ["tile", "detail"] },
          "openSpotsRemaining": { "type": "number", "formula": "capacity - size(signedUpPersonaIds)",
            "displayIcon": "event_seat", "labelTemplate": "{value} spots left",
            "displayContexts": ["tile", "detail"] },
          "isFull": { "type": "bool", "formula": "size(signedUpPersonaIds) >= capacity",
            "displayIcon": "event_busy", "labelTemplate": "Full: {value}" }
        }
      }
    },

    "workflowInstances": [
      {
        "instanceId": "spring-workshop",
        "workflowType": "garden-event-rsvp",
        "currentState": "open",
        "createdByPersonaId": "garden-coordinator",
        "instanceData": {
          "title": "Spring Workshop",
          "eventDate": "2026-08-15",
          "eventTime": "10:00",
          "location": "Community Garden Plot A",
          "capacity": 20,
          "reminderOffsetHours": 24
        }
      },
      {
        "instanceId": "resp-spring-workshop-coordinator",
        "workflowType": "garden-event-rsvp-response",
        "currentState": "going",
        "createdByPersonaId": "garden-coordinator",
        "instanceData": { "eventId": "spring-workshop", "personaId": "garden-coordinator" }
      },
      {
        "instanceId": "resp-spring-workshop-member",
        "workflowType": "garden-event-rsvp-response",
        "currentState": "pending",
        "createdByPersonaId": "garden-coordinator",
        "instanceData": { "eventId": "spring-workshop", "personaId": "garden-member" }
      },
      {
        "instanceId": "plant-tomato-seedlings",
        "workflowType": "plant-exchange-submission",
        "currentState": "reviewed",
        "createdByPersonaId": "garden-member",
        "instanceData": {
          "plantVariety": "Tomato seedlings (Brandywine)",
          "offerType": "offer",
          "notes": "Extra seedlings from spring planting, six available.",
          "pickupWindow": "Saturdays 9-11am at the community shed",
          "contactInfo": "Reach via club messages",
          "privacyAcknowledged": true,
          "ownerPersonaId": "garden-member",
          "submittedAt": "2026-08-05",
          "reviewedByPersonaId": "garden-coordinator",
          "handoffApproved": true
        }
      },
      {
        "instanceId": "plant-basil-request",
        "workflowType": "plant-exchange-submission",
        "currentState": "submitted",
        "createdByPersonaId": "garden-member",
        "instanceData": {
          "plantVariety": "Basil starts",
          "offerType": "request",
          "notes": "Looking for Genovese basil starts for the herb bed.",
          "pickupWindow": "Weekday evenings",
          "contactInfo": "Reach via club messages",
          "privacyAcknowledged": true,
          "ownerPersonaId": "garden-member",
          "submittedAt": "2026-08-07",
          "handoffApproved": false
        }
      },
      {
        "instanceId": "wheelbarrow-loan",
        "workflowType": "garden-tool-loan",
        "currentState": "published",
        "createdByPersonaId": "garden-member",
        "instanceData": {
          "title": "Steel wheelbarrow",
          "toolDescription": "Sturdy steel wheelbarrow, good for hauling mulch and soil.",
          "ownerPersonaId": "garden-member",
          "availabilityState": "available"
        }
      },
      {
        "instanceId": "hand-tools-set",
        "workflowType": "garden-tool-loan",
        "currentState": "published",
        "createdByPersonaId": "garden-coordinator",
        "instanceData": {
          "title": "Hand tool set (trowel, pruners, cultivator)",
          "toolDescription": "Club-owned hand tool set for bed maintenance.",
          "ownerPersonaId": "garden-coordinator",
          "availabilityState": "onLoan",
          "holderPersonaId": "garden-member",
          "pickupWindow": "Saturday mornings",
          "dueDate": "2026-08-20",
          "borrowedAt": "2026-08-01"
        }
      },
      {
        "instanceId": "extra-pots-giveaway",
        "workflowType": "garden-tool-giveaway",
        "currentState": "published",
        "createdByPersonaId": "garden-member",
        "instanceData": {
          "title": "Terracotta pots (assorted sizes)",
          "toolDescription": "Twelve terracotta pots, various sizes, free to a good home.",
          "ownerPersonaId": "garden-member",
          "availabilityState": "available"
        }
      },
      {
        "instanceId": "fall-export-package",
        "workflowType": "garden-export-custom-schemas",
        "currentState": "ready",
        "createdByPersonaId": "garden-coordinator",
        "instanceData": {
          "selectedSchemaIds": ["garden_event", "plant_exchange"],
          "destination": "Neighborhood Association Archive",
          "redactionPreviewReady": true
        }
      },
      {
        "instanceId": "mulch-day-shift",
        "workflowType": "garden-volunteer-shift",
        "currentState": "open",
        "createdByPersonaId": "garden-coordinator",
        "instanceData": {
          "shiftTitle": "Mulch delivery volunteer shift",
          "shiftDate": "2026-08-16",
          "location": "North garden beds",
          "capacity": 6,
          "signedUpPersonaIds": ["garden-member"]
        }
      }
    ]
  }
}
