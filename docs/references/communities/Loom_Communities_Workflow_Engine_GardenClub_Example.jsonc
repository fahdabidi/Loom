// Garden Club — specVersion 4 engine-native community package.
// Re-authored from the supplied Garden Club Product Experience and the
// shipped package using the live fahdabidi/Loom main-branch references.
//
// Workflow split note: the product-doc umbrella "garden-tool-loan-giveaway"
// becomes two types because a reversible loan/custody cycle and a terminal
// giveaway transfer do not have the same states or transitions.

{
  "specVersion": 4,
  "skillVersion": "3.5.0",
  "packageId": "init_garden_club_2",
  "communityId": "community_garden_club",
  "communityHandle": "garden-club",
  "displayName": "Garden Club",
  "extensionId": "ext_garden_club",
  "branding": { "accentColor": "#3F7D4A" },
  "seedDataFiles": [],
  "idempotencyKey": "init-garden-club-v4",

  "experience": {
    "displayName": "Garden Club",
    "tagline": "RSVP to seasonal garden events, share plants and tools, coordinate care, and keep club records portable.",
    "accentColor": "#3F7D4A",
    "theme": {
      "accent": "#3F7D4A",
      "tabThemes": {
        "calendar": { "accent": "#4F8F57" },
        "marketplace": { "accent": "#557A46" },
        "care": { "accent": "#2F7D67" },
        "documents": { "accent": "#356B5D" },
        "organize": { "accent": "#315F3A" }
      }
    },
    "creatableAction": {
      "multiActionStyle": "speedDial",
      "presentationStyle": "slideOutBottom"
    },
    "notifications": {
      "allowedChannels": ["inbox", "push"],
      "default": ["inbox", "push"],
      "muted": false
    },
    "notificationPresentation": { "style": "bell" },

    "roles": [
      {
        "roleId": "garden-member",
        "label": "Member",
        "roleLabel": "Member",
        "description": "RSVPs to events, offers or requests plants, borrows or gives away items, and signs up for care shifts."
      },
      {
        "roleId": "garden-coordinator",
        "label": "Coordinator",
        "roleLabel": "Coordinator",
        "description": "Organizes events, reviews plant handoffs, coordinates shared items and care shifts, and owns club exports."
      }
    ],

    "workflowDefinitions": {
      "garden-event-rsvp": {
        "initialState": "open",
        "visibility": { "default": "public" },
        "reminder": {
          "anchorDateField": "eventDate",
          "anchorTimeField": "eventTime",
          "leadHours": 24,
          "leadHoursField": "reminderOffsetHours"
        },
        "states": {
          "open": {
            "label": "RSVP open",
            "tone": "positive",
            "editableFields": [
              "title",
              "eventDate",
              "eventTime",
              "location",
              "capacity",
              "recurrenceLabel",
              "reminderOffsetHours",
              "durationMinutes",
              "workType",
              "accessibilityNote"
            ],
            "editGuard": { "allowedRoleIds": ["garden-coordinator"] }
          },
          "cancelled": {
            "label": "Cancelled",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "make-recurring",
            "action": "edit",
            "label": "Repeat this event",
            "icon": "event_repeat",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": { "allowedRoleIds": ["garden-coordinator"] },
            "inputs": {
              "freq": {
                "type": "text",
                "required": true,
                "options": ["daily", "weekly", "monthly"]
              },
              "count": { "type": "number", "required": true }
            },
            "effects": [
              {
                "op": "generateRecurringInstances",
                "workflowType": "garden-event-rsvp",
                "anchorField": "eventDate",
                "fields": {
                  "title": "{title}",
                  "eventDate": "{eventDate}",
                  "eventTime": "{eventTime}",
                  "location": "{location}",
                  "capacity": "{capacity}",
                  "coordinatorFanId": "{coordinatorFanId}",
                  "recurrenceLabel": "{recurrenceLabel}",
                  "reminderOffsetHours": "{reminderOffsetHours}",
                  "durationMinutes": "{durationMinutes}",
                  "workType": "{workType}",
                  "accessibilityNote": "{accessibilityNote}",
                  "seriesId": "$newSeriesId"
                },
                "recurrenceRule": {
                  "freq": "{input.freq}",
                  "interval": 1,
                  "count": "{input.count}"
                }
              }
            ]
          },
          {
            "id": "cancel-event",
            "action": "cancel",
            "label": "Cancel event",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["open"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["garden-coordinator"] },
            "effects": [
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "garden-event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "pending" }
                },
                "transitionId": "event-cancelled"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "garden-event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "going" }
                },
                "transitionId": "event-cancelled"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "garden-event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "maybe" }
                },
                "transitionId": "event-cancelled"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "garden-event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "declined" }
                },
                "transitionId": "event-cancelled"
              },
              {
                "op": "transitionRelated",
                "relatedQuery": {
                  "workflowType": "garden-event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "waitlisted" }
                },
                "transitionId": "event-cancelled"
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New garden event",
                "byRoleIds": ["garden-coordinator"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "coordinatorFanId": "$actor" }
              }
            ],
            "responseTable": {
              "workflowType": "garden-event-rsvp-response",
              "eventField": "eventId",
              "pendingStates": ["pending"]
            }
          },
          {
            "states": ["cancelled"],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          },
          {
            "states": ["open", "cancelled"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "storage": "inline",
            "searchable": true,
            "sortable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "storage": "inline",
            "sortable": true,
            "displayIcon": "calendar_today",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventTime": {
            "type": "time",
            "required": true,
            "writableBy": "formEntry",
            "storage": "inline",
            "displayIcon": "schedule",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "location": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "storage": "inline",
            "displayIcon": "location_on_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "capacity": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "storage": "inline",
            "displayIcon": "groups_outlined",
            "labelTemplate": "{value} spots",
            "displayContexts": ["tile", "detail"]
          },
          "coordinatorFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "platform",
            "storage": "inline",
            "displayContexts": []
          },
          "recurrenceLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "storage": "inline",
            "displayIcon": "event_repeat",
            "labelTemplate": "Repeats: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "reminderOffsetHours": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "storage": "inline",
            "displayIcon": "notifications_active",
            "labelTemplate": "Default reminder: {value} hours before",
            "displayContexts": ["detail"]
          },
          "responses": {
            "type": "list",
            "source": "query(garden-event-rsvp-response where eventId == id)",
            "displayContexts": []
          },
          "coordinatorResponseRoster": {
            "type": "list",
            "formula": "if($viewer == coordinatorFanId, responses, null)",
            "displayIcon": "groups_2",
            "labelTemplate": "Attendance roster: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "responseCounts": {
            "type": "map",
            "formula": "groupCount(responses, '$state')",
            "displayContexts": []
          },
          "goingCount": {
            "type": "number",
            "formula": "mapGet(responseCounts, 'going')",
            "displayIcon": "how_to_reg",
            "labelTemplate": "Going: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "waitlistedCount": {
            "type": "number",
            "formula": "mapGet(responseCounts, 'waitlisted')",
            "displayIcon": "hourglass_empty",
            "labelTemplate": "Waitlist: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "seatsRemaining": {
            "type": "number",
            "formula": "capacity - goingCount",
            "displayIcon": "event_seat",
            "labelTemplate": "{value} spots left",
            "displayContexts": ["tile", "detail"]
          },
          "isFull": {
            "type": "bool",
            "formula": "goingCount >= capacity",
            "displayIcon": "event_busy",
            "labelTemplate": "Full: {value}",
            "displayContexts": ["detail"]
          },
          "durationMinutes": {
            "type": "number",
            "writableBy": "formEntry",
            "displayIcon": "timer",
            "labelTemplate": "{value} minutes",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "workType": {
            "type": "text",
            "writableBy": "formEntry",
            "displayIcon": "compost",
            "labelTemplate": "Seasonal focus: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "accessibilityNote": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "accessible",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "seriesId": {
            "type": "text",
            "writableBy": "effect",
            "storage": "inline",
            "displayContexts": []
          }
        }
      },

      "garden-event-rsvp-response": {
        "initialState": "pending",
        "visibility": { "default": "membersOnly" },
        "states": {
          "pending": { "label": "No response yet", "tone": "info" },
          "going": { "label": "Going", "tone": "positive" },
          "maybe": { "label": "Maybe", "tone": "info" },
          "declined": { "label": "Not attending", "tone": "negative" },
          "waitlisted": { "label": "Waitlisted", "tone": "warning" },
          "cancelled": {
            "label": "Event cancelled",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "respond-going",
            "action": "respond",
            "label": "Going",
            "icon": "event_available",
            "tone": "primary",
            "from": ["pending", "maybe", "declined", "waitlisted"],
            "to": "going",
            "guard": {
              "allowedRoleIds": ["garden-member", "garden-coordinator"],
              "actorEqualsField": { "key": "fanId" },
              "relatedAggregate": {
                "workflowType": "garden-event-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count",
                "comparator": "<",
                "compareTo": {
                  "relatedInstanceField": "eventId",
                  "field": "capacity"
                }
              }
            },
            "effects": [
              { "op": "set", "key": "respondedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "respond-maybe",
            "action": "respond",
            "label": "Maybe",
            "icon": "help_outline",
            "tone": "secondary",
            "from": ["pending", "going", "declined", "waitlisted"],
            "to": "maybe",
            "guard": {
              "allowedRoleIds": ["garden-member", "garden-coordinator"],
              "actorEqualsField": { "key": "fanId" }
            },
            "effects": [
              { "op": "set", "key": "respondedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "respond-declined",
            "action": "respond",
            "label": "Not attending",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["pending", "going", "maybe", "waitlisted"],
            "to": "declined",
            "guard": {
              "allowedRoleIds": ["garden-member", "garden-coordinator"],
              "actorEqualsField": { "key": "fanId" }
            },
            "effects": [
              { "op": "set", "key": "respondedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "respond-waitlist",
            "action": "join_waitlist",
            "label": "Join waitlist",
            "icon": "groups",
            "tone": "secondary",
            "from": ["pending", "maybe", "declined"],
            "to": "waitlisted",
            "guard": {
              "allowedRoleIds": ["garden-member", "garden-coordinator"],
              "actorEqualsField": { "key": "fanId" },
              "relatedAggregate": {
                "workflowType": "garden-event-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count",
                "comparator": ">=",
                "compareTo": {
                  "relatedInstanceField": "eventId",
                  "field": "capacity"
                }
              }
            },
            "effects": [
              { "op": "set", "key": "respondedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "add-reminder",
            "action": "set_reminder",
            "label": "Add reminder",
            "icon": "add_alert",
            "tone": "secondary",
            "from": ["pending", "going", "maybe", "waitlisted"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["garden-member", "garden-coordinator"],
              "actorEqualsField": { "key": "fanId" }
            },
            "inputs": {
              "dueAt": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "reminderDueAt", "value": "{input.dueAt}" },
              {
                "op": "createInstance",
                "workflowType": "garden-notification",
                "fields": {
                  "recipientFanId": "{fanId}",
                  "title": "Garden event reminder",
                  "body": "Your saved garden event is coming up. Open Calendar for the current date, place, capacity, and RSVP.",
                  "createdAt": "$timestamp",
                  "dueAt": "{input.dueAt}",
                  "sourceWorkflowType": "garden-event-rsvp-response"
                }
              }
            ]
          },
          {
            "id": "withdraw-rsvp",
            "action": "withdraw_response",
            "label": "Cancel RSVP",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["going", "maybe", "waitlisted"],
            "to": "pending",
            "guard": {
              "allowedRoleIds": ["garden-member", "garden-coordinator"],
              "actorEqualsField": { "key": "fanId" }
            },
            "effects": [
              { "op": "set", "key": "respondedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "event-cancelled",
            "action": "cancel",
            "label": "Event cancelled",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["pending", "going", "maybe", "declined", "waitlisted"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["garden-coordinator"] }
          }
        ],
        "renderBindings": [],
        "instanceDataSchema": {
          "eventId": {
            "type": "text",
            "required": true,
            "storage": "inline"
          },
          "fanId": {
            "type": "fanId",
            "required": true,
            "storage": "inline"
          },
          "respondedAt": {
            "type": "date?",
            "writableBy": "effect",
            "storage": "inline"
          },
          "reminderDueAt": {
            "type": "date?",
            "writableBy": "effect",
            "storage": "inline"
          }
        }
      },

      "garden-notification": {
        "initialState": "unread",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "formula": "$viewer == recipientFanId"
          },
          "fields": { "recipient": "recipientFanId" }
        },
        "states": {
          "unread": { "label": "Unread", "tone": "info" },
          "read": {
            "label": "Read",
            "tone": "positive",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "mark-read",
            "label": "Mark read",
            "icon": "done",
            "tone": "secondary",
            "from": ["unread"],
            "to": "read",
            "guard": {
              "actorEqualsField": { "key": "recipientFanId" }
            }
          }
        ],
        "renderBindings": [
          {
            "states": ["unread"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary"
          },
          {
            "states": ["read"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "recipientFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "effect",
            "storage": "inline"
          },
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "storage": "inline",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "body": {
            "type": "textarea",
            "required": true,
            "writableBy": "effect",
            "storage": "inline",
            "displayContexts": ["detail"]
          },
          "createdAt": {
            "type": "date",
            "required": true,
            "writableBy": "effect",
            "storage": "inline",
            "sortable": true,
            "displayIcon": "schedule",
            "labelTemplate": "Created {value}"
          },
          "dueAt": {
            "type": "date",
            "required": true,
            "writableBy": "effect",
            "storage": "inline",
            "sortable": true,
            "displayIcon": "notifications_active",
            "labelTemplate": "Due {value}"
          },
          "sourceWorkflowType": {
            "type": "text",
            "required": true,
            "writableBy": "effect",
            "storage": "inline",
            "displayIcon": "link",
            "labelTemplate": "From {value}"
          }
        }
      },

      "plant-exchange-submission": {
        "initialState": "draft",
        "visibility": { "default": "membersOnly" },
        "reminder": {
          "anchorDateField": "pickupDate",
          "anchorTimeField": "pickupTime",
          "leadHours": 24,
          "leadHoursField": "reminderOffsetHours"
        },
        "states": {
          "draft": {
            "label": "Draft",
            "tone": "info",
            "editableFields": [
              "plantVariety",
              "offerType",
              "notes",
              "pickupWindow",
              "pickupDate",
              "pickupTime",
              "reminderOffsetHours",
              "safePickupDetails",
              "availabilityNote",
              "contactInfo",
              "privacyLabel",
              "privacyAcknowledged"
            ],
            "editGuard": {
              "actorEqualsField": { "key": "ownerFanId" }
            }
          },
          "submitted": {
            "label": "Submitted for review",
            "tone": "warning"
          },
          "reviewed": {
            "label": "Reviewed for handoff",
            "tone": "positive",
            "isTerminal": true
          },
          "withdrawn": {
            "label": "Withdrawn",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "submit-exchange",
            "label": "Submit exchange",
            "icon": "send",
            "tone": "primary",
            "from": ["draft"],
            "to": "submitted",
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "privacyAcknowledged",
                "value": true
              }
            },
            "effects": [
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              { "op": "set", "key": "handoffStatus", "value": "awaiting-review" }
            ]
          },
          {
            "id": "approve-handoff",
            "label": "Approve handoff",
            "icon": "fact_check",
            "tone": "primary",
            "from": ["submitted"],
            "to": "reviewed",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"]
            },
            "inputs": {
              "handoffRecipientFanId": {
                "type": "fanId",
                "required": true
              },
              "reviewNote": { "type": "text", "required": true }
            },
            "effects": [
              {
                "op": "set",
                "key": "reviewedByFanId",
                "value": "$actor"
              },
              {
                "op": "set",
                "key": "handoffRecipientFanId",
                "value": "{input.handoffRecipientFanId}"
              },
              { "op": "set", "key": "reviewNote", "value": "{input.reviewNote}" },
              { "op": "set", "key": "handoffStatus", "value": "approved" },
              { "op": "set", "key": "reviewedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "withdraw-submission",
            "label": "Withdraw submission",
            "icon": "undo",
            "tone": "destructive",
            "from": ["draft", "submitted"],
            "to": "withdrawn",
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" }
            },
            "effects": [
              { "op": "set", "key": "handoffStatus", "value": "withdrawn" },
              { "op": "set", "key": "withdrawnAt", "value": "$timestamp" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["draft"],
            "audience": "actor",
            "tabId": "home",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Offer or request a plant",
                "byRoleIds": ["garden-member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": { "ownerFanId": "$actor" }
              }
            ]
          },
          {
            "states": ["submitted", "withdrawn"],
            "audience": "actor",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          },
          {
            "states": ["reviewed"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "summary"
          },
          {
            "states": ["submitted"],
            "audience": "any",
            "tabId": "organize",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["reviewed"],
            "audience": "any",
            "tabId": "organize",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "plantVariety": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "displayIcon": "eco",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "offerType": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "swap_horiz",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "notes": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "notes",
            "displayContexts": ["detail"]
          },
          "pickupWindow": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "Pickup: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "pickupDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "event",
            "labelTemplate": "Pickup date: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "pickupTime": {
            "type": "time",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "Pickup time: {value}",
            "displayContexts": ["detail"]
          },
          "reminderOffsetHours": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "notifications_active",
            "labelTemplate": "Reminder: {value} hours before pickup",
            "displayContexts": ["detail"]
          },
          "safePickupDetails": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "local_shipping",
            "labelTemplate": "Safe pickup: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "availabilityNote": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "inventory_2",
            "labelTemplate": "Availability: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "contactInfo": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "privacyLabel": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "privacy_tip",
            "labelTemplate": "Privacy: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "privacyAcknowledged": {
            "type": "bool",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "ownerFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "platform",
            "storage": "inline",
            "displayIcon": "person_outline",
            "labelTemplate": "Submitted by {value}",
            "displayContexts": ["detail"]
          },
          "submittedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "hideWhenEmpty": true,
            "displayIcon": "outbox",
            "labelTemplate": "Submitted {value}"
          },
          "reviewedByFanId": {
            "type": "fanId?",
            "writableBy": "effect",
            "displayContexts": []
          },
          "handoffRecipientFanId": {
            "type": "fanId?",
            "writableBy": "effect",
            "displayContexts": []
          },
          "reviewedAt": {
            "type": "date?",
            "writableBy": "effect",
            "sortable": true,
            "hideWhenEmpty": true,
            "displayIcon": "task_alt",
            "labelTemplate": "Reviewed {value}"
          },
          "reviewNote": {
            "type": "textarea",
            "writableBy": "effect",
            "displayIcon": "rate_review",
            "labelTemplate": "Review: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "handoffStatus": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "handshake",
            "labelTemplate": "Handoff: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "withdrawnAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "undo",
            "labelTemplate": "Withdrawn {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "contactInfoDisplay": {
            "type": "text",
            "formula": "if($viewer == ownerFanId || $viewer == reviewedByFanId || $viewer == handoffRecipientFanId, contactInfo, 'Protected until approved handoff')",
            "displayIcon": "contact_mail",
            "labelTemplate": "Contact: {value}",
            "displayContexts": ["detail"]
          }
        }
      },

      "garden-tool-loan": {
        "initialState": "published",
        "visibility": { "default": "membersOnly" },
        "reminder": {
          "anchorDateField": "dueDate",
          "leadHours": 24
        },
        "states": {
          "published": {
            "label": "Listed for loan",
            "tone": "positive",
            "editableFields": [
              "title",
              "toolDescription",
              "coordinatorFanId",
              "ownerContactInfo",
              "conditionNote",
              "loanTerms",
              "pickupInstructions",
              "returnInstructions",
              "careInstructions"
            ],
            "editGuard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "available"
              }
            }
          },
          "delisted": {
            "label": "Delisted",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "request-loan",
            "action": "request",
            "label": "Request loan",
            "icon": "arrow_forward",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["garden-member"],
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "available"
              },
              "formula": "if(ownerFanId == $actor, false, true)"
            },
            "inputs": {
              "pickupWindow": { "type": "text", "required": true },
              "dueDate": { "type": "text", "required": true },
              "borrowerContactInfo": { "type": "text", "required": true }
            },
            "effects": [
              {
                "op": "set",
                "key": "availabilityState",
                "value": "reserved"
              },
              {
                "op": "set",
                "key": "borrowerFanId",
                "value": "$actor"
              },
              {
                "op": "set",
                "key": "pickupWindow",
                "value": "{input.pickupWindow}"
              },
              {
                "op": "set",
                "key": "dueDate",
                "value": "{input.dueDate}"
              },
              {
                "op": "set",
                "key": "borrowerContactInfo",
                "value": "{input.borrowerContactInfo}"
              },
              {
                "op": "set",
                "key": "requestedAt",
                "value": "$timestamp"
              },
              {
                "op": "createInstance",
                "workflowType": "garden-notification",
                "fields": {
                  "recipientFanId": "{ownerFanId}",
                  "title": "Tool loan requested",
                  "body": "{title} was requested. Review the pickup and due terms in Marketplace.",
                  "createdAt": "$timestamp",
                  "dueAt": "$timestamp",
                  "sourceWorkflowType": "garden-tool-loan"
                }
              }
            ]
          },
          {
            "id": "join-queue",
            "action": "join_queue",
            "label": "Join queue",
            "icon": "queue",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["garden-member"],
              "formula": "if(ownerFanId == $actor, false, availabilityState == 'reserved' || availabilityState == 'onLoan')"
            }
          },
          {
            "id": "leave-queue",
            "action": "leave_queue",
            "label": "Leave queue",
            "icon": "remove_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": { "allowedRoleIds": ["garden-member"] }
          },
          {
            "id": "confirm-pickup",
            "action": "take_custody",
            "label": "Confirm pickup",
            "icon": "handshake",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "reserved"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "availabilityState",
                "value": "onLoan"
              },
              { "op": "set", "key": "borrowedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "decline-loan",
            "action": "decide_request",
            "label": "Decline request",
            "icon": "cancel_presentation",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "reserved"
              }
            },
            "effects": [
              {
                "op": "createInstance",
                "workflowType": "garden-notification",
                "fields": {
                  "recipientFanId": "{borrowerFanId}",
                  "title": "Loan request declined",
                  "body": "The owner declined the current request for {title}.",
                  "createdAt": "$timestamp",
                  "dueAt": "$timestamp",
                  "sourceWorkflowType": "garden-tool-loan"
                }
              },
              {
                "op": "set",
                "key": "availabilityState",
                "value": "available"
              },
              { "op": "set", "key": "borrowerFanId", "value": null },
              { "op": "set", "key": "borrowerContactInfo", "value": null },
              { "op": "set", "key": "pickupWindow", "value": null },
              { "op": "set", "key": "dueDate", "value": null }
            ]
          },
          {
            "id": "cancel-loan",
            "action": "withdraw_request",
            "label": "Cancel loan",
            "icon": "undo",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "borrowerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "reserved"
              }
            },
            "effects": [
              {
                "op": "createInstance",
                "workflowType": "garden-notification",
                "fields": {
                  "recipientFanId": "{ownerFanId}",
                  "title": "Loan request cancelled",
                  "body": "The borrower cancelled the current request for {title}.",
                  "createdAt": "$timestamp",
                  "dueAt": "$timestamp",
                  "sourceWorkflowType": "garden-tool-loan"
                }
              },
              {
                "op": "set",
                "key": "availabilityState",
                "value": "available"
              },
              { "op": "set", "key": "borrowerFanId", "value": null },
              { "op": "set", "key": "borrowerContactInfo", "value": null },
              { "op": "set", "key": "pickupWindow", "value": null },
              { "op": "set", "key": "dueDate", "value": null }
            ]
          },
          {
            "id": "return-item",
            "action": "return",
            "label": "Return item",
            "icon": "assignment_return",
            "tone": "primary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "borrowerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "onLoan"
              }
            },
            "effects": [
              {
                "op": "createInstance",
                "workflowType": "garden-notification",
                "fields": {
                  "recipientFanId": "{ownerFanId}",
                  "title": "Tool returned",
                  "body": "{title} was marked returned and is available again.",
                  "createdAt": "$timestamp",
                  "dueAt": "$timestamp",
                  "sourceWorkflowType": "garden-tool-loan"
                }
              },
              {
                "op": "set",
                "key": "availabilityState",
                "value": "available"
              },
              {
                "op": "set",
                "key": "conditionState",
                "value": "returned"
              },
              { "op": "set", "key": "returnedAt", "value": "$timestamp" },
              { "op": "set", "key": "borrowerFanId", "value": null },
              { "op": "set", "key": "borrowerContactInfo", "value": null },
              { "op": "set", "key": "pickupWindow", "value": null },
              { "op": "set", "key": "dueDate", "value": null }
            ]
          },
          {
            "id": "pause-listing",
            "action": "pause_listing",
            "label": "Pause listing",
            "icon": "pause_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "available"
              }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "paused" }
            ]
          },
          {
            "id": "resume-listing",
            "action": "list_item",
            "label": "Resume listing",
            "icon": "play_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "paused"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "availabilityState",
                "value": "available"
              }
            ]
          },
          {
            "id": "mark-damaged",
            "action": "report_issue",
            "label": "Mark damaged",
            "icon": "build_circle",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "borrowerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "onLoan"
              }
            },
            "inputs": {
              "conditionNote": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "conditionState", "value": "damaged" },
              {
                "op": "set",
                "key": "conditionNote",
                "value": "{input.conditionNote}"
              },
              { "op": "set", "key": "flaggedByFanId", "value": "$actor" }
            ]
          },
          {
            "id": "report-lost",
            "action": "report_issue",
            "label": "Report lost",
            "icon": "report_problem",
            "tone": "destructive",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "borrowerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "onLoan"
              }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "lost" },
              { "op": "set", "key": "conditionState", "value": "lost" },
              { "op": "set", "key": "flaggedByFanId", "value": "$actor" },
              {
                "op": "createInstance",
                "workflowType": "garden-notification",
                "fields": {
                  "recipientFanId": "{ownerFanId}",
                  "title": "Tool reported lost",
                  "body": "The current holder reported {title} lost.",
                  "createdAt": "$timestamp",
                  "dueAt": "$timestamp",
                  "sourceWorkflowType": "garden-tool-loan"
                }
              }
            ]
          },
          {
            "id": "report-issue",
            "action": "report_issue",
            "label": "Report issue",
            "icon": "feedback",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "formula": "ownerFanId == $actor || borrowerFanId == $actor"
            },
            "inputs": {
              "issueNote": { "type": "text", "required": true }
            },
            "effects": [
              {
                "op": "set",
                "key": "conditionNote",
                "value": "{input.issueNote}"
              },
              { "op": "set", "key": "flaggedByFanId", "value": "$actor" }
            ]
          },
          {
            "id": "delist",
            "action": "delist",
            "label": "Delist",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["published"],
            "to": "delisted",
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "available"
              }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": null }
            ]
          },
          {
            "id": "retire-lost-item",
            "action": "delist",
            "label": "Retire lost item",
            "icon": "delete_forever",
            "tone": "destructive",
            "from": ["published"],
            "to": "delisted",
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "lost"
              }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": null }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["published"],
            "audience": "any",
            "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "List a tool to loan",
                "byRoleIds": ["garden-member", "garden-coordinator"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "ownerFanId": "$actor",
                  "mode": "loan",
                  "availabilityState": "available",
                  "conditionState": "good"
                }
              }
            ]
          },
          {
            "states": ["delisted"],
            "audience": "any",
            "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan",
            "bindingKind": "summary"
          },
          {
            "states": ["published"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "equipment-loan",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "toolDescription": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "yard",
            "displayContexts": ["detail"]
          },
          "mode": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "swap_horiz",
            "labelTemplate": "Mode: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "ownerFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "person_outline",
            "labelTemplate": "Owner: {value}",
            "displayContexts": ["detail"]
          },
          "coordinatorFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "ownerContactInfo": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "availabilityState": {
            "type": "text?",
            "writableBy": "platform",
            "displayIcon": "inventory_2",
            "labelTemplate": "Availability: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "borrowerFanId": {
            "type": "fanId?",
            "writableBy": "effect",
            "displayContexts": []
          },
          "borrowerContactInfo": {
            "type": "text?",
            "writableBy": "effect",
            "displayContexts": []
          },
          "pickupWindow": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "schedule",
            "labelTemplate": "Pickup: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "dueDate": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event_busy",
            "labelTemplate": "Due back {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "requestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "outbox",
            "labelTemplate": "Requested {value}"
          },
          "borrowedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "login",
            "labelTemplate": "Borrowed {value}"
          },
          "returnedAt": {
            "type": "date?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayIcon": "assignment_returned",
            "labelTemplate": "Returned {value}"
          },
          "conditionState": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "verified_outlined",
            "labelTemplate": "Condition: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "conditionNote": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "build",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "loanTerms": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "gavel",
            "labelTemplate": "Loan terms: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "pickupInstructions": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "where_to_vote",
            "labelTemplate": "Pickup instructions: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "returnInstructions": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "assignment_return",
            "labelTemplate": "Return instructions: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "careInstructions": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "cleaning_services",
            "labelTemplate": "Tool care: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "flaggedByFanId": {
            "type": "fanId?",
            "writableBy": "effect",
            "hideWhenEmpty": true,
            "displayContexts": []
          },
          "isAvailable": {
            "type": "bool",
            "formula": "availabilityState == 'available'",
            "displayIcon": "check_circle_outline",
            "labelTemplate": "Available: {value}",
            "displayContexts": ["detail"]
          },
          "isOverdue": {
            "type": "bool",
            "formula": "if(availabilityState == 'onLoan', isPast(dueDate), false)",
            "displayIcon": "warning_amber",
            "labelTemplate": "Overdue: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "custodyDisplay": {
            "type": "text",
            "formula": "if(availabilityState == 'onLoan', if($viewer == ownerFanId || $viewer == borrowerFanId || $viewer == coordinatorFanId, borrowerFanId, 'Checked out to a club member'), 'No current holder')",
            "displayIcon": "person_pin",
            "labelTemplate": "Current holder: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "ownerContactDisplay": {
            "type": "text",
            "formula": "if($viewer == ownerFanId || $viewer == coordinatorFanId || ($viewer == borrowerFanId && availabilityState == 'onLoan'), ownerContactInfo, 'Protected until approved pickup handoff')",
            "displayIcon": "contact_mail",
            "labelTemplate": "Owner contact: {value}",
            "displayContexts": ["detail"]
          },
          "borrowerContactDisplay": {
            "type": "text",
            "formula": "if($viewer == ownerFanId || $viewer == coordinatorFanId || $viewer == borrowerFanId, borrowerContactInfo, 'Protected until approved pickup handoff')",
            "displayIcon": "contact_phone",
            "labelTemplate": "Borrower contact: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          }
        }
      },

      "garden-tool-giveaway": {
        "initialState": "published",
        "visibility": { "default": "membersOnly" },
        "states": {
          "published": {
            "label": "Available to claim",
            "tone": "positive",
            "editableFields": [
              "title",
              "itemDescription",
              "coordinatorFanId",
              "ownerContactInfo",
              "conditionNote",
              "transferTerms",
              "pickupInstructions",
              "careInstructions"
            ],
            "editGuard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "available"
              }
            }
          },
          "given": {
            "label": "Ownership transferred",
            "tone": "positive",
            "isTerminal": true
          },
          "delisted": {
            "label": "Delisted",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "claim-giveaway",
            "action": "claim",
            "label": "Claim giveaway",
            "icon": "volunteer_activism",
            "tone": "primary",
            "from": ["published"],
            "to": "given",
            "guard": {
              "allowedRoleIds": ["garden-member"],
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "available"
              },
              "formula": "if(ownerFanId == $actor, false, true)"
            },
            "inputs": {
              "pickupWindow": { "type": "text", "required": true },
              "claimantContactInfo": { "type": "text", "required": true }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": null },
              { "op": "set", "key": "claimantFanId", "value": "$actor" },
              {
                "op": "set",
                "key": "pickupWindow",
                "value": "{input.pickupWindow}"
              },
              {
                "op": "set",
                "key": "claimantContactInfo",
                "value": "{input.claimantContactInfo}"
              },
              { "op": "set", "key": "claimedAt", "value": "$timestamp" },
              {
                "op": "createInstance",
                "workflowType": "garden-notification",
                "fields": {
                  "recipientFanId": "{ownerFanId}",
                  "title": "Giveaway claimed",
                  "body": "{title} was claimed. Review the pickup window in Marketplace.",
                  "createdAt": "$timestamp",
                  "dueAt": "$timestamp",
                  "sourceWorkflowType": "garden-tool-giveaway"
                }
              }
            ]
          },
          {
            "id": "pause-giveaway",
            "action": "pause_listing",
            "label": "Pause listing",
            "icon": "pause_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "available"
              }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": "paused" }
            ]
          },
          {
            "id": "resume-giveaway",
            "action": "list_item",
            "label": "Resume listing",
            "icon": "play_circle_outline",
            "tone": "secondary",
            "from": ["published"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "paused"
              }
            },
            "effects": [
              {
                "op": "set",
                "key": "availabilityState",
                "value": "available"
              }
            ]
          },
          {
            "id": "delist-giveaway",
            "action": "delist",
            "label": "Delist",
            "icon": "delete_outline",
            "tone": "destructive",
            "from": ["published"],
            "to": "delisted",
            "guard": {
              "actorEqualsField": { "key": "ownerFanId" },
              "instanceDataEquals": {
                "key": "availabilityState",
                "value": "available"
              }
            },
            "effects": [
              { "op": "set", "key": "availabilityState", "value": null }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["published"],
            "audience": "any",
            "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Give away a garden item",
                "byRoleIds": ["garden-member", "garden-coordinator"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "ownerFanId": "$actor",
                  "mode": "giveaway",
                  "availabilityState": "available",
                  "conditionState": "good"
                }
              }
            ]
          },
          {
            "states": ["given", "delisted"],
            "audience": "any",
            "tabId": "marketplace",
            "cardSurfaceFamily": "equipment-loan",
            "bindingKind": "summary"
          },
          {
            "states": ["published"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "equipment-loan",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "itemDescription": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "yard",
            "displayContexts": ["detail"]
          },
          "mode": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "redeem",
            "labelTemplate": "Mode: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "ownerFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "person_outline",
            "labelTemplate": "Owner: {value}",
            "displayContexts": ["detail"]
          },
          "coordinatorFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "ownerContactInfo": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayContexts": []
          },
          "availabilityState": {
            "type": "text?",
            "writableBy": "platform",
            "displayIcon": "inventory_2",
            "labelTemplate": "Availability: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "conditionState": {
            "type": "text",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "verified_outlined",
            "labelTemplate": "Condition: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "conditionNote": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "build",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "transferTerms": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "handshake",
            "labelTemplate": "Transfer terms: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "pickupInstructions": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "where_to_vote",
            "labelTemplate": "Pickup instructions: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "careInstructions": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "eco",
            "labelTemplate": "Reuse note: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "claimantFanId": {
            "type": "fanId?",
            "writableBy": "effect",
            "displayContexts": []
          },
          "claimantContactInfo": {
            "type": "text?",
            "writableBy": "effect",
            "displayContexts": []
          },
          "pickupWindow": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "schedule",
            "labelTemplate": "Pickup: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "claimedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "task_alt",
            "labelTemplate": "Claimed {value}",
            "hideWhenEmpty": true
          },
          "transferSummary": {
            "type": "text",
            "formula": "if(claimantFanId == null, 'Awaiting claim', 'Ownership transferred')",
            "displayIcon": "published_with_changes",
            "labelTemplate": "Transfer: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "claimantDisplay": {
            "type": "text",
            "formula": "if(claimantFanId == null, 'Not claimed', if($viewer == ownerFanId || $viewer == claimantFanId || $viewer == coordinatorFanId, claimantFanId, 'Claimed by a club member'))",
            "displayIcon": "person_pin",
            "labelTemplate": "Claim: {value}",
            "displayContexts": ["detail"]
          },
          "ownerContactDisplay": {
            "type": "text",
            "formula": "if($viewer == ownerFanId || $viewer == coordinatorFanId || $viewer == claimantFanId, ownerContactInfo, 'Protected until ownership handoff')",
            "displayIcon": "contact_mail",
            "labelTemplate": "Owner contact: {value}",
            "displayContexts": ["detail"]
          },
          "claimantContactDisplay": {
            "type": "text",
            "formula": "if($viewer == ownerFanId || $viewer == coordinatorFanId || $viewer == claimantFanId, claimantContactInfo, 'Protected until ownership handoff')",
            "displayIcon": "contact_phone",
            "labelTemplate": "Claimant contact: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          }
        }
      },

      "garden-export-custom-schemas": {
        "initialState": "scope-selection",
        "visibility": {
          "default": "guarded",
          "readGuard": {
            "allowedRoleIds": ["garden-member", "garden-coordinator"]
          }
        },
        "states": {
          "scope-selection": {
            "label": "Choose export scope",
            "tone": "info",
            "editableFields": [
              "operationMode",
              "selectedSchemaIds",
              "destination",
              "redactionPreview",
              "exportableDataSummary"
            ],
            "editGuard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" }
            }
          },
          "redaction-review": {
            "label": "Review redaction",
            "tone": "warning"
          },
          "ready": { "label": "Ready for verified export", "tone": "info" },
          "processing": { "label": "Export operation in progress", "tone": "warning" },
          "exported": { "label": "Exported", "tone": "positive" },
          "error": { "label": "Export error", "tone": "negative" },
          "cancelled": {
            "label": "Cancelled",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "open-redaction-preview",
            "action": "preview",
            "label": "Review redaction preview",
            "icon": "policy",
            "tone": "primary",
            "from": ["scope-selection"],
            "to": "redaction-review",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" },
              "formula": "size(selectedSchemaIds) > 0"
            },
            "effects": [
              { "op": "set", "key": "statusMessage", "value": "Reviewing redaction preview" },
              { "op": "set", "key": "redactionStatus", "value": "previewed" }
            ]
          },
          {
            "id": "approve-redaction",
            "action": "approve_redaction",
            "label": "Approve redaction",
            "icon": "verified_user",
            "tone": "primary",
            "from": ["redaction-review"],
            "to": "ready",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" }
            },
            "effects": [
              {
                "op": "set",
                "key": "redactionApprovedAt",
                "value": "$timestamp"
              },
              { "op": "set", "key": "redactionStatus", "value": "approved" },
              { "op": "set", "key": "statusMessage", "value": "Redaction approved; ready to run" }
            ]
          },
          {
            "id": "start-export",
            "action": "run",
            "label": "Export",
            "icon": "file_download",
            "tone": "primary",
            "from": ["ready"],
            "to": "processing",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" },
              "formula": "operationMode == 'export'"
            },
            "effects": [
              { "op": "set", "key": "operationStartedAt", "value": "$timestamp" },
              { "op": "set", "key": "errorMessage", "value": null },
              { "op": "set", "key": "statusMessage", "value": "Generating export package" }
            ]
          },
          {
            "id": "start-transfer",
            "action": "run",
            "label": "Start transfer",
            "icon": "send_to_mobile",
            "tone": "primary",
            "from": ["ready"],
            "to": "processing",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" },
              "formula": "operationMode == 'transfer'"
            },
            "effects": [
              { "op": "set", "key": "operationStartedAt", "value": "$timestamp" },
              { "op": "set", "key": "errorMessage", "value": null },
              { "op": "set", "key": "statusMessage", "value": "Transfer in progress" }
            ]
          },
          {
            "id": "start-import",
            "action": "run",
            "label": "Import data",
            "icon": "upload_file",
            "tone": "primary",
            "from": ["ready"],
            "to": "processing",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" },
              "formula": "operationMode == 'import'"
            },
            "effects": [
              { "op": "set", "key": "operationStartedAt", "value": "$timestamp" },
              { "op": "set", "key": "errorMessage", "value": null },
              { "op": "set", "key": "statusMessage", "value": "Import in progress" }
            ]
          },
          {
            "id": "complete-operation",
            "action": "record_outcome",
            "label": "Confirm completion",
            "icon": "task_alt",
            "tone": "primary",
            "from": ["processing"],
            "to": "exported",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" }
            },
            "effects": [
              { "op": "set", "key": "exportedAt", "value": "$timestamp" },
              { "op": "set", "key": "downloadStatus", "value": "available" },
              { "op": "set", "key": "statusMessage", "value": "Operation complete; checksum and export receipt are generated by the platform" }
            ]
          },
          {
            "id": "fail-operation",
            "action": "record_outcome",
            "label": "Record export error",
            "icon": "error_outline",
            "tone": "secondary",
            "from": ["processing"],
            "to": "error",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" }
            },
            "inputs": {
              "errorMessage": { "type": "text", "required": true }
            },
            "effects": [
              {
                "op": "set",
                "key": "errorMessage",
                "value": "{input.errorMessage}"
              },
              { "op": "set", "key": "statusMessage", "value": "Operation failed; retry or change scope" }
            ]
          },
          {
            "id": "retry-export",
            "action": "retry",
            "label": "Retry",
            "icon": "refresh",
            "tone": "primary",
            "from": ["error"],
            "to": "ready",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" }
            },
            "effects": [
              { "op": "set", "key": "errorMessage", "value": null },
              { "op": "set", "key": "statusMessage", "value": "Ready to retry" }
            ]
          },
          {
            "id": "rollback-export",
            "action": "rollback",
            "label": "Rollback",
            "icon": "settings_backup_restore",
            "tone": "secondary",
            "from": ["exported"],
            "to": "ready",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" }
            },
            "effects": [
              { "op": "set", "key": "rolledBackAt", "value": "$timestamp" },
              { "op": "set", "key": "exportedAt", "value": null },
              { "op": "set", "key": "rollbackStatus", "value": "rolled-back" },
              { "op": "set", "key": "downloadStatus", "value": "unavailable" },
              { "op": "set", "key": "statusMessage", "value": "Rolled back; review scope before rerunning" }
            ]
          },
          {
            "id": "change-scope",
            "action": "configure_scope",
            "label": "Change scope",
            "icon": "tune",
            "tone": "secondary",
            "from": ["redaction-review", "ready", "error", "exported"],
            "to": "scope-selection",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" }
            },
            "effects": [
              { "op": "set", "key": "errorMessage", "value": null },
              { "op": "set", "key": "statusMessage", "value": "Scope reopened for changes" }
            ]
          },
          {
            "id": "download-export",
            "action": "download",
            "label": "Download export",
            "icon": "download",
            "tone": "primary",
            "from": ["exported"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" },
              "formula": "operationMode == 'export'"
            },
            "effects": [
              {
                "op": "set",
                "key": "downloadRequestedAt",
                "value": "$timestamp"
              },
              { "op": "set", "key": "downloadStatus", "value": "download-requested" },
              { "op": "set", "key": "statusMessage", "value": "Download requested; the platform verifies checksum and byte size" }
            ]
          },
          {
            "id": "cancel-transfer",
            "action": "cancel",
            "label": "Cancel transfer",
            "icon": "cancel",
            "tone": "destructive",
            "from": [
              "scope-selection",
              "redaction-review",
              "ready",
              "processing",
              "error"
            ],
            "to": "cancelled",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "ownerFanId" }
            },
            "effects": [
              { "op": "set", "key": "statusMessage", "value": "Operation cancelled" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": [
              "scope-selection",
              "redaction-review",
              "ready",
              "processing",
              "exported",
              "error",
              "cancelled"
            ],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "summary"
          },
          {
            "states": [
              "scope-selection",
              "redaction-review",
              "ready",
              "processing",
              "exported",
              "error",
              "cancelled"
            ],
            "audience": "any",
            "tabId": "documents",
            "cardSurfaceFamily": "exportWizard",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New export package",
                "byRoleIds": ["garden-coordinator"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "ownerFanId": "$actor"
                }
              }
            ]
          }
        ],
        "instanceDataSchema": {
          "operationMode": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "sync_alt",
            "labelTemplate": "Mode: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "selectedSchemaIds": {
            "type": "list",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schema",
            "labelTemplate": "{value.length} schemas selected",
            "displayContexts": ["tile", "detail"]
          },
          "destination": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "outbox",
            "labelTemplate": "Destination: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "redactionPreview": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 1000,
            "displayIcon": "policy",
            "labelTemplate": "Redaction preview: {value}",
            "displayContexts": ["detail"]
          },
          "exportableDataSummary": {
            "type": "textarea",
            "required": true,
            "writableBy": "formEntry",
            "maxLength": 1000,
            "displayIcon": "dataset",
            "labelTemplate": "Exportable data: {value}",
            "displayContexts": ["detail"]
          },
          "ownerFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "platform",
            "displayIcon": "admin_panel_settings",
            "labelTemplate": "Export owner: {value}",
            "displayContexts": ["detail"]
          },
          "redactionApprovedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "event_available",
            "labelTemplate": "Redaction approved {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "checksum": {
            "type": "text?",
            "writableBy": "platform",
            "platformSource": "checksum",
            "displayIcon": "fingerprint",
            "labelTemplate": "Checksum: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "checksumVerified": {
            "type": "bool",
            "writableBy": "platform",
            "displayIcon": "verified",
            "labelTemplate": "Checksum verified: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "transferId": {
            "type": "text?",
            "writableBy": "platform",
            "platformSource": "opaqueId",
            "displayIcon": "tag",
            "labelTemplate": "Transfer ID: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "receiptId": {
            "type": "text?",
            "writableBy": "platform",
            "platformSource": "opaqueId",
            "displayIcon": "receipt_long",
            "labelTemplate": "Receipt ID: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "operationStartedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "play_circle_outline",
            "labelTemplate": "Started {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "exportedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "cloud_done",
            "labelTemplate": "Completed {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "rolledBackAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "restore",
            "labelTemplate": "Rolled back {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "downloadRequestedAt": {
            "type": "date?",
            "writableBy": "effect",
            "displayIcon": "download_done",
            "labelTemplate": "Download requested {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "errorMessage": {
            "type": "textarea",
            "writableBy": "effect",
            "displayIcon": "error_outline",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "statusMessage": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "info_outline",
            "labelTemplate": "Status: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "redactionStatus": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "shield",
            "labelTemplate": "Redaction: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "downloadStatus": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "download_for_offline",
            "labelTemplate": "Download: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "rollbackStatus": {
            "type": "text?",
            "writableBy": "effect",
            "displayIcon": "settings_backup_restore",
            "labelTemplate": "Rollback: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "scopeCount": {
            "type": "number",
            "formula": "size(selectedSchemaIds)",
            "displayIcon": "format_list_numbered",
            "labelTemplate": "{value} schemas",
            "displayContexts": ["tile", "detail"]
          }
        }
      },

      "garden-volunteer-shift": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "reminder": {
          "anchorDateField": "shiftDate",
          "anchorTimeField": "shiftTime",
          "leadHours": 24
        },
        "states": {
          "open": {
            "label": "Open for sign-up",
            "tone": "positive",
            "editableFields": [
              "shiftTitle",
              "shiftDate",
              "shiftTime",
              "location",
              "capacity",
              "careCategory",
              "instructions",
              "signupCutoff",
              "weatherPlan"
            ],
            "editGuard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "coordinatorFanId" }
            }
          },
          "closed": {
            "label": "Closed",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "sign-up",
            "label": "Sign up",
            "icon": "how_to_reg",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["garden-member"],
              "actorInList": {
                "key": "signedUpFanIds",
                "present": false
              },
              "formula": "size(signedUpFanIds) < capacity"
            },
            "effects": [
              {
                "op": "appendUnique",
                "key": "signedUpFanIds",
                "value": "$actor"
              },
              {
                "op": "createInstance",
                "workflowType": "garden-notification",
                "fields": {
                  "recipientFanId": "$actor",
                  "title": "Volunteer shift confirmed",
                  "body": "You're signed up for {shiftTitle}. Open Care for the current time, place, and remaining spots.",
                  "createdAt": "$timestamp",
                  "dueAt": "$timestamp",
                  "sourceWorkflowType": "garden-volunteer-shift"
                }
              }
            ]
          },
          {
            "id": "cancel-signup",
            "label": "Cancel sign-up",
            "icon": "event_busy",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["garden-member"],
              "actorInList": {
                "key": "signedUpFanIds",
                "present": true
              }
            },
            "effects": [
              {
                "op": "removeValue",
                "key": "signedUpFanIds",
                "value": "$actor"
              }
            ]
          },
          {
            "id": "close-shift",
            "label": "Close shift",
            "icon": "lock_outline",
            "tone": "destructive",
            "from": ["open"],
            "to": "closed",
            "guard": {
              "allowedRoleIds": ["garden-coordinator"],
              "actorEqualsField": { "key": "coordinatorFanId" }
            }
          }
        ],
        "renderBindings": [
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "care",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary"
          },
          {
            "states": ["closed"],
            "audience": "any",
            "tabId": "care",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "summary"
          },
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "organize",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New volunteer shift",
                "byRoleIds": ["garden-coordinator"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "coordinatorFanId": "$actor",
                  "signedUpFanIds": []
                }
              }
            ]
          },
          {
            "states": ["closed"],
            "audience": "any",
            "tabId": "organize",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "summary"
          },
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "shiftTitle": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "searchable": true,
            "sortable": true,
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "shiftDate": {
            "type": "date",
            "required": true,
            "writableBy": "formEntry",
            "sortable": true,
            "displayIcon": "calendar_today",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "shiftTime": {
            "type": "time",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "schedule",
            "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "location": {
            "type": "text",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "location_on_outlined",
            "labelTemplate": "{value}",
            "displayContexts": ["detail"]
          },
          "capacity": {
            "type": "number",
            "required": true,
            "writableBy": "formEntry",
            "displayIcon": "groups_outlined",
            "labelTemplate": "{value} spots",
            "displayContexts": ["tile", "detail"]
          },
          "careCategory": {
            "type": "text",
            "writableBy": "formEntry",
            "displayIcon": "yard",
            "labelTemplate": "Care task: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["tile", "detail"]
          },
          "instructions": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "checklist",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "signupCutoff": {
            "type": "date?",
            "writableBy": "formEntry",
            "displayIcon": "timer_off",
            "labelTemplate": "Sign up by {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "weatherPlan": {
            "type": "textarea",
            "writableBy": "formEntry",
            "maxLength": 500,
            "displayIcon": "cloud",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          },
          "coordinatorFanId": {
            "type": "fanId",
            "required": true,
            "writableBy": "platform",
            "displayContexts": []
          },
          "signedUpFanIds": {
            "type": "fanId[]",
            "required": true,
            "writableBy": "platform",
            "displayContexts": []
          },
          "signedUpCount": {
            "type": "number",
            "formula": "size(signedUpFanIds)",
            "displayIcon": "how_to_reg",
            "labelTemplate": "Signed up: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "openSpotsRemaining": {
            "type": "number",
            "formula": "capacity - size(signedUpFanIds)",
            "displayIcon": "event_seat",
            "labelTemplate": "{value} spots left",
            "displayContexts": ["tile", "detail"]
          },
          "isFull": {
            "type": "bool",
            "formula": "size(signedUpFanIds) >= capacity",
            "displayIcon": "event_busy",
            "labelTemplate": "Full: {value}",
            "displayContexts": ["detail"]
          },
          "viewerSignedUp": {
            "type": "bool",
            "formula": "contains(signedUpFanIds, $viewer)",
            "displayIcon": "person_add_alt_1",
            "labelTemplate": "You are signed up: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "coordinatorRoster": {
            "type": "list",
            "formula": "if($viewer == coordinatorFanId, signedUpFanIds, null)",
            "displayIcon": "groups_2",
            "labelTemplate": "Roster: {value}",
            "hideWhenEmpty": true,
            "displayContexts": ["detail"]
          }
        }
      }
    },

