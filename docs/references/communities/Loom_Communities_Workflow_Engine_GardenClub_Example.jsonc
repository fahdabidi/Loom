      {
        "instanceId": "tomato-seedling-offer",
        "workflowType": "plant-exchange-submission",
        "currentState": "reviewed",
        "createdByPersonaId": "garden-member",
        "instanceData": {
          "plantVariety": "Brandywine tomato seedlings",
          "offerType": "offer",
          "notes": "Six sturdy seedlings from the spring sowing, ready for larger pots.",
          "pickupWindow": "Saturday 9–11am at the community shed",
          "availabilityNote": "Six available",
