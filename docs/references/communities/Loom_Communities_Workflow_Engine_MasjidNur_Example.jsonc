{
  "specVersion": 4,
  "skillVersion": "3.6.0",
  "packageId": "init_masjid_nur_engine_native_2",
  "communityId": "community_mosque",
  "communityHandle": "masjid-nur",
  "displayName": "Masjid Nur",
  "extensionId": "ext_mosque",
  "branding": { "accentColor": "#2E7D5B" },
  "seedDataFiles": [],
  "idempotencyKey": "masjid-nur-engine-native-v4-2026-08-19",

  "experience": {
    "displayName": "Masjid Nur",
    "tagline": "Announcements, worship, giving, volunteering, and private community care in one respectful hub.",
    "accentColor": "#2E7D5B",
    "theme": {
      "accent": "#2E7D5B",
      "tabThemes": {
        "calendar": { "accent": "#26734D" },
        "giving": { "accent": "#34785B" },
        "admin": { "accent": "#245C45" },
        "resources": { "accent": "#3B755C" }
      }
    },
    "creatableAction": {
      "multiActionStyle": "speedDial",
      "presentationStyle": "slideOutBottom"
    },
    "notifications": {
      "allowedChannels": ["inbox", "push"],
      "default": ["inbox", "push"]
    },

    "roles": [
      {
        "roleId": "owner",
        "label": "Masjid Admin",
        "roleLabel": "Admin",
        "description": "Publishes trusted updates, coordinates events and volunteers, records donations, and reviews protected care requests."
      },
      {
        "roleId": "community-member",
        "label": "Community Member",
        "roleLabel": "Member",
        "description": "Reads updates, RSVPs, gives, volunteers, uses resources, joins discussions, and requests care."
      }
    ],

    "workflowDefinitions": {
      "mosque-announcement": {
        "initialState": "draft",
        "visibility": { "default": "membersOnly" },
        "states": {
          "draft": {
            "label": "Draft",
            "tone": "info",
            "editableFields": ["title", "body", "audience", "channel", "scheduledFor"],
            "editGuard": { "allowedRoleIds": ["owner"] }
          },
          "previewed": { "label": "Previewed", "tone": "info" },
          "scheduled": {
            "label": "Scheduled",
            "tone": "warning",
            "editableFields": ["title", "body", "audience", "channel", "scheduledFor"],
            "editGuard": { "allowedRoleIds": ["owner"] }
          },
          "sent": { "label": "Sent", "tone": "positive" },
          "archived": { "label": "Archived", "tone": "info", "isTerminal": true },
          "cancelled": { "label": "Cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "save-announcement-draft",
            "label": "Save draft",
            "icon": "save",
            "tone": "secondary",
            "from": ["draft"],
            "to": null,
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "append", "key": "revisionHistory", "value": { "action": "draft-saved", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "preview-announcement",
            "label": "Preview announcement",
            "icon": "preview",
            "tone": "secondary",
            "from": ["draft"],
            "to": "previewed",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "append", "key": "revisionHistory", "value": { "action": "previewed", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "return-to-announcement-draft",
            "label": "Edit announcement",
            "icon": "edit",
            "tone": "secondary",
            "from": ["previewed", "scheduled"],
            "to": "draft",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "append", "key": "revisionHistory", "value": { "action": "returned-to-draft", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "schedule-announcement",
            "label": "Schedule announcement",
            "icon": "schedule",
            "tone": "primary",
            "from": ["draft", "previewed"],
            "to": "scheduled",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "deliveryState", "value": "scheduled" },
              { "op": "append", "key": "deliveryHistory", "value": { "status": "scheduled", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "publish-announcement",
            "label": "Publish announcement",
            "icon": "campaign",
            "tone": "primary",
            "from": ["draft", "previewed", "scheduled"],
            "to": "sent",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "deliveryState", "value": "sent" },
              { "op": "set", "key": "sentAt", "value": "$timestamp" },
              { "op": "append", "key": "deliveryHistory", "value": { "status": "sent", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "mark-announcement-read",
            "label": "Mark read",
            "icon": "mark_email_read",
            "tone": "secondary",
            "from": ["sent"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "readFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "readFanIds", "value": "$actor" },
              { "op": "append", "key": "deliveryHistory", "value": { "status": "read", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "archive-announcement",
            "label": "Archive announcement",
            "icon": "archive",
            "tone": "secondary",
            "from": ["sent"],
            "to": "archived",
            "guard": { "allowedRoleIds": ["owner"] }
          },
          {
            "id": "cancel-announcement",
            "label": "Cancel announcement",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["draft", "previewed", "scheduled"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["owner"] }
          }
        ],
        "renderBindings": [
          {
            "states": ["draft", "previewed", "scheduled"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New announcement",
                "byRoleIds": ["owner"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "senderFanId": "$actor",
                  "deliveryState": "draft",
                  "readFanIds": [],
                  "deliveryHistory": [],
                  "revisionHistory": []
                }
              }
            ]
          },
          {
            "states": ["sent"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary"
          },
          {
            "states": ["sent"],
            "audience": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary"
          },
          {
            "states": ["archived", "cancelled"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "body": { "type": "textarea", "required": true, "writableBy": "formEntry", "maxLength": 2000, "displayIcon": "article", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "senderFanId": { "type": "fanId", "required": true, "writableBy": "platform", "displayIcon": "person_outline", "labelTemplate": "From {value}", "displayContexts": ["tile", "detail"] },
          "audience": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "groups_outlined", "labelTemplate": "Audience: {value}", "displayContexts": ["tile", "detail"] },
          "channel": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "campaign", "labelTemplate": "Channel: {value}", "displayContexts": ["detail"] },
          "scheduledFor": { "type": "date?", "writableBy": "formEntry", "sortable": true, "displayIcon": "schedule", "labelTemplate": "Scheduled {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "sentAt": { "type": "date?", "writableBy": "effect", "sortable": true, "displayIcon": "send", "labelTemplate": "Sent {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "deliveryState": { "type": "text", "writableBy": "platform", "displayIcon": "outbox", "labelTemplate": "Delivery: {value}", "displayContexts": ["tile", "detail"] },
          "readFanIds": { "type": "fanId[]", "writableBy": "platform", "displayIcon": "mark_email_read", "labelTemplate": "Read by {value.length}", "displayContexts": ["tile", "detail"] },
          "deliveryHistory": { "type": "list", "writableBy": "platform", "displayIcon": "history", "labelTemplate": "Delivery history: {value.length}", "displayContexts": ["detail"] },
          "revisionHistory": { "type": "list", "writableBy": "platform", "displayIcon": "edit_note", "labelTemplate": "Revisions: {value.length}", "displayContexts": ["detail"] },
          "readCount": { "type": "number", "formula": "size(readFanIds)", "displayIcon": "done_all", "labelTemplate": "Readers: {value}", "displayContexts": ["tile", "detail"] }
        }
      },

      "mosque-event-rsvp": {
        "initialState": "draft",
        "visibility": { "default": "membersOnly" },
        "reminder": {
          "anchorDateField": "eventDate",
          "anchorTimeField": "eventTime",
          "leadHours": 24
        },
        "states": {
          "draft": {
            "label": "Draft event",
            "tone": "info",
            "editableFields": ["title", "eventDate", "eventTime", "location", "recurrence", "capacity"],
            "editGuard": { "allowedRoleIds": ["owner"] }
          },
          "open": {
            "label": "RSVP open",
            "tone": "positive",
            "editableFields": ["title", "eventDate", "eventTime", "location", "recurrence", "capacity"],
            "editGuard": { "allowedRoleIds": ["owner"] }
          },
          "cancelled": { "label": "Cancelled", "tone": "negative", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "save-event-draft",
            "action": "create",
            "label": "Save draft",
            "icon": "save",
            "tone": "secondary",
            "from": ["draft"],
            "to": null,
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "append", "key": "eventHistory", "value": { "status": "draft-saved", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "publish-event",
            "action": "create",
            "label": "Publish event",
            "icon": "event_available",
            "tone": "primary",
            "from": ["draft"],
            "to": "open",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "publishedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "rsvp-going",
            "action": "respond",
            "label": "Going",
            "icon": "event_available",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "goingFanIds", "present": false },
              "formula": "size(goingFanIds) < capacity"
            },
            "effects": [
              { "op": "appendUnique", "key": "goingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "maybeFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "notGoingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "waitlistFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "rsvp-maybe",
            "action": "respond",
            "label": "Maybe",
            "icon": "help_outline",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "maybeFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "maybeFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "goingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "notGoingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "waitlistFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "rsvp-not-going",
            "action": "respond",
            "label": "Not attending",
            "icon": "event_busy",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "notGoingFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "notGoingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "goingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "maybeFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "waitlistFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "join-event-waitlist",
            "action": "join_waitlist",
            "label": "Join waitlist",
            "icon": "groups",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "waitlistFanIds", "present": false },
              "formula": "size(goingFanIds) >= capacity"
            },
            "effects": [
              { "op": "appendUnique", "key": "waitlistFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "goingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "maybeFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "notGoingFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "cancel-rsvp",
            "action": "withdraw_response",
            "label": "Cancel RSVP",
            "icon": "undo",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "formula": "contains(goingFanIds, $actor) || contains(maybeFanIds, $actor) || contains(notGoingFanIds, $actor) || contains(waitlistFanIds, $actor)"
            },
            "effects": [
              { "op": "removeValue", "key": "goingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "maybeFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "notGoingFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "waitlistFanIds", "value": "$actor" }
            ]
          },
          {
            "id": "add-event-reminder",
            "action": "set_reminder",
            "label": "Add reminder",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": { "allowedRoleIds": ["community-member"] },
            "effects": [
              { "op": "append", "key": "reminderHistory", "value": { "action": "enabled", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "open-linked-volunteer-shift",
            "action": "view",
            "label": "Open volunteer shift",
            "icon": "volunteer_activism",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "guard": { "allowedRoleIds": ["community-member", "owner"] },
            "linkedWorkflowId": "mosque-volunteer-signup"
          },
          {
            "id": "cancel-event",
            "action": "cancel",
            "label": "Cancel event",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["draft", "open"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["owner"] }
          }
        ],
        "renderBindings": [
          {
            "states": ["draft"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary"
          },
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New event",
                "byRoleIds": ["owner"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "goingFanIds": [],
                  "maybeFanIds": [],
                  "notGoingFanIds": [],
                  "waitlistFanIds": [],
                  "reminderHistory": []
                }
              }
            ]
          },
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          },
          {
            "states": ["cancelled"],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "eventDate": { "type": "date", "required": true, "writableBy": "formEntry", "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "eventTime": { "type": "time", "required": true, "writableBy": "formEntry", "displayIcon": "schedule", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "location": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "location_on_outlined", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "recurrence": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "repeat", "labelTemplate": "Repeats: {value}", "displayContexts": ["tile", "detail"] },
          "capacity": { "type": "number", "required": true, "writableBy": "formEntry", "displayIcon": "groups_outlined", "labelTemplate": "{value} seats", "displayContexts": ["tile", "detail"] },
          "publishedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "publish", "labelTemplate": "Published {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "eventHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "Event history: {value.length}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "goingFanIds": { "type": "fanId[]", "writableBy": "platform" },
          "maybeFanIds": { "type": "fanId[]", "writableBy": "platform" },
          "notGoingFanIds": { "type": "fanId[]", "writableBy": "platform" },
          "waitlistFanIds": { "type": "fanId[]", "writableBy": "platform", "displayIcon": "hourglass_top", "labelTemplate": "Waitlist: {value.length}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "reminderHistory": { "type": "list", "writableBy": "platform", "displayIcon": "notifications_active", "labelTemplate": "Reminder changes: {value.length}", "displayContexts": ["detail"] },
          "goingCount": { "type": "number", "formula": "size(goingFanIds)", "displayIcon": "how_to_reg", "labelTemplate": "Going: {value}", "displayContexts": ["tile", "detail"] },
          "spotsRemaining": { "type": "number", "formula": "capacity - size(goingFanIds)", "displayIcon": "event_seat", "labelTemplate": "Open spots: {value}", "displayContexts": ["tile", "detail"] },
          "isFull": { "type": "bool", "formula": "size(goingFanIds) >= capacity", "displayIcon": "block", "labelTemplate": "Full: {value}", "displayContexts": ["detail"] }
        }
      },

      "mosque-document-resource": {
        "initialState": "available",
        "visibility": { "default": "membersOnly" },
        "states": {
          "available": {
            "label": "Available",
            "tone": "positive",
            "editableFields": ["title", "source", "version", "publishedDate", "resourceUrl", "accessLabel", "allowedFanIds"],
            "editGuard": { "allowedRoleIds": ["owner"] }
          },
          "archived": { "label": "Archived", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "record-resource-open",
            "action": "open",
            "label": "Record as opened",
            "icon": "open_in_new",
            "tone": "primary",
            "from": ["available"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member", "owner"],
              "formula": "size(allowedFanIds) == 0 || contains(allowedFanIds, $actor)"
            },
            "effects": [
              { "op": "append", "key": "auditHistory", "value": { "action": "opened", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "acknowledge-resource",
            "action": "acknowledge",
            "label": "Acknowledge",
            "icon": "task_alt",
            "tone": "primary",
            "from": ["available"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member", "owner"],
              "formula": "size(allowedFanIds) == 0 || contains(allowedFanIds, $actor)"
            },
            "effects": [
              { "op": "append", "key": "auditHistory", "value": { "action": "acknowledged", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "mark-resource-unread",
            "action": "mark_unread",
            "label": "Mark unread",
            "icon": "mark_email_unread",
            "tone": "secondary",
            "from": ["available"],
            "to": null,
            "guard": { "allowedRoleIds": ["community-member", "owner"] },
            "effects": [
              { "op": "append", "key": "auditHistory", "value": { "action": "marked-unread", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "request-resource-access",
            "action": "request_access",
            "label": "Request access",
            "icon": "lock_open",
            "tone": "secondary",
            "from": ["available"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "formula": "size(allowedFanIds) > 0 && !contains(allowedFanIds, $actor)"
            },
            "effects": [
              { "op": "append", "key": "auditHistory", "value": { "action": "access-requested", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "save-resource",
            "action": "save",
            "label": "Save resource",
            "icon": "bookmark_add",
            "tone": "secondary",
            "from": ["available"],
            "to": null,
            "guard": { "allowedRoleIds": ["community-member", "owner"] },
            "effects": [
              { "op": "append", "key": "auditHistory", "value": { "action": "saved", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "request-resource-follow-up",
            "action": "request_follow_up",
            "label": "Ask follow-up",
            "icon": "question_answer",
            "tone": "secondary",
            "from": ["available"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "followUpRequestedFanIds", "present": false }
            },
            "effects": [
              { "op": "appendUnique", "key": "followUpRequestedFanIds", "value": "$actor" },
              { "op": "append", "key": "auditHistory", "value": { "action": "follow-up-requested", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "record-resource-download",
            "action": "download",
            "label": "Record download",
            "icon": "download",
            "tone": "secondary",
            "from": ["available"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member", "owner"],
              "formula": "size(allowedFanIds) == 0 || contains(allowedFanIds, $actor)"
            },
            "effects": [
              { "op": "append", "key": "auditHistory", "value": { "action": "download-recorded", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "archive-resource",
            "action": "archive",
            "label": "Archive resource",
            "icon": "archive",
            "tone": "destructive",
            "from": ["available"],
            "to": "archived",
            "guard": { "allowedRoleIds": ["owner"] }
          }
        ],
        "renderBindings": [
          {
            "states": ["available"],
            "audience": "any",
            "tabId": "resources",
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Add resource",
                "byRoleIds": ["owner"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "allowedFanIds": [],
                  "followUpRequestedFanIds": [],
                  "auditHistory": []
                }
              }
            ]
          },
          {
            "states": ["archived"],
            "audience": "any",
            "tabId": "resources",
            "cardSurfaceFamily": "documentLibrary",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "sortable": true, "displayIcon": "description", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "source": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "displayIcon": "account_balance", "labelTemplate": "Source: {value}", "displayContexts": ["tile", "detail"] },
          "version": { "type": "text", "required": true, "writableBy": "formEntry", "sortable": true, "displayIcon": "history", "labelTemplate": "Version {value}", "displayContexts": ["tile", "detail"] },
          "publishedDate": { "type": "date", "required": true, "writableBy": "formEntry", "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "Published {value}", "displayContexts": ["tile", "detail"] },
          "resourceUrl": { "type": "url", "required": true, "writableBy": "formEntry", "openMode": "choice", "displayIcon": "open_in_new", "labelTemplate": "Open {value}", "displayContexts": ["tile", "detail"] },
          "accessLabel": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "verified_user", "labelTemplate": "Access: {value}", "displayContexts": ["tile", "detail"] },
          "allowedFanIds": { "type": "fanId[]", "writableBy": "formEntry", "displayIcon": "lock", "labelTemplate": "Restricted to {value.length}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "followUpRequestedFanIds": { "type": "fanId[]", "writableBy": "platform", "displayIcon": "question_answer", "labelTemplate": "Follow-ups: {value.length}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "auditHistory": { "type": "list", "writableBy": "platform", "displayIcon": "policy", "labelTemplate": "Audit entries: {value.length}", "displayContexts": ["detail"] }
        }
      },

      "mosque-volunteer-signup": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "Volunteer signup open",
            "tone": "positive",
            "editableFields": ["title", "shiftRole", "shiftDate", "shiftTime", "location", "capacity", "contactSharingPolicy"],
            "editGuard": { "allowedRoleIds": ["owner"] }
          },
          "closed": { "label": "Signup closed", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "sign-up-volunteer",
            "label": "Volunteer",
            "icon": "volunteer_activism",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "signedUpFanIds", "present": false },
              "formula": "size(signedUpFanIds) < capacity"
            },
            "effects": [
              { "op": "appendUnique", "key": "signedUpFanIds", "value": "$actor" },
              { "op": "appendUnique", "key": "contactSharingFanIds", "value": "$actor" },
              { "op": "append", "key": "signupHistory", "value": { "action": "signed-up", "member": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "update-volunteer-availability",
            "label": "Edit availability",
            "icon": "edit_calendar",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "inputs": {
              "availabilityNote": { "type": "text", "required": true }
            },
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "signedUpFanIds", "present": true }
            },
            "effects": [
              { "op": "append", "key": "availabilityHistory", "value": { "member": "$actor", "note": "{input.availabilityNote}", "at": "$timestamp" } },
              { "op": "append", "key": "signupHistory", "value": { "action": "availability-updated", "member": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "cancel-volunteer-signup",
            "label": "Cancel signup",
            "icon": "person_remove",
            "tone": "destructive",
            "from": ["open"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["community-member"],
              "actorInList": { "key": "signedUpFanIds", "present": true }
            },
            "effects": [
              { "op": "removeValue", "key": "signedUpFanIds", "value": "$actor" },
              { "op": "removeValue", "key": "contactSharingFanIds", "value": "$actor" },
              { "op": "append", "key": "signupHistory", "value": { "action": "cancelled", "member": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "record-coordinator-follow-up",
            "label": "Record coordinator follow-up",
            "icon": "contact_phone",
            "tone": "secondary",
            "from": ["open"],
            "to": null,
            "inputs": {
              "memberFanId": { "type": "text", "required": true },
              "followUpNote": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "append", "key": "coordinatorFollowUpHistory", "value": { "member": "{input.memberFanId}", "note": "{input.followUpNote}", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "close-volunteer-shift",
            "label": "Close signup",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["open"],
            "to": "closed",
            "guard": { "allowedRoleIds": ["owner"] }
          }
        ],
        "renderBindings": [
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary"
          },
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New volunteer shift",
                "byRoleIds": ["owner"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "signedUpFanIds": [],
                  "contactSharingFanIds": [],
                  "signupHistory": [],
                  "availabilityHistory": [],
                  "coordinatorFollowUpHistory": []
                }
              }
            ]
          },
          {
            "states": ["closed"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "shiftRole": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "badge", "labelTemplate": "Role: {value}", "displayContexts": ["tile", "detail"] },
          "shiftDate": { "type": "date", "required": true, "writableBy": "formEntry", "sortable": true, "displayIcon": "calendar_today", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "shiftTime": { "type": "time", "required": true, "writableBy": "formEntry", "displayIcon": "schedule", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "location": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "location_on_outlined", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "capacity": { "type": "number", "required": true, "writableBy": "formEntry", "displayIcon": "groups_outlined", "labelTemplate": "Capacity: {value}", "displayContexts": ["tile", "detail"] },
          "contactSharingPolicy": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "privacy_tip", "labelTemplate": "Contact privacy: {value}", "displayContexts": ["detail"] },
          "signedUpFanIds": { "type": "fanId[]", "writableBy": "platform", "displayIcon": "how_to_reg", "labelTemplate": "Volunteers: {value.length}", "displayContexts": ["tile", "detail"] },
          "contactSharingFanIds": { "type": "fanId[]", "writableBy": "platform", "displayIcon": "shield", "labelTemplate": "Protected contact consents: {value.length}", "displayContexts": ["detail"] },
          "signupHistory": { "type": "list", "writableBy": "platform", "displayIcon": "history", "labelTemplate": "Signup history: {value.length}", "displayContexts": ["detail"] },
          "availabilityHistory": { "type": "list", "writableBy": "platform", "displayIcon": "edit_note", "labelTemplate": "Availability updates: {value.length}", "displayContexts": ["detail"] },
          "coordinatorFollowUpHistory": { "type": "list", "writableBy": "platform", "displayIcon": "contact_phone", "labelTemplate": "Coordinator follow-ups: {value.length}", "displayContexts": ["detail"] },
          "signedUpCount": { "type": "number", "formula": "size(signedUpFanIds)", "displayIcon": "groups", "labelTemplate": "Signed up: {value}", "displayContexts": ["tile", "detail"] },
          "spotsRemaining": { "type": "number", "formula": "capacity - size(signedUpFanIds)", "displayIcon": "event_seat", "labelTemplate": "Open spots: {value}", "displayContexts": ["tile", "detail"] },
          "isFull": { "type": "bool", "formula": "size(signedUpFanIds) >= capacity", "displayIcon": "block", "labelTemplate": "Full: {value}", "displayContexts": ["detail"] }
        }
      },

      "mosque-donor-visibility": {
        "initialState": "restricted",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "donorFanId" } }
        },
        "states": {
          "public": { "label": "Public donor", "tone": "positive" },
          "anonymous": { "label": "Anonymous donor", "tone": "info" },
          "restricted": { "label": "Restricted to donation records", "tone": "warning" }
        },
        "transitions": [
          {
            "id": "set-donor-public",
            "label": "Reveal name",
            "icon": "person",
            "tone": "secondary",
            "from": ["anonymous", "restricted"],
            "to": "public",
            "guard": { "actorEqualsField": { "key": "donorFanId" } },
            "effects": [
              { "op": "set", "key": "receiptVisibility", "value": "Name visible on donor-facing receipt and public roll" },
              { "op": "append", "key": "visibilityHistory", "value": { "choice": "public", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "set-donor-anonymous",
            "label": "Keep anonymous",
            "icon": "visibility_off",
            "tone": "primary",
            "from": ["public", "restricted"],
            "to": "anonymous",
            "guard": { "actorEqualsField": { "key": "donorFanId" } },
            "effects": [
              { "op": "set", "key": "receiptVisibility", "value": "Name hidden from public roll; visible on donor receipt" },
              { "op": "append", "key": "visibilityHistory", "value": { "choice": "anonymous", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "set-donor-restricted",
            "label": "Restrict name",
            "icon": "lock",
            "tone": "secondary",
            "from": ["public", "anonymous"],
            "to": "restricted",
            "guard": { "actorEqualsField": { "key": "donorFanId" } },
            "effects": [
              { "op": "set", "key": "receiptVisibility", "value": "Identity restricted to donor's private record" },
              { "op": "append", "key": "visibilityHistory", "value": { "choice": "restricted", "by": "$actor", "at": "$timestamp" } }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["public", "anonymous", "restricted"],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary"
          }
        ],
        "instanceDataSchema": {
          "donorFanId": { "type": "fanId", "required": true, "writableBy": "effect", "displayIcon": "person_outline", "labelTemplate": "Donor: {value}", "displayContexts": ["detail"] },
          "amount": { "type": "number", "required": true, "writableBy": "effect", "displayIcon": "payments_outlined", "labelTemplate": "Amount: $ {value}", "displayContexts": ["tile", "detail"] },
          "fund": { "type": "text", "required": true, "writableBy": "effect", "displayIcon": "volunteer_activism", "labelTemplate": "Fund: {value}", "displayContexts": ["tile", "detail"] },
          "receiptVisibility": { "type": "text", "required": true, "writableBy": "effect", "displayIcon": "receipt_long", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "visibilityHistory": { "type": "list", "writableBy": "effect", "displayIcon": "history", "labelTemplate": "Preference history: {value.length}", "displayContexts": ["detail"] }
        }
      },

      "mosque-donation-payment": {
        // NEEDS IMPLEMENTATION (platform service): real online payment processing.
        // This state machine records donation intent and honest admin-confirmed offline payments only.
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "payerFanId" } },
          "fields": { "parties": ["payerFanId", { "role": "owner" }] }
        },
        "states": {
          "draft": {
            "label": "Donation draft",
            "tone": "info",
            "editableFields": ["amount", "fund", "privacyChoice", "recurringPreference"],
            "editGuard": { "allowedRoleIds": ["community-member"] }
          },
          "pending": {
            "label": "Pending recording",
            "tone": "warning",
            "editableFields": ["amount", "fund", "privacyChoice", "recurringPreference"],
            "editGuard": { "allowedRoleIds": ["community-member"] }
          },
          "failed": {
            "label": "Payment failed",
            "tone": "negative",
            "editableFields": ["amount", "fund", "privacyChoice", "recurringPreference"],
            "editGuard": { "allowedRoleIds": ["community-member"] }
          },
          "paid": { "label": "Paid — manually recorded", "tone": "positive" },
          "refundRequested": { "label": "Refund requested", "tone": "warning" },
          "cancelled": { "label": "Cancelled", "tone": "negative", "isTerminal": true },
          "refunded": { "label": "Refunded — manually recorded", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "submit-donation-intent",
            "label": "Submit donation",
            "icon": "favorite",
            "tone": "primary",
            "from": ["draft"],
            "to": "pending",
            "guard": { "actorEqualsField": { "key": "payerFanId" } },
            "effects": [
              { "op": "set", "key": "requestedAt", "value": "$timestamp" },
              { "op": "set", "key": "paymentStatus", "value": "pending" },
              { "op": "append", "key": "paymentHistory", "value": { "status": "intent-submitted", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "save-donation-changes",
            "label": "Save changes",
            "icon": "save",
            "tone": "secondary",
            "from": ["draft", "pending", "failed"],
            "to": null,
            "guard": { "actorEqualsField": { "key": "payerFanId" } },
            "effects": [
              { "op": "append", "key": "paymentHistory", "value": { "status": "details-updated", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "record-payment-failure",
            "label": "Record payment failure",
            "icon": "error_outline",
            "tone": "destructive",
            "from": ["pending"],
            "to": "failed",
            "inputs": {
              "failureReason": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "paymentStatus", "value": "failed" },
              { "op": "set", "key": "failureReason", "value": "{input.failureReason}" },
              { "op": "append", "key": "paymentHistory", "value": { "status": "failed-recorded", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "retry-donation",
            "label": "Retry payment",
            "icon": "refresh",
            "tone": "primary",
            "from": ["failed"],
            "to": "pending",
            "guard": { "actorEqualsField": { "key": "payerFanId" } },
            "effects": [
              { "op": "set", "key": "paymentStatus", "value": "pending" },
              { "op": "set", "key": "failureReason", "value": null },
              { "op": "append", "key": "paymentHistory", "value": { "status": "retry-requested", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "confirm-offline-donation",
            "label": "Record offline payment",
            "icon": "verified",
            "tone": "primary",
            "from": ["pending"],
            "to": "paid",
            "inputs": {
              "receiptSummary": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "paymentStatus", "value": "paid-manual" },
              { "op": "set", "key": "paidAt", "value": "$timestamp" },
              { "op": "set", "key": "receiptSummary", "value": "{input.receiptSummary}" },
              { "op": "set", "key": "receiptStatus", "value": "recorded" },
              { "op": "append", "key": "paymentHistory", "value": { "status": "offline-payment-recorded", "by": "$actor", "at": "$timestamp" } },
              {
                "op": "createInstance",
                "workflowType": "mosque-donor-visibility",
                "fields": {
                  "donorFanId": "{payerFanId}",
                  "amount": "{amount}",
                  "fund": "{fund}",
                  "receiptVisibility": "Identity restricted to donor's private record",
                  "visibilityHistory": []
                }
              }
            ]
          },
          {
            "id": "open-donation-receipt",
            "label": "View receipt",
            "icon": "receipt_long",
            "tone": "secondary",
            "from": ["paid"],
            "to": null,
            "guard": { "actorEqualsField": { "key": "payerFanId" } },
            "effects": [
              { "op": "set", "key": "receiptViewedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "manage-recurring-preference",
            "label": "Manage recurring preference",
            "icon": "settings",
            "tone": "secondary",
            "from": ["paid"],
            "to": null,
            "inputs": {
              "recurringPreference": { "type": "text", "required": true }
            },
            "guard": { "actorEqualsField": { "key": "payerFanId" } },
            "effects": [
              { "op": "set", "key": "recurringPreference", "value": "{input.recurringPreference}" },
              { "op": "append", "key": "paymentHistory", "value": { "status": "recurring-preference-updated", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "request-donation-refund",
            "label": "Request refund",
            "icon": "currency_exchange",
            "tone": "destructive",
            "from": ["paid"],
            "to": "refundRequested",
            "guard": { "actorEqualsField": { "key": "payerFanId" } },
            "effects": [
              { "op": "append", "key": "paymentHistory", "value": { "status": "refund-requested", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "record-donation-refund",
            "label": "Record refund",
            "icon": "done",
            "tone": "primary",
            "from": ["refundRequested"],
            "to": "refunded",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "paymentStatus", "value": "refunded-manual" },
              { "op": "append", "key": "paymentHistory", "value": { "status": "refund-recorded", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "decline-donation-refund",
            "label": "Decline refund",
            "icon": "close",
            "tone": "secondary",
            "from": ["refundRequested"],
            "to": "paid",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "append", "key": "paymentHistory", "value": { "status": "refund-declined", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "cancel-donation",
            "label": "Cancel donation",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["draft", "pending", "failed"],
            "to": "cancelled",
            "guard": { "actorEqualsField": { "key": "payerFanId" } },
            "effects": [
              { "op": "set", "key": "paymentStatus", "value": "cancelled" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["draft", "pending", "failed", "paid", "refundRequested"],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Donate",
                "byRoleIds": ["community-member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "payerFanId": "$actor",
                  "paymentStatus": "draft",
                  "paymentHistory": []
                }
              }
            ]
          },
          {
            "states": ["pending", "refundRequested"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          },
          {
            "states": ["paid"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "paymentCheckout",
            "bindingKind": "summary"
          },
          {
            "states": ["cancelled", "refunded"],
            "audience": "any",
            "tabId": "giving",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "payerFanId": { "type": "fanId", "required": true, "writableBy": "platform", "displayIcon": "person_outline", "labelTemplate": "Payer: {value}", "displayContexts": ["detail"] },
          "amount": { "type": "number", "required": true, "writableBy": "formEntry", "displayIcon": "payments_outlined", "labelTemplate": "Amount: $ {value}", "displayContexts": ["tile", "detail"] },
          "fund": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "volunteer_activism", "labelTemplate": "Fund: {value}", "displayContexts": ["tile", "detail"] },
          "privacyChoice": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "privacy_tip", "labelTemplate": "Privacy: {value}", "displayContexts": ["tile", "detail"] },
          "recurringPreference": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "repeat", "labelTemplate": "Giving plan: {value}", "displayContexts": ["detail"] },
          "requestedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "schedule", "labelTemplate": "Requested {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "paidAt": { "type": "date?", "writableBy": "effect", "displayIcon": "event_available", "labelTemplate": "Recorded paid {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "paymentStatus": { "type": "text", "writableBy": "platform", "displayIcon": "account_balance_wallet", "labelTemplate": "Status: {value}", "displayContexts": ["tile", "detail"] },
          "failureReason": { "type": "text", "writableBy": "effect", "displayIcon": "error_outline", "labelTemplate": "Failure: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "receiptSummary": { "type": "text", "writableBy": "effect", "displayIcon": "receipt_long", "labelTemplate": "Receipt: {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "receiptStatus": { "type": "text", "writableBy": "effect", "displayIcon": "verified", "labelTemplate": "Receipt status: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "receiptViewedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "visibility", "labelTemplate": "Receipt viewed {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          // NEEDS IMPLEMENTATION (platform service): opaque receipt-ID generation. Declared, never written or seeded.
          "receiptId": { "type": "text?", "writableBy": "platform", "displayIcon": "tag", "labelTemplate": "Receipt ID: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "paymentHistory": { "type": "list", "writableBy": "platform", "displayIcon": "history", "labelTemplate": "Payment history: {value.length}", "displayContexts": ["detail"] }
        }
      },

      "mosque-care-request": {
        "initialState": "draft",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "requesterFanId" } },
          "fields": { "parties": ["requesterFanId", { "role": "owner" }] }
        },
        "states": {
          "draft": {
            "label": "Draft care request",
            "tone": "info",
            "editableFields": ["publicSummary", "privateDetails", "privacyLabel", "contactPreference"],
            "editGuard": { "allowedRoleIds": ["community-member"] }
          },
          "submitted": { "label": "Submitted for private review", "tone": "warning" },
          "changesRequested": {
            "label": "Changes requested",
            "tone": "warning",
            "editableFields": ["publicSummary", "privateDetails", "privacyLabel", "contactPreference"],
            "editGuard": { "allowedRoleIds": ["community-member"] }
          },
          "assigned": { "label": "Assigned to care reviewer", "tone": "info" },
          "responded": { "label": "Private response sent", "tone": "positive" },
          "resolved": { "label": "Resolved", "tone": "positive", "isTerminal": true },
          "rejected": { "label": "Unable to accept", "tone": "negative", "isTerminal": true },
          "withdrawn": { "label": "Withdrawn", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "submit-care-request",
            "label": "Submit request",
            "icon": "send",
            "tone": "primary",
            "from": ["draft"],
            "to": "submitted",
            "guard": { "actorEqualsField": { "key": "requesterFanId" } },
            "effects": [
              { "op": "set", "key": "submittedAt", "value": "$timestamp" },
              { "op": "append", "key": "statusHistory", "value": { "status": "submitted", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "request-care-changes",
            "label": "Request changes",
            "icon": "edit_note",
            "tone": "secondary",
            "from": ["submitted", "assigned"],
            "to": "changesRequested",
            "inputs": {
              "changeNote": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "reviewNote", "value": "{input.changeNote}" },
              { "op": "append", "key": "statusHistory", "value": { "status": "changes-requested", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "revise-care-request",
            "label": "Revise and resubmit",
            "icon": "send",
            "tone": "primary",
            "from": ["changesRequested"],
            "to": "submitted",
            "guard": { "actorEqualsField": { "key": "requesterFanId" } },
            "effects": [
              { "op": "append", "key": "statusHistory", "value": { "status": "resubmitted", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "approve-and-assign-care-request",
            "label": "Approve and assign",
            "icon": "assignment_ind",
            "tone": "primary",
            "from": ["submitted"],
            "to": "assigned",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "assignedReviewerFanId", "value": "$actor" },
              { "op": "set", "key": "assignedAt", "value": "$timestamp" },
              { "op": "append", "key": "statusHistory", "value": { "status": "assigned", "by": "$actor", "at": "$timestamp" } },
              {
                "op": "createInstance",
                "workflowType": "mosque-neutral-notification",
                "fields": {
                  "title": "Care request received",
                  "senderFanId": "$actor",
                  "recipientFanId": "{requesterFanId}",
                  "audience": "requester only",
                  "messageBody": "Your request was received. A care reviewer will follow up privately; no protected details are included here.",
                  "createdAt": "$timestamp"
                }
              }
            ]
          },
          {
            "id": "reject-care-request",
            "label": "Reject request",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["submitted", "assigned"],
            "to": "rejected",
            "inputs": {
              "reviewNote": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "reviewNote", "value": "{input.reviewNote}" },
              { "op": "append", "key": "statusHistory", "value": { "status": "rejected", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "send-private-care-response",
            "label": "Send private response",
            "icon": "reply",
            "tone": "primary",
            "from": ["assigned"],
            "to": "responded",
            "inputs": {
              "responseBody": { "type": "text", "required": true }
            },
            "guard": { "actorEqualsField": { "key": "assignedReviewerFanId" } },
            "effects": [
              { "op": "set", "key": "responseSummary", "value": "{input.responseBody}" },
              { "op": "set", "key": "respondedAt", "value": "$timestamp" },
              { "op": "append", "key": "statusHistory", "value": { "status": "responded", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "resolve-care-request",
            "label": "Resolve request",
            "icon": "check_circle",
            "tone": "primary",
            "from": ["responded"],
            "to": "resolved",
            "guard": { "actorEqualsField": { "key": "assignedReviewerFanId" } },
            "effects": [
              { "op": "append", "key": "statusHistory", "value": { "status": "resolved", "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "withdraw-care-request",
            "label": "Withdraw request",
            "icon": "undo",
            "tone": "destructive",
            "from": ["draft", "submitted", "changesRequested", "assigned", "responded"],
            "to": "withdrawn",
            "guard": { "actorEqualsField": { "key": "requesterFanId" } },
            "effects": [
              { "op": "append", "key": "statusHistory", "value": { "status": "withdrawn", "by": "$actor", "at": "$timestamp" } }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["draft", "changesRequested"],
            "audience": "actor",
            "tabId": "home",
            "cardSurfaceFamily": "formEntry",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Request care",
                "byRoleIds": ["community-member"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "requesterFanId": "$actor",
                  "statusHistory": []
                }
              }
            ]
          },
          {
            "states": ["submitted", "assigned", "responded", "resolved", "rejected", "withdrawn"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "statusTimeline",
            "bindingKind": "summary"
          },
          {
            "states": ["submitted", "assigned", "responded"],
            "audience": "any",
            "tabId": "admin",
            "cardSurfaceFamily": "approvalQueueItem",
            "bindingKind": "primary"
          }
        ],
        "instanceDataSchema": {
          "requesterFanId": { "type": "fanId", "required": true, "writableBy": "platform", "displayIcon": "person_outline", "labelTemplate": "Requester: {value}", "displayContexts": ["detail"] },
          "assignedReviewerFanId": { "type": "fanId", "writableBy": "effect", "displayIcon": "admin_panel_settings", "labelTemplate": "Reviewer: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "publicSummary": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "displayIcon": "description", "labelTemplate": "Public summary: {value}", "displayContexts": ["tile", "detail"] },
          "privateDetails": { "type": "textarea", "required": true, "writableBy": "formEntry", "maxLength": 2000, "displayIcon": "lock", "labelTemplate": "Protected details: {value}", "displayContexts": ["detail"] },
          "privacyLabel": { "type": "text", "required": true, "writableBy": "formEntry", "displayIcon": "privacy_tip", "labelTemplate": "Privacy: {value}", "displayContexts": ["tile", "detail"] },
          "contactPreference": { "type": "text", "writableBy": "formEntry", "displayIcon": "contact_phone", "labelTemplate": "Contact: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "submittedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "send", "labelTemplate": "Submitted {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "assignedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "assignment_ind", "labelTemplate": "Assigned {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "respondedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "reply", "labelTemplate": "Responded {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "reviewNote": { "type": "text", "writableBy": "effect", "displayIcon": "rate_review", "labelTemplate": "Review note: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "responseSummary": { "type": "text", "writableBy": "effect", "displayIcon": "forum", "labelTemplate": "Private response: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "statusHistory": { "type": "list", "writableBy": "platform", "displayIcon": "history", "labelTemplate": "Status history: {value.length}", "displayContexts": ["tile", "detail"] }
        }
      },

      "mosque-neutral-notification": {
        "initialState": "unread",
        "visibility": {
          "default": "guarded",
          "readGuard": { "allowedRoleIds": ["owner"] },
          "fields": { "recipient": "recipientFanId" }
        },
        "states": {
          "unread": { "label": "Received — unread", "tone": "warning" },
          "read": { "label": "Read", "tone": "positive" },
          "archived": { "label": "Archived", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "mark-notification-read",
            "label": "Mark read",
            "icon": "mark_email_read",
            "tone": "primary",
            "from": ["unread"],
            "to": "read",
            "guard": { "actorEqualsField": { "key": "recipientFanId" } },
            "effects": [
              { "op": "set", "key": "readAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "keep-notification-unread",
            "label": "Keep unread",
            "icon": "mark_email_unread",
            "tone": "secondary",
            "from": ["unread"],
            "to": null,
            "guard": { "actorEqualsField": { "key": "recipientFanId" } },
            "effects": [
              { "op": "set", "key": "keptUnreadAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "mark-notification-unread",
            "label": "Mark unread",
            "icon": "mark_email_unread",
            "tone": "secondary",
            "from": ["read"],
            "to": "unread",
            "guard": { "actorEqualsField": { "key": "recipientFanId" } },
            "effects": [
              { "op": "set", "key": "readAt", "value": null }
            ]
          },
          {
            "id": "request-notification-follow-up",
            "label": "Request follow-up",
            "icon": "question_answer",
            "tone": "secondary",
            "from": ["unread", "read"],
            "to": null,
            "guard": { "actorEqualsField": { "key": "recipientFanId" } },
            "effects": [
              { "op": "set", "key": "followUpRequestedAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "archive-notification",
            "label": "Archive notice",
            "icon": "archive",
            "tone": "destructive",
            "from": ["unread", "read"],
            "to": "archived",
            "guard": { "actorEqualsField": { "key": "recipientFanId" } }
          }
        ],
        "renderBindings": [
          {
            "states": ["unread", "read"],
            "audience": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary"
          },
          {
            "states": ["unread"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "summary"
          },
          {
            "states": ["archived"],
            "audience": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": { "type": "text", "required": true, "writableBy": "effect", "displayIcon": "notifications", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "senderFanId": { "type": "fanId", "required": true, "writableBy": "effect", "displayIcon": "person_outline", "labelTemplate": "From {value}", "displayContexts": ["tile", "detail"] },
          "recipientFanId": { "type": "fanId", "required": true, "writableBy": "effect", "displayIcon": "person_pin", "labelTemplate": "For {value}", "displayContexts": ["detail"] },
          "audience": { "type": "text", "required": true, "writableBy": "effect", "displayIcon": "groups_outlined", "labelTemplate": "Audience: {value}", "displayContexts": ["detail"] },
          "messageBody": { "type": "textarea", "required": true, "writableBy": "effect", "maxLength": 1000, "displayIcon": "article", "labelTemplate": "{value}", "displayContexts": ["tile", "detail"] },
          "createdAt": { "type": "date", "required": true, "writableBy": "effect", "sortable": true, "displayIcon": "schedule", "labelTemplate": "Received {value}", "displayContexts": ["tile", "detail"] },
          "readAt": { "type": "date?", "writableBy": "effect", "displayIcon": "done_all", "labelTemplate": "Read {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "keptUnreadAt": { "type": "date?", "writableBy": "effect", "displayIcon": "mark_email_unread", "labelTemplate": "Kept unread {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "followUpRequestedAt": { "type": "date?", "writableBy": "effect", "displayIcon": "question_answer", "labelTemplate": "Follow-up requested {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] }
        }
      },

      "mosque-search-ai-citation": {
        "initialState": "asked",
        "visibility": { "default": "membersOnly" },
        "states": {
          "asked": {
            "label": "Question asked",
            "tone": "warning",
            "editableFields": ["query"],
            "editGuard": { "allowedRoleIds": ["community-member", "owner"] }
          },
          "answered": { "label": "Curated answer available", "tone": "positive" },
          "reported": { "label": "Citation reported stale", "tone": "warning" }
        },
        "transitions": [
          {
            "id": "provide-curated-answer",
            "action": "curate",
            "label": "Provide curated answer",
            "icon": "rate_review",
            "tone": "primary",
            "from": ["asked"],
            "to": "answered",
            "inputs": {
              "answerBody": { "type": "text", "required": true },
              "citationLabel": { "type": "text", "required": true },
              "citationUrl": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "curatedAnswerBody", "value": "{input.answerBody}" },
              { "op": "set", "key": "citations", "value": [{ "label": "{input.citationLabel}", "source": "{input.citationUrl}" }] },
              { "op": "set", "key": "answerSource", "value": "Masjid admin curated" },
              { "op": "set", "key": "answeredAt", "value": "$timestamp" },
              { "op": "set", "key": "citationStatus", "value": "current" }
            ]
          },
          {
            "id": "refine-search-query",
            "action": "ask",
            "label": "Refine query",
            "icon": "search",
            "tone": "primary",
            "from": ["asked", "answered", "reported"],
            "to": "asked",
            "inputs": {
              "query": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["community-member", "owner"] },
            "effects": [
              { "op": "set", "key": "query", "value": "{input.query}" },
              { "op": "set", "key": "curatedAnswerBody", "value": null },
              { "op": "set", "key": "citations", "value": [] },
              { "op": "set", "key": "answerSource", "value": null },
              { "op": "set", "key": "answeredAt", "value": null },
              { "op": "set", "key": "citationStatus", "value": "awaiting-review" }
            ]
          },
          {
            "id": "save-search-answer",
            "action": "curate",
            "label": "Save answer",
            "icon": "bookmark_add",
            "tone": "secondary",
            "from": ["answered"],
            "to": null,
            "guard": { "allowedRoleIds": ["community-member", "owner"] },
            "effects": [
              { "op": "append", "key": "saveAnswerHistory", "value": { "by": "$actor", "at": "$timestamp" } }
            ]
          },
          {
            "id": "hide-search-source",
            "action": "moderate",
            "label": "Hide source",
            "icon": "visibility_off",
            "tone": "secondary",
            "from": ["answered"],
            "to": null,
            "inputs": {
              "citationUrl": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "appendUnique", "key": "hiddenCitationUrls", "value": "{input.citationUrl}" },
              { "op": "set", "key": "citationStatus", "value": "source-hidden-pending-renderer-redaction" }
            ]
          },
          {
            "id": "report-stale-citation",
            "action": "report",
            "label": "Report stale citation",
            "icon": "report",
            "tone": "destructive",
            "from": ["answered"],
            "to": "reported",
            "inputs": {
              "reportReason": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["community-member", "owner"] },
            "effects": [
              { "op": "set", "key": "reportReason", "value": "{input.reportReason}" },
              { "op": "set", "key": "citationStatus", "value": "reported-stale" }
            ]
          },
          {
            "id": "reopen-reported-question",
            "action": "moderate",
            "label": "Reopen for new answer",
            "icon": "refresh",
            "tone": "secondary",
            "from": ["reported"],
            "to": "asked",
            "guard": { "allowedRoleIds": ["owner"] },
            "effects": [
              { "op": "set", "key": "citationStatus", "value": "awaiting-review" }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["asked", "answered", "reported"],
            "audience": "any",
            "tabId": "resources",
            "cardSurfaceFamily": "searchAiAnswer",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "Ask Masjid Nur",
                "byRoleIds": ["community-member", "owner"],
                "scope": "tab",
                "presentation": "fab",
                "prefill": {
                  "askedByFanId": "$actor",
                  "citations": [],
                  "hiddenCitationUrls": [],
                  "saveAnswerHistory": [],
                  "citationStatus": "awaiting-review"
                }
              }
            ]
          }
        ],
        "instanceDataSchema": {
          "query": { "type": "text", "required": true, "writableBy": "formEntry", "searchable": true, "displayIcon": "search", "labelTemplate": "Query: {value}", "displayContexts": ["tile", "detail"] },
          "askedByFanId": { "type": "fanId", "required": true, "writableBy": "platform", "displayIcon": "person_outline", "labelTemplate": "Asked by {value}", "displayContexts": ["detail"] },
          // NEEDS IMPLEMENTATION (platform service): external search / AI answer. Declared, never written or seeded.
          "aiAnswerBody": { "type": "textarea?", "writableBy": "platform", "displayIcon": "auto_awesome", "labelTemplate": "AI answer: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "curatedAnswerBody": { "type": "textarea?", "writableBy": "effect", "displayIcon": "rate_review", "labelTemplate": "Curated answer: {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "displayAnswer": { "type": "textarea?", "formula": "if(curatedAnswerBody == null, aiAnswerBody, curatedAnswerBody)", "displayIcon": "article", "labelTemplate": "Answer: {value}", "hideWhenEmpty": true, "displayContexts": ["tile", "detail"] },
          "citations": {
            "type": "list",
            "writableBy": "platform",
            "itemSchema": {
              "label": { "type": "text" },
              "source": { "type": "url", "openMode": "external" }
            },
            "displayIcon": "auto_stories",
            "labelTemplate": "Sources: {value.length}",
            "displayContexts": ["tile", "detail"]
          },
          "answerSource": { "type": "text", "writableBy": "effect", "displayIcon": "verified_user", "labelTemplate": "Answer source: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "answeredAt": { "type": "date?", "writableBy": "effect", "displayIcon": "schedule", "labelTemplate": "Answered {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "citationStatus": { "type": "text", "writableBy": "platform", "displayIcon": "fact_check", "labelTemplate": "Citation status: {value}", "displayContexts": ["tile", "detail"] },
          "saveAnswerHistory": { "type": "list", "writableBy": "platform", "displayIcon": "bookmark", "labelTemplate": "Saved: {value.length}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "hiddenCitationUrls": { "type": "list", "writableBy": "platform", "displayIcon": "visibility_off", "labelTemplate": "Hidden sources: {value.length}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "reportReason": { "type": "text", "writableBy": "effect", "displayIcon": "report", "labelTemplate": "Report: {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] }
        }
      },

      "mosque-discussion-thread": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "Open",
            "tone": "positive",
            "editableFields": ["threadTitle", "initialMessage"],
            "editGuard": { "allowedRoleIds": ["community-member", "owner"] }
          },
          "replied": { "label": "Replied", "tone": "info" },
          "archived": { "label": "Archived", "tone": "info", "isTerminal": true }
        },
        "transitions": [
          {
            "id": "reply-thread",
            "label": "Reply",
            "icon": "reply",
            "tone": "primary",
            "from": ["open"],
            "to": "replied",
            "inputs": {
              "messageBody": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["community-member", "owner"] },
            "effects": [
              { "op": "append", "key": "messages", "value": { "senderFanId": "$actor", "body": "{input.messageBody}", "timestamp": "$timestamp" } },
              { "op": "set", "key": "latestMessage", "value": "{input.messageBody}" },
              { "op": "set", "key": "latestMessageAt", "value": "$timestamp" }
            ]
          },
          {
            "id": "continue-thread",
            "label": "Continue discussion",
            "icon": "send",
            "tone": "primary",
            "from": ["replied"],
            "to": "open",
            "inputs": {
              "messageBody": { "type": "text", "required": true }
            },
            "guard": { "allowedRoleIds": ["community-member", "owner"] },
            "effects": [
              { "op": "append", "key": "messages", "value": { "senderFanId": "$actor", "body": "{input.messageBody}", "timestamp": "$timestamp" } },
              { "op": "set", "key": "latestMessage", "value": "{input.messageBody}" },
              { "op": "set", "key": "latestMessageAt", "value": "$timestamp" }
            ]
          },
          {
            // NEEDS IMPLEMENTATION (platform service): per-member thread mute state belongs to the
            // messaging service; keep the promised mute/unmute affordances visible until it ships.
            "id": "mute-thread",
            "label": "Mute thread",
            "icon": "notifications_off",
            "tone": "secondary",
            "from": ["open", "replied"],
            "to": null,
            "guard": { "allowedRoleIds": ["community-member", "owner"] }
          },
          {
            "id": "unmute-thread",
            "label": "Unmute thread",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": ["open", "replied"],
            "to": null,
            "guard": { "allowedRoleIds": ["community-member", "owner"] }
          },
          {
            "id": "archive-thread",
            "label": "Archive thread",
            "icon": "archive",
            "tone": "destructive",
            "from": ["open", "replied"],
            "to": "archived",
            "guard": { "allowedRoleIds": ["owner"] }
          }
        ],
        "renderBindings": [
          {
            "states": ["open", "replied"],
            "audience": "any",
            "tabId": "messages",
            "cardSurfaceFamily": "discussionThread",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New discussion",
