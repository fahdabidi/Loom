          "latestMessageAt": { "type": "date?", "writableBy": "effect", "displayIcon": "schedule", "labelTemplate": "Latest reply {value}", "hideWhenEmpty": true, "displayContexts": ["detail"] },
          "messageCount": { "type": "number", "formula": "size(messages)", "displayIcon": "mark_chat_read", "labelTemplate": "Replies: {value}", "displayContexts": ["tile", "detail"] }
        }
      }
