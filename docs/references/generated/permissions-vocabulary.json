  "genericDerivation": {
    "_comment": "permissions.md §5. Generic families declare no action; it is derived from structure the transition already carries.",
    "rules": [
      {
        "when": "a create action on a renderBinding",
        "action": "create"
      },
      {
        "when": "tone == \"destructive\", or the target state isTerminal",
        "action": "terminate"
      },
      {
        "when": "any other state-changing transition",
        "action": "advance"
      },
      {
        "when": "a read-only binding with no transition",
        "action": "view"
      }
    ]
  }
}
