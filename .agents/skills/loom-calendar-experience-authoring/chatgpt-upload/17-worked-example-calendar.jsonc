// 17-worked-example-calendar.jsonc
//
// A complete, validator-checked, standalone Loom community package containing
// ONLY a Calendar event-RSVP experience and the two supporting row types that
// make per-member reminders real. This is a curated teaching artifact, not a
// copy of a production community.
//
// It intentionally covers THREE workflow types:
//   1. event-rsvp            — the organizer-managed run (open/cancelled).
//   2. event-rsvp-response   — one row per (event, member), whose state is that
//                              member's pending/going/maybe/declined/waitlisted
//                              answer. This row shape is the point of the example:
//                              a reminder reads one scalar memberFanId directly,
//                              instead of extracting a person from a shared list.
//   3. notification          — a generic recipient-scoped notice created by the
//                              response row's send-reminder transition.
//
// Two ROLES are declared. People in seed data use separate fanId values, making
// the specVersion 4 roleId/fanId distinction visible rather than merely asserted.
//
// Live validator result: pass, 0 errors, 6 expected response-row warnings. Each
// warning is no_render_binding_for_reachable_state on event-rsvp-response; those
// rows render through the parent responseTable and must not gain their own card.

{
  // One package-root version stamp. Never combine this with the retired legacy
  // schemaVersion / experienceSchemaVersion / workflowGrammarVersion triple.
  "specVersion": 4,
  "packageId": "init_riverbend_run_club_1",
  "communityId": "community_riverbend_run_club",
  "communityHandle": "riverbend-run-club",
  "displayName": "Riverbend Run Club",
  "extensionId": "ext_riverbend_run_club",
  "branding": { "accentColor": "#2A6F4D" },
  "seedDataFiles": [],
  "idempotencyKey": "init-riverbend-run-club-v4",

  "experience": {
    "displayName": "Riverbend Run Club",
    "tagline": "Weekly group runs along the river trail.",
    "accentColor": "#2A6F4D",

    // Notifications created below appear in the global bell. They are supporting
    // Calendar behavior, not a fourth domain workflow or a second custom tab.
    "notificationPresentation": { "style": "bell" },

    "roles": [
      {
        "roleId": "run-organizer",
        "label": "Organizer",
        "roleLabel": "Organizer",
        "description": "Schedules, publishes, edits, and cancels group runs."
      },
      {
        "roleId": "run-member",
        "label": "Member",
        "roleLabel": "Member",
        "description": "RSVPs to runs and receives an addressed reminder."
      }
    ],

    "workflowDefinitions": {
      // ---------------------------------------------------------------------
      // EVENT-RSVP — the run itself. The literal eventDate/eventTime names are
      // required by the real Calendar renderer; synonyms silently break sorting.
      // ---------------------------------------------------------------------
      "event-rsvp": {
        "initialState": "open",
        "visibility": { "default": "membersOnly" },
        "states": {
          "open": {
            "label": "RSVP open",
            "tone": "positive",
            "editableFields": [
              "title", "eventDate", "eventTime", "location", "routeNotes",
              "distanceKm", "paceGuidance", "capacity", "reminderOffsetHours"
            ],
            // editGuard is what actually exposes these editors to organizers.
            "editGuard": { "allowedRoleIds": ["run-organizer"] }
          },
          "cancelled": {
            "label": "Cancelled",
            "tone": "negative",
            "isTerminal": true
          }
        },
        "transitions": [
          {
            // event-rsvp owns response-row provisioning: action:create is the
            // contract shape for fanning out one pending row per member. No JSON
            // effect hand-rolls that archetype behavior. The fetched narrative
            // archetype doc still marks runtime fan-out pending; see the delivered
            // Gaps / assumptions rather than mistaking correct JSON for shipped code.
            "id": "publish-event",
            "action": "create",
            "label": "Publish run",
            "icon": "publish",
            "tone": "primary",
            "from": ["open"],
            "to": null,
            "guard": { "allowedRoleIds": ["run-organizer"] }
          },
          {
            "id": "cancel-event",
            "action": "cancel",
            "label": "Cancel run",
            "icon": "cancel",
            "tone": "destructive",
            "from": ["open"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["run-organizer"] },
            // A response row cannot see its parent's state. Cancelling therefore
            // sweeps every live response state explicitly; otherwise members could
            // keep changing orphaned RSVP rows after the run was cancelled.
            "effects": [
              {
                "op": "transitionRelated",
                "transitionId": "event-cancelled",
                "relatedQuery": {
                  "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "pending" }
                }
              },
              {
                "op": "transitionRelated",
                "transitionId": "event-cancelled",
                "relatedQuery": {
                  "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "going" }
                }
              },
              {
                "op": "transitionRelated",
                "transitionId": "event-cancelled",
                "relatedQuery": {
                  "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "maybe" }
                }
              },
              {
                "op": "transitionRelated",
                "transitionId": "event-cancelled",
                "relatedQuery": {
                  "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "declined" }
                }
              },
              {
                "op": "transitionRelated",
                "transitionId": "event-cancelled",
                "relatedQuery": {
                  "workflowType": "event-rsvp-response",
                  "filter": { "eventId": "{id}", "$state": "waitlisted" }
                }
              }
            ]
          }
        ],
        "renderBindings": [
          {
            "states": ["open"],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "primary",
            "actions": [
              {
                "kind": "create",
                "label": "New run",
                "byRoleIds": ["run-organizer"],
                "scope": "tab",
                "presentation": "fab"
              }
            ],
            // The Calendar card renders response rows through this table. The
            // response workflow correctly has no renderBindings of its own.
            "responseTable": {
              "workflowType": "event-rsvp-response",
              "eventField": "eventId",
              "pendingStates": ["pending"]
            }
          },
          {
            "states": ["cancelled"],
            "audience": "any",
            "tabId": "calendar",
            "cardSurfaceFamily": "event-rsvp",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "title": {
            "type": "text", "required": true, "writableBy": "formEntry",
            "storage": "inline", "searchable": true, "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "eventDate": {
            "type": "date", "required": true, "writableBy": "formEntry",
            "storage": "inline", "sortable": true, "displayIcon": "calendar_today",
            "labelTemplate": "{value}", "displayContexts": ["tile", "detail"]
          },
          "eventTime": {
            "type": "time", "required": true, "writableBy": "formEntry",
            "storage": "inline", "displayIcon": "schedule", "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "location": {
            "type": "text", "required": true, "writableBy": "formEntry",
            "storage": "inline", "displayIcon": "location_on_outlined",
            "labelTemplate": "Meet at {value}", "displayContexts": ["detail"]
          },
          "routeNotes": {
            "type": "textarea", "required": true, "writableBy": "formEntry",
            "storage": "inline", "maxLength": 500, "displayIcon": "route",
            "labelTemplate": "Route: {value}", "displayContexts": ["detail"]
          },
          "distanceKm": {
            "type": "number", "required": true, "writableBy": "formEntry",
            "storage": "inline", "displayIcon": "straighten",
            "labelTemplate": "{value} km", "displayContexts": ["tile", "detail"]
          },
          "paceGuidance": {
            "type": "text", "required": true, "writableBy": "formEntry",
            "storage": "inline", "displayIcon": "speed",
            "labelTemplate": "Pace: {value}", "displayContexts": ["detail"]
          },
          "capacity": {
            "type": "number", "required": true, "writableBy": "formEntry",
            "storage": "inline", "displayIcon": "groups_outlined",
            "labelTemplate": "{value} runners", "displayContexts": ["tile", "detail"]
          },
          "reminderOffsetHours": {
            "type": "number", "writableBy": "formEntry", "storage": "inline",
            "displayContexts": []
          },
          // Combining the date and time before subtracting avoids the classic
          // midnight bug. Both functions are real formula vocabulary.
          "reminderAt": {
            "type": "date",
            "formula": "subtractHours(combineDateAndTime(eventDate, eventTime), if(reminderOffsetHours == null, 24, reminderOffsetHours))"
          },
          // Query-backed rows and computed counts are never seeded or effect-written.
          "responses": {
            "type": "list",
            "source": "query(event-rsvp-response where eventId == id)"
          },
          "responseCounts": {
            "type": "map", "formula": "groupCount(responses, '$state')",
            "displayContexts": []
          },
          "goingCount": {
            "type": "number", "formula": "mapGet(responseCounts, 'going')",
            "displayIcon": "directions_run", "labelTemplate": "Going: {value}",
            "displayContexts": ["tile", "detail"]
          },
          "waitlistedCount": {
            "type": "number", "formula": "mapGet(responseCounts, 'waitlisted')",
            "displayIcon": "hourglass_empty", "labelTemplate": "Waitlist: {value}",
            "hideWhenEmpty": true, "displayContexts": ["tile", "detail"]
          },
          "seatsRemaining": {
            "type": "number", "formula": "capacity - goingCount",
            "displayIcon": "event_seat", "labelTemplate": "{value} spots left",
            "displayContexts": ["detail"]
          },
          "isFull": { "type": "bool", "formula": "goingCount >= capacity" },
          "hasWaitlist": { "type": "bool", "formula": "waitlistedCount > 0" }
        }
      },

      // ---------------------------------------------------------------------
      // EVENT-RSVP-RESPONSE — one row per event/member. Its state, not a second
      // stored status field, is the member's one mutually exclusive answer.
      // ---------------------------------------------------------------------
      "event-rsvp-response": {
        "initialState": "pending",
        "visibility": { "default": "membersOnly" },
        "states": {
          "pending": { "label": "No response yet", "tone": "info" },
          "going": { "label": "Going", "tone": "positive" },
          "maybe": { "label": "Maybe", "tone": "info" },
          "declined": { "label": "Can't make it", "tone": "negative" },
          "waitlisted": { "label": "Waitlisted", "tone": "warning" },
          "cancelled": {
            "label": "Run cancelled", "tone": "negative", "isTerminal": true
          }
        },
        "transitions": [
          {
            "id": "respond-going",
            "action": "respond",
            "label": "Going",
            "icon": "event_available",
            "tone": "primary",
            "from": ["pending", "maybe", "declined", "waitlisted"],
            "to": "going",
            "guard": {
              "allowedRoleIds": ["run-member", "run-organizer"],
              "actorEqualsField": { "key": "memberFanId" },
              // Only count is currently safe for relatedAggregate capacity checks.
              "relatedAggregate": {
                "workflowType": "event-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count",
                "comparator": "<",
                "compareTo": { "relatedInstanceField": "eventId", "field": "capacity" }
              }
            }
          },
          {
            "id": "respond-maybe",
            "action": "respond",
            "label": "Maybe",
            "icon": "help_outline",
            "tone": "secondary",
            "from": ["pending", "going", "declined", "waitlisted"],
            "to": "maybe",
            "guard": {
              "allowedRoleIds": ["run-member", "run-organizer"],
              "actorEqualsField": { "key": "memberFanId" }
            }
          },
          {
            "id": "respond-declined",
            "action": "respond",
            "label": "Can't make it",
            "icon": "event_busy",
            "tone": "destructive",
            "from": ["pending", "going", "maybe", "waitlisted"],
            "to": "declined",
            "guard": {
              "allowedRoleIds": ["run-member", "run-organizer"],
              "actorEqualsField": { "key": "memberFanId" }
            }
          },
          {
            "id": "respond-waitlist",
            "action": "join_waitlist",
            "label": "Join waitlist",
            "icon": "groups",
            "tone": "secondary",
            "from": ["pending", "maybe", "declined"],
            "to": "waitlisted",
            "guard": {
              "allowedRoleIds": ["run-member", "run-organizer"],
              "actorEqualsField": { "key": "memberFanId" },
              "relatedAggregate": {
                "workflowType": "event-rsvp-response",
                "filter": { "eventId": "{eventId}", "$state": "going" },
                "op": "count",
                "comparator": ">=",
                "compareTo": { "relatedInstanceField": "eventId", "field": "capacity" }
              }
            }
          },
          {
            // Withdrawal is deliberately distinct from “Can't make it”: it returns
            // to the responseTable's pending state and can be reminded again later.
            "id": "withdraw-rsvp",
            "action": "withdraw_response",
            "label": "Clear RSVP",
            "icon": "undo",
            "tone": "secondary",
            "from": ["going", "maybe", "waitlisted"],
            "to": "pending",
            "guard": {
              "allowedRoleIds": ["run-member", "run-organizer"],
              "actorEqualsField": { "key": "memberFanId" }
            }
          },
          {
            // Member-facing opt-in. It stamps the member's own response row; the
            // platform-applied transition below performs delivery later.
            "id": "request-reminder",
            "action": "set_reminder",
            "label": "Remind me",
            "icon": "notifications_active",
            "tone": "secondary",
            "from": ["pending", "maybe", "going", "waitlisted"],
            "to": null,
            "guard": {
              "allowedRoleIds": ["run-member", "run-organizer"],
              "actorEqualsField": { "key": "memberFanId" },
              "formula": "reminderRequestedAt == null"
            },
            "effects": [
              { "op": "set", "key": "reminderRequestedAt", "value": "$timestamp" }
            ]
          },
          {
            // Platform-applied, not a member button. At reminder time the Calendar
            // sweep supplies event-specific title/body text. The scalar memberFanId
            // makes the recipient unambiguous; both stamps make delivery requested
            // and idempotent for this response row.
            "id": "send-reminder",
            "action": "deliver_reminder",
            "label": "Send reminder",
            "from": ["pending", "maybe", "going", "waitlisted"],
            "to": null,
            "guard": {
              "actorEqualsField": { "key": "memberFanId" },
              "formula": "if(reminderRequestedAt == null, false, reminderSentAt == null)"
            },
            "inputs": {
              "notificationTitle": { "type": "text", "required": true },
              "notificationBody": { "type": "text", "required": true }
            },
            "effects": [
              {
                "op": "createInstance",
                "workflowType": "notification",
                "fields": {
                  "recipientFanId": "{memberFanId}",
                  "title": "{input.notificationTitle}",
                  "body": "{input.notificationBody}",
                  "createdAt": "$timestamp"
                }
              },
              { "op": "set", "key": "reminderSentAt", "value": "$timestamp" }
            ]
          },
          {
            // Organizer-only cascade target. It is never rendered as a member action.
            "id": "event-cancelled",
            "action": "cancel",
            "label": "Close cancelled run response",
            "from": ["pending", "going", "maybe", "declined", "waitlisted"],
            "to": "cancelled",
            "guard": { "allowedRoleIds": ["run-organizer"] }
          }
        ],
        // Correct response-row exception: these rows render inside the parent
        // event-rsvp card via responseTable, never as standalone cards.
        "renderBindings": [],
        "instanceDataSchema": {
          "eventId": { "type": "text", "required": true, "storage": "inline" },
          "memberFanId": {
            "type": "fanId", "required": true, "storage": "inline"
          },
          "reminderRequestedAt": {
            "type": "date?", "writableBy": "effect", "storage": "inline"
          },
          "reminderSentAt": {
            "type": "date?", "writableBy": "effect", "storage": "inline"
          }
        }
      },

      // ---------------------------------------------------------------------
      // NOTIFICATION — a generic, addressed reminder created by send-reminder.
      // It has no create action because another workflow's effect is its creation
      // path. It declares no archetype-owned dismissed/read tracking arrays.
      // ---------------------------------------------------------------------
      "notification": {
        "initialState": "unread",
        "visibility": {
          "default": "guarded",
          "readGuard": { "actorEqualsField": { "key": "recipientFanId" } },
          "fields": { "recipient": "recipientFanId" }
        },
        "states": {
          "unread": { "label": "Unread", "tone": "info" },
          "read": { "label": "Read", "tone": "positive" }
        },
        "transitions": [
          {
            "id": "mark-read",
            "label": "Mark read",
            "icon": "done",
            "tone": "secondary",
            "from": ["unread"],
            "to": "read",
            "guard": { "actorEqualsField": { "key": "recipientFanId" } }
          },
          {
            "id": "mark-unread",
            "label": "Mark unread",
            "icon": "mark_email_unread",
            "tone": "secondary",
            "from": ["read"],
            "to": "unread",
            "guard": { "actorEqualsField": { "key": "recipientFanId" } }
          }
        ],
        "renderBindings": [
          {
            "states": ["unread"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "primary"
          },
          {
            "states": ["read"],
            "audience": "any",
            "tabId": "home",
            "cardSurfaceFamily": "notificationInbox",
            "bindingKind": "summary"
          }
        ],
        "instanceDataSchema": {
          "recipientFanId": {
            "type": "fanId", "required": true, "writableBy": "effect",
            "storage": "inline"
          },
          "title": {
            "type": "text", "required": true, "writableBy": "effect",
            "storage": "inline", "labelTemplate": "{value}",
            "displayContexts": ["tile", "detail"]
          },
          "body": {
            "type": "textarea", "required": true, "writableBy": "effect",
            "storage": "inline", "maxLength": 500,
            "displayContexts": ["detail"]
          },
          "createdAt": {
            "type": "date", "required": true, "writableBy": "effect",
            "storage": "inline", "sortable": true, "displayIcon": "notifications",
            "labelTemplate": "Created {value}", "displayContexts": ["detail"]
          }
        }
      }
    },

    "workflowInstances": [
      {
        "instanceId": "run-tuesday-river-loop",
        "workflowType": "event-rsvp",
        "currentState": "open",
        "createdByFanId": "fan-riverbend-organizer-01",
        "instanceData": {
          "title": "Tuesday river loop",
          "eventDate": "2026-09-08",
          "eventTime": "18:00",
          "location": "North River Trailhead kiosk",
          "routeNotes": "Out-and-back on the signed river trail; regroup at the footbridge.",
          "distanceKm": 8,
          "paceGuidance": "Conversational pace; 6:00–7:00 min/km group",
          "capacity": 15,
          "reminderOffsetHours": 24
        }
      },
      {
        "instanceId": "response-tuesday-organizer",
        "workflowType": "event-rsvp-response",
        "currentState": "going",
        "createdByFanId": "fan-riverbend-organizer-01",
        "instanceData": {
          "eventId": "run-tuesday-river-loop",
          "memberFanId": "fan-riverbend-organizer-01"
        }
      },
      {
        "instanceId": "response-tuesday-member-01",
        "workflowType": "event-rsvp-response",
        "currentState": "pending",
        "createdByFanId": "fan-riverbend-organizer-01",
        "instanceData": {
          "eventId": "run-tuesday-river-loop",
          "memberFanId": "fan-riverbend-member-01"
        }
      },
      {
        "instanceId": "notification-tuesday-member-reminder",
        "workflowType": "notification",
        "currentState": "unread",
        "createdByFanId": "fan-riverbend-organizer-01",
        "instanceData": {
          "recipientFanId": "fan-riverbend-member-01",
          "title": "Tuesday river loop reminder",
          "body": "Meet at the North River Trailhead kiosk at 6:00 PM tomorrow.",
          "createdAt": "2026-09-07T18:00:00-07:00"
        }
      }
    ]
  },

  // Whole-package tab audit: renderBindings use only the built-in home tab and
  // this one declared custom tab. No roleTabs are needed.
  "appShell": {
    "tabs": [
      {
        "tabId": "calendar",
        "label": "Calendar",
        "iconKey": "calendar_today",
        "description": "Group runs, capacity, RSVP responses, and reminders."
      }
    ]
  }
}
